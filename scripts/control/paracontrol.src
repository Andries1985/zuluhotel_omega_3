use uo;
use os;
use cfgfile;

include "include/dotempmods";
include "include/classes";
include "include/client";
include "include/spelldata";

const DELAY_BETWEEN_CHECKS_MS	:= 1000;

program para_control( item )

	// 2026-10-31: ByTrueMage and Creator are not read once at startup, as in poisoncontrol: the caster sets them after
	// CreateItemAtLocation has already started this script; SetScriptController once
	var controller := 0;
	// 2026-10-31: the props are read every tick until Creator has been seen on two ticks, then kept: the caster
	// writes Creator first and the rest straight after, and ticks are seconds apart. The caster itself is still
	// looked up every tick, so a field notices when a monster caster has died
	var reads_with_creator := 0;
	var diff, points, duration, serial;
	
	while( item )
		// 2026-10-29: read the location once per tick: the field can be destroyed mid-tick, which gave an uninit realm (ZH2.5 1.1.5 port)
		var realm := item.realm;
		var fx := CInt(item.x), fy := CInt(item.y), fz := CInt(item.z);
		if( !realm )
			break;
		endif

		if( reads_with_creator < 2 )
			diff     := 50;
			points   := 25;
			duration := 10;
			if( GetObjProperty( item , "ByTrueMage" ) )
				diff := Cint( diff * CLASSE_BONUS );
				points := Cint( points / CLASSE_BONUS );
				duration := Cint( duration * CLASSE_BONUS );
			endif
			serial := Cint( GetObjProperty( item , "Creator" ) );
			if( serial )
				reads_with_creator := reads_with_creator + 1;
			endif
		endif

		var creator := 0;
		if( serial )
			creator := SystemFindObjectBySerial( serial , SYSFIND_SEARCH_OFFLINE_MOBILES );
			if( creator and !controller )
				SetScriptController(creator);
				controller := creator;
			endif
		endif

		PlaySoundEffect( item , SFX_SPELL_PARALYZE_FIELD );
		var victims := ListMobilesNearLocation( fx , fy , fz , 0, realm );
		victims := SmartAoE(creator, victims);
		foreach mobile in victims
			if( CanMod( mobile , "p" ) )
				if( !GetObjProperty( mobile , "FreeAction" ) )
					if( !CheckSkill( mobile , SKILLID_MAGICRESISTANCE , diff , points ) )
						PlayObjectCenteredEffect( mobile , FX_SPELL_PARALYZE , SPEED_SPELL_PARALYZE , LOOP_SPELL_PARALYZE );
						PlaySoundEffect( mobile , SFX_SPELL_PARALYZE );
						if(!mobile.multi)
							DoTempMod( mobile , "p" , 1 , duration );
						endif
					endif
				endif
			endif
		endforeach
		
		Sleepms( DELAY_BETWEEN_CHECKS_MS );
	endwhile
  
endprogram