use uo;
use os;
use cfgfile;

include "include/spelldata";
include "include/objtype";
include "include/classes";
include "include/client";
include "include/random";
const DELAY_BETWEEN_HITS_MS	:= 1000;

program energy_control( item )

	//return 1;
	var diff    := 60;
	var points  := 25;
	var element := AIR;
	// 2026-10-31: ByTrueMage and Creator are not read once at startup, as in poisoncontrol: the caster sets them after
	// CreateItemAtLocation has already started this script; SetScriptController once
	var controller := 0;
	// 2026-10-31: the props are read every tick until Creator has been seen on two ticks, then kept: the caster
	// writes Creator first and the rest straight after, and ticks are seconds apart. The caster itself is still
	// looked up every tick, so a field notices when a monster caster has died
	var reads_with_creator := 0;
	var power, serial;

	var coordinates := {};
	
	case( item.objtype )
		UOBJ_EFIELD_NS:	coordinates := { { item.x , item.y , item.z },
						 { item.x , item.y-1 , item.z },
						 { item.x , item.y+1 , item.z } };
				break;
				 
				 
		UOBJ_EFIELD_EW:	coordinates := { { item.x , item.y , item.z },
						 { item.x-1 , item.y , item.z },
						 { item.x+1 , item.y , item.z } };
				break;
				
		default:
	endcase

	if( !len(coordinates) )
		return;
	endif
		
	while( item )
		// 2026-10-29: read the realm once per tick: the field can be destroyed mid-tick, which gave an uninit realm (ZH2.5 1.1.5 port)
		var realm := item.realm;
		if( !realm )
			break;
		endif

		if( reads_with_creator < 2 )
			power := 4;
			if( GetObjProperty( item , "ByTrueMage" ) )
				power := Cint( power * CLASSE_BONUS );
			endif
			serial := Cint( GetObjProperty( item , "Creator" ) );
			if( serial )
				reads_with_creator := reads_with_creator + 1;
			endif
		endif

		var creator := 0;
		if( serial )
			creator := SystemFindObjectBySerial( serial , SYSFIND_SEARCH_OFFLINE_MOBILES );
			if( creator and !controller )
				SetScriptController(creator);
				controller := creator;
			endif
		endif

		var dmg := RandomDiceStr( power + "d8" );
		PlaySoundEffect( item , SFX_SPELL_ENERGY_FIELD );
		foreach coord in coordinates
			var victims := ListMobilesNearLocation( coord[1] , coord[2] , coord[3] , 0, realm );
			victims := SmartAoE(creator, victims);
			foreach mobile in victims
				// 2026-10-31: with no caster each victim stands in for itself; the first-victim fallback made that
				// victim the attacker of everyone else in the field (same fix as firecontrol.src)
				var attacker := creator;
				if( !attacker )
					attacker := mobile;
				endif
				if(!mobile.multi)
					PerformAction( mobile , ANIM_HIT );
					PlayObjectCenteredEffectEx( mobile, 0x3789, 0 , 10, 496, 5);
					ApplyElementalDamageNoResist( mobile, attacker, Cint(ResistedDefinedSkillGain( attacker , mobile , dmg , diff , points )), element );
				endif
			endforeach
		endforeach
		Sleepms( DELAY_BETWEEN_HITS_MS );
	endwhile
  
endprogram