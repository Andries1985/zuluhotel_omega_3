use uo;
use os;
use util;

program trash(item)
	var count := 0;
	while(item)
		foreach trashitem in EnumerateItemsInContainer(item)
			// 2026-09-23: the stamp is runtime-only, so an item already in the can at a restart
			// (or moved in by a script) had none and was never destroyed; no stamp = due now.
			var destroy_at := CInt(GetObjProperty(trashitem, "#DestroyAt"));
			if(!destroy_at || destroy_at <= ReadGameClock())
				count := count + 1;
				DestroyItem(trashitem);
			endif
		endforeach
		if(count)
			case(RandomInt(4))
				0: PrintTextAbove(item, "*gurgle*");
				1: PrintTextAbove(item, "*slosh*");
				2: PrintTextAbove(item, "*fwoomp*");
				3: PrintTextAbove(item, "*crunch*");
			endcase
		endif
		count := 0;
		sleep(120);
	endwhile
endprogram