use uo;
use os;
use cfgfile;

include "include/spelldata";
include "include/classes";
include "include/client";
include "include/random";
const DELAY_BETWEEN_HITS_MS	:= 5000;

program field_control( item )

	var diff    := 30;
	var points  := 25;
	// 2026-10-29: power/element/dice/creator moved into the loop (ZH2.5 1.1.5 port)
	var controller := 0;
	// 2026-10-31: the props are read every tick until Creator has been seen on two ticks, then kept: the caster
	// writes Creator first and the rest straight after, and ticks are seconds apart. The caster itself is still
	// looked up every tick, so a field notices when a monster caster has died
	var reads_with_creator := 0;
	var element, dice, unresistable, serial;

	//var itemx:=cint(item.x), itemy:=cint(itemy), itemz:=cint(item.z);

	while(item.x)
		// 2026-10-29: read the location once; the field can be destroyed between a check and the lookup, which gave an uninit realm (ZH2.5 1.1.5 port)
		var realm := item.realm;
		var fx := CInt(item.x), fy := CInt(item.y), fz := CInt(item.z);
		if(!realm)
			break;
		endif

		// 2026-10-29: the caster sets these props after CreateItemAtLocation has already started this script,
		// so they are not read once at startup (ZH2.5 1.1.5 port; specialELE from ZH2.5 d5d232a)
		if( reads_with_creator < 2 )
			var power := 2;
			if( GetObjProperty( item , "ByTrueMage" ) )
				power := Cint( power * CLASSE_BONUS );
			endif
			element := FIRE;
			var specEle := GetObjProperty( item, "specialELE" );
			if( specEle )
				element := specEle;
			endif
			// 2026-10-29: a field can set its own damage dice and skip Magic Resistance (champfire's fields, npccastspells.inc);
			// other fields roll power d8 and are resisted as before (ZH2.5 1.1.5 port)
			// 2026-10-31: an Unresistable field goes through ApplyElementalDamageNoResist: protection only, no Magic
			// Resistance, class or Eval Int adjustment and no Mage protection pierce
			dice := power + "d8";
			if( GetObjProperty( item , "FieldDice" ) )
				dice := CStr( GetObjProperty( item , "FieldDice" ) );
			endif
			unresistable := CInt( GetObjProperty( item , "Unresistable" ) );
			serial := Cint( GetObjProperty( item , "Creator" ) );
			if( serial )
				reads_with_creator := reads_with_creator + 1;
			endif
		endif

		// 2026-10-29: look the caster up each tick (a monster's fields can outlive it); SetScriptController once (ZH2.5 1.1.5 port)
		var creator := 0;
		if( serial )
			creator := SystemFindObjectBySerial( serial , SYSFIND_SEARCH_OFFLINE_MOBILES );
			if( creator and !controller )
				SetScriptController(creator);
				controller := creator;
			endif
		endif

		var dmg := RandomDiceStr( dice );
		PlaySoundEffect( item , SFX_SPELL_FIRE_FIELD );
		var victims := ListMobilesNearLocation( fx , fy , fz , 0 , realm );
		victims := SmartAoE(creator, victims);
		foreach mobile in victims
			// 2026-10-31: with no caster (none set, or it has died) each victim stands in for itself, so nobody
			// is credited or blamed; the old first-victim fallback made that victim the attacker of everyone else
			var attacker := creator;
			if( !attacker )
				attacker := mobile;
			endif
			if(!mobile.multi)
				PerformAction( mobile , ANIM_HIT );
				PlayObjectCenteredEffectEx( mobile, 0x371A, 0 , 10, 0, 5);
				if( unresistable )
					ApplyElementalDamageNoResist( mobile, attacker, dmg, element );
				else
					ApplyElementalDamage( attacker, mobile, 4, dmg, element );
				endif
			endif
		endforeach
		Sleepms( DELAY_BETWEEN_HITS_MS );
	endwhile
  
endprogram
