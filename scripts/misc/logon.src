use uo;
use os;
use datafile;

include "include/attributes";
include "include/NameChecker";
include ":areas:include/areafunctions";
include "include/areas"; // 2026-09-23: IsInSafeArea / IsInNOPKArea for the login re-check
include ":karmafame:karmafame";
include "include/constants/locations";
include "include/client";
include "include/spellgrants";
include ":accounts:accounts";
include ":accounts:settings";
include "include/ipban";
include ":powerhour:include/powerhour"; // 2026-10-08: PPH_ClearFlags for the powerhour resume below

program logon( who )
	//Print("I am using scripts misc logon.src");

	// 2026-10-01: login policy first (the DiscordID / IP / household rules in
	// :accounts:accounts). A refused character is disconnected here, before it is
	// announced or any player script starts; the check used to run after this whole
	// script, from pkg/systems/accounts/logon.src. Its logoff marker is cleared as for
	// any character entering the world; logoff.src puts a new one down when it leaves.
	if( !ACCT_AdmitCharacter( who ) )
		RemoveLogoff( who );
		return 0;
	endif

	// 2026-10-04: IP ban list (.ipban). Checked before the character is announced or any
	// player script starts, so a banned address never shows "has arrived!".
	if( !IPBan_AdmitCharacter( who ) )
		RemoveLogoff( who );
		return 0;
	endif

	var stafflevel := who.cmdlevel;

	if(stafflevel > 0)
		who.setlightlevel(0, 999999);
	endif

	if(DEBUG_MODE)
		who.setlightlevel(0, 999999);
		SetObjProperty( who, "hunger", 1 );
	endif

	RemoveLogoff( who );

	// for whatever reason I didn't use # tag for this. 
	RemoveSafeAreaProperties(who, 1);
	// 2026-09-23: decide the safe-zone and no-PK flags here instead of racing the region
	// enter script the engine fires at login (it hands off to a delayed script).
	if (IsInSafeArea(who))
		SetSafeAreaProperties(who);
	elseif (IsInNOPKArea(who))
		SetNOPK(who);
	else
		RemoveNOPK(who);
	endif
	
	var acc:=who.acct;
	if(acc.getprop("acctjail"))
		MoveObjectToLocation( who, DEFAULT_LOCATION_JAIL_X, DEFAULT_LOCATION_JAIL_Y, DEFAULT_LOCATION_JAIL_Z, DEFAULT_LOCATION_JAIL_R, MOVEOBJECT_FORCELOCATION);
	endif

	if(!acc.getprop("Release"))
		acc.eraseprop("acctjail");
	endif
	
	Print( "logon: " + who.name );
	Start_Script( "::playermanager", who );
	
	var settings := ACCT_GetSettingsCfgElem( "Settings" );
	acc.set_uo_expansion(settings.DefaultExpansion);

    GrantPrivilege( who, "seeghosts" );
	who.Enable( "seeghosts" );

	// Name Check
        var check := CheckName(who.name,who);
        if (check[1] == 0 || check != 1 || GetObjProperty(who, "Converted"))
			who.name := "AlreadyUsed";
			start_script("misc/namechanger", {who, check[2]}); 
        endif
		
	if (stafflevel == 0)		
		who.concealed := 0;
	endif

	// Clear stuck movement-blocking flags on logon. Players who logged out
	// while frozen (e.g. mid-cast, mid-verse) or paralyzed (paralyze spell,
	// stun) should not stay locked in place after logging back in.
	who.frozen := 0;
	who.paralyzed := 0;

	// 2026-09-22: take back what a restart left behind: a Dragon Skin grant on
	// PhysicalProtection and an Antidote/Sanctuary poison immunity, durable
	// properties that only their sleeping script used to remove (spellgrants.inc).
	// 2026-10-25: the spells no longer write those markers (they keep their own level, see spellprots.inc, ZH2.5
	// 1.1.5 port). These two calls only clean up markers saved by the old code; remove them, the include above and
	// spellgrants.inc after the next release.
	ReclaimDragonSkinGrant( who );
	ReclaimSpellPoisonImmunity( who );
	
	if(!GetObjProperty(who, "OrgName"))
		SetObjProperty(who, "OrgName", who.name);
	endif

	if(!GetObjProperty(who, "DaysOld"))
		var time := GetObjProperty(who, "CreatedAt");
		var timenow := ReadGameClock();
		if(!time)
			time := 0;
		endif
		time := timenow-time;
		time := CInt(time/(24*3600));
		SetObjProperty(who, "DaysOld", time);
	endif

	if (stafflevel == 0)		
		who.concealed := 0;
		Broadcast( who.name + " has arrived!");
	else
		Broadcast( who.name + " has come online and is here to help!");
	endif
	// 2026-10-01: logoff.src announces a departure only when the arrival was announced.
	SetObjProperty( who, "#ArrivalAnnounced", 1 );

	// Resume personal powerhour if one was active when the player disconnected.
	// The original activateph() instance (setph.src) does not survive a server
	// reboot, so #SettingPH/#PPHPid would otherwise be stuck forever -- only
	// that dead instance's own cleanup, or a GM .resetph, would ever clear them.
	//
	// 2026-09-01: gated on the durable "pph_active_type" property instead of
	// #PPHH/#PPHC/#PPHS directly -- those "#"-prefixed flags aren't reliably
	// persisted across an actual server restart in this repo, so after a real
	// reboot this whole block used to silently never trigger: the player's
	// active hour was lost with no message, and since pph_use_time/
	// pph_use_weekday (plain, durable) still showed the week as "already
	// used," they'd also be blocked from starting a new one until next week.
	// activateph() (setph.src) writes pph_active_type alongside the "#" flag
	// specifically so this check survives a reboot; the specific #PPHx flag
	// is re-set from it below (in the same still-running session) so
	// resumeph.src and every crafting-skill-gain check that reads #PPHH/
	// #PPHC/#PPHS directly keep working unchanged.
	var active_type := GetObjProperty(who, PPH_PROP_ACTIVE);
	if(active_type && !active_type.errortext)
		// A plain disconnect (not a reboot) does NOT kill the original activateph()
		// instance -- it keeps sleeping toward the same end time. Kill it here so
		// resumeph.src below is the only thing still counting down; otherwise both
		// finish at once and the player gets the "has ended!" message twice.
		var old_pid := GetObjProperty(who, PPH_PROP_PID);
		if(old_pid)
			var old_process := GetProcess(CInt(old_pid));
			if(old_process)
				old_process.kill();
			endif
		endif

		SetObjProperty(who, active_type, 1);

		var pph_start := PPH_UseTime(who);
		var remaining := (pph_start + PH_DURATION) - POLCore().systime;
		var resume_process := 0;
		EraseObjProperty(who, PPH_PROP_SETTING);
		EraseObjProperty(who, PPH_PROP_PID);
		if( remaining > 0 )
			// 2026-10-08: pass the start time so resumeph can tell a later powerhour apart from this one
			resume_process := start_script(":powerhour:resumeph", {who, remaining, pph_start});
			// 2026-10-08: record the resume timer like activateph does, so .resetph and the next logon can kill it
			if( resume_process )
				SetObjProperty(who, PPH_PROP_PID, resume_process.pid);
			endif
			// 2026-10-08: pph_active_type is kept until the hour really ends (PPH_Finish). It used to be erased
			// here, so a second restart inside a resumed hour lost the rest of it while the week stayed used.
		else
			PPH_ClearFlags(who);
			EraseObjProperty(who, PPH_PROP_ACTIVE);
		endif
	endif

endprogram


function RemoveLogoff( mobile )

        var shrink_serial := GetObjProperty( mobile, "ShrinkLogoff" );
        if( shrink_serial.errortext )
                return 0;
        endif
        
        var shrink_mobile := SystemFindObjectBySerial( shrink_serial );
        if( shrink_mobile )
                DestroyItem( shrink_mobile );
        endif

        return 1;
endfunction
