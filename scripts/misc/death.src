//Edited August 25, 2024

use uo;
use cfgfile;
use os;
use storage;
use datafile;
include "include/areas";
include "include/starteqp";
include "../pkg/mobiles/npcs/include/NPCBackpacks";
include "include/eventid";
include ":karmafame:karmafame";
include "include/dismount";
include "include/managers";
include ":quests:questdeath";
include "../pkg/opt/rituals/include/altarquest";
// 2026-09-21: include ":combat:shilcombat" removed along with the file -- none
// of its four functions was called anywhere, and none could have compiled if
// one had been (undefined variables, ":=" used as a condition).
include ":champspawns:death";
include ":lootlottery:lootlottery";
include ":containers:storageAreas";
include ":warriorforhire:include/wfhcommon";	// 2026-10-10: WFH_MAX_DEATHS
include ":warriorforhire:include/wfhescrow";	// 2026-10-10: WFH_EscrowCorpseGear for a warrior its owner gave up

program npcdeath(corpse)

	if((GetObjProperty(corpse, "SpawnPoint")))
		var spawnpoint := SystemFindObjectBySerial(GetObjProperty(corpse, "SpawnPoint"));
		if (GetObjProperty(corpse, "GateOnDeath") || GetObjProperty(spawnpoint, "GateOnDeath"))
			Start_Script("misc/deathgate", {corpse, spawnpoint});
		endif
	endif

	var masterserials := GetObjProperty( corpse, "master" );
	var masters;

	if( GetObjProperty( corpse, "PeaceKeeper") )
		DestroyItem(corpse);
	endif
	
	if(masterserials)
		if( GetObjProperty( corpse, "DonatorMount") && !GetObjProperty( corpse, "NoDelete")  )
			masters := SystemFindObjectBySerial( masterserials );
			if( !masters )
				masters := SystemFindObjectBySerial( masterserials, SYSFIND_SEARCH_OFFLINE_MOBILES );
			endif
			EraseObjProperty( masters, "DonatorMounted");
			DestroyItem(corpse);
		endif

		if( (corpse.npctemplate == "donatorhorse") OR (corpse.npctemplate == "donatorllama") OR (corpse.npctemplate == "donatorostard") OR (corpse.npctemplate == "donatorbear") )
			masters := SystemFindObjectBySerial( masterserials );
			if( !masters )
				masters := SystemFindObjectBySerial( masterserials, SYSFIND_SEARCH_OFFLINE_MOBILES );
			endif
			EraseObjProperty( masters, "DonatorMounted");
			DestroyItem(corpse);
		endif
	endif
	set_script_option( SCRIPTOPT_NO_RUNAWAY , 1 );

	// so we know when it died
	SetObjProperty(corpse, "DeathTime", ReadGameClock());
        var npctemplate := GetObjProperty(corpse,"npctemplate");
	
	// For now we destory the horse.  
	// This will just make it a boat piece, destroy it down 
	if (GetObjProperty(corpse, "DismountOnDeath"))
		dismount( corpse );
	else
		DestroyItem(GetEquipmentByLayer( corpse, 0x19 ));
	endif

	set_critical(1);

	WarnManagerOfNpcDeath(corpse);

	if (GetObjProperty(corpse, "rise"))
		start_script("misc/rise", corpse);
	endif

	if (corpse.truecolor) corpse.color:=corpse.truecolor; endif

	if (GetObjProperty(corpse,"color"))
		corpse.color := Cint(GetObjProperty(corpse,"color"));
	endif

    MoveBackpackToCorpse( corpse );
	var heart;
	var resnum;
	if (GetObjProperty(corpse,"WarriorForHire") and GetObjProperty(corpse,"npctemplate") == "warriorforhire" and !GetObjProperty(corpse,"AbandonedByOwner"))

		var corpsemasterserial := GetObjProperty(corpse,"master");
		var corpsemaster := SystemFindObjectBySerial(corpsemasterserial);
		var mastermonline := 1;
		if (!corpsemaster)
			corpsemaster := SystemFindObjectBySerial(corpsemasterserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
			mastermonline := 0;
		endif

		resnum := GetObjProperty(corpse,"resnum");
		if (!resnum)
			resnum := 0;
		endif
		resnum := resnum + 1;
		// 2026-10-10: deaths 1-10 write the backup and drop a heart, both stamped with this corpse's
		// serial (WFHDeathId) so only this death's heart matches the High Priest's memory
		// (IsCurrentWfhHeart); either revival spends both. The eleventh death is final: nothing is
		// written and any older memory is erased so the priest cannot bring the warrior back.
		if (resnum > WFH_MAX_DEATHS)
			if (corpsemaster)
				EraseObjProperty(corpsemaster, "WFHBackup");
				if (mastermonline)
					SendSysMessage(corpsemaster, GetObjProperty(corpse,"Name")+" has fallen for the last time. Neither heart nor priest can bring them back.");
				endif
			endif
		elseif (corpsemasterserial != 0 and corpsemaster)
			heart := CreateItemAtLocation(corpse.x,corpse.y,corpse.z,0x1CED,1,corpse.realm);
			heart.newbie := 1;
			heart.color := 2750;
			heart.usescript := "";
			heart.name := "The Heart of "+GetObjProperty(corpse,"Name");
			SetObjProperty(heart,"Str",GetObjProperty(corpse,"Str"));
			SetObjProperty(heart,"Int",GetObjProperty(corpse,"Int"));
			SetObjProperty(heart,"Dex",GetObjProperty(corpse,"Dex"));
			SetObjProperty(heart,"Name",GetObjProperty(corpse,"Name"));
			SetObjProperty(heart,"resnum",resnum);
			SetObjProperty(heart,"Sex",GetObjProperty(corpse,"Sex"));
			SetObjProperty(heart,"master",corpsemasterserial);
			SetObjProperty(heart,"Skills",GetObjProperty(corpse,"Skills"));
			SetObjProperty(heart,"WFHDeathId",corpse.serial);	// 2026-10-10: only the current death's heart revives

			var backup := dictionary;
			backup.insert("Str", GetObjProperty(corpse,"Str"));
			backup.insert("Int", GetObjProperty(corpse,"Int"));
			backup.insert("Dex", GetObjProperty(corpse,"Dex"));
			backup.insert("Name", GetObjProperty(corpse,"Name"));
			backup.insert("Sex", GetObjProperty(corpse,"Sex"));
			backup.insert("resnum", resnum);
			backup.insert("Skills", GetObjProperty(corpse,"Skills"));
			backup.insert("WFHDeathId", corpse.serial);
			SetObjProperty(corpsemaster, "WFHBackup", backup);

			if (mastermonline)
				MoveItemToContainer(heart, corpsemaster.backpack);
				SendSysMessage(corpsemaster, heart.name+" has been placed in your backpack.");
			else
				var bankbox := CP_GetStorageContainerForMobile(corpsemaster, CP_DEFAULT_AREA, CP_CREATE);
				if (bankbox)
					MoveItemToContainer(heart, bankbox);
					SendSysMessage(corpsemaster, heart.name+" has been placed in your bank box.");
				endif
			endif
		endif

		if(IsInSafeArea(corpse) and corpsemaster)
			foreach item in EnumerateItemsInContainer( corpse )
				if (item.container.serial == corpse.serial)
					MoveItemToContainer( item, corpsemaster.backpack );
				endif
			endforeach
		endif
	endif
	var nocorpse  := GetObjproperty(corpse,"nocorpse");
	var summoned  := GetObjproperty(corpse,"summoned");
	var guardkill := GetObjproperty(corpse,"guardkill");

	foreach item in EnumerateItemsInContainer( corpse )

		// destroy boat piece
		if (item.objtype == 0x1f021)
			DestroyItem(item);
		endif

		if( GetObjProperty( item, "noloot" ) )
			DestroyItem(item);
		elseif( item.container == corpse )
			if( GetObjProperty( item, "dropitem" ) )
				EraseObjProperty( item, "dropitem" );
				MoveObjectToLocation( item, corpse.x, corpse.y, corpse.z, corpse.realm );
			endif
		endif
	endforeach

    set_critical(0);

	var npc_cfg	:= ReadConfigFile( "::npcdesc" );
	var soundFx	:= npc_cfg[npctemplate].deathsnd;

	if (soundFx) 
		PlaySoundEffect( corpse, soundFx ); 
	endif
	
	// 2026-10-10: a warrior its owner released or gave up has no corpse worth waiting for (guardkill
	// destroys it below), so its gear goes to the owner's escrow now instead of vanishing with it.
	// No heart and no backup exist for it; any memory of an earlier death is erased too.
	if (GetObjProperty(corpse,"WarriorForHire") and npctemplate == "warriorforhire" and GetObjProperty(corpse,"AbandonedByOwner"))
		var abandonedowner := GetObjProperty(corpse,"master");
		if (abandonedowner)
			var abandonedobj := SystemFindObjectBySerial(abandonedowner);
			if (!abandonedobj)
				abandonedobj := SystemFindObjectBySerial(abandonedowner, SYSFIND_SEARCH_OFFLINE_MOBILES);
			endif
			if (abandonedobj)
				EraseObjProperty(abandonedobj, "WFHBackup");
			endif
			WFH_EscrowCorpseGear(corpse, abandonedowner);
		endif
	endif

	if ( guardkill || summoned )
		// 2026-10-25: a hired warrior the guards killed was destroyed here with its gear, which never
		// reached corpsedecay's escrow; file it now (the given-up case is handled above) (ZH2.5 1.1.5 port)
		if (GetObjProperty(corpse,"WarriorForHire") and npctemplate == "warriorforhire" and !GetObjProperty(corpse,"AbandonedByOwner"))
			var killedowner := GetObjProperty(corpse,"master");
			if (killedowner)
				WFH_EscrowCorpseGear(corpse, killedowner);
			endif
		endif
		zapstorageareas(corpse);
		return DestroyItem(corpse);
	endif

	if (Getobjproperty(corpse, "LottoDrops"))
		LootLottery(corpse);
		if(GetObjProperty(corpse, "LottoLootBag"))
			SetObjProperty(corpse, "noloot", 1);
		endif
	endif
	
    AdviseAttackers( corpse );

	// Safe zone check. No loot if dead in a safe zone
	if (IsInSafeArea(corpse) && GetObjProperty(corpse,"npctemplate") != "warriorforhire" && !GetObjProperty( corpse, "master" ))
		PrintTextAbove(corpse, "*The magic surrounding the area strips the corpse of any items*", 3, 87);
		SetObjProperty(corpse, "noloot", 1);
	endif

	if( GetObjProperty( corpse, "noloot") )
		foreach item in EnumerateItemsInContainer( corpse )
			if( item.container == corpse )
				if( GetObjProperty( corpse, "RiseLootTransfer" ) and GetObjProperty( item, "KeepOnNoLootDeath" ) )
					EraseObjProperty( item, "KeepOnNoLootDeath" );
					continue;
				endif
				DestroyItem(item);
			endif
		endforeach
		if( GetObjProperty( corpse, "RiseLootTransfer" ) )
			EraseObjProperty( corpse, "RiseLootTransfer" );
		endif
	else
		MakeLoot(corpse);
		RegisterNPC(corpse);
	endif
	
	if( nocorpse )
		foreach item in EnumerateItemsInContainer( corpse )
			if( item.container == corpse )
				MoveObjectToLocation( item, corpse.x, corpse.y, corpse.z, corpse.realm );
			endif
		endforeach
		DestroyItem(corpse);
	endif
		
	if(GetObjProperty(corpse, "iChampSpawn"))
		ProcessChampSpawnCorpse(corpse);
	endif

	if(GetObjProperty(corpse, "Champion"))
		ProcessChampionCorpse(corpse);
	endif

	if(GetObjProperty(corpse, "QuestId"))
		QP_Debug("[QuestPkg] npcdeath: QuestId tag seen on corpse "+CStr(corpse.serial)+", handing off to ProcessQuestKill"); // 2026-09-23: behind the quest debug switch like the rest
		ProcessQuestKill(corpse);
	endif

	if(GetObjProperty(corpse, "QuestTrophyObjtype"))
		ProcessRitualBossTrophyDrop(corpse);
	endif

	zapstorageareas(corpse);
		
endprogram

function RegisterNPC(corpse)
	var killer;
	if(GetObjProperty(corpse, "KilledBySerial"))
		killer := SystemFindObjectBySerial(GetObjProperty(corpse, "KilledBySerial"),SYSFIND_SEARCH_OFFLINE_MOBILES );
	endif

	// Only record npcs killed by players
	// Note, KilledBy needs an update. I made KilledBySerial which should be killedby really.
	// Also need to add it to poison death, and maybe some others
	if (!killer || killer.cmdlevel)
		if (!killer && GetObjProperty(corpse, "poison"))
			killer := GetObjProperty(corpse, "PoisonedBy");
			SetObjProperty(corpse, "KilledBy", killer);
		else
			return 0;
		endif
	endif

	var npctype := GetObjProperty(corpse, "npctemplate");

	var file := OpenDataFile("KilledNPCS");
	if (!file)
		CreateDataFile( "KilledNPCS");
	endif

	var currentelement := file.FindElement("NPCDeaths");

	if (!currentelement)
		currentelement := file.CreateElement("NPCDeaths");
	endif

	var npcprop := CInt(currentelement.GetProp(npctype));

	currentelement.SetProp(npctype,npcprop+1);

	UnloadDataFile("KilledNPCS");

endfunction

function zapstorageareas(me)

	var myserial:=getobjproperty(me,"serial");
	if (!myserial) return; endif
	//Print("In zapstorageareas for NPC serial: "+myserial);

	//Print("In zapstorageareas Hex of serial: "+Hex(myserial));
	var name := Hex(myserial);
	//var storage := FindStorageArea( "Merchant Storage" );
	Destroy_Node_Merc(name);
	// if (DestroyRootItemInStorageArea( storage, myserial + " FS"))
	// 	DestroyRootItemInStorageArea( storage, myserial + " PB");
	// 	DestroyRootItemInStorageArea( storage, myserial + " 1C");
	// endif

	var storage := FindStorageArea( "Tamed Storage" );
	DestroyRootItemInStorageArea( storage, "Bankbox  " + HEX(myserial));

endfunction
