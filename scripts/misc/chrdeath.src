use uo;
use os;
use math;

include "include/dotempmods";
include "include/objtype";
include "include/client";
include "include/possess";
include "include/reportmurder";
include ":gumps:yesno";
include ":karmafame:karmafame";
include "include/dismount";
include "include/myutil";
include "include/res";
include "include/camouflage";
include "include/constants/propids";
include "include/packets";
include ":areas:include/areafunctions";

program chrdeath(corpse,ghost) 

	corpse.decayat := ReadGameClock()+2700;
	// Toad - Applying the latest player corpse serial to the player.  Only used for the pvp.src
	SetObjProperty(ghost, "#PVPDeath", corpse.serial);

	// Toad - We want to know exactly when a player died, doesn't matter if the corpse gets destroyed
	// This is for forensics.
	SetObjProperty(corpse,"DeathTime",ReadGameClock());
	SetObjProperty(corpse,"cut",1);

	// For insta guard kills, stop him following.
	EraseObjProperty(ghost, "#KillMe");

	var plyr := 0;
	var killer:=getobjproperty(ghost,"KilledBy");
	foreach character in EnumerateOnlineCharacters()
		if (character.name == killer)
			plyr := character;
		endif
	endforeach

	var acc := plyr.acct;
	var accname := acc.name;	
	if(plyr)
		SetObjProperty( ghost,"KillerSerial",plyr.serial);
		SetObjProperty( corpse,"KillerSerial",plyr.serial);
		SetObjProperty( ghost,"KillerAcct",accname);
		SetObjProperty ( corpse, "KillerAcct", accname );	
	endif
	var wasguarded:=getobjproperty(ghost,PROPID_MOBILE_GUARD_KILLED);
	SetObjProperty( ghost, "Killer", killer);
	SetObjProperty( corpse,"Killer",killer);
	if(wasguarded)
		SetObjProperty( ghost, "WasGuarded", wasguarded);
	endif
	var dx := ghost.x;
	var dy := ghost.y;
	var dz := ghost.z;
	SetObjProperty( ghost, "deathx", dx);
	SetObjProperty( ghost, "deathy", dy);
	SetObjProperty( ghost, "deathz", dz);

	if( GetObjProperty( ghost, PROPID_MOBILE_GUARD_KILLED ) )
		SetObjProperty( ghost, "Killer", "Guards");
	endif
	EraseObjProperty( ghost, "KilledBy" );
	EraseObjProperty( ghost, PROPID_MOBILE_KILLED_BY );
	EraseObjProperty( ghost, PROPID_MOBILE_GUARD_KILLED );
	EraseObjProperty( ghost, PROPID_MOBILE_MAGIC_REFLECTION );
	SetObjProperty( corpse, PROPID_CORPSE_CORPSE_OF, ghost.serial );
	
	// anti looting stuff
	if( !ghost.criminal )
		if( !ghost.murderer )
			if( !GetObjProperty( corpse, PROPID_MOBILE_GUARD_KILLED ) )
				SetObjProperty( corpse, PROPID_CORPSE_IS_BLUE, 1 );
				corpse.color := 90;
			endif
		endif
	endif

	// Set RPer flag on corpse so we can check for this in the antiloot script.
	if(GetObjProperty( ghost, "IsRPer" ))
		SetObjProperty( corpse, PROPID_CORPSE_IS_RPER, 1 );
		corpse.color := 40;
	endif

	ReequipCursed(ghost,corpse);
	CurePoison(ghost);

	var oktodestroy := 1;
	var pvpdeath := GetObjProperty( ghost, "pvping" );
	if(  pvpdeath  )
		EraseObjProperty( ghost, "pvping" );
		sleep (2);
		ResurrectMobile(ghost);
		SetHP(ghost, GetMaxHP(ghost));	
		SetMana(ghost, GetMaxMana(ghost));	
		SetStamina(ghost, GetMaxStamina(ghost));
		ghost.warmode:= 0;
		var mount2;
		foreach item in ListRootItemsInContainerOfObjtype(corpse,0x1F021)
			mount2:=item;
		endforeach
		if(mount2) 
			EquipItem(ghost,mount2);
		endif
		foreach item in EnumerateItemsInContainer( corpse )
			if (item.container.serial == corpse.serial)
				if(!MoveItemToContainer( item, ghost.backpack ))
					ReleaseItem( item );
					SleepMS(100);
					MoveItemToContainer( item, ghost.backpack );
				endif
			endif
		endforeach
		sleepms(100);
		// 2nd sweep of corpse
		foreach item in EnumerateItemsInContainer( corpse )
			sleepms(100);
			item.movable := 1;
			if(!MoveItemToContainer( item, ghost.backpack ))
				ReleaseItem( item );
				SleepMS(100);
				MoveItemToContainer( item, ghost.backpack );
			endif
		endforeach
		// Final Check b4 Destroying Corpse
		foreach item in EnumerateItemsInContainer( corpse )
			if (item)
				oktodestroy := 0;
			endif
		endforeach
		if (oktodestroy)
			DestroyItem(corpse);
		else
			SendSysMessage(ghost,"There are still items left on your corpse - please page staff.");
		endif
		return;
	endif

	var bmdeath := GetObjProperty( ghost, "bmPlayer" );
	if(  bmdeath  ) 
		if( GetObjProperty(ghost, "bmSpeed") )
			EraseObjProperty(ghost, "bmSpeed");
			SendPacket( ghost, "BF0006002600" );
		endif
		EraseObjProperty( ghost, "bmPlayer" );
		EraseObjProperty( ghost, "bmColor");
		sleep (2);
		ResurrectMobile(ghost);
		SetHP(ghost, GetMaxHP(ghost));	
		SetMana(ghost, GetMaxMana(ghost));	
		SetStamina(ghost, GetMaxStamina(ghost));
		ghost.warmode:= 0;
		var mount2;
		foreach item in ListRootItemsInContainerOfObjtype(corpse,0x1F021)
			mount2:=item;
		endforeach
		if(mount2) 
			EquipItem(ghost,mount2);
		endif
		foreach item in EnumerateItemsInContainer( corpse )
			if (item.container.serial == corpse.serial)
				if(GetObjProperty(item, "bmItem"))
					DestroyItem(item);
				else
					sleepms(100);
					item.movable := 1;
					if(!MoveItemToContainer( item, ghost.backpack ))
						ReleaseItem( item );
						SleepMS(100);
						MoveItemToContainer( item, ghost.backpack );
					endif
				endif
			endif
		endforeach
		sleepms(100);
		// 2nd sweep of corpse
		foreach item in EnumerateItemsInContainer( corpse )
			sleepms(100);
			item.movable := 1;
			if(!MoveItemToContainer( item, ghost.backpack ))
				ReleaseItem( item );
				SleepMS(100);
				MoveItemToContainer( item, ghost.backpack );
			endif
		endforeach
		// Final Check b4 Destroying Corpse
		foreach item in EnumerateItemsInContainer( corpse )
			if (item)
				oktodestroy := 0;
			endif
		endforeach
		if (oktodestroy)
			DestroyItem(corpse);
		else
			SendSysMessage(ghost,"There are still items left on your corpse - please page staff.");
		endif
		SetSafeAreaProperties(ghost);
		MoveObjectToLocation( ghost, 5503, 1665, 22, "britannia", MOVEOBJECT_FORCELOCATION );
		return;
	endif

	AwardFame( ghost, FAME_LOST_ON_DEATH );
	if( !GetObjProperty( corpse, PROPID_MOBILE_GUARD_KILLED ) )
		AdviseAttackers(ghost);
	endif

	// Ghosts can't hear or see other ghosts???
/* 	if( !ghost.cmdlevel )
		RevokePrivilege(ghost,"hearghosts");
		RevokePrivilege(ghost,"seeghosts");
	endif */

	// Set real name if incog
	var temp:=GetObjProperty(ghost,"realname");
	if (temp)
		SetName(ghost,temp);
		EraseObjProperty(ghost,"realname");
	endif

	if (GetObjProperty(ghost,"origform"))
		EraseObjProperty(ghost,"origform");
		ghost.frozen:=0;
	endif

	// Earth Spell shape shift
	temp:=getobjproperty(ghost,"tn");
	if (temp)
		SetName (ghost,temp);
		EraseObjProperty(ghost,"tn");
		EraseObjProperty(ghost,"tc");
		EraseObjProperty(ghost,"tg");
	endif

	// Camouflage Check
	temp := getobjproperty(ghost, "cmfc");
	if (temp)
		RemoveCamouflage( ghost );
	endif

	if( ghost.dead and (ghost.graphic != 0x192) and (ghost.graphic != 0x193) )
	  	ghost.graphic := 402 + Cint(ghost.gender);
	endif


	// Dismount handling: modern POL core (2013+) unequips the mount from
	// the character during die() and equips it on the CORPSE's layer 25.
	// Older/edge-case paths can instead leave it on the ghost's own mount
	// layer or loose in the corpse's root contents -- clearmount.src (our
	// manual GM recovery command for this exact bug) additionally has to
	// check the ghost's root contents, so check all four locations.
	var mount := GetEquipmentByLayer( corpse, LAYER_MOUNT );
	if( !mount )
		mount := GetEquipmentByLayer( ghost, LAYER_MOUNT );
	endif
	if( !mount )
		foreach item in ListRootItemsInContainerOfObjtype(corpse,0x1F021)
			mount := item;
		endforeach
	endif
	if( !mount )
		foreach item in ListRootItemsInContainerOfObjtype(ghost,0x1F021)
			mount := item;
		endforeach
	endif

	if(mount)
		Print( "chrdeath(): dismounting "+ghost.name+" mount item "+mount.serial+" graphic=0x"+Hex(mount.graphic) );
		if( !Dismount(ghost,mount) )
			// Emergency fallback: never leave a dead player mounted.
			Print( "chrdeath(): dismount failed for "+ghost.name+" ("+ghost.serial+"); forcing mount destroy." );
			if( !DestroyItem(mount) )
				ReleaseItem( mount );
				SleepMS(50);
				DestroyItem(mount);
			endif
		endif
	else
		Print( "chrdeath(): no mount item found in any known location for "+ghost.name+" ("+ghost.serial+")." );
	endif

	// Belt-and-suspenders sweep: destroy any stray mount-objtype items on
	// other equipment layers or loose in the ghost's backpack. These
	// shouldn't normally exist, but clearmount.src has needed to clean
	// exactly this up in the field, which means the checks above don't
	// always catch everything.
	var strylayer;
	for( strylayer := 1; strylayer <= 30; strylayer := strylayer + 1 )
		if( strylayer != LAYER_MOUNT )
			var stray := GetEquipmentByLayer( ghost, strylayer );
			if( stray && stray.objtype == 0x1F021 )
				Print( "chrdeath(): destroying stray mount item on layer "+strylayer+" serial="+stray.serial+" for "+ghost.name );
				if( !DestroyItem( stray ) )
					ReleaseItem( stray );
					SleepMS(50);
					DestroyItem( stray );
				endif
			endif
		endif
	endfor
	if( ghost.backpack )
		foreach item in EnumerateItemsInContainer( ghost.backpack, ENUMERATE_ROOT_ONLY )
			if( item.objtype == 0x1F021 )
				Print( "chrdeath(): destroying backpack mount item serial="+item.serial+" for "+ghost.name );
				if( !DestroyItem( item ) )
					ReleaseItem( item );
					SleepMS(50);
					DestroyItem( item );
				endif
			endif
		endforeach
	endif

	// Clear every stale mount-related property clearmount.src resets, not
	// just DonatorMounted -- DMountSerial/bmSpeed/SpeedWalk left behind
	// are exactly what our manual recovery tool has to erase by hand.
	EraseObjProperty( ghost, "DonatorMounted" );
	EraseObjProperty( ghost, "DMountSerial" );
	EraseObjProperty( ghost, "bmSpeed" );
	EraseObjProperty( ghost, "SpeedWalk" );

	// Force a full client redraw. IncRevision plus a same-tile relocate
	// were not enough on their own to clear a stuck mounted animation and
	// its movement speed in the field. This matches a known UO client bug
	// class where a forced, instant transition -- dying while mounted,
	// instead of a normal double-click dismount -- leaves the client
	// rendering the pre-transition mounted pose. Briefly hiding and
	// unhiding the mobile forces the client to fully remove and re-insert
	// it, which is the same technique already used elsewhere in this
	// codebase (pvp.src, pvp2vs2.src, chaosmultikillpcs.src) to force a
	// clean client redraw.
	IncRevision( ghost );
	ghost.hidden := 1;
	SleepMS(50);
	ghost.hidden := 0;
	MoveObjectToLocation( ghost, ghost.x, ghost.y, ghost.z, ghost.realm, MOVEOBJECT_FORCELOCATION );

	SetPlayerWarMode(ghost, 0);
	SleepMS(200);
	SetPlayerWarMode(ghost, 1);

	if(len(ghost.reportables)>0)
		SendReportGump(ghost);
	endif

	// Find out what this prop is
	EraseObjProperty(ghost,"mr");
	
	// What's this for? It's the time of death PLUS an hour
	SetObjProperty(ghost,"death",ReadGameClock()+3600);

	// Play the "death" music midi
	PlayMidiMusic( ghost, "2A" );

	// Fast loot own corpse
	Start_Script(":loot:lootgump", corpse);


endprogram


function FindMyPack(myserial)
    var mybank:=OpenTamedStorageAreas();
    var bank_obj_name:="Bankbox  "+hex(myserial);
    var bankbox:=FindRootItemInStorageArea(mybank,bank_obj_name);

    if (!bankbox) 
		bankbox:=CreateRootItemInStorageArea(mybank,bank_obj_name,UOBJ_BANKBOX); 
	endif

    return bankbox;

endfunction


function OpenTamedStorageAreas()
    var bank:=FindStorageArea("Tamed Storage");

    if (!bank) 
		bank:=CreateStorageArea("Tamed Storage"); 
	endif

    return bank;
endfunction


function ReequipCursed(ghost,corpse)

	foreach item in EnumerateItemsInContainer(corpse)
		if(GetObjProperty(item,"StayEquipped"))
			EquipItem(ghost,item);
		endif
	endforeach

	foreach item in EnumerateItemsInContainer(ghost.backpack)
		if(GetObjProperty(item,"StayEquipped"))
			EquipItem(ghost,item);
		endif
	endforeach

endfunction