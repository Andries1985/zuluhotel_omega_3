use uo;
use os;

include "include/client";
include "include/camouflage";
include "include/dotempmods";
include "include/attributes";
include "include/possess";
include ":areas:include/areafunctions";
include ":accounts:accounts";


program logoff(who)

	print("Logoff: "+who.name);
	ACCT_ClearPendingLoginReservation( who );

	DisplayLogoff( who );

	var temp := GetObjProperty(who,"realname");
	if (temp)
		SetName (who,temp);
		EraseObjProperty(who,"realname");
	endif
	
	temp := GetObjProperty(who, "tn");
	if (temp)
		 SetName (who,temp);
		 eraseobjproperty(who, "tn");
	endif

	eraseobjproperty(who, "tc");

	temp := GetObjProperty(who, "tg");
	if (temp)
		 who.graphic := temp;
		 eraseobjproperty(who, "tg");
	endif

	// #2 Polymorph graphic restore: golem-wand and liche spell save the
	// player's pre-transform graphic in "origform" before mutating
	// who.graphic. If logoff happens while polymorphed, neither script
	// gets to restore it -> player stays a golem/liche across sessions.
	// Restore then erase, same restore-then-erase pattern as the liche
	// stat-mod cleanup at the bottom of program logoff().
	temp := GetObjProperty(who, "origform");
	if (temp)
		who.graphic := temp;
		EraseObjProperty(who, "origform");
	endif

	temp := GetObjProperty(who,"#BrowsingGuild");
	if (temp)
		EraseObjProperty(who,"#BrowsingGuild");
	endif
	
	temp := GetObjProperty(who,"#Paging");
	if (temp)
		EraseObjProperty(who,"#Paging");
	endif

	temp := GetObjProperty(who, "#ViewingBeast");
	if (temp)
		who.frozen := 0;
		who.concealed := 0;
		EraseObjProperty(who, "#ViewingBeast");
	endif

	// Beastal Bond cleanup: if logoff happens mid-verse the bard's
	// Beastal_Bond script may never run BringBackToPosition, leaving the
	// player permanently concealed/frozen and the wisp AI alive.
	// Clear all bond state; ai_beastal_bond exits on its own once
	// BeastalBond is missing on the master.
	if (GetObjProperty(who, "BeastalBond") || GetObjProperty(who, "BeastalBondTimer") || GetObjProperty(who, "#StopPlaying"))
		who.frozen := 0;
		who.concealed := 0;
		EraseObjProperty(who, "BeastalBond");
		EraseObjProperty(who, "BeastalBondTimer");
		EraseObjProperty(who, "#StopPlaying");
		EraseObjProperty(who, "#ViewingBeast");
	endif

	//Erase #Casting just to be sure!
	EraseObjProperty(who, "#Casting");

	// Transient in-progress action / UI flags. Any script that owns one of
	// these clears it on its own happy path, but a logoff mid-action can
	// leave them set, which blocks future use of the same system on
	// reconnect. Safe to unconditionally erase here.
	EraseObjProperty(who, "#BoulderSelection");  // Bardic_Boulders target picker
	EraseObjProperty(who, "#BoulderTarget");     // Bardic_Boulders chosen target serial
	EraseObjProperty(who, "#StopPlaying");       // Verse cancel flag
	EraseObjProperty(who, "#Flock");             // Spirit_Flock active flock array
	EraseObjProperty(who, "#Messaging");         // pkg/opt/msg conversation buffer
	EraseObjProperty(who, "#MerchantID");        // merchantidentify in-flight
	EraseObjProperty(who, "#DaggerThrow");       // balanceddagger in-flight
	EraseObjProperty(who, "#SpellMove");         // summoning/checkmove interrupt flag
	EraseObjProperty(who, "spelldata");          // cast textcmd spell state
	EraseObjProperty(who, "DoingVet");           // veterinary in-flight
	EraseObjProperty(who, "IsMeditating");       // meditation in-flight
	EraseObjProperty(who, "banker_making_check"); // banker check-creation in-flight
	EraseObjProperty(who, "StatsState");         // dye stat gump state
	EraseObjProperty(who, "Detsoob");            // booststone selection state
	EraseObjProperty(who, "#TryAddVerse");       // versescroll add-verse pending response

	// #3 / #4 Poison residue: poison_heal.src tracks active poison ticks
	// in "#PoisonPIDs" and the running poison level in "#PoisonAmt".
	// The #RunningScripts loop below kills the tick processes, but the
	// props persist -- next time the player gets poisoned, the new
	// amount stacks on top of stale level with no live ticks. Erase
	// both; effective poison state is gone the instant the processes die.
	EraseObjProperty(who, "#PoisonPIDs");
	EraseObjProperty(who, "#PoisonAmt");

	// Possession cleanup (#30-34): if staff logs off while possessing an
	// NPC, fully unpossess so the staff body is restored to its real
	// name/prefix/suffix/graphic/skills/stats and the puppet NPC has its
	// hidden/frozen flags cleared. Without this the staff char stays
	// stuck with the npc's appearance & the puppet remains hidden/frozen.
	if (GetObjProperty(who, "possess"))
		unpossess(who);
	endif

	var scripts := GetObjProperty( who, "#RunningScripts" );
	if( scripts )
		var process;
		foreach pid in scripts
			process := GetProcess(pid);
			if( process )
				process.kill();
			endif
		endforeach
	endif
	
	// Personal powerhour persists through logoff. logon.src resumes
	// the remaining time (or clears stale props if expired).

//	setchat(who);

//	if (TypeOf(getobjproperty(who,"ctfloc"))="Integer")
//		quitctf(who);
//	else
//		fixchr(who);
//	endif

	EraseObjProperty( who , "ReactiveArmor" );
	//  if (who.cmdlevel>0) return; endif

	// online time counter
	var sessiontime:=ReadGameClock()-GetObjProperty(who,"#logontime");
	var timer:=GetObjProperty(who,"onlinetimer");
	if(!timer)
		timer:=0;
	endif
	SetObjProperty(who,"onlinetimer",timer+sessiontime);
/*
	//reset newbie status
	var newbieflag := GetObjProperty(who,"newbie");

	if (((timer+sessiontime) >= 1000000) and newbieflag)
		var result:=find(who.name," [New]",1),name:=who.name;
	if (result)
		result:=result-1;
		name:=name[1,result];
		who.name:=name;
		endif
		SetObjProperty(who,"newbie", 0);
	endif*/
	// end online time counter
	
	// liche Fix
	temp := getobjproperty(who, "IsLiche");
	if (temp)
			var str_modulation := GetObjProperty( who , "lstrmod" );
			var dex_modulation := GetObjProperty( who , "ldexmod" );
			var int_modulation := GetObjProperty( who , "lintmod" );
			EraseObjProperty(who, "IsLiche");
			EraseObjProperty(who, "Type");
			EraseObjProperty( who , "lstrmod");
			EraseObjProperty( who , "ldexmod");
			EraseObjProperty( who , "lintmod");	
			SetStrengthMod(who, GetStrengthmod(who)-str_modulation);
			SetDexterityMod(who, GetDexteritymod(who)-dex_modulation);
			SetIntelligenceMod(who, GetIntelligencemod(who)-int_modulation);
	endif

	// #9 / #10 PvP arena (pvp.src / pvp2vs2.src) backs up the player's
	// real Karma/Fame in "lkarma"/"lfame" on entry and restores them on
	// exit. If the player logs off mid-match, the arena script never
	// gets to restore -> player keeps whatever karma/fame the match
	// applied, and the real values are stranded in lkarma/lfame.
	// Restore then erase. (Full arena exit -- teleport, pvping/pvptype,
	// pvpmurd/pvpcrim -- is intentionally NOT done here yet.)
	var saved_karma := GetObjProperty(who, "lkarma");
	if (saved_karma)
		SetObjProperty(who, "Karma", saved_karma);
	endif
	EraseObjProperty(who, "lkarma");
	var saved_fame := GetObjProperty(who, "lfame");
	if (saved_fame)
		SetObjProperty(who, "Fame", saved_fame);
	endif
	EraseObjProperty(who, "lfame");

	// #5 / #6 PvP arena exit on logoff. If the player disconnects while
	// inside the arena (pvp.src / pvp2vs2.src), the arena script can't
	// teleport them out or restore murderer/criminal status. Mirror the
	// arena's normal exit just for this player:
	//   - restore murderer/criminal from pvpmurd/pvpcrim backup props
	//   - teleport to the arena drop-off coords
	//   - re-apply safe-area properties
	//   - clear pvping/pvptype/pvpmurd/pvpcrim
	// NOTE: this does NOT clean up the opponent/partners or kill the
	// arena process or clear the ArenaInUse globalprop -- the surviving
	// arena script remains responsible for the match it started.
	if (GetObjProperty(who, "pvping"))
		var pvpmurd := GetObjProperty(who, "pvpmurd");
		var pvpcrim := GetObjProperty(who, "pvpcrim");
		who.setmurderer(pvpmurd);
		who.setcriminal(pvpcrim);
		EraseObjProperty(who, "pvpmurd");
		EraseObjProperty(who, "pvpcrim");

		MoveObjectToLocation(who, 5507, 1653, 22, "britannia", MOVEOBJECT_FORCELOCATION);
		SetSafeAreaProperties(who);

		EraseObjProperty(who, "pvping");
		EraseObjProperty(who, "pvptype");
	endif

	Broadcast( "Player " + who.name + " has departed");

endprogram

/*
 * DEAD CODE BELOW — commented out 2026-05.
 *
 * setchat(): old per-character chat list maintenance. Call site in
 * program logoff() is already commented out (line ~115).
 *
 * fixchr() / fixcolor(): legacy "restore polymorphed/disguised player on
 * logoff" routine. The single call site is commented out (the
 * `if (TypeOf(getobjproperty(who,"ctfloc"))="Integer") ... else fixchr(who);`
 * block above). Kept here only for reference — origform / cmfc /
 * polymorph-on-logoff handling, if it is ever re-introduced, should
 * follow this pattern (restore-then-erase, like the IsLiche cleanup).
 *
function setchat(who)

	while (getglobalproperty("plylock") ==1 )
	sleep(10);
	endwhile
	set_critical(1);

	setglobalproperty("plylock",1);

	var i, plychat:=getglobalproperty("plychat"), csize:=plychat.size();

	for (i:=1; i<=csize; i:=i+1)
		if (plychat[i] == who.serial) 
			plychat.erase(i); 
			break; 
		endif
	endfor

	if (plychat.size() == 0) 
		plychat := {"NONE"};
	endif
	setglobalproperty("plychat",plychat);
	setglobalproperty("plylock",0);
	set_critical(0);

endfunction


function fixchr(who)

	var temp;

	temp := GetObjProperty(who,"realname");

	if (temp)
		SetName (who,temp);
		EraseObjProperty(who,"realname");
	endif

	temp := GetObjProperty(who,"origform");
	if (temp)
		who.graphic := temp;
		EraseObjProperty(who,"origform");
		who.frozen := 0;
	endif

	// druid spell shapechange
	temp := getobjproperty(who, "tn");
	if (temp)
		 SetName (who,temp);
		 eraseobjproperty(who, "tn");
	endif

	if (getobjproperty(who, "tc"))
		 eraseobjproperty(who, "tc");
	endif

	temp := getobjproperty(who, "tg");
	if (temp)
		 who.graphic := temp;
		 eraseobjproperty(who, "tg");
	endif

	// Camouflage Fix
	temp := getobjproperty(who, "cmfc");
	if (temp)
		RemoveCamouflage( who );
	endif

	fixcolor(who);

endfunction

function fixcolor(who)

	var newcolor, racepicked := who.title_race;

	if (racepicked == "Elf")
		newcolor := 770;
	elseif (racepicked == "Dark-Elf")
		newcolor := 33877;
	elseif (racepicked == "Goblin")
		newcolor := 34186;
	elseif (racepicked == "Barbarian")
		newcolor := 33804;
	elseif (racepicked == "Dwarf")
		newcolor := 33888;
	elseif (racepicked == "Orc")
		newcolor := 1056;
	elseif (racepicked == "Frost-Elf")
		newcolor := 91;
	else
		newcolor := who.truecolor;
	endif

	who.color := newcolor;

endfunction
 *
 * END DEAD CODE
 */

function DisplayLogoff( mobile )

        var shrink_mobile := CreateItemAtLocation( mobile.x, mobile.y, mobile.z, 0x20F8, 1, mobile.realm );
        if( shrink_mobile.errortext )
                PrintTextAbove( mobile, "Error couldn't create shrink mobile -->"+shrink_mobile.errortext );
                return 0;
        endif
        
        shrink_mobile.invisible := 1;
        shrink_mobile.saveonexit := 0;
        shrink_mobile.color := 2473; // pink so staff can distinguish from spawnpoint markers
        
        SetName( shrink_mobile, mobile.name );
        
        SetObjProperty( mobile, "ShrinkLogoff", shrink_mobile.serial );
        SetObjProperty( shrink_mobile, "ShrinkLogoff", mobile.serial );
        
        return 1;
endfunction
