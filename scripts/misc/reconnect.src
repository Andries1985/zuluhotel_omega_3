use uo;
use datafile;

include "include/NameChecker";
include ":accounts:accounts";
include ":areas:include/areafunctions"; // 2026-09-23: safe-zone flags re-checked on reconnect too
include "include/areas";
include "include/ipban";

program reconnect( who )

	// 2026-10-01: login policy first, as in logon.src. A refused reconnect is disconnected
	// here; the check used to run afterwards, from pkg/systems/accounts/reconnect.src.
	if( !ACCT_AdmitCharacter( who ) )
		return 0;
	endif

	// 2026-10-04: IP ban list (.ipban), checked before anything else runs for this login.
	if( !IPBan_AdmitCharacter( who ) )
		return 0;
	endif

	// 2026-10-02: a character that was refused at login waits out its logout delay in the
	// world, and logging into it again inside that delay comes here, not to logon.src. Its
	// login setup never ran (no arrival, no playermanager: hunger, area ban, class), so run
	// logon.src for it now. #ArrivalAnnounced is what logon.src sets once it has run.
	if( !GetObjProperty( who, "#ArrivalAnnounced" ) )
		Start_Script( "misc/logon", who );
		return 1;
	endif

	// Name Check
        var check := CheckName(who.name,who);
        if (check[1] == 0 || check != 1 || GetObjProperty(who, "Converted"))
			who.name := "AlreadyUsed";
			start_script("misc/namechanger", {who, check[2]}); 
        endif

	RemoveSafeAreaProperties(who, 1);
	// 2026-09-23: decide the safe-zone and no-PK flags here instead of racing the region
	// enter script the engine fires at login (it hands off to a delayed script).
	if (IsInSafeArea(who))
		SetSafeAreaProperties(who);
	elseif (IsInNOPKArea(who))
		SetNOPK(who);
	else
		RemoveNOPK(who);
	endif

	var temp := GetObjProperty(who, "#ViewingBeast");
	if (temp)
		who.frozen := 0;
		who.concealed := 0;
		EraseObjProperty(who, "#ViewingBeast");
	endif

	// Beastal Bond cleanup mirrors logoff.src: ensure no orphaned bond
	// state leaves the bard permanently concealed/frozen after a
	// disconnect/reconnect cycle.
	if (GetObjProperty(who, "BeastalBond") || GetObjProperty(who, "BeastalBondTimer") || GetObjProperty(who, "#StopPlaying"))
		who.frozen := 0;
		who.concealed := 0;
		EraseObjProperty(who, "BeastalBond");
		EraseObjProperty(who, "BeastalBondTimer");
		EraseObjProperty(who, "#StopPlaying");
		EraseObjProperty(who, "#ViewingBeast");
	endif

	if (getobjproperty(who,"starttime"))
		Eraseobjproperty(who,"starttime");
	endif

	// #20: destroy the shrink mobile placed by DisplayLogoff() so the
	// pink marker doesn't linger in the world after a reconnect. Mirrors
	// RemoveLogoff() in logon.src.
	var shrink_serial := GetObjProperty( who, "ShrinkLogoff" );
	if (shrink_serial && !shrink_serial.errortext)
		var shrink_mobile := SystemFindObjectBySerial( shrink_serial );
		if (shrink_mobile)
			DestroyItem( shrink_mobile );
		endif
		EraseObjProperty( who, "ShrinkLogoff" );
	endif

	SendSysMessage( who, "Reconnected." );

endprogram

