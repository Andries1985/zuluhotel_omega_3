const HALT_THRESHOLD := 10; // how close before he attacks?

var runaway := 0;

program KillPlayers()

	SetObjProperty(me,"ExplosionPotionType",0xdc07); // Greater Explosion Potion -- boss tier
	SetWarMode( 0 );
    	main_AI_loop();

endprogram

function CloseDistance( opponent )

	if (!getobjproperty(me,"serial"))
		setobjproperty(me, "serial", me.serial);
	endif

	// 2026-09-23: used to pre-create one melee weapon and one bow in the pack on the first call
	// and then create fresh copies to equip on every swap, so one pre-made copy was never used
	// and went to the corpse as a spare boss weapon. Now swaps by what is in hand.
	var inhand := GetEquipmentByLayer( me, LAYER_HAND1 );
	var inbow := GetEquipmentByLayer( me, LAYER_HAND2 );

	if (distance(me, opponent) <= 7)
		if (!inhand || inhand.objtype != 0x9ed3)
			if (inhand) DestroyItem(inhand); endif
			if (inbow) DestroyItem(inbow); endif
			EquipItem(me, CreateItemInInventory(me.backpack,0x9ed3,1));
		endif
		RunToward(opponent);
		return 0;
	endif

	if (!inbow || inbow.objtype != 0x7cd9)
		if (inhand) DestroyItem(inhand); endif
		if (inbow) DestroyItem(inbow); endif
		EquipItem(me, CreateItemInInventory(me.backpack,0x7cd9,1));
	endif
	return 1;

endfunction
