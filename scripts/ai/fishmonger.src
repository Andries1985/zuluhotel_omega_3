// Synopsis: Fish Monger, the pole/fish quest-giver. Say "quest" to open the quest-giver
// gump (lists whatever quests.cfg entries have "Giver fishmonger" -- currently Quest
// 100-103, the fish line). Also periodically shouts a reminder at nearby players who have
// an undone quest available. Scaffolded directly from valthor.src.
use npc;
use os;
use uo;

include "include/eventid";
include ":questpkg:questnpcgump";
include ":questpkg:queststate";
include "ai/setup/modsetup";

const FISHMONGER_SHOUT_RANGE := 10;

var me := Self();

EnableEvents(SYSEVENT_SPEECH, 2);

while(1)
	var event := os::wait_for_event(15);
	if(event)
		case(event.type)
			SYSEVENT_SPEECH:
				HandleQuestGiverSpeech(me, event);
		endcase
	else
		var should_shout := 0;
		foreach mobile in ListMobilesNearLocation(me.x, me.y, me.z, FISHMONGER_SHOUT_RANGE, me.realm)
			if(!mobile.npctemplate && QP_GiverHasUndoneQuest(me, mobile))
				SendSysMessage(mobile, me.name+": Got a strong back and a weak stomach for waiting? I've got work.", 3, 73);
				should_shout := 1;
			endif
		endforeach

		if(should_shout)
			Say("The tide doesn't wait for anyone, traveler.");
		endif
	endif
endwhile
