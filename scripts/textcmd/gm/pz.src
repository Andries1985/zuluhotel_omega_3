// Synopsis: Move a targeted object N tiles up or down (default 1, negative allowed)
use uo;

program  z(who, howfar)

var what := target(who, TGTOPT_NOCHECK_LOS);

if (!what)
        return;
endif

var tdist;

if (howfar == "")
        tdist := 1;
else
        tdist := cint(howfar);
endif

moveobjecttolocation(what, what.x, what.y, what.z + tdist, what.realm); // 2026-09-23: was who.realm, the caller's

endprogram
