// Synopsis: Display where and when a targeted NPC was released or hatched
//////////////////////////////////////////////////////////////////////////
// Toadstool 16/04/2012 
//
// ReleaseInfo() - Displays information about where an animal was
//		   released/hatched.
//	Go button needs to be fixed
//////////////////////////////////////////////////////////////////////////

use uo;
use os;

include ":mdgumps:gumps";
include ":mdgumps:gumps_ex";
include ":staff:include/staff";

program releaseinfo(who)

SendSysMessage(who, "Target an NPC..");

var targ := Target(who);
LogCommand(who, GetProcess(GetPid()).name, targ.name+"/"+targ.serial);

if (!targ.isa(POLCLASS_NPC))
	SendSysMessage(who, "You must select an NPC");
	return 0;
endif

var relinfo := GetObjProperty(targ, "ReleasedBy");
var hatinfo := GetObjProperty(targ, "HatchedBy");

var gump := GFCreateGump(0, 0, 380, 190);

// entire pages
GFResizePic( gump, 10, 10, 9260, 380, 190);
GFResizePic( gump, 15, 15, 9350, 370, 180);

// title bar
GFResizePic( gump, 60, 10, 9260, 280, 35);
GFResizePic( gump, 65, 15, 9350, 270, 25);

// 2 bottom white pages
GFResizePic( gump, 15, 80, 9350, 185, 115);
GFResizePic( gump, 200, 80, 9350, 185, 115);

// Title texts and creature names
GFTextLine( gump, 95, 16, 89, "Released/Hatched Information" );
GFTextLine( gump, 30, 50, 67, "Creature Name: " );
GFTextLine( gump, 145, 50, 0, targ.name );
GFTextLine( gump, 80, 80, 89, "Released" );
GFTextLine( gump, 260, 80, 89, "Hatched" );

// Fill in the released info panel
if (relinfo)
	var relplayer := SplitWords(relinfo);
	relplayer := SystemFindObjectBySerial(CInt(relplayer[2]), 1);
		
	GFTextLine( gump, 20, 100, 67, "Acc:" );
	GFTextLine( gump, 70, 100, 0, relplayer.acctname );

	GFTextLine( gump, 20, 115, 67, "Char:" );
	GFTextLine( gump, 70, 115, 0, relplayer.name );

	GFTextLine( gump, 20, 135, 67, "X:" );
	GFTextLine( gump, 70, 135, 0, SplitWords(relinfo)[4] );

	GFTextLine( gump, 20, 150, 67, "Y:" );
	GFTextLine( gump, 70, 150, 0, SplitWords(relinfo)[5] );

	GFTextLine( gump, 20, 165, 67, "Z:" );
	GFTextLine( gump, 70, 165, 0, SplitWords(relinfo)[6] );

		// DECO - lines to Go button
	GFTextLine( gump, 115, 150, 0, "-" );
	GFTextLine( gump, 115, 135, 0, "-" );
	GFTextLine( gump, 115, 165, 0, "-" );
	GFTextLine( gump, 120, 150, 0, "|" );
	GFTextLine( gump, 120, 140, 0, "|" );
	GFTextLine( gump, 120, 158, 0, "|" );
	GFTextLine( gump, 121, 150, 0, "|" );
	GFTextLine( gump, 121, 140, 0, "|" );
	GFTextLine( gump, 121, 158, 0, "|" );
	GFTextLine( gump, 121, 150, 0, "-" );
	GFTextLine( gump, 125, 150, 0, "-" );
	GFTextLine( gump, 160, 150, 33, "Go" );
	GFAddButton( gump, 140, 155, 0x93A, 0x939, GF_CLOSE_BTN, 5);
else
	GFTextLine( gump, 35, 130, 0, "No previous release" );
endif

// Fill in the hatched info panel
if (hatinfo)
	var hatplayer := SplitWords(hatinfo);
	hatplayer := SystemFindObjectBySerial(CInt(hatplayer[2]), 1);
		
	GFTextLine( gump, 205, 100, 67, "Acc:" );
	GFTextLine( gump, 255, 100, 0, hatplayer.acctname );

	GFTextLine( gump, 205, 115, 67, "Char:" );
	GFTextLine( gump, 255, 115, 0, hatplayer.name );

	GFTextLine( gump, 205, 135, 67, "X:" );
	GFTextLine( gump, 255, 135, 0, SplitWords(hatinfo)[4] );

	GFTextLine( gump, 205, 150, 67, "Y:" );
	GFTextLine( gump, 255, 150, 0, SplitWords(hatinfo)[5] );

	GFTextLine( gump, 205, 165, 67, "Z:" );
	GFTextLine( gump, 255, 165, 0, SplitWords(hatinfo)[6] );

	// DECO - lines to Go button
	GFTextLine( gump, 300, 150, 0, "-" );
	GFTextLine( gump, 300, 135, 0, "-" );
	GFTextLine( gump, 300, 165, 0, "-" );
	GFTextLine( gump, 305, 150, 0, "|" );
	GFTextLine( gump, 305, 140, 0, "|" );
	GFTextLine( gump, 305, 158, 0, "|" );
	GFTextLine( gump, 306, 150, 0, "|" );
	GFTextLine( gump, 306, 140, 0, "|" );
	GFTextLine( gump, 306, 158, 0, "|" );
	GFTextLine( gump, 306, 150, 0, "-" );
	GFTextLine( gump, 310, 150, 0, "-" );

	GFTextLine( gump, 345, 150, 33, "Go" );
	GFAddButton( gump, 325, 155, 0x93A, 0x939, GF_CLOSE_BTN, 10 );

else
	GFTextLine( gump, 230, 130, 0, "Wasn't hatched" );
endif

var data := GFSendGump( who, gump );

// Teleport who to hatched or released location
case (data[0])
5: 	MoveObjectToLocation(who, CInt(SplitWords(relinfo)[4]), CInt(SplitWords(relinfo)[5]), CInt(SplitWords(relinfo)[6]), MOVEOBJECT_FORCELOCATION);
	SendSysMessage(who, "Moved to where the creature went wild.");
10:	MoveObjectToLocation(who, CInt(SplitWords(hatinfo)[4]), CInt(SplitWords(hatinfo)[5]), CInt(SplitWords(hatinfo)[6]), MOVEOBJECT_FORCELOCATION);
	SendSysMessage(who, "Moved to where the creature was hatched.");
endcase

endprogram
