// Synopsis: Teleport to an online player's location by name

use uo;
use os;

include ":gumps:gumps";
include ":staff:include/staff";

program textcmd_goto( character , whom )

	whom := Upper( whom );
	var chr := MakeAndProcessGump( character, whom );
	if( chr )
		LogCommand(character, GetProcess(GetPid()).name, chr.name+"/"+chr.serial, "XYZ - "+chr.x+","+chr.y+","+chr.z);
		MoveObjecttoLocation( character , chr.x , chr.y , chr.z , chr.realm, MOVEOBJECT_FORCELOCATION );
		ShowFlame( character );
	endif

endprogram


function MakeAndProcessGump( who , Whom )

	var players := EnumerateOnlineCharacters();
	var maxlen := len(Whom);
	var count := 0;
	var lastindex := 0;
	var i;

	var gump := GFCreateGump(20, 20, 740, 720);
	GFDisposable(gump, 0);
	GFResizePic(gump, 20, 20, 9250, 740, 725);
	GFResizePic(gump, 38, 60, 9200, 704, 40);
	GFResizePic(gump, 38, 100, 9200, 704, 605);

	GFResizePic(gump, 300, 35, 9200, 140, 20);
	GFTextLine(gump, 340, 35, 67, "Goto Menu");

	GFTextLine(gump, 55, 74, 900, "Character");
	GFTextLine(gump, 315, 74, 900, "Location");
	GFTextLine(gump, 665, 74, 900, "Goto");

	var y := 110;
	var page := 1;
	var perpage := 20;

	GFTextLine(gump, 360, 708, 1000, "Page 1");
	GFPage(gump, 1);

	for( i := 1 ; i <= len(players) ; i := i + 1 )
		if (players[i].concealed <= who.cmdlevel)
			var uhunter := CInt(GetObjProperty(players[i], "UHunter"));
			var playername := Upper(players[i].name);

			if ((playername[1,maxlen] == Whom) AND ((uhunter == 0) OR (who.cmdlevel > 3)))
				if (perpage <= 0)
					GFAddButton(gump, 580, 705, 4005, 4006, 0, page + 1); // next page
					GFPage(gump, page + 1);
					GFAddButton(gump, 60, 705, 4014, 4015, 0, page); // previous page
					page := page + 1;
					GFTextLine(gump, 360, 708, 1000, "Page " + page);
					y := 110;
					perpage := 20;
				endif

				var namecolor := 0;
				if (players[i].cmdlevel > 0)
					namecolor := 51;
				endif

				var location := GetRegionName(players[i]);
				if(!location)
					location := players[i].realm;
				endif

				GFTextLine(gump, 55, y, namecolor, players[i].name);
				GFTextLine(gump, 315, y, 0, location);
				GFAddButton(gump, 665, y - 3, 5540, 5541, GF_CLOSE_BTN, i);

				perpage := perpage - 1;
				y := y + 25;
				count := count + 1;
				lastindex := i;
			endif
		endif
	endfor

	if (count > 0)
		if (count == 1)
			return players[lastindex];
		endif

		var result := GFSendGump(who, gump);
		if(!result[0])
			return;
		endif

		result := CInt(result[0]);
		return players[result];
	endif

	SendSysMessage(who, "No player with name '"+Whom+"*' was found.");
	return;

endfunction


function ShowFlame( who )

	if( (who.cmdlevel<1) and (who.concealed<>1) )
		var coolflame;
		coolflame := CreateItemAtLocation( who.x, who.y, who.z, 0x3709, 1, who.realm );
		PlaySoundEffect(who, 0x208);
		Sleep(3);
		DestroyItem(coolflame);
	endif

endfunction
