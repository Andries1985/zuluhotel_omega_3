// Synopsis: Remove your own freeze or paralysis effect
use uo;
include ":staff:include/staff";
program thawme( gm )
    gm.frozen := 0;
    EraseObjProperty( gm, "frozen" ); // 2026-09-23: .freeze sets this cprop as well
    EraseObjProperty( gm, "frozen" ); // 2026-09-23: .freeze sets this cprop as well
    PrintTextAbovePrivate( gm, "Fly!  Be free!", gm );
endprogram
