// Synopsis: Set a household's cap: .householdcap [cap] [account] (no account name = target a member)
use uo;

include ":accounts:accounts";

program textcmd_householdcap( who, text )

	// 2026-10-01: ".householdcap <cap> <account>" works on an offline account; with no
	// account name it targets a character, as before.
	var params := array;
	if( text )
		params := SplitWords( text );
	endif

	var cap_text := "";
	var account_name := "";
	if( params.size() >= 1 )
		cap_text := params[1];
	endif
	if( params.size() >= 2 )
		account_name := ACCT_TrimDiscordID( params[2] );
	endif

	var picked_mobile := 0;
	var account := ACCT_PickAccountForCommand( who, account_name, "Target a household member to set household cap.", picked_mobile );
	if( !account )
		return 0;
	endif

	var info := ACCT_GetAccountDiscordInfo( account );
	if( info.errortext )
		SendSysMessage( who, "Unable to resolve account Discord info." );
		return 0;
	endif

	var household_id := ACCT_TrimDiscordID( info["HouseholdId"] );
	if( !household_id )
		SendSysMessage( who, "Account " + account.name + " is not assigned to a household. Use .householdadd first." );
		return 0;
	endif

	if( !cap_text )
		// 3rd positional arg is "cancel" (TE_CANCEL_ENABLE/DISABLE), not
		// "maximum" -- the bare 4 used to land there instead of the intended
		// 4-character input cap, which was silently falling back to the
		// default max of 40.
		cap_text := SendTextEntryGump( who, "Enter household cap (minimum 1).", TE_CANCEL_ENABLE, TE_STYLE_NORMAL, 4 );
	endif

	if( !cap_text || cap_text.errortext )
		SendSysMessage( who, "Cancelled." );
		return 0;
	endif

	var cap := CInt( cap_text );
	if( cap.errortext || cap < 1 )
		SendSysMessage( who, "Invalid cap value. Must be >= 1." );
		return 0;
	endif

	var household := ACCT_GetHouseholdById( household_id, 1 );
	if( household.errortext )
		SendSysMessage( who, "Unable to open household record: " + household.errortext );
		return 0;
	endif

	household.SetProp( "HouseholdCap", cap );
	household.SetProp( "UpdatedBy", who.name );

	SendSysMessage( who, "Household " + household_id + " cap set to " + CStr( cap ) + ".", 3, 53 );
	return 1;
endprogram
