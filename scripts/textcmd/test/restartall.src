// Synopsis: Restart the AI script on all NPC mobiles on the server
use uo;
use os;
use polsys;

program npcres( you )

	set_critical(0);

	// 2026-09-23: was a sweep of the caller's realm in 32-tile squares at five heights (about
	// 123,000 list calls); one box list per realm finds every mobile on every map in one pass.
	var number := 0;
	var realmtable := Realms();
	var realmnames := realmtable.keys();
	foreach realmname in realmnames
		var rinfo := realmtable[realmname];
		var mobs := ListMobilesInBox( 0, 0, -128, rinfo.width - 1, rinfo.height - 1, 127, realmname );
		SendSysMessage( you, "Restarting NPCs on " + realmname + " (" + len(mobs) + " mobiles)..." );
		foreach mob in mobs
			if( mob.npctemplate )
				RestartScript( mob );
				number := number + 1;
				if( number % 100 == 0 )
					sleepms( 1 );
				endif
			endif
		endforeach
	endforeach
	SendSysMessage( you, "Total NPCs restarted: " + number );

endprogram
