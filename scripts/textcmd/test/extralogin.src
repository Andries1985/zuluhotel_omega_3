// Synopsis: Backward-compatible alias: put an account in a household and set its cap to 2: .extralogin [account] (no account name = target a player)
use uo;

include ":accounts:accounts";

program textcmd_extralogin( who, text )

	ACCT_DebugPrint( "extralogin invoked by " + who.name );

	// 2026-10-01: takes an account name, so it works on an offline account; with no name
	// it targets a character, as before.
	var account_name := "";
	if( text )
		account_name := ACCT_TrimDiscordID( text );
	endif

	var picked_mobile := 0;
	var account := ACCT_PickAccountForCommand( who, account_name, "Target a player to grant household cap 2.", picked_mobile );
	if( !account )
		ACCT_DebugPrint( "extralogin ended before an account was picked." );
		return 0;
	endif

	var info := ACCT_GetAccountDiscordInfo( account );
	if( info.errortext )
		SendSysMessage( who, "Unable to resolve account Discord info." );
		return 0;
	endif

	var discord_norm := info["DiscordIDNorm"];
	if( !discord_norm )
		SendSysMessage( who, "Account " + account.name + " has no DiscordID set." );
		return 0;
	endif

	var household_id := ACCT_TrimDiscordID( info["HouseholdId"] );
	if( !household_id )
		household_id := "hh_" + discord_norm;
	endif

	if( !ACCT_ConfirmDiscordHouseholdReassign( who, discord_norm, household_id, "extralogin", account.name ))
		return 0;
	endif

	var result := ACCT_AssignAccountToHousehold( account, household_id, who.name );
	if( result.errortext )
		ACCT_DebugPrint( "extralogin assign failed for " + account.name + ": " + result.errortext );
		SendSysMessage( who, "Unable to assign household." );
		return 0;
	endif

	var household := ACCT_GetHouseholdById( result["HouseholdId"], 1 );
	household.SetProp( "HouseholdCap", 2 );
	household.SetProp( "UpdatedBy", who.name );
	ACCT_DebugPrint( "extralogin cap set to 2 for household=" + result["HouseholdId"] + " account=" + account.name );

	SendSysMessage( who, "Household cap set to 2 for account " + account.name + " (" + result["HouseholdId"] + ").", 3, 53 );
	if( picked_mobile )
		SendSysMessage( picked_mobile, "Your household login cap has been set to 2 by staff.", 3, 53 );
	endif

	return 1;

endprogram
