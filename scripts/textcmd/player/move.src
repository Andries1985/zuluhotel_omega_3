// Synopsis: Move all items of a targeted type to another container
use uo;

include "include/client";
include "include/canstack";
include ":mdgumps:yesNo";

const STACK_CAP := 60000;

program move(who)

	SendSysMessage(who, "Target a type of item to move to another container.");
	var what := Target(who);

	if (!what.isa(POLCLASS_ITEM))
		SendSysMessage(who, "You must target an item to move.");
		return 0;
	elseif (!InBackpack(who, what))
		SendSysMessage(who, "The item must be in your backpack.");
		return 0;
	endif

	SendSysMessage(who, "Select a container to move all these types of items to.");
	var cont := Target(who);

	if (!cont.isa(POLCLASS_CONTAINER))
		SendSysMessage(who, "You must target a container.");
		return 0;
	elseif (!InBackpack(who, cont))
		SendSysMessage(who, "The container must be in your backpack.");
		return 0;
	endif

	var originalcontainer := what.container;
	var all := YesNo(who, "Move all items of the targeted type to the selected container?");
	if(all)
		var count := 0;
		var matches := array{};
		foreach item in EnumerateItemsInContainer(originalcontainer, ENUMERATE_ROOT_ONLY)
			if (item.objtype == what.objtype && item != cont && Accessible( who, item ) && item.container != cont)
				matches.Append(item);
			endif
		endforeach

		SetObjProperty(who, "#FastLooting", 1);
		count := count + MoveConsolidated(matches, cont);
		EraseObjProperty(who, "#FastLooting");

		if (count == 0)
			SendSysMessage(who, "No items were moved.");
		elseif (count < 2)
			SendSysMessage(who, count+" item moved to the container.");
		else
			SendSysMessage(who, count+" items moved to the container.");
		endif
	endif

endprogram

// Manual scan instead of item.HasExistingStack() -- that builtin only reports
// a stack as a candidate when the WHOLE incoming item's amount fits under the
// cap, so it never surfaces a partially-fillable target for the overflow case.
function FindOpenStack(item, cont)
	foreach dest in EnumerateItemsInContainer(cont, ENUMERATE_ROOT_ONLY)
		if (dest.stackable && dest.amount < STACK_CAP && CanStack(item, dest))
			return dest;
		endif
	endforeach
	return 0;
endfunction

// Streams every matched stackable item's amount through a single "carrier"
// stack in the destination, topping it off to STACK_CAP before starting a
// new carrier, so only the final stack ends up partially filled.
function MoveConsolidated(matches, cont)

	var count := 0;
	var stackables := array{};

	foreach item in matches
		if (item.stackable)
			stackables.append(item);
		else
			if (MoveItemToContainer(item, cont))
				count := count + 1;
			endif
		endif
	endforeach

	if (stackables.size() == 0)
		return count;
	endif

	var carrier := FindOpenStack(stackables[0], cont);

	foreach item in stackables
		if (carrier && carrier.amount < STACK_CAP && CanStack(item, carrier))
			var space := STACK_CAP - carrier.amount;
			if (item.amount <= space)
				AddAmount(carrier, item.amount);
				SubtractAmount(item, item.amount);
				count := count + 1;
			else
				AddAmount(carrier, space);
				SubtractAmount(item, space);
				if (MoveItemToContainer(item, cont))
					count := count + 1;
					carrier := item;
				endif
			endif
		else
			if (MoveItemToContainer(item, cont))
				count := count + 1;
				carrier := item;
			endif
		endif
	endforeach

	return count;

endfunction

function InBackpack(who, thing)

	if (thing.serial == who.backpack.serial)
		return 1;
	endif

	foreach item in EnumerateItemsInContainer(who.backpack)
		if (item.serial == thing.serial)
			return 1;
		endif
	endforeach

	return 0;

endfunction
