// Synopsis: Open the hair and beard style or color customization shop
use uo;

include ":mdgumps:include/gumps";
include ":mdgumps:include/gumps_ex";
include "include/areas";

const CID_HUMAN_MALE := 0x190;
const CID_HUMAN_FEMALE := 0x191;
const CID_ELF_MALE := 0x025d;
const CID_ELF_FEMALE := 0x025e;
const CID_GARGOYLE_MALE := 0x029a;
const CID_GARGOYLE_FEMALE := 0x029b;

function raceProfile(who)
	if((who.graphic == CID_GARGOYLE_MALE) || (who.graphic == CID_GARGOYLE_FEMALE))
		return "gargoyle";
	elseif((who.graphic == CID_ELF_MALE) || (who.graphic == CID_ELF_FEMALE))
		return "elf";
	endif
	return "human";
endfunction

function hasValue(arr, needle)
	foreach value in arr
		if(value == needle)
			return 1;
		endif
	endforeach
	return 0;
endfunction

function hairOptions(race, sex)
	if(race == "elf")
		if(sex == 0)
			return {0, 999, 50916, 50917, 50918, 50919, 50890, 50891, 50892, 50893, 50894, 50895, 50889, 51459, 51460, 51461, 51462};
		endif
		return {0, 999, 60916, 60917, 60918, 60919, 60890, 60891, 60892, 60893, 60894, 60895, 60889, 61463, 61464, 61465, 61466};
	elseif(race == "gargoyle")
		if(sex == 0)
			return {0, 999, 50483, 50485, 50843, 50499, 50696, 50697, 50698, 50699, 51467, 51468, 51469, 51470};
		endif
		return {0, 999, 60769, 60541, 60795, 60707, 60708, 60475, 60632, 61475, 61476, 61477, 61478};
	endif

	if(sex == 0)
		return {0, 999, 50700, 50701, 50702, 50703, 50710, 50900, 50901, 50903, 51447, 51448, 51449, 51450};
	endif
	return {0, 999, 60700, 60701, 60702, 60703, 60710, 60712, 60900, 60902, 60903, 61455, 61456, 61457, 61458};
endfunction

function hairNames(race, sex)
	if(race == "elf")
		if(sex == 0)
			return {"Current", "Shaved", "Elf Hair 1", "Elf Hair 2", "Elf Hair 3", "Elf Hair 4", "Elf Hair 5", "Elf Hair 6", "Elf Hair 7", "Elf Hair 8", "Elf Hair 9", "Elf Hair 10", "Elf Hair 11", "Elf Modern 1", "Elf Modern 2", "Elf Modern 3", "Elf Modern 4"};
		endif
		return {"Current", "Shaved", "Elf Hair 1", "Elf Hair 2", "Elf Hair 3", "Elf Hair 4", "Elf Hair 5", "Elf Hair 6", "Elf Hair 7", "Elf Hair 8", "Elf Hair 9", "Elf Hair 10", "Elf Hair 11", "Elf Modern 1", "Elf Modern 2", "Elf Modern 3", "Elf Modern 4"};
	elseif(race == "gargoyle")
		if(sex == 0)
			return {"Current", "Shaved", "Horns 1", "Horns 2", "Horns 3", "Horns 4", "Horns 5", "Horns 6", "Horns 7", "Horns 8", "Modern Horns 1", "Modern Horns 2", "Modern Horns 3", "Modern Horns 4"};
		endif
		return {"Current", "Shaved", "Horns 1", "Horns 2", "Horns 3", "Horns 4", "Horns 5", "Horns 6", "Horns 7", "Modern Horns 1", "Modern Horns 2", "Modern Horns 3", "Modern Horns 4"};
	endif

	if(sex == 0)
		return {"Current", "Shaved", "Short", "Long", "Pony Tail", "Mohawk", "Pageboy", "Curly", "Receding", "Topknot", "Modern 1", "Modern 2", "Modern 3", "Modern 4"};
	endif
	return {"Current", "Shaved", "Short", "Long", "Pony Tail", "Mohawk", "Pageboy", "Buns", "Curly", "2 Tails", "Topknot", "Modern 1", "Modern 2", "Modern 3", "Modern 4"};
endfunction

function beardOptions(race, sex)
	if(race == "elf")
		return {0, 999};
	elseif(race == "gargoyle")
		if(sex == 0)
			return {0, 999, 50665, 50652, 50650, 50647, 50534, 51471, 51472, 51473, 51474};
		endif
		return {0, 999};
	endif

	if(sex == 0)
		return {0, 999, 50800, 50801, 50802, 50803, 50806, 50805, 50804, 51451, 51452, 51453, 51454};
	endif
	return {0, 999};
endfunction

function beardNames(race, sex)
	if(race == "elf")
		return {"Current", "Shaved"};
	elseif(race == "gargoyle")
		if(sex == 0)
			return {"Current", "Shaved", "Facial Horns 1", "Facial Horns 2", "Facial Horns 3", "Facial Horns 4", "Facial Horns 5", "Modern Facial Horns 1", "Modern Facial Horns 2", "Modern Facial Horns 3", "Modern Facial Horns 4"};
		endif
		return {"Current", "Shaved"};
	endif

	if(sex == 0)
		return {"Current", "Shaved", "Goatee", "Long", "Short", "Moustache", "Short/Moustache", "Long/Moustache", "Vandyke", "Modern 1", "Modern 2", "Modern 3", "Modern 4"};
	endif
	return {"Current", "Shaved"};
endfunction

