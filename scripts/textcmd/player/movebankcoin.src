// Synopsis: Move gold, silver, or copper coins to a container in your bank box or vault, consolidating stacks
use uo;

include "include/client";
include "include/canstack";
include "include/objtype";
include ":containers:storageAreas";
include ":mdgumps:yesNo";

const STACK_CAP := 60000;

program movebankcoin(who)

	var bankbox := CP_GetStorageContainerForMobile(who, CP_DEFAULT_AREA);
	var vaultbox := CP_GetPlayerVaultContainerForMobile(who);
	if (!bankbox && !vaultbox)
		SendSysMessage(who, "You don't have a bank box or vault.");
		return 0;
	endif

	SendSysMessage(who, "Target a stack of gold, silver, or copper in your bank box or vault to move.");
	var what := Target(who);

	if (!what.isa(POLCLASS_ITEM))
		SendSysMessage(who, "You must target a stack of currency.");
		return 0;
	elseif (what.objtype != UOBJ_GOLD_COIN && what.objtype != UOBJ_SILVER_COIN && what.objtype != UOBJ_COPPER_COIN)
		SendSysMessage(who, "You must target gold, silver, or copper coins.");
		return 0;
	endif

	var storagebox := 0;
	var storage_label := "";
	if (InStorageBox(bankbox, what))
		storagebox := bankbox;
		storage_label := "bank box";
	elseif (InStorageBox(vaultbox, what))
		storagebox := vaultbox;
		storage_label := "vault";
	else
		SendSysMessage(who, "The currency must be in your bank box or vault.");
		return 0;
	endif

	SendSysMessage(who, "Select a container in your " + storage_label + " to move the currency to.");
	var cont := Target(who);

	if (!cont.isa(POLCLASS_CONTAINER))
		SendSysMessage(who, "You must target a container.");
		return 0;
	elseif (!InStorageBox(storagebox, cont))
		SendSysMessage(who, "The container must be in your " + storage_label + ".");
		return 0;
	endif

	var all := YesNo(who, "Move all of that currency to the selected container?");
	if(all)
		var originalcontainer := what.container;
		var matches := array{};
		foreach item in EnumerateItemsInContainer(originalcontainer, ENUMERATE_ROOT_ONLY)
			if (item.objtype == what.objtype && item != cont && Accessible(who, item) && item.container != cont)
				matches.Append(item);
			endif
		endforeach

		SetObjProperty(who, "#FastLooting", 1);
		var count := MoveConsolidated(matches, cont);
		EraseObjProperty(who, "#FastLooting");

		if (count == 0)
			SendSysMessage(who, "No currency was moved.");
		elseif (count < 2)
			SendSysMessage(who, count+" stack moved to the container.");
		else
			SendSysMessage(who, count+" stacks moved to the container.");
		endif
	endif

endprogram

// Manual scan instead of item.HasExistingStack() -- that builtin only reports
// a stack as a candidate when the WHOLE incoming item's amount fits under the
// cap, so it never surfaces a partially-fillable target for the overflow case.
function FindOpenStack(item, cont)
	foreach dest in EnumerateItemsInContainer(cont, ENUMERATE_ROOT_ONLY)
		if (dest.stackable && dest.amount < STACK_CAP && CanStack(item, dest))
			return dest;
		endif
	endforeach
	return 0;
endfunction

// Every match here is the same coin objtype already (gold, silver, or copper
// picked by the initial target), so a single streaming carrier is enough --
// top it off to STACK_CAP before starting a new one.
function MoveConsolidated(matches, cont)

	var count := 0;
	var carrier := 0;

	foreach item in matches
		if (!carrier)
			carrier := FindOpenStack(item, cont);
		endif

		if (carrier && carrier.amount < STACK_CAP && CanStack(item, carrier))
			var space := STACK_CAP - carrier.amount;
			if (item.amount <= space)
				AddAmount(carrier, item.amount);
				SubtractAmount(item, item.amount);
				count := count + 1;
			else
				AddAmount(carrier, space);
				SubtractAmount(item, space);
				if (MoveItemToContainer(item, cont))
					count := count + 1;
					carrier := item;
				endif
			endif
		else
			if (MoveItemToContainer(item, cont))
				count := count + 1;
				carrier := item;
			endif
		endif
	endforeach

	return count;

endfunction

function InStorageBox(storagebox, thing)

	if (!storagebox)
		return 0;
	endif

	if (thing.serial == storagebox.serial)
		return 1;
	endif

	foreach item in EnumerateItemsInContainer(storagebox)
		if (item.serial == thing.serial)
			return 1;
		endif
	endforeach

	return 0;

endfunction
