// Synopsis: Assign a class and class level to a targeted player
use uo;
use os;
use polsys;

include ":mdgumps:include/gumps";
include "include/classes";
include "include/attributes";

program textcmd_class(who, lvl)

	if (!lvl)
		lvl := 1;
	endif

	// .setclass 999 -- shortcut that resets all skills to 0 and skips the
	// class picker/assignment entirely.
	if( CInt(lvl) == 999 )
		SendSysMessage(who, "Who do you want to reset to 0 skill?");
		var resettarg := Target( who );
		if( !resettarg )
			return;
		endif

		var resetskill999;
		foreach resetskill999 in GetSkillIds()
			SetBaseSkill(resettarg, resetskill999, 0);
		endforeach

		IncRevision(resettarg);
		SendSysMessage(resettarg, "Your skills have been reset to 0.", 3, 53);
		return;
	endif

	SendSysMessage(who, "Who do you want to make spec "+lvl+"?");
	var targ := Target( who );
	if( !targ )
		return;
	endif

	var gump := GFCreateGump(15, 15, 200, 400);
	GFResizePic(gump, 15, 15, 9250, 200, 400);
	GFTextLine(gump, 60, 30, 53, "--Choose a Class--");

	var y := 60;
	foreach thing in GetClasseIds()
		GFTextLine(gump, 55, y, 67, GetClasseName( thing ));
		GFAddButton(gump, 35, y+5, 2362, 2361, 1, _thing_iter);
		y := y + 20;
	endforeach

	var result := GFSendGump(who, gump);

	if (result[0] < 1)
		SendSysMessage(who, "Canceled.");
		return 0;
	endif

	var classid := GetClasseIds()[result[0]];

	// GetSkillIds() rather than a raw numeric range -- ids 49-56 have no
	// skillsdef.cfg entry (only Throwing/57 was added), and SetBaseSkill on
	// an unconfigured id risks feeding an error struct into SetAttributeBaseValue.
	var resetskill;
	foreach resetskill in GetSkillIds()
		SetBaseSkill(targ, resetskill, 0);
	endforeach

	var skillamount := 60 + (CInt(lvl) * 15);
	foreach skill in GetClasseSkills( classid )
		SetBaseSkill(targ, skill, skillamount);
	endforeach

	// Free coskills -- matches Testclassbooststone.src (pkg/opt/zuluitems):
	// these ride along with their class without being part of
	// GetClasseSkills() itself. IsFromThatClasse's forensicsallowed/
	// mageryallowed/musicianshipallowed/detectinghiddenallowed/
	// snoopingallowed params already treat these the same way so they don't
	// dilute the class-spec-level calculation -- Throwing/Tactics need no
	// extra handling here since they're already in Thief's own class list.
	if( classid == CLASSEID_RANGER )
		SetBaseSkill(targ, SKILLID_FORENSICS, skillamount);
	elseif( classid == CLASSEID_CRAFTER )
		SetBaseSkill(targ, SKILLID_MAGERY, skillamount);
		SetBaseSkill(targ, SKILLID_MUSICIANSHIP, skillamount);
	elseif( classid == CLASSEID_THIEF )
		SetBaseSkill(targ, SKILLID_DETECTINGHIDDEN, skillamount);
		SetBaseSkill(targ, SKILLID_SNOOPING, skillamount);
	endif

	AssignClasse( targ );
	IncRevision(targ);
	SendSysMessage(targ, "You are now a level " + lvl + " " + GetClasseName( classid ), 3, 53);

endprogram
