// Synopsis: Set all skills of a targeted mobile to a specified value
use uo;

include "include/client";
include "include/attributes";

program textcmd_setallskills( who , amount )

	var targ := Target( who );
	if( !targ )
		return;
	endif
	
	amount := Cint( amount );
	
	// 2026-09-23: was 0..48, which skipped the skills added above that (Throwing is 57)
	var sas_ids := GetSkillIds();
	foreach sas_id in sas_ids
		SetBaseSkill( targ , sas_id , amount);
	endforeach
	
	SendSysMessage( targ , "All your skills are now at " + amount + "." );

endprogram
