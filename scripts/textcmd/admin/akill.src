// Synopsis: Instantly kill all NPCs within a specified tile range
//Edited August 25, 2024

use os;
use uo;

include "include/attributes";
include ":staff:include/staff";
include "include/managers";

function IsPlayerVendor(byref mob)
	if(!mob or !mob.npctemplate)
		return 0;
	endif

	return (mob.npctemplate == "playervendor" or mob.npctemplate == "playervendorelf" or mob.npctemplate == "playervendorgargoyle");
endfunction

function TryForceClosePlayerVendor(byref who, byref mob)
	if(!IsPlayerVendor(mob) or !mob.process)
		return 0;
	endif

	var ev := struct;
	ev.type := "pm_force_fire";
	ev.source := who;
	ev.reason := "akillcmd";
	ev.force_escrow := 0;

	var sent := mob.process.SendEvent(ev);
	if(sent)
		SendSysMessage(who, "Player vendor closure event sent for " + mob.name + " (" + mob.serial + ").");
	endif
	return sent;
endfunction

program akill( who, dist )
	
	dist := CInt(dist);
        SendSysMessage( who, "Killing all npcs in range of "+dist+" tiles." );

	foreach mob in ListMobilesNearLocation( who.x, who.y, LIST_IGNORE_Z, dist, who.realm )
		if(who.cmdlevel < 4 && !mob.isa(POLCLASS_NPC))
			SendSysmessage(who, "You can only .kill NPCs.");
			LogCommand(who, GetProcess(GetPid()).name, who.name+" tried to .kill "+mob.name);
			return;
		endif
		if( mob.cmdlevel > who.cmdlevel and who.cmdlevel < 5 )
			SendSysMessage( who , "You cant kill him, he is superior to you." );
			SendSysMessage( mob , who.name + " is trying to kill you." );
			return;
		endif
		if (mob != who)
			RevokePrivilege( mob, "invul" );
			SetObjProperty( mob, "guardkill", 1);	
			if(TryForceClosePlayerVendor(who, mob))
				continue;
			endif
			WarnManagerofNPCDeath(mob);
			mob.kill();
		endif
	endforeach
		
	foreach mob in ListMobilesNearLocationEx( who.x, who.y, LIST_IGNORE_Z, dist, LISTEX_FLAG_HIDDEN, who.realm )
		if(who.cmdlevel < 4 && !mob.isa(POLCLASS_NPC))
			SendSysmessage(who, "You can only .kill NPCs.");
			LogCommand(who, GetProcess(GetPid()).name, who.name+" tried to .kill "+mob.name);
			return;
		endif
		if( mob.cmdlevel > who.cmdlevel and who.cmdlevel < 5 )
			SendSysMessage( who , "You cant kill him, he is superior to you." );
			SendSysMessage( mob , who.name + " is trying to kill you." );
			return;
		endif
		if (mob != who)
			RevokePrivilege( mob, "invul" );
			SetObjProperty( mob, "guardkill", 1);	
			if(TryForceClosePlayerVendor(who, mob))
				continue;
			endif
			WarnManagerofNPCDeath(mob);
			mob.kill();
		endif
	endforeach

	foreach mob in ListMobilesNearLocationEx( who.x, who.y, LIST_IGNORE_Z, dist, LISTEX_FLAG_CONCEALED, who.realm )
		if(who.cmdlevel < 4 && !mob.isa(POLCLASS_NPC))
			SendSysmessage(who, "You can only .kill NPCs.");
			LogCommand(who, GetProcess(GetPid()).name, who.name+" tried to .kill "+mob.name);
			return;
		endif
		if( mob.cmdlevel > who.cmdlevel and who.cmdlevel < 5 )
			SendSysMessage( who , "You cant kill him, he is superior to you." );
			SendSysMessage( mob , who.name + " is trying to kill you." );
			return;
		endif
		if (mob != who)
			RevokePrivilege( mob, "invul" );
			SetObjProperty( mob, "guardkill", 1);	
			if(TryForceClosePlayerVendor(who, mob))
				continue;
			endif
			WarnManagerofNPCDeath(mob);
			mob.kill();
		endif
	endforeach
endprogram
