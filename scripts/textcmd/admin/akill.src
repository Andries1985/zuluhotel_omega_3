// Synopsis: Kill every NPC (normal, hidden or concealed) within a tile range; players and staff are never touched, player vendors are force-closed
//Edited August 25, 2024
// 2026-09-26: NPC-only. One NPC_ONLY list pass instead of three, and anything that is not a killable NPC is skipped instead of aborting the whole command.

use os;
use uo;

include "include/attributes";
include ":staff:include/staff";
include "include/managers";

function IsPlayerVendor(byref mob)
	if(!mob or !mob.npctemplate)
		return 0;
	endif

	return (mob.npctemplate == "playervendor" or mob.npctemplate == "playervendorelf" or mob.npctemplate == "playervendorgargoyle");
endfunction

function TryForceClosePlayerVendor(byref who, byref mob)
	if(!IsPlayerVendor(mob) or !mob.process)
		return 0;
	endif

	var ev := struct;
	ev.type := "pm_force_fire";
	ev.source := who;
	ev.reason := "akillcmd";
	ev.force_escrow := 0;

	var sent := mob.process.SendEvent(ev);
	if(sent)
		SendSysMessage(who, "Player vendor closure event sent for " + mob.name + " (" + mob.serial + ").");
	endif
	return sent;
endfunction

program akill( who, dist )

	dist := CInt(dist);
	SendSysMessage( who, "Killing all npcs in range of "+dist+" tiles." );

	var killed := 0;
	var closed := 0;
	var mobs := ListMobilesNearLocationEx( who.x, who.y, LIST_IGNORE_Z, dist, LISTEX_FLAG_NORMAL + LISTEX_FLAG_HIDDEN + LISTEX_FLAG_CONCEALED + LISTEX_FLAG_NPC_ONLY, who.realm );
	foreach mob in mobs
		// belt and braces: the NPC_ONLY flag should already exclude players and staff
		if( mob == who or !mob.isa(POLCLASS_NPC) )
			continue;
		endif

		RevokePrivilege( mob, "invul" );
		SetObjProperty( mob, "guardkill", 1);
		if(TryForceClosePlayerVendor(who, mob))
			closed := closed + 1;
			continue;
		endif
		WarnManagerofNPCDeath(mob);
		mob.kill();
		killed := killed + 1;
	endforeach

	SendSysMessage( who, "Killed "+killed+" NPC(s), closed "+closed+" player vendor(s)." );
	LogCommand(who, GetProcess(GetPid()).name, "Radius "+dist+": killed "+killed+", closed "+closed+" player vendor(s)");

endprogram
