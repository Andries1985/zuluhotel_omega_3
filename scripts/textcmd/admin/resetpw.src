// Synopsis: Reset a player account's password by account name
use os;
use uo;

include "include/attributes";

program resetpw( who, acc )
	
acc := FindAccount(acc);

if (!acc)
	SendSysMessage(who, "Could not find that account!");
	return; // 2026-09-23: the script went on and reset a password on the error value
endif

var newpw := "temp"+RandomInt(1000);
acc.setpassword(newpw);

SendSysMessage(who, "Account: "+acc.name+" Password reset to: "+newpw);
		
endprogram
