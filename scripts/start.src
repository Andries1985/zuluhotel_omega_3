use uo;
use os;

include "include/utility";
include "include/teleporters";
include ":containers:storageAreas";

//include "util/bank";

start_script("blockLogin");

SetGlobalProperty("signs",{"NONE"});

foreach name in ( CP_ListStorageAreas() )
    CP_GetStorageArea( name, CP_CREATE );
    Print( "Initializing "+name+" Area." );
endforeach

//Start_Script( "storageWipe" ); // disabled 2026-09-03, see project_storagewipe_needs_fixing memory
//Print( "Wiping merchant storage (NEEDS FIXING)" );

SetGlobalProperty( "#NoNpcLooting" , 1 );

//OpenWorldBank();
//find_or_create_storage("Merchant Storage");

start_script("EquipTemplateValidation");

start_script("CustomHpFix");

start_script(":donationbox:scripts/sweeper");
Print( "Donation box sweeper started." );

//The sweeper's single-instance guard is a GlobalProperty, which persists across a real
//server restart (not just a script reload) - so without clearing it here, the guard would
//stay set forever after the first successful boot and silently block the sweeper (and its
//boot-time buoy cleanup) from ever starting again. start.src only runs on a genuine
//startup, so it's always safe to force this clear here.
EraseGlobalProperty("#CrustaceanTrapSweeperRunning");
start_script(":fishing:crustaceansweeper");
Print( "Crustacean trap sweeper started." );