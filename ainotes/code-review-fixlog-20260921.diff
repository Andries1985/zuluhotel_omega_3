+	mounts.append(array{"Horse Elemental Air", "horseelementalair", 0x3EE2, 0});
+
+	return mounts;
+endfunction
+
+function ShowMountListGump(who, mounts)
+	var per_page := 14;
+	var total_pages := CInt((mounts.size() + per_page - 1) / per_page);
+	if (total_pages < 1)
+		total_pages := 1;
+	endif
+
+	var gump := GFCreateGump(0, 0, 560, 620);
+	GFDisposable(gump, 0);
+	GFResizePic(gump, 0, 0, 3600, 560, 620);
+	GFTextMid(gump, 15, 20, 530, 1153, "Mount Test");
+	GFTextLine(gump, 25, 52, 1153, "Mount");
+	GFTextLine(gump, 350, 52, 1153, "Use");
+	GFAddButton(gump, 260, 565, 2119, 2120, GF_CLOSE_BTN, 999999);
+
+	var page := 1;
+	while (page <= total_pages)
+		GFPage(gump, page);
+		var start_index := ((page - 1) * per_page) + 1;
+		var end_index := start_index + per_page - 1;
+		if (end_index > mounts.size())
+			end_index := mounts.size();
+		endif
+
+		var y_pos := 75;
+		var index := start_index;
+		while (index <= end_index)
+			var entry := mounts[index];
+			GFTextCrop(gump, 25, y_pos, 300, 18, 0, entry[1]);
+			GFAddButton(gump, 355, y_pos - 1, 2117, 2118, GF_CLOSE_BTN, index);
+			y_pos := y_pos + 32;
+			index := index + 1;
+		endwhile
+
+		if (page > 1)
+			GFAddButton(gump, 380, 565, 4014, 4015, GF_PAGE_BTN, page - 1);
+			GFTextLine(gump, 410, 565, 1153, "Prev");
+		endif
+		if (page < total_pages)
+			GFAddButton(gump, 450, 565, 4005, 4006, GF_PAGE_BTN, page + 1);
+			GFTextLine(gump, 480, 565, 1153, "Next");
+		endif
+
+		page := page + 1;
+	endwhile
+
+	var input := GFSendGump(who, gump);
+	if (!input)
+		return 0;
+	endif
+
+	var choice := CInt(input[0]);
+	if (choice == 999999 || choice < 1 || choice > mounts.size())
+		return 0;
+	endif
+
+	return choice;
+endfunction
+
+function CreateAndMount(who, mount_entry)
+	var mount := CreateItemAtLocation(DEFAULT_LOCATION_ITEM_CREATION_X, DEFAULT_LOCATION_ITEM_CREATION_Y, DEFAULT_LOCATION_ITEM_CREATION_Z, 0x1F021, 1, DEFAULT_LOCATION_ITEM_CREATION_R);
+	if (!mount)
+		SendSysMessage(who, "Could not create that mount.");
+		return 0;
+	endif
+
+	mount.graphic := CInt(mount_entry[3]);
+	if (CInt(mount_entry[4]))
+		mount.color := CInt(mount_entry[4]);
+	endif
+	SetObjProperty(mount, "npctemplate", mount_entry[2]);
+
+	if (!EquipItem(who, mount))
+		SendSysMessage(who, "Could not mount that creature.");
+		ApplyRawDamage(mount, CInt(GetHP(mount) + 3));
+		return 0;
+	endif
+
+	SetObjProperty(who, "DonatorMounted", 1);
+	SendSysMessage(who, "Mounted: " + mount_entry[1] + ".");
+	return 1;
+endfunction
