-function _Play_Sound( character )
-
-	PlaySoundEffect( character, SCISSORS_SOUND );
-	Sleep(1);
-	PlaySoundEffect( character, SCISSORS_SOUND );
-	Sleep(2);
-	if( !GetObjProperty( character, CLASSEID_CRAFTER ))
-		PlaySoundEffect( character , SCISSORS_SOUND );
-		Sleep (2);
-	endif
-
-endfunction
