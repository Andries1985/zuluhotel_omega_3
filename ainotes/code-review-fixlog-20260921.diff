-// OpenTownstoneDataFile / TouchTownstoneRegionEntry moved to tstone.inc (2026-09-01)
\ No newline at end of file
+// OpenTownstoneDataFile / TouchTownstoneRegionEntry moved to tstone.inc (2026-09-01)
+
+// 2026-09-22: the stones the datafile knows about (stone_serial per region).
+function FindTownstonesFromDatafile()
+	var stones := {};
+	var df := OpenTownstoneDataFile();
+	if(!df)
+		return stones;
+	endif
+	var keys := df.Keys();
+	foreach region_name in keys
+		var elem := df.FindElement(region_name);
+		if(!elem)
+			continue;
+		endif
+		var serial := CInt(elem.GetProp("stone_serial"));
+		if(!serial)
+			continue;
+		endif
+		var stone := SystemFindObjectBySerial(serial);
+		if(stone and stone.objtype == TOWNSTONE_OBJTYPE)
+			stones.append(stone);
+		endif
+	endforeach
+	UnloadDataFile(TOWNSTONE_DATAFILE);
+	return stones;
+endfunction
+
+// The old whole-world scan, kept as the fallback.
+function FindTownstonesByWorldScan()
+	var stones := {};
+	foreach realm_name in TOWNSTONE_REALMS
+		var found := ListItemsNearLocationOfType(0, 0, LIST_IGNORE_Z, TOWNSTONE_SEARCH_RANGE, TOWNSTONE_OBJTYPE, realm_name);
+		if(found and found.size())
+			foreach item in found
+				stones.append(item);
+			endforeach
+		endif
+	endforeach
+	return stones;
+endfunction
