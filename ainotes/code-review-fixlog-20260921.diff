+// Synopsis: Delete your current mount and open a gump to mount a selected test mount
+// 2026-09-23: moved here from textcmd/player, where every player could run it; a test tool.
+use uo;
+use os;
+
+include ":mdgumps:gumps";
+include ":mdgumps:gumps_ex";
+include "include/constants/locations";
+include "include/dismount";
+
+program mounttest(who)
+	DeleteCurrentMount(who);
+
+	var mount_list := BuildMountList();
+	if (!mount_list || !mount_list.size())
+		SendSysMessage(who, "No mount templates are configured.");
+		return 0;
+	endif
+
+	var selected := ShowMountListGump(who, mount_list);
+	if (!selected)
+		return 0;
+	endif
+
+	var entry := mount_list[selected];
+	if (!entry)
+		SendSysMessage(who, "That mount entry is no longer available.");
+		return 0;
+	endif
+
+	CreateAndMount(who, entry);
+endprogram
+
+function DeleteCurrentMount(who)
+	var equipped_mount := GetEquipmentByLayer(who, 25);
+	if (equipped_mount)
+		dismount(who);
+		SleepMS(60);
+		MoveObjectToLocation(equipped_mount, DEFAULT_LOCATION_NPC_RELOCATION_X, DEFAULT_LOCATION_NPC_RELOCATION_Y, DEFAULT_LOCATION_NPC_RELOCATION_Z, DEFAULT_LOCATION_NPC_RELOCATION_R, MOVEOBJECT_FORCELOCATION);
+		SetObjProperty(equipped_mount, "guardkill", 1);
+		ApplyRawDamage(equipped_mount, CInt(GetHP(equipped_mount) + 3));
+	endif
+
+	var mount_serial := CInt(GetObjProperty(who, "DMountSerial"));
+	if (mount_serial)
+		var old_mount := SystemFindObjectBySerial(mount_serial);
+		if (old_mount)
+			MoveObjectToLocation(old_mount, DEFAULT_LOCATION_NPC_RELOCATION_X, DEFAULT_LOCATION_NPC_RELOCATION_Y, DEFAULT_LOCATION_NPC_RELOCATION_Z, DEFAULT_LOCATION_NPC_RELOCATION_R, MOVEOBJECT_FORCELOCATION);
+			SetObjProperty(old_mount, "guardkill", 1);
+			ApplyRawDamage(old_mount, CInt(GetHP(old_mount) + 3));
+		endif
+	endif
+
+	EraseObjProperty(who, "DonatorMounted");
+	EraseObjProperty(who, "DMountSerial");
+endfunction
