+// Gold in stacks the engine accepts (60,000 max per stack): backpack first,
+// the owner's feet when the backpack is full. Nothing is ever silently lost.
+function CustomHousePayGold (character, amount)
+	var left := CInt (amount);
+	while (left > 0)
+		var chunk := left;
+		if (chunk > 60000)
+			chunk := 60000;
+		endif
+		var coins := CreateItemInBackpack (character, UOBJ_GOLD_COIN, chunk);
+		if (!coins)
+			coins := CreateItemAtLocation (character.x, character.y, character.z, UOBJ_GOLD_COIN, chunk, character.realm);
+			if (coins)
+				SendSysMessage (character, "Your backpack is full; " + chunk + " gold was placed at your feet.", color := 45);
+			endif
+		endif
+		if (!coins)
+			SendSysMessage (character, "Could not create " + left + " gold anywhere. Please page a GM.", color := 33);
+			SysLog ("[customhousing] MakeADeed could not pay " + left + " gold to " + character.name + " (" + character.serial + ")");
+			return 0;
+		endif
+		left := left - chunk;
+	endwhile
+	return 1;
