use cfgfile;
use cliloc;
use math;
use os;
use uo;


include ":house:multihouse_settings";

program walk_on_bantile(who, tile)
	var hsign := GetHSign( who, tile );
	if(!hsign)
		return;
	endif
	var ownerser := hsign.GetOwnerSerial();
	if(ownerser == who.serial)
		SetObjProperty(hsign,"decay", (ReadGameClock() + get_abandon_time()));
//		SendSysMessage(who, "Your house is refreshed.", color := 66);
	endif

	var banlist := hsign.GetBanList();
	if(!banlist)
		return;
	endif
	if(who.serial in banlist)
		hsign.BootBannedFromHouse(who);
	endif
endprogram

// 2026-09-03: GetBanTileDropSpot()/FindBanTileDropNear()/IsBanTileSpot() (the
// safe-drop-spot search added 2026-08-12) moved to the shared method script
// (:house:multiSign/method, exported as sign.GetBanTileDropSpot()) so other
// ban-enforcement call sites (secure containers, lockdown/release) can reuse
// it via sign.BootBannedFromHouse() instead of a third duplicate copy.
// staticHousing/bantile/walkOn.src had a byte-for-byte duplicate that moved
// the same way.

function GetHSign( byref who, byref tile )

	foreach sign in ListObjectsInBox (who.x-32, who.y-32, -128, who.x+32, who.y+32, +127, who.realm)
		if(sign.objtype in {0xBCF, 0xBD1, 0xBD2, 0xBD0, 0x20BD1, 0x20BD2, 0x20BCF, 0x20BD0, 0x260FA})
			if(CInt(GetObjProperty(sign, "houseserial")) == CInt(GetObjProperty(tile, "houseserial")))
				if(GetObjProperty(sign, "footage"))
					return sign;
				endif
			endif
		endif
	endforeach
	return 0;
endfunction

