function HandleManageFriendsAction(sign, who, action)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "You do not have permission to manage house friends.", color := 33);
		return;
	endif
	case(action)
		210: AddFriend(sign, who);
		211: DeleteFriend(sign, who);
		212: ToggleCoOwnerStatus(sign, who);
		213: ToggleHousePermission(sign, who, "lockdown", "lockdown");
		214: ToggleHousePermission(sign, who, "secure", "secure");
		215: ToggleHousePermission(sign, who, "eject", "eject");
		216: ToggleHousePermission(sign, who, "ban", "ban");
		217: ToggleHousePermission(sign, who, "teleporter", "teleporter");
		218: ShowHousePermissionOverview(sign, who);
		219: ListBan(sign, who);
		default: return;
	endcase
	OpenManageHouseFriendsGump(sign, who);
endfunction

function ToggleCoOwnerStatus(sign, who)
	SendSysMessage(who, "Target the person whose co-owner status you want to toggle.", color := 88);
	var targetchr := Target(who, TGTOPT_NOCHECK_LOS);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!targetchr.isa(POLCLASS_MOBILE))
		SendSysMessage(who, "That cannot be added to house lists.", color := 33);
		return;
	endif
	if(targetchr.serial == GetObjProperty(sign, "ownerserial"))
		SendSysMessage(who, "You cannot modify the house owner.", color := 33);
		return;
	endif
	if(sign.IsACoOwner(targetchr))
		if(sign.RemoveCoOwner(targetchr) == 1)
			SendSysMessage(who, targetchr.name + " is no longer a co-owner.", color := 66);
		else
			SendSysMessage(who, "Could not remove that co-owner.", color := 33);
		endif
	else
		if(!sign.IsAFriend(targetchr))
			var addres := sign.AddFriend(targetchr);
			if(addres == -1)
				SendSysMessage(who, "Friend list is full.", color := 33);
				return;
			endif
		endif
		var cores := sign.AddCoOwner(targetchr);
		if(cores == 1)
			sign.SetFriendPermission(targetchr, "lockdown", 1);
			sign.SetFriendPermission(targetchr, "secure", 1);
			sign.SetFriendPermission(targetchr, "eject", 1);
			sign.SetFriendPermission(targetchr, "ban", 1);
			sign.SetFriendPermission(targetchr, "teleporter", 1);
			SendSysMessage(who, targetchr.name + " is now a co-owner.", color := 66);
		elseif(cores == -1)
			SendSysMessage(who, "Co-owner list is full.", color := 33);
		else
			SendSysMessage(who, "That person is already a co-owner.", color := 33);
		endif
	endif
endfunction

function ToggleHousePermission(sign, who, perm_key, label)
	SendSysMessage(who, "Target the person whose " + label + " permission you want to toggle.", color := 88);
	var targetchr := Target(who, TGTOPT_NOCHECK_LOS);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!targetchr.isa(POLCLASS_MOBILE))
		SendSysMessage(who, "That cannot be modified.", color := 33);
		return;
	endif
	if(targetchr.serial == GetObjProperty(sign, "ownerserial"))
		SendSysMessage(who, "Owner always has full permissions.", color := 33);
		return;
	endif
	if(sign.IsACoOwner(targetchr))
		SendSysMessage(who, "Co-owners always have full permissions.", color := 33);
		return;
	endif
	if(!sign.IsAFriend(targetchr))
		SendSysMessage(who, "That person is not on your friend list.", color := 33);
		return;
	endif
	var profile := sign.GetFriendPermissionProfile(targetchr);
	var enabled := 0;
	case(perm_key)
		"lockdown": enabled := profile[2];
		"secure": enabled := profile[3];
		"eject": enabled := profile[4];
		"ban": enabled := profile[5];
		"teleporter": enabled := profile[6];
	endcase
	if(enabled)
		sign.SetFriendPermission(targetchr, perm_key, 0);
		SendSysMessage(who, "Disabled " + label + " permission for " + targetchr.name + ".", color := 66);
	else
		sign.SetFriendPermission(targetchr, perm_key, 1);
		SendSysMessage(who, "Enabled " + label + " permission for " + targetchr.name + ".", color := 66);
	endif
endfunction

function ShowHousePermissionOverview(sign, who)
	SendSysMessage(who, "House permissions overview:", color := 66);
	var owner := SystemFindObjectBySerial(CInt(GetObjProperty(sign, "ownerserial")));
	if(owner)
		SendSysMessage(who, owner.name + " [owner] full access", color := 66);
	endif
	foreach serial in (sign.GetCoOwnerList())
		var co := SystemFindObjectBySerial(serial);
		if(!co)
			co := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(co)
			SendSysMessage(who, co.name + " [co-owner] full access", color := 66);
		endif
	endforeach
	foreach serial in (sign.GetFriendList())
		if(serial in (sign.GetCoOwnerList()))
			continue;
		endif
		var fr := SystemFindObjectBySerial(serial);
		if(!fr)
			fr := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(fr)
			var p := sign.GetFriendPermissionProfile(fr);
			SendSysMessage(who, fr.name + " [friend] L:" + CStr(p[2]) + " S:" + CStr(p[3]) + " E:" + CStr(p[4]) + " B:" + CStr(p[5]) + " T:" + CStr(p[6]), color := 88);
		endif
	endforeach
endfunction

