			0x160e1: CreateItemInBackpack(who,0xd33d1063,1); //squareplasterhouse
			0x160e2: CreateItemInBackpack(who,0xd33d1064,1); //twostorystoneandthatchhouse
			0x160e3: CreateItemInBackpack(who,0xd33d1065,1); //splitlevelstoneandthatchhouse
			0x160e4: CreateItemInBackpack(who,0xd33d1066,1); //smallstoneandthatchhouse
			0x160e5: CreateItemInBackpack(who,0xd33d1067,1); //twostorydetachedstoneandthatchhouse
			0x160e6: CreateItemInBackpack(who,0xd33d1068,1); //mediumtwostorystoneandthatchhouse
			0x160e7: CreateItemInBackpack(who,0xd33d1069,1); //mediumtwostorystoneandwoodthatchhouse
			0x160e8: CreateItemInBackpack(who,0xd33d106a,1); //twostorylogandstonecabinhouse
			0x160e9: CreateItemInBackpack(who,0xd33d106b,1); //mediumstoneandlogthatchhouse
			0x160ea: CreateItemInBackpack(who,0xd33d106c,1); //mediumtwostorystoneandlogthatchhouse
			0x160eb: CreateItemInBackpack(who,0xd33d106d,1); //smallstoneandlogthatchhouse
			0x160ec: CreateItemInBackpack(who,0xd33d106e,1); //threestorystoneandplastersplitlevelhouse
			0x160ed: CreateItemInBackpack(who,0xd33d106f,1); //twostorywoodandplastermagehouse
			0x160ee: CreateItemInBackpack(who,0xd33d1070,1); //mediumstoneandslatehouse
			0x160ef: CreateItemInBackpack(who,0xd33d1071,1); //mediumstonelshapehouse
			0x160f0: CreateItemInBackpack(who,0xd33d1072,1); //twostorymediumgreytowereast
			0x160f1: CreateItemInBackpack(who,0xd33d1073,1); //smalltowereast
			0x160f2: CreateItemInBackpack(who,0xd33d1074,1); //twostorymediumgreytowersouth
			0x160f3: CreateItemInBackpack(who,0xd33d1075,1); //smallbrickandtilehousewithyard
			0x160f5: CreateItemInBackpack(who,0xd33d1077,1); //smallstoneandwoodenhouseeast
			0x160f6: CreateItemInBackpack(who,0xd33d1078,1); //mediumstoneandlogsplitlevelhouse
		endcase
		var tilelist := GetObjProperty(house, "bantiles");
		foreach thing in tilelist
			DestroyItem(SystemFindObjectBySerial(thing));
		endforeach
		foreach thing in itemlist
			if(CInt(thing.objtype) == OMEGACACHE_OBJTYPE)
				EraseObjProperty(thing, "houseserial");
				DestroyItem(thing);
			elseif (thing.objtype == 0x15000) // House Teleporter
					//Print("Demolishing a house teleporter.");
					DemolishTeleporter(thing, who);
			endif
			if((GetObjProperty(thing,"secure") == 1) && (thing.movable == 0))
				EraseObjProperty(thing,"secure");
				if(GetObjProperty(thing, "houseserial" ) == house.serial)
					var oldscript := GetObjProperty(thing, "oldscript");
					if (oldscript == error)
						oldscript := "";
					endif
					thing.usescript := oldscript;
					thing.movable := 1;
					thing.decayat := ReadGameClock() + 1;
					EraseObjProperty(thing, "houseserial" );
					EraseObjProperty(thing, "oldscript" );
				endif
			elseif ((GetObjProperty(thing, "lockeddown" ) == 1) && (thing.movable == 0))
				thing.movable := 1;
				thing.decayat := ReadGameClock() + 1;
				EraseObjProperty(thing, "houseserial" );
				EraseObjProperty(thing, "lockeddown");
			elseif (thing.movable == 0)
				if(thing.objtype == 0x1A390)
					MoveObjectToLocation(thing, thing.x, thing.y, house.z, house.realm, MOVEOBJECT_FORCELOCATION);
					thing.decayat := ReadGameClock() + 1;
				else
					DestroyItem(thing);
				endif
			endif
		endforeach
		CloseOmegaCacheStore(house.serial);
		if(who and who.acctname)
			UnregisterAccountHouseSign(sign, who.acctname);
		endif
		var hserial := house.serial;
		var hx := house.x;
		var hy := house.y;
		var hz := house.z;
		var hrealm := house.realm;
		var destroy_result := DestroyMulti(house);
		var destroy_failed := 0;
		var destroy_err := "";
		if(!destroy_result)
			destroy_failed := 1;
			destroy_err := "DestroyMulti returned false";
		elseif(destroy_result.errortext)
			destroy_failed := 1;
			destroy_err := destroy_result.errortext;
		endif

		var still_exists := SystemFindObjectBySerial(CInt(hserial));
		if(still_exists)
			var destroy_retry := DestroyMulti(still_exists);
			if((!destroy_retry) || destroy_retry.errortext || SystemFindObjectBySerial(CInt(hserial)))
				destroy_failed := 1;
				if(destroy_retry && destroy_retry.errortext)
					destroy_err := destroy_retry.errortext;
				elseif(destroy_err == "")
					destroy_err := "multi serial still exists after retry";
				endif
			endif
		endif

		if(destroy_failed)
			Print("House demolish failed for serial " + CStr(hserial) + " (objtype " + Hex(house.objtype) + "): " + destroy_err);
			SendSysMessage(who, "Could not demolish this house: " + destroy_err, color := 33);
			return;
		endif

		// Some clients can keep rendering the removed multi shell until a full
		// local revision update is forced. Use cached coords because the house
		// object may be invalid after DestroyMulti.
		foreach viewer in ListMobilesNearLocation(hx, hy, hz, 24, hrealm)
			if(viewer && viewer.connected)
				IncRevision(viewer);
				MoveObjectToLocation(viewer, viewer.x, viewer.y, viewer.z, viewer.realm, MOVEOBJECT_FORCELOCATION);
			endif
		endforeach
		if(who && who.connected)
			IncRevision(who);
			MoveObjectToLocation(who, who.x, who.y, who.z, who.realm, MOVEOBJECT_FORCELOCATION);
		endif
	elseif(builtdeed_error)
		SendSysMessage(who, "Could not find the built deed, please page a GM.", color := 33);
		return;
	endif
endfunction

function GetHouseTypeDisplayName(house)
	if(!house)
		return "Unknown";
	endif
	var itemdesc_cfg := ReadConfigFile(":house:itemdesc");
	if(itemdesc_cfg)
		var house_elem := itemdesc_cfg[house.objtype];
		if(house_elem && !house_elem.errortext)
			var house_desc := GetConfigString(house_elem, "Desc");
			if(house_desc && !house_desc.errortext && house_desc != "")
				return house_desc;
			endif
		endif
	endif
	return CStr(Hex(house.objtype));
endfunction

function ChangeLocks(who, house)
  SendSysMessage(who, "Target the new master key.", color := 88);
  var newkey:=Target(who);
  if(!newkey)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
  endif
  var addonitem;
  if((newkey.IsKey()) && (!newkey.IsKeyring()))
    var LockID:=AllocateLockID();
    newkey.SetLockId(LockID);
    foreach item in(house.components)
      if(item.IsA(POLCLASS_DOOR))
        item.locked := 1;
        SetObjProperty(item,"LockID",LockID);
	  elseif(item.IsMultiHouseSign())
        SetObjProperty(item,"LockID",LockID);
      endif
    endforeach
    addonitem:=CInt(GetObjProperty(house,"component2"));
    if(addonitem)
      addonitem.locked:=1;
      SetObjProperty(addonitem,"LockID",LockID);
    endif
    SendSysMessage(who, "Locks have been changed.", color := 66);
  else
    SendSysMessage(who,"That is not a key!", color := 33);
  endif
endfunction

function BuildHouseFriendRows(sign)
	var rows := {};
	var seen := {};
	var allserials := {};
	foreach serial in (sign.GetFriendList())
		allserials.append(serial);
	endforeach
	foreach serial in (sign.GetCoOwnerList())
		if(!(serial in allserials))
			allserials.append(serial);
		endif
	endforeach
	foreach serial in allserials
		if(serial in seen)
			continue;
		endif
		seen.append(serial);
		var mob := SystemFindObjectBySerial(serial);
		if(!mob)
			mob := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(!mob)
			continue;
		endif
		var p := sign.GetFriendPermissionProfile(mob);
		var secure := p[3];
		var tele := p[6];
		rows.append(array(serial, secure, secure, secure, tele, tele, tele, p[1]));
	endforeach
	return rows;
endfunction

function SaveHouseFriendData(sign, byref keys, byref rows)
	var i := 1;
	foreach person in rows
		var serial := person[1];
		var mob := SystemFindObjectBySerial(serial);
		if(!mob)
			mob := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(!mob)
			i := i + 1;
			continue;
		endif
		var base := i * 100;
		var coowner := ((base + 8) in keys);
		var secure := ((base + 2) in keys) || ((base + 3) in keys) || ((base + 4) in keys);
		var tele := ((base + 5) in keys) || ((base + 6) in keys) || ((base + 7) in keys);
		if(coowner)
			if(!sign.IsAFriend(mob))
				sign.AddFriend(mob);
			endif
			if(!sign.IsACoOwner(mob))
				sign.AddCoOwner(mob);
			endif
			sign.SetFriendPermission(mob, "lockdown", 1);
			sign.SetFriendPermission(mob, "secure", 1);
			sign.SetFriendPermission(mob, "eject", 1);
			sign.SetFriendPermission(mob, "ban", 1);
			sign.SetFriendPermission(mob, "teleporter", 1);
		else
			if(sign.IsACoOwner(mob))
				sign.RemoveCoOwner(mob);
			endif
			sign.SetFriendPermission(mob, "secure", secure);
			sign.SetFriendPermission(mob, "teleporter", tele);
		endif
		i := i + 1;
	endforeach
endfunction

function NewFriendsControl(who, sign, pagenum := 0)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "You do not have permission to manage house friends.", color := 33);
		return 0;
	endif
	var rows := BuildHouseFriendRows(sign);
	var start := (pagenum * 11) + 1;
	var shown := {};
	var stop := start + 10;
	var i := 0;
	for(i := start; i <= stop; i := i + 1)
		if(rows[i])
			shown.append(rows[i]);
		endif
	endfor

	GFInitGump();
	GFNoClose();
	GFNoDispose();
	GFResizePic(10, 10, 2600, 750, 530);
	GFResizePic(60, 25, 5100, 650, 25);
	GFTextLine(272, 28, 60, "MANAGE HOUSE FRIENDS");
	GFResizePic(40, 80, 2620, 690, 410);
	GFTextLine(60, 110, 2302, "Friend Name");
	GFTextLine(293, 90, 2302, "Secures");
	GFTextLine(250, 110, 2302, "View |");
	GFTextLine(303, 110, 2302, "Add |");
	GFTextLine(342, 110, 2302, "Remove |");
	GFTextLine(460, 90, 2302, "Recall/Gate");
	GFTextLine(406, 110, 2302, "Recall |");
	GFTextLine(464, 110, 2302, "Gate To |");
	GFTextLine(538, 110, 2302, "Gate From");
	GFTextLine(650, 110, 2302, "Co-owner");
	GFButtonID(220, 500, 2714, 2715, 1, 100000);
	GFTextLine(250, 498, 60, "Remove Friend");
	GFButtonID(60, 500, 2714, 2715, 1, 200000);
	GFTextLine(90, 498, 60, "Add Friend");
	GFButtonID(650, 497, 0x850, 0x851, 1, 300000);

	if(pagenum > 0)
		GFTextLine(367, 60, 99, "Page - " + CStr(pagenum + 1));
		GFButtonID(730, 80, 2704, 2705, 1, 500000);
	elseif(rows.size() > 11)
		GFTextLine(367, 60, 99, "Page - 1");
	endif

	GFPage(1);
	var y := 145;
	var idx := 1;
	foreach person in shown
		var mob := SystemFindObjectBySerial(person[1]);
		if(!mob)
			mob := SystemFindObjectBySerial(person[1], SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(!mob)
			continue;
		endif
		var namecolour := 44;
		if(person[8])
			namecolour := 53;
		endif
		var ch := idx * 100;
		GFRadioButton(47, y, 210, 211, 0, idx);
		GFTextCrop(70, y, 180, 20, namecolour, mob.name);
		GFCheckBox(667, y, 210, 211, person[8], ch + 8);
		if(!person[8])
			GFCheckBox(257, y, 210, 211, person[2], ch + 2);
			GFCheckBox(302, y, 210, 211, person[3], ch + 3);
			GFCheckBox(347, y, 210, 211, person[4], ch + 4);
			GFCheckBox(416, y, 210, 211, person[5], ch + 5);
			GFCheckBox(486, y, 210, 211, person[6], ch + 6);
			GFCheckBox(556, y, 210, 211, person[7], ch + 7);
		else
			GFTextLine(260, y, 2302, "Co-owners have the same authority as owners.");
		endif
		y := y + 30;
		idx := idx + 1;
	endforeach

	if((start + 11) <= rows.size())
		GFButtonID(730, 471, 2706, 2707, 1, 400000);
	endif

	var res := GFSendGump(who);
	case(res[0])
		100000:
			SaveHouseFriendData(sign, res.keys, shown);
			var selected := 0;
			var i2 := 0;
			for(i2 := 1; i2 <= shown.size(); i2 := i2 + 1)
				if(i2 in res.keys)
					selected := i2;
					break;
				endif
			endfor
			if(!selected)
				SendSysMessage(who, "Select a friend first.", color := 33);
			else
				var rmob := SystemFindObjectBySerial(shown[selected][1]);
				if(!rmob)
					rmob := SystemFindObjectBySerial(shown[selected][1], SYSFIND_SEARCH_OFFLINE_MOBILES);
				endif
				if(rmob)
					sign.RemoveCoOwner(rmob);
					sign.RemoveFriend(rmob);
					SendSysMessage(who, rmob.name + " removed from house friends.", color := 66);
				endif
			endif
			return NewFriendsControl(who, sign, pagenum);
		200000:
			SaveHouseFriendData(sign, res.keys, shown);
			AddFriend(sign, who);
			return NewFriendsControl(who, sign, pagenum);
		300000:
			SaveHouseFriendData(sign, res.keys, shown);
			SendSysMessage(who, "Permissions updated.", color := 66);
			return 1;
		400000:
			SaveHouseFriendData(sign, res.keys, shown);
			return NewFriendsControl(who, sign, pagenum + 1);
		500000:
			SaveHouseFriendData(sign, res.keys, shown);
			if(pagenum > 0)
				return NewFriendsControl(who, sign, pagenum - 1);
			endif
			return NewFriendsControl(who, sign, 0);
	endcase
	return 0;
endfunction

function AddSecureFacingFromMenu(who, sign, house, facing_east := 1)
	if(!sign.HasHousePermission(who, "secure"))
		SendSysMessage(who, "You do not have secure permission.", color := 33);
		return;
	endif
	var targ := TargetCoordinates(who);
	if(!targ)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!sign.IsObjectInsideHouse(targ))
		SendSysMessage(who, "That is not inside the building.", color := 33);
		return;
	endif
	if(GetObjProperty(sign, "RemainingSecures") <= 0)
		SendSysMessage(who, "The house has no more secure containers remaining.", color := 33);
		return;
	endif
	var obj := 0xE41;
	if(!facing_east)
		obj := 0xE40;
	endif
	var box := CreateItemAtLocation(targ.x, targ.y, targ.z, obj, 1, targ.realm);
	if(!box)
		SendSysMessage(who, "Could not create the secure container.", color := 33);
		return;
	endif
	var lockid := GetObjProperty(box, "LockID");
	if(lockid && !lockid.errortext)
		var lockids := {};
		lockids.append(lockid);
		KP_DestroyKeysForLockIDsInContainer(box, lockids);
		EraseObjProperty(box, "LockID");
	endif
	box.locked := 0;
	box.movable := 0;
	SetObjProperty(box, "houseserial", CInt(house.serial));
	SetObjProperty(box, "secure", 1);
	SetObjProperty(box, "oldscript", box.script);
	box.usescript := ":house:secureCont";
	SetObjProperty(sign, "RemainingSecures", CInt(GetObjProperty(sign, "RemainingSecures") - 1));
	SendSysMessage(who, "Secure On.", color := 66);
endfunction

function RevealLostItemsFromMenu(who, house)
	if(!house)
		return;
	endif
	SendSysMessage(who, "Please wait, recovering lost items....", color := 88);
	foreach item in (house.items)
		if(!GetObjProperty(item, "houseserial"))
			var waslocked := 0;
			if(item.movable == 0)
				waslocked := 1;
				item.movable := 1;
			endif
			MoveObjectToLocation(item, item.x, item.y, item.z, item.realm, MOVEOBJECT_FORCELOCATION);
			if(waslocked)
				item.movable := 0;
			endif
			SleepMs(10);
		endif
	endforeach
	SendSysMessage(who, "Any previously lost items are now back in place!", color := 66);
endfunction

function HouseManagement(sign, house, who)
	var ok := 1;
	EnsureOmegaCacheSlots(house, sign);
	while(ok)
		GFInitGump();
		GFNoDispose();
		GFNoClose();
		GFResizePic(0, 0, 2600, 250, 316);
		GFTextLine(60, 15, 20, "House Management");
		GFButtonID(35, 50, 2714, 2715, 1, 1);
		GFTextLine(70, 50, 2302, "Lock down an item");
		GFButtonID(35, 72, 2714, 2715, 1, 2);
		GFTextLine(70, 72, 2302, "Unlock an item");
		GFButtonID(35, 94, 2714, 2715, 1, 3);
		GFTextLine(70, 94, 2302, "Add a secure east");
		GFButtonID(35, 116, 2714, 2715, 1, 4);
		GFTextLine(70, 116, 2302, "Add a secure south");
		GFButtonID(35, 138, 2714, 2715, 1, 5);
		GFTextLine(70, 138, 2302, "Delete a secure");
		GFButtonID(35, 160, 2714, 2715, 1, 6);
		GFTextLine(70, 160, 2302, "Reveal lost items");
		GFButtonID(35, 182, 2714, 2715, 1, 7);
		GFTextLine(70, 182, 2302, "Add Teleporter");
		GFButtonID(35, 204, 2714, 2715, 1, 8);
		GFTextLine(70, 204, 2302, "Remove Teleporter");
		GFButtonID(35, 226, 2714, 2715, 1, 9);
		GFTextLine(70, 226, 2302, "Remove Cache Container");
		GFButtonID(35, 248, 2714, 2715, 1, 10);
		GFTextLine(70, 248, 2302, "Manage Teleporters");
		GFButtonID(90, 276, 243, 241, 1, 13);
		var result := GFSendGump(who);
		case(result[0])
			1: HandleLockdownRelease(sign, house, who, 1);
			2: HandleLockdownRelease(sign, house, who, 2);
			3: AddSecureFacingFromMenu(who, sign, house, 1);
			4: AddSecureFacingFromMenu(who, sign, house, 0);
			5: UnsecureContainerFromMenu(sign, house, who);
			6: RevealLostItemsFromMenu(who, house);
			7: PlaceHouseTeleporterPair(sign, who);
			8: RemoveHouseTeleporter(sign, who);
			9: HouseFunctionRemoveOmegaCache(sign, house, who);
			10: OpenTeleporterManagementGump(sign, house, who);
			13: ok := 0;
			default: ok := 0;
		endcase
		SleepMs(150);
	endwhile
endfunction

function EnsureOmegaCacheSlots(house, sign := 0)
	var max_slots := GetObjProperty(house, "maxnumomegacache");
	if(max_slots == error)
		max_slots := GetMaxOmegaCacheForHouse(CInt(GetObjType(house)));
		SetObjProperty(house, "maxnumomegacache", max_slots);
	endif

	var remaining := GetObjProperty(house, "numomegacache");
	if(remaining == error)
		remaining := max_slots;
		SetObjProperty(house, "numomegacache", remaining);
	endif

	if(sign)
		if(GetObjProperty(sign, "maxnumomegacache") == error)
			SetObjProperty(sign, "maxnumomegacache", max_slots);
		endif
		if(GetObjProperty(sign, "numomegacache") == error)
			SetObjProperty(sign, "numomegacache", remaining);
		endif
	endif

	return array(remaining, max_slots);
endfunction

function HouseFunctionRemoveOmegaCache(sign, house, who)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "Only owners and co-owners can remove Omega Cache containers.", color := 33);
		return;
	endif

	var slots := EnsureOmegaCacheSlots(house, sign);
	var remaining := CInt(slots[1]);
	var max_slots := CInt(slots[2]);

	SendSysMessage(who, "Choose the Omega Cache container you wish to remove.", color := 88);
	var cache := Target(who, TGTOPT_NOCHECK_LOS);
	if(!cache)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif

	if(CInt(cache.objtype) != OMEGACACHE_OBJTYPE)
		SendSysMessage(who, "That is not an Omega Cache container.", color := 33);
		return;
	endif

	if(CInt(GetObjProperty(cache, "houseserial")) != CInt(house.serial))
		SendSysMessageCL(who, 1005525, color := 33);
		return;
	endif

	if(!IsOmegaCacheEmpty(house.serial))
		SendSysMessage(who, "This house Omega Cache still contains stored items. Withdraw them first.", color := 33);
		return;
	endif

	if(!confirmationSizable(who, "Remove this Omega Cache container?"))
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif

	// Avoid destroy script re-credit on manual house-management remove.
	EraseObjProperty(cache, "houseserial");
	if(!DestroyItem(cache))
		SendSysMessage(who, "Could not remove that Omega Cache container.", color := 33);
		return;
	endif

	remaining := remaining + 1;
	if(remaining > max_slots)
		remaining := max_slots;
	endif
	SetObjProperty(house, "numomegacache", remaining);
	SetObjProperty(sign, "numomegacache", remaining);
	SetObjProperty(house, "maxnumomegacache", max_slots);
	SetObjProperty(sign, "maxnumomegacache", max_slots);

	SendSysMessage(who, "Omega Cache container removed. One cache slot was refunded.", color := 66);
endfunction

function OpenManageHouseFriendsGump(sign, who)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "Only owners or co-owners can manage house friend permissions.", color := 33);
		return;
	endif
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 2600, 400, 280);
	GFTextLine(155, 120, 995, "Manage House Friends");
	GFButtonID(130, 150, 2714, 2715, 1, 210);
	GFTextLine(165, 150, 0, "Add person to house lists");
	GFButtonID(130, 172, 2714, 2715, 1, 211);
	GFTextLine(165, 172, 0, "Remove person from house lists");
	GFButtonID(130, 194, 2714, 2715, 1, 212);
	GFTextLine(165, 194, 0, "Toggle co-owner");
	GFButtonID(130, 216, 2714, 2715, 1, 213);
	GFTextLine(165, 216, 0, "Toggle lockdown permission");
	GFButtonID(130, 238, 2714, 2715, 1, 214);
	GFTextLine(165, 238, 0, "Toggle secure permission");
	GFButtonID(130, 260, 2714, 2715, 1, 215);
	GFTextLine(165, 260, 0, "Toggle eject permission");
	GFButtonID(130, 282, 2714, 2715, 1, 216);
	GFTextLine(165, 282, 0, "Toggle ban permission");
	GFButtonID(130, 304, 2714, 2715, 1, 217);
	GFTextLine(165, 304, 0, "Toggle teleporter permission");
	GFButtonID(130, 326, 2714, 2715, 1, 218);
	GFTextLine(165, 326, 0, "Show permission overview");
	GFButtonID(130, 348, 2714, 2715, 1, 219);
	GFTextLine(165, 348, 0, "Show banned people");
	var res := GFSendGump(who);
	if(res)
		HandleManageFriendsAction(sign, who, res[0]);
	endif
endfunction

function HandleManageFriendsAction(sign, who, action)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "You do not have permission to manage house friends.", color := 33);
		return;
	endif
	case(action)
		210: AddFriend(sign, who);
		211: DeleteFriend(sign, who);
		212: ToggleCoOwnerStatus(sign, who);
		213: ToggleHousePermission(sign, who, "lockdown", "lockdown");
		214: ToggleHousePermission(sign, who, "secure", "secure");
		215: ToggleHousePermission(sign, who, "eject", "eject");
		216: ToggleHousePermission(sign, who, "ban", "ban");
		217: ToggleHousePermission(sign, who, "teleporter", "teleporter");
		218: ShowHousePermissionOverview(sign, who);
		219: ListBan(sign, who);
		default: return;
	endcase
	OpenManageHouseFriendsGump(sign, who);
endfunction

function ToggleCoOwnerStatus(sign, who)
	SendSysMessage(who, "Target the person whose co-owner status you want to toggle.", color := 88);
	var targetchr := Target(who, TGTOPT_NOCHECK_LOS);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!targetchr.isa(POLCLASS_MOBILE))
		SendSysMessage(who, "That cannot be added to house lists.", color := 33);
		return;
	endif
	if(targetchr.serial == GetObjProperty(sign, "ownerserial"))
		SendSysMessage(who, "You cannot modify the house owner.", color := 33);
		return;
	endif
	if(sign.IsACoOwner(targetchr))
		if(sign.RemoveCoOwner(targetchr) == 1)
			SendSysMessage(who, targetchr.name + " is no longer a co-owner.", color := 66);
		else
			SendSysMessage(who, "Could not remove that co-owner.", color := 33);
		endif
	else
		if(!sign.IsAFriend(targetchr))
			var addres := sign.AddFriend(targetchr);
			if(addres == -1)
				SendSysMessage(who, "Friend list is full.", color := 33);
				return;
			endif
		endif
		var cores := sign.AddCoOwner(targetchr);
		if(cores == 1)
			sign.SetFriendPermission(targetchr, "lockdown", 1);
			sign.SetFriendPermission(targetchr, "secure", 1);
			sign.SetFriendPermission(targetchr, "eject", 1);
			sign.SetFriendPermission(targetchr, "ban", 1);
			sign.SetFriendPermission(targetchr, "teleporter", 1);
			SendSysMessage(who, targetchr.name + " is now a co-owner.", color := 66);
		elseif(cores == -1)
			SendSysMessage(who, "Co-owner list is full.", color := 33);
		else
			SendSysMessage(who, "That person is already a co-owner.", color := 33);
		endif
	endif
endfunction

function ToggleHousePermission(sign, who, perm_key, label)
	SendSysMessage(who, "Target the person whose " + label + " permission you want to toggle.", color := 88);
	var targetchr := Target(who, TGTOPT_NOCHECK_LOS);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!targetchr.isa(POLCLASS_MOBILE))
		SendSysMessage(who, "That cannot be modified.", color := 33);
		return;
	endif
	if(targetchr.serial == GetObjProperty(sign, "ownerserial"))
		SendSysMessage(who, "Owner always has full permissions.", color := 33);
		return;
	endif
	if(sign.IsACoOwner(targetchr))
		SendSysMessage(who, "Co-owners always have full permissions.", color := 33);
		return;
	endif
	if(!sign.IsAFriend(targetchr))
		SendSysMessage(who, "That person is not on your friend list.", color := 33);
		return;
	endif
	var profile := sign.GetFriendPermissionProfile(targetchr);
	var enabled := 0;
	case(perm_key)
		"lockdown": enabled := profile[2];
		"secure": enabled := profile[3];
		"eject": enabled := profile[4];
		"ban": enabled := profile[5];
		"teleporter": enabled := profile[6];
	endcase
	if(enabled)
		sign.SetFriendPermission(targetchr, perm_key, 0);
		SendSysMessage(who, "Disabled " + label + " permission for " + targetchr.name + ".", color := 66);
	else
		sign.SetFriendPermission(targetchr, perm_key, 1);
		SendSysMessage(who, "Enabled " + label + " permission for " + targetchr.name + ".", color := 66);
	endif
endfunction

function ShowHousePermissionOverview(sign, who)
	SendSysMessage(who, "House permissions overview:", color := 66);
	var owner := SystemFindObjectBySerial(CInt(GetObjProperty(sign, "ownerserial")));
	if(owner)
		SendSysMessage(who, owner.name + " [owner] full access", color := 66);
	endif
	foreach serial in (sign.GetCoOwnerList())
		var co := SystemFindObjectBySerial(serial);
		if(!co)
			co := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(co)
			SendSysMessage(who, co.name + " [co-owner] full access", color := 66);
		endif
	endforeach
	foreach serial in (sign.GetFriendList())
		if(serial in (sign.GetCoOwnerList()))
			continue;
		endif
		var fr := SystemFindObjectBySerial(serial);
		if(!fr)
			fr := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(fr)
			var p := sign.GetFriendPermissionProfile(fr);
			SendSysMessage(who, fr.name + " [friend] L:" + CStr(p[2]) + " S:" + CStr(p[3]) + " E:" + CStr(p[4]) + " B:" + CStr(p[5]) + " T:" + CStr(p[6]), color := 88);
		endif
	endforeach
endfunction

// 2026-08-10: removed OpenHouseManagementGump/HandleHouseManagementAction --
// a second, never-called "house management" gump+dispatch pair (confirmed
// via repo-wide grep: no caller anywhere except each other's redraw-loop
// callback). HouseManagement() above is the one real, player-reachable
// entry point (main sign gump, button 15) and now also reaches teleporter
// management (case 10, below) directly. SecureContainerFromMenu and
// PlaceTrashBarrelFromMenu, which only this dead pair called, were removed
// too -- both were redundant with live equivalents (AddSecureFacingFromMenu,
// and control.src's speech-triggered trashbarrel()). The teleporter
// sub-gump (OpenTeleporterManagementGump and everything it calls) was kept
// and wired in, since it had no live equivalent -- rename/access-level
// management for house teleporters was previously unreachable by any path.

function HandleLockdownRelease(sign, house, who, mode)
	var itemt := Target(who, TGTOPT_NOCHECK_LOS);
	if(!itemt)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	var DeedObjType := GetObjProperty(itemt, "DeedObjType");
	var DeedColor := GetObjProperty(itemt, "DeedColor");
	var OtherItems := GetObjProperty(itemt, "OtherItems");
	var lists := GetObjProperty(sign, "footage");
	var itemlist := {};
	var holder;
	foreach thing in lists
		holder := ListObjectsInBox(thing[1], thing[2], thing[3], thing[4], thing[5], thing[6], house.realm);
		foreach it in holder
			itemlist.append(it);
		endforeach
	endforeach
	if(!(itemt in itemlist))
		SendSysMessageCL(who, 1005525, color := 33);
		return;
	endif
	case(mode)
		1:
			if(GetObjProperty(sign, "RemainingLockdowns") <= 0)
				SendSysMessageCL(who, 1005379, color := 33);
				return;
			endif
			if(itemt.movable == 1)
				itemt.movable := 0;
				SetObjProperty(itemt, "lockeddown", 1);
				SetObjProperty(itemt, "houseserial", house.serial);
				SetObjProperty(sign, "RemainingLockdowns", GetObjProperty(sign, "RemainingLockdowns") - 1);
				SendSysMessageCL(who, 501721, color := 66);
			elseif((itemt.movable == 0) && (GetObjProperty(itemt, "lockeddown") == 1))
				SendSysMessageCL(who, 501719, color := 33);
			elseif((itemt.movable == 0) && (GetObjProperty(itemt, "secure") == 1))
				SendSysMessageCL(who, 501714, color := 33);
			else
				SendSysMessageCL(who, 1010414, color := 33);
			endif
		2:
			if(GetObjProperty(itemt, "lockeddown") && (itemt.movable == 0))
				if(DeedObjType)
					var deed := CreateItemInBackpack(who, CInt(DeedObjType));
					if(!deed)
						SendSysMessageCL(who, 1045150, {}, 3, 33);
						return;
					endif
					deed.color := CInt(DeedColor);
					foreach part in OtherItems
						var partitem := SystemFindObjectBySerial(part);
						if(partitem)
							DestroyItem(partitem);
						endif
					endforeach
					sign.AddLockdown();
					return;
				endif
				if(GetObjProperty(itemt, "secure") == 1)
					EraseObjProperty(itemt, "secure");
					var oldscript := GetObjProperty(itemt, "oldscript");
					if(oldscript == error)
						oldscript := "";
					endif
					itemt.usescript := oldscript;
					SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") + 1);
					EraseObjProperty(itemt, "oldscript");
					EraseObjProperty(itemt, "boxserial");
				endif
				EraseObjProperty(itemt, "signserial");
				itemt.movable := 1;
				EraseObjProperty(itemt, "lockeddown");
				SetObjProperty(sign, "RemainingLockdowns", GetObjProperty(sign, "RemainingLockdowns") + 1);
				SendSysMessage(who, "Released.", color := 66);
			elseif((itemt.movable == 0) && (GetObjProperty(itemt, "secure") == 1))
				EraseObjProperty(itemt, "secure");
				var oldscript2 := GetObjProperty(itemt, "oldscript");
				if(oldscript2 == error)
					oldscript2 := "";
				endif
				itemt.usescript := oldscript2;
				SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") + 1);
				EraseObjProperty(itemt, "signserial");
				EraseObjProperty(itemt, "oldscript");
				itemt.movable := 1;
				SendSysMessageCL(who, 501657, color := 66);
			elseif(itemt.movable == 1)
				SendSysMessageCL(who, 1042271, color := 33);
			else
				SendSysMessage(who, "You cannot release that.", color := 33);
			endif
	endcase
endfunction

// 2026-08-10: SecureContainerFromMenu removed -- only caller was the dead
// HandleHouseManagementAction removed above; redundant with the live
// AddSecureFacingFromMenu (facing-direction placement) used by
// HouseManagement's own "Add a secure east/south" buttons.

function UnsecureContainerFromMenu(sign, house, who)
	SendSysMessage(who, "Choose the secure container you wish to delete.", color := 88);
	var itemt := Target(who);
	if(!itemt)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(GetObjProperty(itemt, "secure") != 1)
		SendSysMessage(who, "You can only delete a secure container.", color := 33);
		return;
	endif
	if(GetObjProperty(itemt, "houseserial") != house.serial)
		SendSysMessageCL(who, 1005525, color := 33);
		return;
	endif
	if(!confirmationSizable(who, "Are you sure you want to delete this secure container? All items inside will be deleted."))
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif

	EraseObjProperty(itemt, "secure");
	SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") + 1);
	if(!DestroyItem(itemt))
		SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") - 1);
		SendSysMessage(who, "Could not delete that secure container.", color := 33);
		return;
	endif
	SendSysMessage(who, "Secure container deleted. One secure slot was refunded.", color := 66);
endfunction

// 2026-08-10: PlaceTrashBarrelFromMenu removed -- only caller was the dead
// HandleHouseManagementAction removed above; redundant with control.src's
// live speech-triggered trashbarrel().

function OpenTeleporterManagementGump(sign, unused house, who)
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 2600, 400, 220);
	GFTextLine(155, 120, 995, "Teleporter Management");
	GFButtonID(130, 150, 2714, 2715, 1, 230);
	GFTextLine(165, 150, 0, "Place a teleporter pair");
	GFButtonID(130, 172, 2714, 2715, 1, 231);
	GFTextLine(165, 172, 0, "Rename a teleporter");
	GFButtonID(130, 194, 2714, 2715, 1, 232);
	GFTextLine(165, 194, 0, "Set teleporter access");
	GFButtonID(130, 216, 2714, 2715, 1, 233);
	GFTextLine(165, 216, 0, "Remove a teleporter pair");
	GFButtonID(130, 238, 2714, 2715, 1, 234);
	GFTextLine(165, 238, 0, "List house teleporters");
	var res := GFSendGump(who);
	if(res)
		HandleTeleporterManagementAction(sign, SystemFindObjectBySerial(CInt(GetObjProperty(sign, "houseserial"))), who, res[0]);
	endif
endfunction

function HandleTeleporterManagementAction(sign, unused house, who, action)
	if(!sign.HasHousePermission(who, "teleporter"))
		SendSysMessage(who, "You do not have teleporter permission.", color := 33);
		return;
	endif
	case(action)
		230: PlaceHouseTeleporterPair(sign, who);
		231: RenameHouseTeleporter(sign, who);
		232: SetHouseTeleporterAccess(sign, who);
		233: RemoveHouseTeleporter(sign, who);
		234: ListHouseTeleporters(sign, who);
		default: return;
	endcase
	OpenTeleporterManagementGump(sign, 0, who);
endfunction

function PlaceHouseTeleporterPair(sign, who)
	var settings := HE_GetSettingsCfgElem("settings");
	if(!settings.AllowHouseTeleporters)
		SendSysMessage(who, "House teleporters are disabled.", color := 33);
		return;
	endif
	if(settings.LimitHouseTeleporters && (CInt(GetObjProperty(sign, "numhteles")) >= CInt(settings.MaxHouseTeleporters)))
		SendSysMessage(who, "This house has reached the teleporter limit.", color := 33);
		return;
	endif
	SendSysMessage(who, "Target location for the primary teleporter.", color := 88);
	var t1 := TargetCoordinates(who);
	if(!t1)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!sign.IsObjectInsideHouse(t1))
		SendSysMessage(who, "Primary teleporter must be placed inside this house.", color := 33);
		return;
	endif
	var htele1 := CreateItemAtLocation(t1.x, t1.y, t1.z, 0x15000, 1, t1.realm);
	if(!htele1)
		SendSysMessage(who, "Could not create the primary teleporter.", color := 33);
		return;
	endif
	htele1.movable := 0;
	SendSysMessage(who, "Target location for the secondary teleporter.", color := 88);
	var t2 := TargetCoordinates(who);
	if(!t2)
		DestroyItem(htele1);
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!sign.IsObjectInsideHouse(t2))
		DestroyItem(htele1);
		SendSysMessage(who, "Secondary teleporter must be placed inside this house.", color := 33);
		return;
	endif
	var htele2 := CreateItemAtLocation(t2.x, t2.y, t2.z, 0x15000, 1, t2.realm);
	if(!htele2)
		DestroyItem(htele1);
		SendSysMessage(who, "Could not create the secondary teleporter.", color := 33);
		return;
	endif
	htele2.movable := 0;
	htele1.invisible := 0;
	htele2.invisible := 0;
	SetObjProperty(htele1, "AccessLevel", "A");
	SetObjProperty(htele1, "DestX", htele2.x);
	SetObjProperty(htele1, "DestY", htele2.y);
	SetObjProperty(htele1, "DestZ", htele2.z);
	SetObjProperty(htele1, "DestRealm", htele2.realm);
	SetObjProperty(htele1, "signserial", sign.serial);
	SetObjProperty(htele1, "Othertele", htele2.serial);
	SetObjProperty(htele1, "Primary", 1);
	SetObjProperty(htele2, "AccessLevel", "A");
	SetObjProperty(htele2, "DestX", htele1.x);
	SetObjProperty(htele2, "DestY", htele1.y);
	SetObjProperty(htele2, "DestZ", htele1.z);
	SetObjProperty(htele2, "DestRealm", htele1.realm);
	SetObjProperty(htele2, "Othertele", htele1.serial);
	SetObjProperty(htele2, "signserial", sign.serial);
	if(settings.LimitHouseTeleporters)
		SetObjProperty(sign, "numhteles", CInt(GetObjProperty(sign, "numhteles")) + 1);
	endif
	SendSysMessage(who, "House teleporter pair placed.", color := 66);
endfunction

function TargetManagedTeleporter(sign, who)
	SendSysMessage(who, "Target a house teleporter.", color := 88);
	var tele := Target(who, TGTOPT_NOCHECK_LOS);
	if(!tele)
		SendSysMessageCL(who, 1042023, color := 33);
		return 0;
	endif
	if(tele.objtype != 0x15000)
		SendSysMessage(who, "That is not a house teleporter.", color := 33);
		return 0;
	endif
	if(CInt(GetObjProperty(tele, "signserial")) != sign.serial)
		SendSysMessage(who, "That teleporter does not belong to this house.", color := 33);
		return 0;
	endif
	return tele;
endfunction

function RenameHouseTeleporter(sign, who)
	var tele := TargetManagedTeleporter(sign, who);
	if(!tele)
		return;
	endif
	SendSysMessage(who, "Enter a name for the teleporter.", color := 88);
	var newname := RequestInput(who, tele, "");
	if(!newname)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	tele.name := newname;
	SendSysMessage(who, "Teleporter renamed.", color := 66);
endfunction

function SetHouseTeleporterAccess(sign, who)
	var tele := TargetManagedTeleporter(sign, who);
	if(!tele)
		return;
	endif
	var othertele := SystemFindObjectBySerial(CInt(GetObjProperty(tele, "Othertele")));
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 2600, 260, 180);
	GFTextLine(140, 120, 995, "Set teleporter access");
	GFButtonID(130, 145, 2714, 2715, 1, 1);
	GFTextLine(165, 145, 0, "Owner");
	GFButtonID(130, 165, 2714, 2715, 1, 2);
	GFTextLine(165, 165, 0, "Co-Owners");
	GFButtonID(130, 185, 2714, 2715, 1, 3);
	GFTextLine(165, 185, 0, "Friends");
	GFButtonID(130, 205, 2714, 2715, 1, 4);
	GFTextLine(165, 205, 0, "Anyone");
	var res := GFSendGump(who);
	if(!res)
		return;
	endif
	var lvl := "A";
	case(res[0])
		1: lvl := "O";
		2: lvl := "C";
		3: lvl := "F";
		4: lvl := "A";
		default: return;
	endcase
	SetObjProperty(tele, "AccessLevel", lvl);
	SetObjProperty(tele, "secure", 1);
	SetObjProperty(tele, "houseserial", sign.serial);
	if(othertele)
		SetObjProperty(othertele, "AccessLevel", lvl);
		SetObjProperty(othertele, "secure", 1);
		SetObjProperty(othertele, "houseserial", sign.serial);
	endif
	SendSysMessage(who, "Teleporter access updated.", color := 66);
endfunction

function RemoveHouseTeleporter(sign, who)
	var tele := TargetManagedTeleporter(sign, who);
	if(!tele)
		return;
	endif
	if(!confirmationSizable(who, "Remove this teleporter pair?"))
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	DemolishTeleporter(tele, who);
endfunction

function ListHouseTeleporters(sign, who)
	var house := SystemFindObjectBySerial(CInt(GetObjProperty(sign, "houseserial")));
	if(!house)
		return;
	endif
	var count := 0;
	foreach box in GetObjProperty(sign, "footage")
		foreach thing in ListObjectsInBox(box[1], box[2], box[3], box[4], box[5], box[6], house.realm)
			if(thing.objtype == 0x15000 && CInt(GetObjProperty(thing, "signserial")) == sign.serial)
				count := count + 1;
			endif
		endforeach
	endforeach
	SendSysMessage(who, "This house currently has " + CStr(count) + " teleporter endpoints.", color := 66);
endfunction