program Mulit_House_sign(who, sign)
	var hserial := GetObjProperty(sign, "houseserial");
	if(!hserial)
		if(sign.multi)
			hserial := sign.multi.serial;
			SetObjProperty(sign, "houseserial", hserial);
			SetObjProperty(sign.multi, "signserial", sign.serial);
		else
			return;
		endif
	endif
	var house := SystemFindObjectBySerial(CInt(hserial));
	if(!house)
		SendSysMessage(who, "Cannot find this house in the world data.", color := 33);
		return 0;
	endif
	var bank_region := CP_DEFAULT_AREA;
	var oserial := GetObjProperty(sign, "ownerserial");

	var declare_text := "Declare this house Public";
	if(GetObjProperty(sign, "Public"))
		declare_text := "Declare this house Private";
	endif
	var owner_name := "Unknown";
	if(who.serial == oserial)
		owner_name := who.name;
		SetObjProperty(sign, "lastownername", who.name);
	else
		owner_name := GetObjProperty(sign, "lastownername");
		if(!owner_name || owner_name.errortext)
			owner_name := GetObjProperty(sign, "Owner");
		endif
		if(!owner_name || owner_name.errortext)
			// Fall back: resolve owner name from ownerserial, including offline mobiles.
			var owner_obj := SystemFindObjectBySerial(CInt(oserial));
			if(!owner_obj)
				owner_obj := SystemFindObjectBySerial(CInt(oserial), SYSFIND_SEARCH_OFFLINE_MOBILES);
			endif
			if(owner_obj)
				owner_name := owner_obj.name;
				SetObjProperty(sign, "lastownername", owner_obj.name);
			endif
		endif
	endif
	var remaining_lockdowns := GetObjProperty(sign, "RemainingLockdowns");
	var remaining_secures := GetObjProperty(sign, "RemainingSecures");
	var guild_house_name := GetGuildHouseName(house);
	var house_type := GetHouseTypeDisplayName(house);
	var friend_ := 0, cown := 0;
	var friendlist := sign.GetFriendList();
	var coown := sign.GetCoOwnerList();
	if(who.serial in friendlist)
		friend_ := 1;
	elseif(who.serial in coown)
		cown := 1;
	endif
	if(oserial == who.serial)
		SetObjProperty(sign,"decay",(ReadGameClock() + get_abandon_time())); // Refreshed by configured abandon timeout.
		SendSysMessageCL(who, 1043293, color := 66); // Your house's age and contents have been refreshed.
	endif
	var decay_display := GetHouseDecayDisplay(sign);
	var result;
	var acct := GetObjProperty(sign, "owneracct");
	if((cown == 1) || (friend_ == 1) || (who.acctname == acct) || (who.cmdlevel > 2))
		result := ShowHouseSignGump(who, sign, owner_name, house_type, decay_display, remaining_lockdowns, remaining_secures, guild_house_name, declare_text, 1);
	else
		result := ShowHouseSignGump(who, sign, owner_name, house_type, decay_display, remaining_lockdowns, remaining_secures, guild_house_name, declare_text, 0);
	endif
	// Friends can see house lists.
	if(sign.IsAFriend(who))
		case(result[0])
			2:	ListCoowner(sign, who);                                   //list co-owners
			5:	ListFriend(sign, who);                                    //list friends
			11: ListBan(sign, who);                                       //list bans
		endcase
	endif
	if((acct == who.acctname) || (cown) || (who.cmdlevel > 2))
		if(result[0] > 2979 && result[0] < 3085)
			ChangeSign(who, house, sign, result[0]);
		endif
		case(result[0])
			1:	SendSysMessage(who, "Enter a name for this house.(nothing to exit)", color := 88);
				var newname := RequestInput(who, sign, "");
				if(!newname)
					SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
				elseif((len(newname) > 20))
					SendSysMessage(who, "House sign names may not be longer than 20 characters.", color := 33);
				elseif(len(SplitWords(newname)) > 5)
					SendSysMessage(who, "House sign names are limited to 5 words or less.", color := 33);
				else
					SetName(sign, newname);
					SetObjProperty(sign, "signname", newname);
				endif
			2:	ListCoowner(sign, who);                                   //list co-owners
			3:	AddCoowner(sign, who);                                    //add co-owner
			4:	DeleteCoowner(sign, who);                                 //delete co-owner
			5:	ListFriend(sign, who);                                    //list friends
			6:	AddFriend(sign, who);                                     //add friend
			7:	DeleteFriend(sign, who);                                  //delete friend
			8:	NewFriendsControl(who, sign);
			9:	AddBan(sign, who);                                   //add a ban
			10: Eject(sign,who);                                     //eject someone
			11: ListBan(sign, who);                                       //list bans
			12: DeleteBan(sign, who);                                     //remove a ban
			13:	if((oserial == who.serial) or (who.cmdlevel > 2))          //transfer ownership
					var targetow := Target(who);
					SendSysMessage(who, "Transfer the house to whom?");
					if(ChangeHouseOwner(who, targetow, sign, bank_region) == 1)
						SendSysMessage(who, "House transfer was successful.", color := 66);
					else
						SendSysMessage(who, "House transfer was NOT successful.", color := 33);
					endif
				endif
			14:	if(oserial == who.serial)                                   //demolish house
					if(SmallYesNo(who, "are you sure?"))
						demolish(house, sign, who, bank_region);
					else
						SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
					endif
					return;
				endif
			16:	if(oserial == who.serial)                                   //change locks
					ChangeLocks(who, house);
				endif
			15:	HouseManagement(sign, house, who);
			17:	if(SmallYesNo(who,"Clear List?"))                               //clear co-owner list
					EraseObjProperty(sign, "coowners");
					SendSysMessage(who,"Co-owner list has been cleared.");
				else
					SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
				endif
			// 2026-08-10: Public/Private declaration disabled (kept, not deleted,
			// in case it's wanted again later). DeclarePrivPub() below is now
			// unreachable dead code; the button still renders and returns id 19,
			// it just falls through this case with no handler.
			// 19:	if(oserial == who.serial)                                   //make private
			//		DeclarePrivPub(who, house, sign);
			//	endif
		endcase
	endif
endprogram

//////////////////////////////////
//       friending
//////////////////////////////////

function AddFriend(hsign, who)
  //var friendlist := hsign.GetFriendList();
  SendSysMessageCL(who, 501317, color := 88); // Target the person you wish to name a friend of your household.
  var targetchr := Target(who);
  if(!targetchr)
    SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
    return;
  endif
  if(!targetchr.isA(POLCLASS_MOBILE))
    SendSysMessage(who, "That cannot be added to the list.", color := 33);
    return;
  endif
  var result := hsign.AddFriend(targetchr);
  if(!result)
    SendSysMessage(who, "That person is already a friend.", color := 33);
    return;
  elseif(result < 0)
    SendSysMessage(who, "Your friend list is full.", color := 33);
	return;
  elseif(targetchr.acctname == GetObjProperty(hsign, "owneracct"))
    SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
	return;
  endif
  SendSysMessage(who, targetchr.name + " was friended to your house", color := 66);
  SendSysMessageCL(targetchr, 501337, color := 88); // You have been made a friend of this house.
endfunction

function DeleteFriend(hsign,who)
	var z := 0;
	var fillname;
	var retval1 := 0;
	var names := {};
	var friendlist := hsign.GetFriendList();
	var newlist := {};
	foreach thing in friendlist
		fillname := SystemFindObjectBySerial(thing);
		if(!fillname)
			fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetFriendList(newlist);
	retval1 := ShowPagedNameSelectionGump(who, "Remove a friend", "Remove", names, 165, 335);
	var friendcheck, returncheck;
	if(retval1[0] > 2 && retval1[0] <= 22)
		returncheck := retval1[0] - 2;
		friendcheck := newlist[returncheck];
		var unfriended := SystemFindObjectBySerial(friendcheck);
		var result := hsign.RemoveFriend( unfriended );
		if(result > 0)
			SendSysMessageCL(who, 501298, color := 66); // Friend removed from list.
		elseif(!result)
			SendSysMessage(who, "The friendlist is empty.", color := 33);
		elseif(result == -1)
			SendSysMessage(who, "There is no person in that slot.", color := 33);
		endif
	endif
endfunction

function ListFriend(hsign, who)
	var z := 0;
	var fillname;
	var names := {};
	var friendlist := hsign.GetFriendList();
	var newlist := {};
	foreach thing in friendlist
		fillname := SystemFindObjectBySerial(thing);
		if(!fillname)
			fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetFriendList(newlist);
	var retval := ShowPagedNameListGump(who, "Friends of the house", names);
	return retval;
endfunction

////////////////////////////
//   banning
////////////////////////////

function AddBan(hsign, who)
	//var banlist := hsign.GetBanList();
	SendSysMessageCL(who, 502014, color := 88); // Select the victim.
	var targetchr := Target(who);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if(!targetchr.isA(POLCLASS_MOBILE))
		SendSysMessage(who, "That cannot be added to the list.", color := 33);
		return;
	endif
	var result := hsign.IsBanned(targetchr);
	if(result)
		SendSysMessageCL(who, 501356, color := 42); // This person is already banned!
		return;
	endif
	if(targetchr.multi.serial == GetObjProperty(hsign, "houseserial"))
		MoveObjectToLocation(targetchr, hsign.x, hsign.y, hsign.z, hsign.realm);
	endif
		if(targetchr.serial == GetObjProperty(hsign,"ownerserial"))
			SendSysMessageCL(who, 1115838, color := 33); // You cannot ban yourself!
			return;
		endif
		checklists(hsign, targetchr, "friendlist", "coowners");
		result := hsign.AddBan(targetchr);
		if(result < 0)
			SendSysMessageCL(who, 501355, color := 33); // The ban limit for this house has been reached!
			return;
		endif
		// banlist.append(targetchr.serial);
		// SetObjProperty(hsign, "banlist", banlist);
		SendSysMessageCL(who, 1042839, CAscZ(targetchr.name), color := 66); // ~1_PLAYER_NAME~ has been banned from this house.
		SendSysMessageCL(targetchr, 501340, color := 33); // You have been banned from this house.
	// else
		// SendSysMessage(who, "That cannot be added to the list.");
		// return;
	// endif
endfunction

function DeleteBan(hsign,who)
	var z := 0;
	var fillname;
	var retval1 := 0;
	var names := {};
	var banlist := hsign.GetBanList();
	var newlist := {};
	foreach thing in banlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetBanList(newlist);
	retval1 := ShowPagedNameSelectionGump(who, "Lift a Ban", "Remove", names, 170, 340);
	var bancheck, returncheck;
	if(retval1[0] > 2 && retval1[0] <= 22)
		returncheck := retval1[0] - 2;
		bancheck := newlist[returncheck];
		var unbanned := SystemFindObjectBySerial(bancheck);
		var result := hsign.RemoveBan( unbanned );
		if(result > 0)
			SendSysMessage(who, "The banned person has been removed from the banned list.", color := 66);
		elseif(!result)
			SendSysMessage(who, "The ban list is empty.", color := 33);
		elseif(result == -1)
			SendSysMessage(who, "There is no person in that slot.", color := 33);
		endif
	endif
endfunction

function ListBan(hsign, who)
	var z := 0;
	var fillname;
	var names := {};
	var banlist := hsign.GetBanList();
	if(!banlist)
		banlist := {};
	endif
	var newlist := {};
	foreach thing in banlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetBanList(newlist);
	var retval := ShowPagedNameListGump(who, "Enemies of the house", names);
	return retval;
endfunction

function AddCoowner(hsign, who)
	//var coownlist := hsign.GetCoOwnerList();
	SendSysMessageCL(who, 502020, color := 88); // Click on the player whom you wish to make a co-owner.
	var targetchr := Target(who);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if(!targetchr.isA(POLCLASS_MOBILE))
		SendSysMessageCL(who,501362, color := 33); // That can't be a co-owner of the house.
		return;
	endif
	if(targetchr.isA(POLCLASS_NPC))
		SendSysMessageCL(who,501362, color := 33); // That can't be a co-owner of the house.
		return;
	endif
	var result := hsign.AddCoOwner(targetchr);
	if(!result)
		SendSysMessageCL(who, 501369, color := 33); // This person is already on your co-owner list!
		return;
	elseif(result < 0)
		SendSysMessageCL(who, 501368, color := 33); // Your co-owner list is full!
		return;
	endif
	if(targetchr.serial == GetObjProperty(hsign,"ownerserial"))
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	SendSysMessage(who, targetchr.name + " is now a co-owner of your house", color := 66);
	SendSysMessageCL(targetchr, 501343, color := 66); // You have been made a co-owner of this house.
endfunction

function DeleteCoowner(hsign,who)
	var z := 0;
	var fillname;
	var retvalue := 0;
	var names := {};
	var coownlist := hsign.GetCoOwnerList();
	var newlist := {};
	foreach thing in coownlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetCoOwnerList(newlist);
	retvalue := ShowPagedNameSelectionGump(who, "Remove a Co-owner", "Remove", names, 165, 335);
	if(!retvalue[0])
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return 0;
	endif
	var cocheck, returncheck;
	if(retvalue[0] > 2 && retvalue[0] <= 22)
		returncheck := retvalue[0] - 2;
		cocheck := newlist[returncheck];
		var uncoowner := SystemFindObjectBySerial(cocheck);
		var result := hsign.RemoveCoOwner( uncoowner );
		if(result > 0)
			SendSysMessage(who, "The person has been removed from the co-owner list.", color := 66);
		elseif(!result)
			SendSysMessage(who, "The co-owner list is empty.", color := 33);
		elseif(result == -1)
			SendSysMessage(who, "There is no person in that slot.", color := 33);
		endif
	endif
	SendSysMessageCL(who, 501299, color := 66); // Co-owner removed from list.
endfunction

function ListCoowner(sign, who)
	var z := 0;
	var fillname;
	var names := {};
	var coownlist := sign.GetCoOwnerList();
	var newlist := {};
	foreach thing in coownlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	sign.SetCoOwnerList(newlist);
	var retval := ShowPagedNameListGump(who, "Co-owners of the house", names);
	return retval;
endfunction

function ChangeHouseOwner(oldowner, newowner, sign, bank_region)
	var oldownerserial:=GetObjProperty(sign, "ownerserial");
	if(!newowner || !newowner.acctname)
		return 0;
	endif
	if(oldownerserial == newowner.serial)
		return 0;
	elseif((newowner.cmdlevel == 0) and !IsAccountUnderHouseCap(newowner.acctname))
		SendSysMessage(newowner, "You already own the maximum number of houses allowed on this account.", color := 33);
		return 0;
	else
		var chk;
		var builtdeed := GetObjProperty(sign, "builtdeed");
		if(builtdeed)
			chk := SystemFindObjectBySerial(builtdeed);
			if(!chk)
				chk := SystemFindObjectBySerial(builtdeed, 1);
			endif
			if(!chk)
				chk := SystemFindObjectBySerial(builtdeed, 2);
			endif
			if(!chk)
				SendSysMessage(newowner, "Error: Could not find built deed. Page a GM.", color := 33);
				return 0;
			endif
		else
			SendSysMessage(newowner, "Error: Could not find built deed. Page a GM.", color := 33);
			return 0;
		endif
		var hisbank := CP_GetStorageContainerForMobile( newowner, bank_region, CP_CREATE );
		if(!hisbank)
			SendSysMessage(newowner,      "House transfer was NOT successful. I could not find your bank.", color := 33);
			SendSysMessage(oldowner, "House transfer was NOT successful. I could not find the bank for " + newowner.name + ".", color := 33);
			return 0;
		endif
		if(!MoveItemToContainer(builtdeed, hisbank))
			SendSysMessage(newowner,      "House transfer was NOT successful.", color := 33);
			SendSysMessage(oldowner, "House transfer was NOT successful.", color := 33);
			return 0;
		endif
		if(oldowner and oldowner.acctname)
			UnregisterAccountHouseSign(sign, oldowner.acctname);
		endif
		SetObjProperty(sign,    "ownerserial", newowner.serial);
		SetObjProperty(sign,    "owneracct",   newowner.acctname);
		RegisterAccountHouseSign(sign, newowner.acctname);
		EraseObjProperty(sign, "coowners");
		EraseObjProperty(sign, "friendlist");
		EraseObjProperty(sign, "banlist");
		EraseObjProperty(sign, "Public");
		SendSysMessage(newowner,      "House transfer was successful.", color := 66);
		SendSysMessage(newowner,      "It would be wise to change the locks soon.", color := 45);
		SendSysMessage(oldowner, "House transfer was successful.", color := 66);
		return 1;
	endif
	SendSysMessage(newowner,      "House transfer was NOT successful.", color := 33);
	SendSysMessage(oldowner, "House transfer was NOT successful.", color := 33);
	return 0;
endfunction

function DeclarePrivPub(who, house, sign)
	var public := GetObjProperty(sign, "Public");
	if(public == 1)
		var check := 0;
		foreach mob in (sign.mobiles)
			if(mob.npctemplate == "playervendor")
				check := 1;
				break;
			endif
		endforeach
		if(check == 1)
			SendSysMessage(who, "You cannot declare this house private while there are vendors inside.", color := 33);
			return;
		endif
		foreach thing in (house.components)
			if(((thing.y == (sign.y - 1)) or (thing.y == (sign.y))) and (thing.isa(POLCLASS_DOOR)))
				thing.locked := 1;
				EraseObjProperty(thing, "Public");
			endif
		endforeach
		var signgraph := GetObjProperty(sign, "oldsignprop");
		if(signgraph)
			sign.graphic := signgraph;
		endif
		EraseObjProperty(house, "Public");
		SetObjProperty(house, "Private", 1);
		EraseObjProperty(sign, "Public");
		SetObjProperty(sign, "Private", 1);
		SendSysMessage(who, "This house is now private. The front doors have been locked, and friends may no longer place vendors here.", color := 66);
	else
		if(confirmationSizable(who, "Declaring this house public will unlock the front doors and make them not lockable. Continue?"))
			EraseObjProperty(house, "Private");
			SetObjProperty(house, "Public", 1);
			EraseObjProperty(sign, "Private");
			SetObjProperty(sign, "Public", 1);
			foreach thing in (house.components)
				if(((thing.y == (sign.y - 1)) or (thing.y == (sign.y))) and (thing.isa(POLCLASS_DOOR)))
					thing.locked := 0;
					SetObjProperty(thing, "Public", 1);
				endif
			endforeach
			SendSysMessage(who, "This house is now public. Friends of the house may now place vendors.", color := 66);
		else
			SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		endif
	endif
endfunction

function ChangeSign(who, unused house, sign, result)
	who := who;
	var signgraph := result[0];
	if(sign.graphic == 0xBD0 || sign.graphic == 0xBD1 || sign.graphic == 0xBD2 || sign.graphic == 0xBCF)
		SetObjProperty(sign, "oldsignprop", sign.graphic);
		sign.graphic := signgraph;
	else
		sign.graphic := signgraph;
	endif
endfunction

function Eject(hsign, who)

	SendSysMessageCL(who, 502014, color := 88); // Select the victim.
	var targetchr:=Target(who);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if((!targetchr.multi) && (Distance(who, hsign)>15))
		return;
	endif
	MoveObjectToLocation(targetchr, hsign.x, hsign.y, hsign.z, hsign.realm, MOVEOBJECT_FORCELOCATION);
	SendSysMessage(who,targetchr.name + " was ejected!");
endfunction

// Removes a character from one or both lists.
function checklists(hsign, who, list1, list2)
	var junk := 0;
	var lista := GetObjProperty(hsign, list1);
	var listb := GetObjProperty(hsign, list2);
	junk := who.serial in lista;
	if(junk)
		lista.erase(junk);
	endif
	junk := who.serial in listb;
	if(junk)
		listb.erase(junk);
	endif
		SetObjProperty(hsign, list1, lista);
		SetObjProperty(hsign, list2, listb);
endfunction

function demolish(house, sign, who, bank_region)
	sign := sign;
	var guild_house_id := GetObjProperty(house, "GuildHouse");
	if(guild_house_id && !guild_house_id.errortext)
		var guild_house_serial := CInt(house.serial);
		foreach guild in ListGuilds()
			if(CInt(guild.guildid) == CInt(guild_house_id) && CInt(guild.getprop("GuildHouse")) == guild_house_serial)
				SendSysMessage(who, "This house is your active guild house. Select a new guild house first.", color := 33);
				return;
			endif
		endforeach
	endif
	if(!IsOmegaCacheEmpty(house.serial))
		SendSysMessage(who, "You cannot redeed this house while Omega Cache contents are stored.", color := 33);
		return;
	endif
	var lists := GetObjProperty(sign, "footage");
	var itemlist := {};
	var holder;
	var has_guildstone := 0;
	var has_vendor := 0;
	var builtdeed_error := 0;
	foreach thing in lists
		holder := ListObjectsInBox(thing[1], thing[2], thing[3], thing[4], thing[5],thing[6], house.realm);
		foreach thing in holder
			itemlist.append(thing);
		endforeach
	endforeach
	foreach thing in itemlist
		if(thing.objtype == 0x1A390)
			has_guildstone := 1;
			break;
		endif
	endforeach
	foreach npc in (house.mobiles)
		if(npc.npctemplate == "playervendor")
			has_vendor := 1;
			break;
		endif
	endforeach
	if(has_guildstone)
		SendSysMessage(who, "You cannot redeed a house while it has a guildstone.", color := 33);
		return;
	endif
	if(has_vendor)
		SendSysMessage(who, "You cannot redeed a house with vendors in it.", color := 33);
		return;
	endif
	var builtdeed := SystemFindObjectBySerial(GetObjProperty(sign, "builtdeed"));
	if(builtdeed)
		if(!DestroyItem(builtdeed))
			builtdeed_error := 1;
		endif
	endif
	if(!builtdeed_error)
		var LockIDs := {}, id;
		foreach thing in (house.components)
			id := GetObjProperty(thing, "LockID");
			if(id)
				LockIDs.append(id);
			endif
		endforeach
		KP_DestroyOwnedKeysForLockIDs( who, bank_region, LockIDs );
		case(house.objtype)
			0x16060: CreateItemInBackpack(who,0x16019,1); //smallstoneandplasterhouse
			0x16061: CreateItemInBackpack(who,0x1601a,1); //smallstonehouse
			0x16062: CreateItemInBackpack(who,0x1601b,1); //smallwoodenhouse
			0x16063: CreateItemInBackpack(who,0x1601c,1); //smallplasterhouse
			0x16064: CreateItemInBackpack(who,0x1601d,1); //smallwoodandstrawhouse
			0x16073: CreateItemInBackpack(who,0x1601e,1); //smallbrickhouse
			0x16065: CreateItemInBackpack(who,0x16020,1); //largebrickhouse
			0x16072: CreateItemInBackpack(who,0x16026,1); //largepatiohouse
			0x16066: CreateItemInBackpack(who,0x16021,1); //twostorywoodandplasterhouse
			0x16068: CreateItemInBackpack(who,0x16022,1); //twostorystoneandplasterhouse
			0x16069: CreateItemInBackpack(who,0x16023,1); //tower
			0x16070: CreateItemInBackpack(who,0x16024,1); //keep
			0x16071: CreateItemInBackpack(who,0x16025,1); //castle
			0x16074: CreateItemInBackpack(who,0x1602d,1); //large marble patio house
			0x16075: CreateItemInBackpack(who,0x1602e,1); //small tower
			0x16076: CreateItemInBackpack(who,0x1602f,1); //log cabin house
			0x16077: CreateItemInBackpack(who,0x16030,1); //sandstone patio house
