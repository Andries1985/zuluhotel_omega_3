program Mulit_House_sign(who, sign)
	var hserial := GetObjProperty(sign, "houseserial");
	if(!hserial)
		if(sign.multi)
			hserial := sign.multi.serial;
			SetObjProperty(sign, "houseserial", hserial);
			SetObjProperty(sign.multi, "signserial", sign.serial);
		else
			return;
		endif
	endif
	var house := SystemFindObjectBySerial(CInt(hserial));
	if(!house)
		SendSysMessage(who, "Cannot find this house in the world data.", color := 33);
		return 0;
	endif
	var bank_region := CP_DEFAULT_AREA;
	var oserial := GetObjProperty(sign, "ownerserial");

	var declare_text := "Declare this house Public";
	if(GetObjProperty(sign, "Public"))
		declare_text := "Declare this house Private";
	endif
	var owner_name := "Unknown";
	if(who.serial == oserial)
		owner_name := who.name;
		SetObjProperty(sign, "lastownername", who.name);
	else
		owner_name := GetObjProperty(sign, "lastownername");
		if(!owner_name || owner_name.errortext)
			owner_name := GetObjProperty(sign, "Owner");
		endif
		if(!owner_name || owner_name.errortext)
			// Fall back: resolve owner name from ownerserial, including offline mobiles.
			var owner_obj := SystemFindObjectBySerial(CInt(oserial));
			if(!owner_obj)
				owner_obj := SystemFindObjectBySerial(CInt(oserial), SYSFIND_SEARCH_OFFLINE_MOBILES);
			endif
			if(owner_obj)
				owner_name := owner_obj.name;
				SetObjProperty(sign, "lastownername", owner_obj.name);
			endif
		endif
	endif
	var remaining_lockdowns := GetObjProperty(sign, "RemainingLockdowns");
	var remaining_secures := GetObjProperty(sign, "RemainingSecures");
	var house_type := GetHouseTypeDisplayName(house);
	var friend_ := 0, cown := 0;
	var friendlist := sign.GetFriendList();
	var coown := sign.GetCoOwnerList();
	if(who.serial in friendlist)
		friend_ := 1;
	elseif(who.serial in coown)
		cown := 1;
	endif
	if(oserial == who.serial)
		SetObjProperty(sign,"decay",(ReadGameClock() + get_abandon_time())); // Refreshed by configured abandon timeout.
		SendSysMessageCL(who, 1043293, color := 66); // Your house's age and contents have been refreshed.
	endif
	var decay_display := GetHouseDecayDisplay(sign);
	var result;
	var acct := GetObjProperty(sign, "owneracct");
	if((cown == 1) || (friend_ == 1) || (who.acctname == acct) || (who.cmdlevel > 2))
		result := ShowHouseSignGump(who, sign, owner_name, house_type, decay_display, remaining_lockdowns, remaining_secures, declare_text, 1);
	else
		result := ShowHouseSignGump(who, sign, owner_name, house_type, decay_display, remaining_lockdowns, remaining_secures, declare_text, 0);
	endif
	// Friends can see house lists.
	if(sign.IsAFriend(who))
		case(result[0])
			2:	ListCoowner(sign, who);                                   //list co-owners
			5:	ListFriend(sign, who);                                    //list friends
			11: ListBan(sign, who);                                       //list bans
		endcase
	endif
	if((acct == who.acctname) || (cown) || (who.cmdlevel > 2))
		if(result[0] > 2979 && result[0] < 3085)
			ChangeSign(who, house, sign, result[0]);
		endif
		case(result[0])
			1:	SendSysMessage(who, "Enter a name for this house.(nothing to exit)", color := 88);
				var newname := RequestInput(who, sign, "");
				if(!newname)
					SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
				elseif((len(newname) > 20))
					SendSysMessage(who, "House sign names may not be longer than 20 characters.", color := 33);
				elseif(len(SplitWords(newname)) > 5)
					SendSysMessage(who, "House sign names are limited to 5 words or less.", color := 33);
				else
					SetName(sign, newname);
					SetObjProperty(sign, "signname", newname);
				endif
			2:	ListCoowner(sign, who);                                   //list co-owners
			3:	AddCoowner(sign, who);                                    //add co-owner
			4:	DeleteCoowner(sign, who);                                 //delete co-owner
			5:	ListFriend(sign, who);                                    //list friends
			6:	AddFriend(sign, who);                                     //add friend
			7:	DeleteFriend(sign, who);                                  //delete friend
			8:	NewFriendsControl(who, sign);
			9:	AddBan(sign, who);                                   //add a ban
			10: Eject(sign,who);                                     //eject someone
			11: ListBan(sign, who);                                       //list bans
			12: DeleteBan(sign, who);                                     //remove a ban
			13:	if((oserial == who.serial) or (who.cmdlevel > 2))          //transfer ownership
					var targetow := Target(who);
					SendSysMessage(who, "Transfer the house to whom?");
					if(ChangeHouseOwner(who, targetow, sign, bank_region) == 1)
						SendSysMessage(who, "House transfer was successful.", color := 66);
					else
						SendSysMessage(who, "House transfer was NOT successful.", color := 33);
					endif
				endif
			14:	if(oserial == who.serial)                                   //demolish house
					if(SmallYesNo(who, "are you sure?"))
						demolish(house, sign, who, bank_region);
					else
						SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
					endif
					return;
				endif
			16:	if(oserial == who.serial)                                   //change locks
					ChangeLocks(who, house);
				endif
			15:	HouseManagement(sign, house, who);
			17:	if(SmallYesNo(who,"Clear List?"))                               //clear co-owner list
					EraseObjProperty(sign, "coowners");
					SendSysMessage(who,"Co-owner list has been cleared.");
				else
					SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
				endif
			19:	if(oserial == who.serial)                                   //make private
					DeclarePrivPub(who, house, sign);
				endif
		endcase
	endif
endprogram

//////////////////////////////////
//       friending
//////////////////////////////////

function AddFriend(hsign, who)
  //var friendlist := hsign.GetFriendList();
  SendSysMessageCL(who, 501317, color := 88); // Target the person you wish to name a friend of your household.
  var targetchr := Target(who);
  if(!targetchr)
    SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
    return;
  endif
  if(!targetchr.isA(POLCLASS_MOBILE))
    SendSysMessage(who, "That cannot be added to the list.", color := 33);
    return;
  endif
  var result := hsign.AddFriend(targetchr);
  if(!result)
    SendSysMessage(who, "That person is already a friend.", color := 33);
    return;
  elseif(result < 0)
    SendSysMessage(who, "Your friend list is full.", color := 33);
	return;
  elseif(targetchr.acctname == GetObjProperty(hsign, "owneracct"))
    SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
	return;
  endif
  SendSysMessage(who, targetchr.name + " was friended to your house", color := 66);
  SendSysMessageCL(targetchr, 501337, color := 88); // You have been made a friend of this house.
endfunction

function DeleteFriend(hsign,who)
	var z := 0;
	var fillname;
	var retval1 := 0;
	var names := {};
	var friendlist := hsign.GetFriendList();
	var newlist := {};
	foreach thing in friendlist
		fillname := SystemFindObjectBySerial(thing);
		if(!fillname)
			fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetFriendList(newlist);
	retval1 := ShowPagedNameSelectionGump(who, "Remove a friend", "Remove", names, 165, 335);
	var friendcheck, returncheck;
	if(retval1[0] > 2 && retval1[0] <= 22)
		returncheck := retval1[0] - 2;
		friendcheck := newlist[returncheck];
		var unfriended := SystemFindObjectBySerial(friendcheck);
		var result := hsign.RemoveFriend( unfriended );
		if(result > 0)
			SendSysMessageCL(who, 501298, color := 66); // Friend removed from list.
		elseif(!result)
			SendSysMessage(who, "The friendlist is empty.", color := 33);
		elseif(result == -1)
			SendSysMessage(who, "There is no person in that slot.", color := 33);
		endif
	endif
endfunction

function ListFriend(hsign, who)
	var z := 0;
	var fillname;
	var names := {};
	var friendlist := hsign.GetFriendList();
	var newlist := {};
	foreach thing in friendlist
		fillname := SystemFindObjectBySerial(thing);
		if(!fillname)
			fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetFriendList(newlist);
	var retval := ShowPagedNameListGump(who, "Friends of the house", names);
	return retval;
endfunction

////////////////////////////
//   banning
////////////////////////////

function AddBan(hsign, who)
	//var banlist := hsign.GetBanList();
	SendSysMessageCL(who, 502014, color := 88); // Select the victim.
	var targetchr := Target(who);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if(!targetchr.isA(POLCLASS_MOBILE))
		SendSysMessage(who, "That cannot be added to the list.", color := 33);
		return;
	endif
	var result := hsign.IsBanned(targetchr);
	if(result)
		SendSysMessageCL(who, 501356, color := 42); // This person is already banned!
		return;
	endif
	if(targetchr.multi.serial == GetObjProperty(hsign, "houseserial"))
		MoveObjectToLocation(targetchr, hsign.x, hsign.y, hsign.z, hsign.realm);
	endif
		if(targetchr.serial == GetObjProperty(hsign,"ownerserial"))
			SendSysMessageCL(who, 1115838, color := 33); // You cannot ban yourself!
			return;
		endif
		checklists(hsign, targetchr, "friendlist", "coowners");
		result := hsign.AddBan(targetchr);
		if(result < 0)
			SendSysMessageCL(who, 501355, color := 33); // The ban limit for this house has been reached!
			return;
		endif
		// banlist.append(targetchr.serial);
		// SetObjProperty(hsign, "banlist", banlist);
		SendSysMessageCL(who, 1042839, CAscZ(targetchr.name), color := 66); // ~1_PLAYER_NAME~ has been banned from this house.
		SendSysMessageCL(targetchr, 501340, color := 33); // You have been banned from this house.
	// else
		// SendSysMessage(who, "That cannot be added to the list.");
		// return;
	// endif
endfunction

function DeleteBan(hsign,who)
	var z := 0;
	var fillname;
	var retval1 := 0;
	var names := {};
	var banlist := hsign.GetBanList();
	var newlist := {};
	foreach thing in banlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetBanList(newlist);
	retval1 := ShowPagedNameSelectionGump(who, "Lift a Ban", "Remove", names, 170, 340);
	var bancheck, returncheck;
	if(retval1[0] > 2 && retval1[0] <= 22)
		returncheck := retval1[0] - 2;
		bancheck := newlist[returncheck];
		var unbanned := SystemFindObjectBySerial(bancheck);
		var result := hsign.RemoveBan( unbanned );
		if(result > 0)
			SendSysMessage(who, "The banned person has been removed from the banned list.", color := 66);
		elseif(!result)
			SendSysMessage(who, "The ban list is empty.", color := 33);
		elseif(result == -1)
			SendSysMessage(who, "There is no person in that slot.", color := 33);
		endif
	endif
endfunction

function ListBan(hsign, who)
	var z := 0;
	var fillname;
	var names := {};
	var banlist := hsign.GetBanList();
	if(!banlist)
		banlist := {};
	endif
	var newlist := {};
	foreach thing in banlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetBanList(newlist);
	var retval := ShowPagedNameListGump(who, "Enemies of the house", names);
	return retval;
endfunction

function AddCoowner(hsign, who)
	//var coownlist := hsign.GetCoOwnerList();
	SendSysMessageCL(who, 502020, color := 88); // Click on the player whom you wish to make a co-owner.
	var targetchr := Target(who);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if(!targetchr.isA(POLCLASS_MOBILE))
		SendSysMessageCL(who,501362, color := 33); // That can't be a co-owner of the house.
		return;
	endif
	if(targetchr.isA(POLCLASS_NPC))
		SendSysMessageCL(who,501362, color := 33); // That can't be a co-owner of the house.
		return;
	endif
	var result := hsign.AddCoOwner(targetchr);
	if(!result)
		SendSysMessageCL(who, 501369, color := 33); // This person is already on your co-owner list!
		return;
	elseif(result < 0)
		SendSysMessageCL(who, 501368, color := 33); // Your co-owner list is full!
		return;
	endif
	if(targetchr.serial == GetObjProperty(hsign,"ownerserial"))
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	SendSysMessage(who, targetchr.name + " is now a co-owner of your house", color := 66);
	SendSysMessageCL(targetchr, 501343, color := 66); // You have been made a co-owner of this house.
endfunction

function DeleteCoowner(hsign,who)
	var z := 0;
	var fillname;
	var retvalue := 0;
	var names := {};
	var coownlist := hsign.GetCoOwnerList();
	var newlist := {};
	foreach thing in coownlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetCoOwnerList(newlist);
	retvalue := ShowPagedNameSelectionGump(who, "Remove a Co-owner", "Remove", names, 165, 335);
	if(!retvalue[0])
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return 0;
	endif
	var cocheck, returncheck;
	if(retvalue[0] > 2 && retvalue[0] <= 22)
		returncheck := retvalue[0] - 2;
		cocheck := newlist[returncheck];
		var uncoowner := SystemFindObjectBySerial(cocheck);
		var result := hsign.RemoveCoOwner( uncoowner );
		if(result > 0)
			SendSysMessage(who, "The person has been removed from the co-owner list.", color := 66);
		elseif(!result)
			SendSysMessage(who, "The co-owner list is empty.", color := 33);
		elseif(result == -1)
			SendSysMessage(who, "There is no person in that slot.", color := 33);
		endif
	endif
	SendSysMessageCL(who, 501299, color := 66); // Co-owner removed from list.
endfunction

function ListCoowner(sign, who)
	var z := 0;
	var fillname;
	var names := {};
	var coownlist := sign.GetCoOwnerList();
	var newlist := {};
	foreach thing in coownlist
		fillname := SystemFindObjectBySerial(thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if(fillname)
			newlist.append(thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	sign.SetCoOwnerList(newlist);
	var retval := ShowPagedNameListGump(who, "Co-owners of the house", names);
	return retval;
endfunction

function ChangeHouseOwner(oldowner, newowner, sign, bank_region)
	var oldownerserial:=GetObjProperty(sign, "ownerserial");
	if(!newowner || !newowner.acctname)
		return 0;
	endif
	if(oldownerserial == newowner.serial)
		return 0;
	else
		var chk;
		var builtdeed := GetObjProperty(sign, "builtdeed");
		if(builtdeed)
			chk := SystemFindObjectBySerial(builtdeed);
			if(!chk)
				chk := SystemFindObjectBySerial(builtdeed, 1);
			endif
			if(!chk)
				chk := SystemFindObjectBySerial(builtdeed, 2);
			endif
			if(!chk)
				SendSysMessage(newowner, "Error: Could not find built deed. Page a GM.", color := 33);
				return 0;
			endif
		else
			SendSysMessage(newowner, "Error: Could not find built deed. Page a GM.", color := 33);
			return 0;
		endif
		var hisbank := CP_GetStorageContainerForMobile( newowner, bank_region, CP_CREATE );
		if(!hisbank)
			SendSysMessage(newowner,      "House transfer was NOT successful. I could not find your bank.", color := 33);
			SendSysMessage(oldowner, "House transfer was NOT successful. I could not find the bank for " + newowner.name + ".", color := 33);
			return 0;
		endif
		if(!MoveItemToContainer(builtdeed, hisbank))
			SendSysMessage(newowner,      "House transfer was NOT successful.", color := 33);
			SendSysMessage(oldowner, "House transfer was NOT successful.", color := 33);
			return 0;
		endif
		SetObjProperty(sign,    "ownerserial", newowner.serial);
		SetObjProperty(sign,    "owneracct",   newowner.acctname);
		EraseObjProperty(sign, "coowners");
		EraseObjProperty(sign, "friendlist");
		EraseObjProperty(sign, "banlist");
		EraseObjProperty(sign, "Public");
		SendSysMessage(newowner,      "House transfer was successful.", color := 66);
		SendSysMessage(newowner,      "It would be wise to change the locks soon.", color := 45);
		SendSysMessage(oldowner, "House transfer was successful.", color := 66);
		return 1;
	endif
	SendSysMessage(newowner,      "House transfer was NOT successful.", color := 33);
	SendSysMessage(oldowner, "House transfer was NOT successful.", color := 33);
	return 0;
endfunction

function DeclarePrivPub(who, house, sign)
	var public := GetObjProperty(sign, "Public");
	if(public == 1)
		var check := 0;
		foreach mob in (sign.mobiles)
			if(mob.npctemplate == "playervendor")
				check := 1;
				break;
			endif
		endforeach
		if(check == 1)
			SendSysMessage(who, "You cannot declare this house private while there are vendors inside.", color := 33);
			return;
		endif
		foreach thing in (house.components)
			if(((thing.y == (sign.y - 1)) or (thing.y == (sign.y))) and (thing.isa(POLCLASS_DOOR)))
				thing.locked := 1;
				EraseObjProperty(thing, "Public");
			endif
		endforeach
		var signgraph := GetObjProperty(sign, "oldsignprop");
		if(signgraph)
			sign.graphic := signgraph;
		endif
		EraseObjProperty(house, "Public");
		SetObjProperty(house, "Private", 1);
		EraseObjProperty(sign, "Public");
		SetObjProperty(sign, "Private", 1);
		SendSysMessage(who, "This house is now private. The front doors have been locked, and friends may no longer place vendors here.", color := 66);
	else
		if(confirmationSizable(who, "Declaring this house public will unlock the front doors and make them not lockable. Continue?"))
			EraseObjProperty(house, "Private");
			SetObjProperty(house, "Public", 1);
			EraseObjProperty(sign, "Private");
			SetObjProperty(sign, "Public", 1);
			foreach thing in (house.components)
				if(((thing.y == (sign.y - 1)) or (thing.y == (sign.y))) and (thing.isa(POLCLASS_DOOR)))
					thing.locked := 0;
					SetObjProperty(thing, "Public", 1);
				endif
			endforeach
			SendSysMessage(who, "This house is now public. Friends of the house may now place vendors.", color := 66);
		else
			SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		endif
	endif
endfunction

function ChangeSign(who, unused house, sign, result)
	who := who;
	var signgraph := result[0];
	if(sign.graphic == 0xBD0 || sign.graphic == 0xBD2)
		SetObjProperty(sign, "oldsignprop", sign.graphic);
		sign.graphic := signgraph;
	else
		sign.graphic := signgraph;
	endif
endfunction

function Eject(hsign, who)

	SendSysMessageCL(who, 502014, color := 88); // Select the victim.
	var targetchr:=Target(who);
	if(!targetchr)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if((!targetchr.multi) && (Distance(who, hsign)>15))
		return;
	endif
	MoveObjectToLocation(targetchr, hsign.x, hsign.y, hsign.z, hsign.realm, MOVEOBJECT_FORCELOCATION);
	SendSysMessage(who,targetchr.name + " was ejected!");
endfunction

// Removes a character from one or both lists.
function checklists(hsign, who, list1, list2)
	var junk := 0;
	var lista := GetObjProperty(hsign, list1);
	var listb := GetObjProperty(hsign, list2);
	junk := who.serial in lista;
	if(junk)
		lista.erase(junk);
	endif
	junk := who.serial in listb;
	if(junk)
		listb.erase(junk);
	endif
		SetObjProperty(hsign, list1, lista);
		SetObjProperty(hsign, list2, listb);
endfunction

function demolish(house, sign, who, bank_region)
	sign := sign;
	if(!IsOmegaCacheEmpty(house.serial))
		SendSysMessage(who, "You cannot redeed this house while Omega Cache contents are stored.", color := 33);
		return;
	endif
	var lists := GetObjProperty(sign, "footage");
	var itemlist := {};
	var holder, chk := 0;
	foreach thing in lists
		holder := ListObjectsInBox(thing[1], thing[2], thing[3], thing[4], thing[5],thing[6], house.realm);
		foreach thing in holder
			itemlist.append(thing);
		endforeach
	endforeach
	foreach thing in itemlist
		if(thing.objtype == 0x1A390)
			chk := 1;
			break;
		endif
	endforeach
	foreach npc in (house.mobiles)
		if(npc.npctemplate == "playervendor")
			chk := 1;
			break;
		endif
	endforeach
	if(chk == 1)
		SendSysMessage(who, "You cannot redeed a house with vendors in it.", color := 33);
		return;
	endif
	if(chk == 0)
		var builtdeed := SystemFindObjectBySerial(GetObjProperty(sign, "builtdeed"));
		if(builtdeed)
			if(!DestroyItem(builtdeed))
				chk := 2;
			endif
		endif
	endif
	if(chk == 0)
		var LockIDs := {}, id;
		foreach thing in (house.components)
			id := GetObjProperty(thing, "LockID");
			if(id)
				LockIDs.append(id);
			endif
		endforeach
		KP_DestroyOwnedKeysForLockIDs( who, bank_region, LockIDs );
		case(house.objtype)
			0x16060: CreateItemInBackpack(who,0x16019,1); //smallstoneandplasterhouse
			0x16061: CreateItemInBackpack(who,0x1601a,1); //smallstonehouse
			0x16062: CreateItemInBackpack(who,0x1601b,1); //smallwoodenhouse
			0x16063: CreateItemInBackpack(who,0x1601c,1); //smallplasterhouse
			0x16064: CreateItemInBackpack(who,0x1601d,1); //smallwoodandstrawhouse
			0x16073: CreateItemInBackpack(who,0x1601e,1); //smallbrickhouse
			0x16065: CreateItemInBackpack(who,0x16020,1); //largebrickhouse
			0x16072: CreateItemInBackpack(who,0x16026,1); //largepatiohouse
			0x16066: CreateItemInBackpack(who,0x16021,1); //twostorywoodandplasterhouse
			0x16068: CreateItemInBackpack(who,0x16022,1); //twostorystoneandplasterhouse
			0x16069: CreateItemInBackpack(who,0x16023,1); //tower
			0x16070: CreateItemInBackpack(who,0x16024,1); //keep
			0x16071: CreateItemInBackpack(who,0x16025,1); //castle
			0x16074: CreateItemInBackpack(who,0x1602d,1); //large marble patio house
			0x16075: CreateItemInBackpack(who,0x1602e,1); //small tower
			0x16076: CreateItemInBackpack(who,0x1602f,1); //log cabin house
			0x16077: CreateItemInBackpack(who,0x16030,1); //sandstone patio house
			0x16078: CreateItemInBackpack(who,0x16031,1); //two story villa
			0x16079: CreateItemInBackpack(who,0x16032,1); //small stone workshop
			0x1607a: CreateItemInBackpack(who,0x16033,1); //small marble workshop
			0x1607b: CreateItemInBackpack(who,0x16034,1); //garden shed south
			0x1607c: CreateItemInBackpack(who,0x16035,1); //garden shed east
		endcase
		var tilelist := GetObjProperty(house, "bantiles");
		foreach thing in tilelist
			DestroyItem(SystemFindObjectBySerial(thing));
		endforeach
		foreach thing in itemlist
			if(CInt(thing.objtype) == OMEGACACHE_OBJTYPE)
				EraseObjProperty(thing, "houseserial");
				DestroyItem(thing);
			elseif (thing.objtype == 0x15000) // House Teleporter
					//Print("Demolishing a house teleporter.");
					DemolishTeleporter(thing, who);
			endif
			if((GetObjProperty(thing,"secure") == 1) && (thing.movable == 0))
				EraseObjProperty(thing,"secure");
				if(GetObjProperty(thing, "houseserial" ) == house.serial)
					var oldscript := GetObjProperty(thing, "oldscript");
					if (oldscript == error)
						oldscript := "";
					endif
					thing.usescript := oldscript;
					thing.movable := 1;
					thing.decayat := ReadGameClock() + 1;
					EraseObjProperty(thing, "houseserial" );
					EraseObjProperty(thing, "oldscript" );
				endif
			elseif ((GetObjProperty(thing, "lockeddown" ) == 1) && (thing.movable == 0))
				thing.movable := 1;
				thing.decayat := ReadGameClock() + 1;
				EraseObjProperty(thing, "houseserial" );
				EraseObjProperty(thing, "lockeddown");
			elseif (thing.movable == 0)
				if(thing.objtype == 0x1A390)
					MoveObjectToLocation(thing, thing.x, thing.y, house.z, house.realm, MOVEOBJECT_FORCELOCATION);
					thing.decayat := ReadGameClock() + 1;
				else
					DestroyItem(thing);
				endif
			endif
		endforeach
		CloseOmegaCacheStore(house.serial);
		DestroyMulti(house);
	elseif(chk == 2)
		SendSysMessage(who, "Could not find the built deed, please page a GM.", color := 33);
		return;
	else
		SendSysMessage(who, "You cannot redeed a house while it has a guildstone.", color := 33);
		return;
	endif
endfunction

function GetHouseTypeDisplayName(house)
	if(!house)
		return "Unknown";
	endif
	var itemdesc_cfg := ReadConfigFile(":house:itemdesc");
	if(itemdesc_cfg)
		var house_elem := itemdesc_cfg[house.objtype];
		if(house_elem && !house_elem.errortext)
			var house_desc := GetConfigString(house_elem, "Desc");
			if(house_desc && !house_desc.errortext && house_desc != "")
				return house_desc;
			endif
		endif
	endif
	return CStr(Hex(house.objtype));
endfunction

function ChangeLocks(who, house)
  SendSysMessage(who, "Target the new master key.", color := 88);
  var newkey:=Target(who);
  if(!newkey)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
  endif
  var addonitem;
  if((newkey.IsKey()) && (!newkey.IsKeyring()))
    var LockID:=AllocateLockID();
    newkey.SetLockId(LockID);
    foreach item in(house.components)
      if(item.IsA(POLCLASS_DOOR))
        item.locked := 1;
        SetObjProperty(item,"LockID",LockID);
	  elseif(item.IsMultiHouseSign())
        SetObjProperty(item,"LockID",LockID);
      endif
    endforeach
    addonitem:=CInt(GetObjProperty(house,"component2"));
    if(addonitem)
      addonitem.locked:=1;
      SetObjProperty(addonitem,"LockID",LockID);
    endif
    SendSysMessage(who, "Locks have been changed.", color := 66);
  else
    SendSysMessage(who,"That is not a key!", color := 33);
  endif
endfunction

function BuildHouseFriendRows(sign)
	var rows := {};
	var seen := {};
	var allserials := {};
	foreach serial in (sign.GetFriendList())
		allserials.append(serial);
	endforeach
	foreach serial in (sign.GetCoOwnerList())
		if(!(serial in allserials))
			allserials.append(serial);
		endif
	endforeach
	foreach serial in allserials
		if(serial in seen)
			continue;
		endif
		seen.append(serial);
		var mob := SystemFindObjectBySerial(serial);
		if(!mob)
			mob := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(!mob)
			continue;
		endif
		var p := sign.GetFriendPermissionProfile(mob);
		var secure := p[3];
		var tele := p[6];
		rows.append(array(serial, secure, secure, secure, tele, tele, tele, p[1]));
	endforeach
	return rows;
endfunction

function SaveHouseFriendData(sign, byref keys, byref rows)
	var i := 1;
	foreach person in rows
		var serial := person[1];
		var mob := SystemFindObjectBySerial(serial);
		if(!mob)
			mob := SystemFindObjectBySerial(serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(!mob)
			i := i + 1;
			continue;
		endif
		var base := i * 100;
		var coowner := ((base + 8) in keys);
		var secure := ((base + 2) in keys) || ((base + 3) in keys) || ((base + 4) in keys);
		var tele := ((base + 5) in keys) || ((base + 6) in keys) || ((base + 7) in keys);
		if(coowner)
			if(!sign.IsAFriend(mob))
				sign.AddFriend(mob);
			endif
			if(!sign.IsACoOwner(mob))
				sign.AddCoOwner(mob);
			endif
			sign.SetFriendPermission(mob, "lockdown", 1);
			sign.SetFriendPermission(mob, "secure", 1);
			sign.SetFriendPermission(mob, "eject", 1);
			sign.SetFriendPermission(mob, "ban", 1);
			sign.SetFriendPermission(mob, "teleporter", 1);
		else
			if(sign.IsACoOwner(mob))
				sign.RemoveCoOwner(mob);
			endif
			sign.SetFriendPermission(mob, "secure", secure);
			sign.SetFriendPermission(mob, "teleporter", tele);
		endif
		i := i + 1;
	endforeach
endfunction

function NewFriendsControl(who, sign, pagenum := 0)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "You do not have permission to manage house friends.", color := 33);
		return 0;
	endif
	var rows := BuildHouseFriendRows(sign);
	var start := (pagenum * 11) + 1;
	var shown := {};
	var stop := start + 10;
	var i := 0;
	for(i := start; i <= stop; i := i + 1)
		if(rows[i])
			shown.append(rows[i]);
		endif
	endfor

	GFInitGump();
	GFNoClose();
	GFNoDispose();
	GFResizePic(10, 10, 2600, 750, 530);
	GFResizePic(60, 25, 5100, 650, 25);
	GFTextLine(272, 28, 60, "MANAGE HOUSE FRIENDS");
	GFResizePic(40, 80, 2620, 690, 410);
	GFTextLine(60, 110, 2302, "Friend Name");
	GFTextLine(293, 90, 2302, "Secures");
	GFTextLine(250, 110, 2302, "View |");
	GFTextLine(303, 110, 2302, "Add |");
	GFTextLine(342, 110, 2302, "Remove |");
	GFTextLine(460, 90, 2302, "Recall/Gate");
	GFTextLine(406, 110, 2302, "Recall |");
	GFTextLine(464, 110, 2302, "Gate To |");
	GFTextLine(538, 110, 2302, "Gate From");
	GFTextLine(650, 110, 2302, "Co-owner");
	GFButtonID(220, 500, 2714, 2715, 1, 100000);
	GFTextLine(250, 498, 60, "Remove Friend");
	GFButtonID(60, 500, 2714, 2715, 1, 200000);
	GFTextLine(90, 498, 60, "Add Friend");
	GFButtonID(650, 497, 0x850, 0x851, 1, 300000);

	if(pagenum > 0)
		GFTextLine(367, 60, 99, "Page - " + CStr(pagenum + 1));
		GFButtonID(730, 80, 2704, 2705, 1, 500000);
	elseif(rows.size() > 11)
		GFTextLine(367, 60, 99, "Page - 1");
	endif

	GFPage(1);
	var y := 145;
	var idx := 1;
	foreach person in shown
		var mob := SystemFindObjectBySerial(person[1]);
		if(!mob)
			mob := SystemFindObjectBySerial(person[1], SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if(!mob)
			continue;
		endif
		var namecolour := 44;
		if(person[8])
			namecolour := 53;
		endif
		var ch := idx * 100;
		GFRadioButton(47, y, 210, 211, 0, idx);
		GFTextCrop(70, y, 180, 20, namecolour, mob.name);
		GFCheckBox(667, y, 210, 211, person[8], ch + 8);
		if(!person[8])
			GFCheckBox(257, y, 210, 211, person[2], ch + 2);
			GFCheckBox(302, y, 210, 211, person[3], ch + 3);
			GFCheckBox(347, y, 210, 211, person[4], ch + 4);
			GFCheckBox(416, y, 210, 211, person[5], ch + 5);
			GFCheckBox(486, y, 210, 211, person[6], ch + 6);
			GFCheckBox(556, y, 210, 211, person[7], ch + 7);
		else
			GFTextLine(260, y, 2302, "Co-owners have the same authority as owners.");
		endif
		y := y + 30;
		idx := idx + 1;
	endforeach

	if((start + 11) <= rows.size())
		GFButtonID(730, 471, 2706, 2707, 1, 400000);
	endif

	var res := GFSendGump(who);
	case(res[0])
		100000:
			SaveHouseFriendData(sign, res.keys, shown);
			var selected := 0;
			var i2 := 0;
			for(i2 := 1; i2 <= shown.size(); i2 := i2 + 1)
				if(i2 in res.keys)
					selected := i2;
					break;
				endif
			endfor
			if(!selected)
				SendSysMessage(who, "Select a friend first.", color := 33);
			else
				var rmob := SystemFindObjectBySerial(shown[selected][1]);
				if(!rmob)
					rmob := SystemFindObjectBySerial(shown[selected][1], SYSFIND_SEARCH_OFFLINE_MOBILES);
				endif
				if(rmob)
					sign.RemoveCoOwner(rmob);
					sign.RemoveFriend(rmob);
					SendSysMessage(who, rmob.name + " removed from house friends.", color := 66);
				endif
			endif
			return NewFriendsControl(who, sign, pagenum);
		200000:
			SaveHouseFriendData(sign, res.keys, shown);
			AddFriend(sign, who);
			return NewFriendsControl(who, sign, pagenum);
		300000:
			SaveHouseFriendData(sign, res.keys, shown);
			SendSysMessage(who, "Permissions updated.", color := 66);
			return 1;
		400000:
			SaveHouseFriendData(sign, res.keys, shown);
			return NewFriendsControl(who, sign, pagenum + 1);
		500000:
			SaveHouseFriendData(sign, res.keys, shown);
			if(pagenum > 0)
				return NewFriendsControl(who, sign, pagenum - 1);
			endif
			return NewFriendsControl(who, sign, 0);
	endcase
	return 0;
endfunction

function AddSecureFacingFromMenu(who, sign, house, facing_east := 1)
	if(!sign.HasHousePermission(who, "secure"))
		SendSysMessage(who, "You do not have secure permission.", color := 33);
		return;
	endif
	var targ := TargetCoordinates(who);
	if(!targ)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!sign.IsObjectInsideHouse(targ))
		SendSysMessage(who, "That is not inside the building.", color := 33);
		return;
	endif
	if(GetObjProperty(sign, "RemainingSecures") <= 0)
		SendSysMessage(who, "The house has no more secure containers remaining.", color := 33);
		return;
	endif
	var obj := 0xE41;
	if(!facing_east)
		obj := 0xE40;
	endif
	var box := CreateItemAtLocation(targ.x, targ.y, targ.z, obj, 1, targ.realm);
	if(!box)
		SendSysMessage(who, "Could not create the secure container.", color := 33);
		return;
	endif
	box.movable := 0;
	SetObjProperty(box, "houseserial", CInt(house.serial));
	SetObjProperty(box, "secure", 1);
	SetObjProperty(box, "oldscript", box.script);
	box.usescript := ":house:secureCont";
	SetObjProperty(sign, "RemainingSecures", CInt(GetObjProperty(sign, "RemainingSecures") - 1));
	SendSysMessage(who, "Secure On.", color := 66);
endfunction

function RevealLostItemsFromMenu(who, house)
	if(!house)
		return;
	endif
	SendSysMessage(who, "Please wait, recovering lost items....", color := 88);
	foreach item in (house.items)
		if(!GetObjProperty(item, "houseserial"))
			var waslocked := 0;
			if(item.movable == 0)
				waslocked := 1;
				item.movable := 1;
			endif
			MoveObjectToLocation(item, item.x, item.y, item.z, item.realm, MOVEOBJECT_FORCELOCATION);
			if(waslocked)
				item.movable := 0;
			endif
			SleepMs(10);
		endif
	endforeach
	SendSysMessage(who, "Any previously lost items are now back in place!", color := 66);
endfunction

function HouseManagement(sign, house, who)
	var ok := 1;
	EnsureOmegaCacheSlots(house, sign);
	while(ok)
		GFInitGump();
		GFNoDispose();
		GFNoClose();
		GFResizePic(0, 0, 2600, 250, 294);
		GFTextLine(60, 15, 20, "House Management");
		GFButtonID(35, 50, 2714, 2715, 1, 1);
		GFTextLine(70, 50, 2302, "Lock down an item");
		GFButtonID(35, 72, 2714, 2715, 1, 2);
		GFTextLine(70, 72, 2302, "Unlock an item");
		GFButtonID(35, 94, 2714, 2715, 1, 3);
		GFTextLine(70, 94, 2302, "Add a secure east");
		GFButtonID(35, 116, 2714, 2715, 1, 4);
		GFTextLine(70, 116, 2302, "Add a secure south");
		GFButtonID(35, 138, 2714, 2715, 1, 5);
		GFTextLine(70, 138, 2302, "Delete a secure");
		GFButtonID(35, 160, 2714, 2715, 1, 6);
		GFTextLine(70, 160, 2302, "Reveal lost items");
		GFButtonID(35, 182, 2714, 2715, 1, 7);
		GFTextLine(70, 182, 2302, "Add Teleporter");
		GFButtonID(35, 204, 2714, 2715, 1, 8);
		GFTextLine(70, 204, 2302, "Remove Teleporter");
		GFButtonID(35, 226, 2714, 2715, 1, 9);
		GFTextLine(70, 226, 2302, "Remove Cache Container");
		GFButtonID(90, 254, 243, 241, 1, 13);
		var result := GFSendGump(who);
		case(result[0])
			1: HandleLockdownRelease(sign, house, who, 1);
			2: HandleLockdownRelease(sign, house, who, 2);
			3: AddSecureFacingFromMenu(who, sign, house, 1);
			4: AddSecureFacingFromMenu(who, sign, house, 0);
			5: UnsecureContainerFromMenu(sign, house, who);
			6: RevealLostItemsFromMenu(who, house);
			7: PlaceHouseTeleporterPair(sign, who);
			8: RemoveHouseTeleporter(sign, who);
			9: HouseFunctionRemoveOmegaCache(sign, house, who);
			13: ok := 0;
			default: ok := 0;
		endcase
		SleepMs(150);
	endwhile
endfunction

function EnsureOmegaCacheSlots(house, sign := 0)
	var max_slots := GetObjProperty(house, "maxnumomegacache");
	if(max_slots == error)
		max_slots := GetMaxOmegaCacheForHouse(CInt(GetObjType(house)));
		SetObjProperty(house, "maxnumomegacache", max_slots);
	endif

	var remaining := GetObjProperty(house, "numomegacache");
	if(remaining == error)
		remaining := max_slots;
		SetObjProperty(house, "numomegacache", remaining);
	endif

	if(sign)
		if(GetObjProperty(sign, "maxnumomegacache") == error)
			SetObjProperty(sign, "maxnumomegacache", max_slots);
		endif
		if(GetObjProperty(sign, "numomegacache") == error)
			SetObjProperty(sign, "numomegacache", remaining);
		endif
	endif

	return array(remaining, max_slots);
endfunction

function HouseFunctionRemoveOmegaCache(sign, house, who)
	if(!sign.IsFullHouseManager(who))
		SendSysMessage(who, "Only owners and co-owners can remove Omega Cache containers.", color := 33);
		return;
	endif

	var slots := EnsureOmegaCacheSlots(house, sign);
	var remaining := CInt(slots[1]);
	var max_slots := CInt(slots[2]);

	SendSysMessage(who, "Choose the Omega Cache container you wish to remove.", color := 88);
	var cache := Target(who, TGTOPT_NOCHECK_LOS);
	if(!cache)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif

	if(CInt(cache.objtype) != OMEGACACHE_OBJTYPE)
		SendSysMessage(who, "That is not an Omega Cache container.", color := 33);
		return;
	endif

	if(CInt(GetObjProperty(cache, "houseserial")) != CInt(house.serial))
		SendSysMessageCL(who, 1005525, color := 33);
		return;
	endif

	if(!IsOmegaCacheEmpty(house.serial))
		SendSysMessage(who, "This house Omega Cache still contains stored items. Withdraw them first.", color := 33);
		return;
	endif

	if(!confirmationSizable(who, "Remove this Omega Cache container?"))
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif

	// Avoid destroy script re-credit on manual house-management remove.
	EraseObjProperty(cache, "houseserial");
	if(!DestroyItem(cache))
		SendSysMessage(who, "Could not remove that Omega Cache container.", color := 33);
		return;
	endif

	remaining := remaining + 1;
	if(remaining > max_slots)
		remaining := max_slots;
	endif
	SetObjProperty(house, "numomegacache", remaining);
	SetObjProperty(sign, "numomegacache", remaining);
	SetObjProperty(house, "maxnumomegacache", max_slots);
	SetObjProperty(sign, "maxnumomegacache", max_slots);

	SendSysMessage(who, "Omega Cache container removed. One cache slot was refunded.", color := 66);
endfunction

