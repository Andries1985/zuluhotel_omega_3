const UOBJECT_DOORS_START := 0x0675;
const UOBJECT_DOORS_END   := 0x06f4;
const KEYSTART := 0x100e;
const KEYEND := 0x1013;
const KEYRING := 0x1011;

function GetPlaqueLines(sign)
	var line1 := " ";
	var line2 := "";
	var signname := GetObjProperty(sign, "signname");
	if(!signname)
		signname := " ";
	endif
	var split := SplitWords(signname);
	var j;
	for(j := 1; j <= 5; j := j + 1)
		if(!split[j])
			split[j] := "";
		endif
	endfor
	if(len(signname) <= 12)
		line1 := signname;
	elseif((len(split[1]) + len(split[2]) + len(split[3]) + 2) <= 12)
		line1 := split[1] + " " + split[2] + " " + split[3];
		line2 := split[4] + " " + split[5];
	elseif(len(split[1]) + len(split[2]) + 1 <= 12)
		line1 := split[1] + " " + split[2];
		line2 := split[3] + " " + split[4] + " " + split[5];
	elseif(len(split[1]) <= 12)
		line1 := split[1];
		line2 := split[2] + " " + split[3] + " " + split[4] + " " + split[5];
	endif
	return array(line1, line2);
endfunction

function GetHouseDecayDisplay(sign)
	var decaytime := GetObjProperty(sign, "decay");
	if(!decaytime || decaytime.errortext)
		return "Unknown";
	endif
	var remaining := CInt(decaytime) - ReadGameClock();
	if(remaining <= 0)
		return "0mo 0d 0h 0m";
	endif

	var months := 0;
	while(remaining >= 2592000)
		months := months + 1;
		remaining := remaining - 2592000;
	endwhile

	var days := 0;
	while(remaining >= 86400)
		days := days + 1;
		remaining := remaining - 86400;
	endwhile

	var hours := 0;
	while(remaining >= 3600)
		hours := hours + 1;
		remaining := remaining - 3600;
	endwhile

	var mins := 0;
	while(remaining >= 60)
		mins := mins + 1;
		remaining := remaining - 60;
	endwhile

	return CStr(months) + "mo " + CStr(days) + "d " + CStr(hours) + "h " + CStr(mins) + "m";
endfunction

function GetGuildHouseName(house)
	if(!house)
		return "";
	endif

	var guild_house_id := GetObjProperty(house, "GuildHouse");
	if(!guild_house_id || guild_house_id.errortext)
		return "";
	endif

	foreach guild in ListGuilds()
		if(CInt(guild.guildid) == CInt(guild_house_id) && CInt(guild.getprop("GuildHouse")) == CInt(house.serial))
			var guild_name := guild.getprop("GuildName");
			if(guild_name && !guild_name.errortext)
				return guild_name;
			endif
			return "Unknown Guild";
		endif
	endforeach

	return "";
endfunction

function ShowHouseSignGump(who, sign, owner_name, house_type, decay_display, lockdowns, secures, guild_house_name, declare_text, can_manage)
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 45, 2600, 412, 300);
	GFGumpPic(240, 0, 100);
	var plaque := GetPlaqueLines(sign);
	GFTextLine(270, 30, 48, plaque[1]);
	GFTextLine(270, 50, 48, plaque[2]);
	GFResizePic(115, 100, 5100, 382, 25);
	GFTextLine(125, 102, 0, "Info");
	GFButtonPage(178, 104, 5209, 5003, 1);
	GFTextLine(215, 102, 0, "House Lists");
	GFButtonPage(293, 104, 5209, 5003, 2);
	GFTextLine(330, 102, 0, "Options");
	GFButtonPage(390, 104, 5209, 5003, 3);
	GFButtonID(430, 308, 247, 248, 1, 0);

	GFPage(1);
	GFTextLine(135, 140, 2302, "Owned by:");
	GFTextLine(220, 140, 0, owner_name);
	GFTextLine(135, 165, 2302, "House Type:");
	GFTextLine(220, 165, 0, house_type);
	GFTextLine(135, 190, 2302, "House Decays At:");
	GFTextLine(250, 190, 0, decay_display);
	GFTextLine(135, 215, 2302, "Number of locked down items:");
	GFTextLine(350, 215, 0, CStr(lockdowns));
	GFTextLine(135, 240, 2302, "Number of secure containers:");
	GFTextLine(350, 240, 0, CStr(secures));
	if(guild_house_name)
		GFTextLine(135, 265, 2302, "Guild House:");
		GFTextLine(220, 265, 0, guild_house_name);
	endif
	if(!can_manage)
		return GFSendGump(who);
	endif

	GFButtonID(125, 308, 2714, 2715, 1, 1);
	GFTextLine(155, 308, 2302, "Change the house name!");

	GFPage(2);
	GFTextLine(155, 140, 2302, "Manage house friends");
	GFButtonID(125, 140, 2714, 2715, 1, 8);
	GFTextLine(155, 165, 2302, "List of banned people");
	GFButtonID(125, 165, 2714, 2715, 1, 11);
	GFTextLine(155, 190, 2302, "Ban someone from the house");
	GFButtonID(125, 190, 2714, 2715, 1, 9);
	GFTextLine(155, 215, 2302, "Remove a ban");
	GFButtonID(125, 215, 2714, 2715, 1, 12);
	GFTextLine(155, 240, 2302, "Eject someone from the house");
	GFButtonID(125, 240, 2714, 2715, 1, 10);

	GFPage(3);
	GFTextLine(155, 140, 2302, "House management");
	GFButtonID(125, 140, 2714, 2715, 1, 15);
	GFTextLine(155, 165, 2302, "Transfer ownership of the house");
	GFButtonID(125, 165, 2714, 2715, 1, 13);
	GFTextLine(155, 190, 2302, "Demolish the house & get a deed back");
	GFButtonID(125, 190, 2714, 2715, 1, 14);
	GFTextLine(155, 215, 2302, "Change the master key");
	GFButtonID(125, 215, 2714, 2715, 1, 16);
	// 2026-08-10: Public/Private declaration button hidden (not just
	// non-functional -- see the case(result[0]) 19 handler below, which was
	// already commented out but still reachable through this visible button).
	// Kept in place, not deleted, in case it's wanted back later.
	// GFTextLine(155, 240, 2302, declare_text);
	// GFButtonID(125, 240, 2714, 2715, 1, 19);

	return GFSendGump(who);
endfunction

function ShowPagedNameSelectionGump(who, title, action_label, names, action_x := 165, action_y := 335)
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 2600, 400, 300);
	GFResizePic(147, 359, 5100, 310, 25);
	GFTextLine(185, 118, 995, title);
	GFButtonID(270, 360, 247, 248, 1, 1);
	GFTextLine(action_x, action_y, 995, action_label);

	if(names.size() > 10)
		GFButtonPage(425, 363, 5224, 5224, 2);
	endif

	GFPage(1);
	var i := 1;
	for(i := 1; i <= 10; i := i + 1)
		if(names[i])
			var y := 120 + (i * 20);
			GFTextLine(180, y, 0, names[i]);
			GFButtonID(150, y, 210, 211, 1, i + 2);
		endif
	endfor

	GFPage(2);
	for(i := 11; i <= 20; i := i + 1)
		if(names[i])
			var y2 := 120 + ((i - 10) * 20);
			GFTextLine(180, y2, 0, names[i]);
			GFButtonID(150, y2, 210, 211, 1, i + 2);
		endif
	endfor
	GFButtonPage(160, 363, 5223, 5223, 1);

	return GFSendGump(who);
endfunction

