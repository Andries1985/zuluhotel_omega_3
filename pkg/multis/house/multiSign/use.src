function HandleHouseManagementAction(sign, house, who, action)
	if(!house)
		SendSysMessage(who, "Cannot locate this house.", color := 33);
		return;
	endif
	case(action)
		220:
			if(!sign.HasHousePermission(who, "lockdown"))
				SendSysMessage(who, "You do not have lockdown permission.", color := 33);
				return;
			endif
			HandleLockdownRelease(sign, house, who, 1);
		221:
			if(!sign.HasHousePermission(who, "lockdown"))
				SendSysMessage(who, "You do not have lockdown permission.", color := 33);
				return;
			endif
			HandleLockdownRelease(sign, house, who, 2);
		222:
			if(!sign.HasHousePermission(who, "secure"))
				SendSysMessage(who, "You do not have secure permission.", color := 33);
				return;
			endif
			SecureContainerFromMenu(sign, house, who);
		223:
			if(!sign.HasHousePermission(who, "secure"))
				SendSysMessage(who, "You do not have secure permission.", color := 33);
				return;
			endif
			UnsecureContainerFromMenu(sign, house, who);
		224:
			if(!sign.HasHousePermission(who, "eject"))
				SendSysMessage(who, "You do not have eject permission.", color := 33);
				return;
			endif
			Eject(sign, who);
		225:
			if(!sign.HasHousePermission(who, "ban"))
				SendSysMessage(who, "You do not have ban permission.", color := 33);
				return;
			endif
			AddBan(sign, who);
		226:
			if(!sign.IsFullHouseManager(who))
				SendSysMessage(who, "Only owners and co-owners can place a trash barrel.", color := 33);
				return;
			endif
			PlaceTrashBarrelFromMenu(house, who);
		227:
			if(!sign.IsFullHouseManager(who))
				SendSysMessage(who, "Only owners and co-owners can change locks.", color := 33);
				return;
			endif
			ChangeLocks(who, house);
		228:
			if(!sign.HasHousePermission(who, "teleporter"))
				SendSysMessage(who, "You do not have teleporter permission.", color := 33);
				return;
			endif
			OpenTeleporterManagementGump(sign, house, who);
	endcase
	OpenHouseManagementGump(sign, who);
endfunction

function HandleLockdownRelease(sign, house, who, mode)
	var itemt := Target(who, TGTOPT_NOCHECK_LOS);
	if(!itemt)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	var DeedObjType := GetObjProperty(itemt, "DeedObjType");
	var DeedColor := GetObjProperty(itemt, "DeedColor");
	var OtherItems := GetObjProperty(itemt, "OtherItems");
	var lists := GetObjProperty(sign, "footage");
	var itemlist := {};
	var holder;
	foreach thing in lists
		holder := ListObjectsInBox(thing[1], thing[2], thing[3], thing[4], thing[5], thing[6], house.realm);
		foreach it in holder
			itemlist.append(it);
		endforeach
	endforeach
	if(!(itemt in itemlist))
		SendSysMessageCL(who, 1005525, color := 33);
		return;
	endif
	case(mode)
		1:
			if(GetObjProperty(sign, "RemainingLockdowns") <= 0)
				SendSysMessageCL(who, 1005379, color := 33);
				return;
			endif
			if(itemt.movable == 1)
				itemt.movable := 0;
				SetObjProperty(itemt, "lockeddown", 1);
				SetObjProperty(itemt, "houseserial", house.serial);
				SetObjProperty(sign, "RemainingLockdowns", GetObjProperty(sign, "RemainingLockdowns") - 1);
				SendSysMessageCL(who, 501721, color := 66);
			elseif((itemt.movable == 0) && (GetObjProperty(itemt, "lockeddown") == 1))
				SendSysMessageCL(who, 501719, color := 33);
			elseif((itemt.movable == 0) && (GetObjProperty(itemt, "secure") == 1))
				SendSysMessageCL(who, 501714, color := 33);
			else
				SendSysMessageCL(who, 1010414, color := 33);
			endif
		2:
			if(GetObjProperty(itemt, "lockeddown") && (itemt.movable == 0))
				if(DeedObjType)
					var deed := CreateItemInBackpack(who, CInt(DeedObjType));
					if(!deed)
						SendSysMessageCL(who, 1045150, {}, 3, 33);
						return;
					endif
					deed.color := CInt(DeedColor);
					foreach part in OtherItems
						var partitem := SystemFindObjectBySerial(part);
						if(partitem)
							DestroyItem(partitem);
						endif
					endforeach
					sign.AddLockdown();
					return;
				endif
				if(GetObjProperty(itemt, "secure") == 1)
					EraseObjProperty(itemt, "secure");
					var oldscript := GetObjProperty(itemt, "oldscript");
					if(oldscript == error)
						oldscript := "";
					endif
					itemt.usescript := oldscript;
					SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") + 1);
					EraseObjProperty(itemt, "oldscript");
					EraseObjProperty(itemt, "boxserial");
				endif
				EraseObjProperty(itemt, "signserial");
				itemt.movable := 1;
				EraseObjProperty(itemt, "lockeddown");
				SetObjProperty(sign, "RemainingLockdowns", GetObjProperty(sign, "RemainingLockdowns") + 1);
				SendSysMessage(who, "Released.", color := 66);
			elseif((itemt.movable == 0) && (GetObjProperty(itemt, "secure") == 1))
				EraseObjProperty(itemt, "secure");
				var oldscript2 := GetObjProperty(itemt, "oldscript");
				if(oldscript2 == error)
					oldscript2 := "";
				endif
				itemt.usescript := oldscript2;
				SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") + 1);
				EraseObjProperty(itemt, "signserial");
				EraseObjProperty(itemt, "oldscript");
				itemt.movable := 1;
				SendSysMessageCL(who, 501657, color := 66);
			elseif(itemt.movable == 1)
				SendSysMessageCL(who, 1042271, color := 33);
			else
				SendSysMessage(who, "You cannot release that.", color := 33);
			endif
	endcase
endfunction

function SecureContainerFromMenu(sign, house, who)
	SendSysMessageCL(who, 502103, color := 88);
	var itemt := Target(who);
	if(!itemt)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(!sign.IsObjectInsideHouse(itemt))
		SendSysMessage(who, "You can only secure containers inside your house.", color := 33);
		return;
	endif
	if(GetObjProperty(itemt, "secure"))
		SendSysMessageCL(who, 501714, color := 33);
		return;
	elseif(!itemt.isa(POLCLASS_CONTAINER))
		SendSysMessageCL(who, 501682, color := 33);
		return;
	endif
	if(!GetObjProperty(sign, "RemainingSecures"))
		SendSysMessageCL(who, 1061839, color := 33);
		return;
	endif
	if(itemt.movable == 0)
		if(GetObjProperty(itemt, "lockeddown") == 1)
			SetObjProperty(sign, "RemainingLockdowns", GetObjProperty(sign, "RemainingLockdowns") + 1);
			EraseObjProperty(itemt, "lockeddown");
		else
			SendSysMessage(who, "You cannot secure that.", color := 33);
			return;
		endif
	endif
	itemt.movable := 0;
	SetObjProperty(itemt, "boxserial", itemt.serial);
	SetObjProperty(itemt, "houseserial", house.serial);
	SetObjProperty(itemt, "secure", 1);
	SetObjProperty(itemt, "oldscript", itemt.script);
	itemt.usescript := ":house:secureCont";
	SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") - 1);
	SendSysMessageCL(who, 1010563, color := 66);
endfunction

function UnsecureContainerFromMenu(sign, house, who)
	SendSysMessage(who, "Choose the secure container you wish to delete.", color := 88);
	var itemt := Target(who);
	if(!itemt)
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif
	if(GetObjProperty(itemt, "secure") != 1)
		SendSysMessage(who, "You can only delete a secure container.", color := 33);
		return;
	endif
	if(GetObjProperty(itemt, "houseserial") != house.serial)
		SendSysMessageCL(who, 1005525, color := 33);
		return;
	endif
	if(!confirmationSizable(who, "Are you sure you want to delete this secure container? All items inside will be deleted."))
		SendSysMessageCL(who, 1042023, color := 33);
		return;
	endif

	EraseObjProperty(itemt, "secure");
	SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") + 1);
	if(!DestroyItem(itemt))
		SetObjProperty(sign, "RemainingSecures", GetObjProperty(sign, "RemainingSecures") - 1);
		SendSysMessage(who, "Could not delete that secure container.", color := 33);
		return;
	endif
	SendSysMessage(who, "Secure container deleted. One secure slot was refunded.", color := 66);
endfunction

function PlaceTrashBarrelFromMenu(house, who)
	var barrelcheck := GetObjProperty(house, "barrelserial");
	if(barrelcheck)
		var exists := SystemFindObjectBySerial(CInt(barrelcheck));
		if(exists)
			SendSysMessage(who, "This house already has a trash barrel.", color := 33);
			return;
		endif
	endif
	var items := ListItemsNearLocation(who.x, who.y, who.z, 1);
	foreach thing in items
		if(thing.objtype == 0x18889)
			SendSysMessage(who, "You cannot place that here.", color := 33);
			return;
		endif
	endforeach
	var barrel := CreateItemAtLocation(who.x, who.y, who.z, 0x17009, 1);
	if(barrel)
		SetObjProperty(house, "barrelserial", barrel.serial);
		SetObjProperty(barrel, "houseserial", house.serial);
		SendSysMessage(who, "Trash barrel placed.", color := 66);
	endif
endfunction

function OpenTeleporterManagementGump(sign, unused house, who)
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 2600, 400, 220);
	GFTextLine(155, 120, 995, "Teleporter Management");
