program Install()

	return 1;
endprogram

///////////////////////////////////////////////////////////
//
// IsHouseSign( sign )
//
// Purpose: Determines if the passed
// object is a valid house sign. It will return
// the object ref for both static and multi
// house signs.
// Parameter: objref:: sign
//
// Returns: 1 if true or 0 if false
//
///////////////////////////////////////////////////////////
exported function IsHouseSign( byref sign )
	if(!sign)
		return 0;
	endif
	if(sign.objtype in {0xBCF, 0xBD0, 0xBD1, 0xBD2, 0x20BD1, 0x20BD2, 0x20BCF, 0x20BD0, 0x260FA, 0xFFF4})
		return 1;
	endif
	return 0;
endfunction

///////////////////////////////////////////////////////////
// function IsStaticHouseSign(sign)
//
// Purpose: Tests whether a sign is a static house sign
// Parameters: loc - an object with the following
// members - x, y, z, realm.
// This is essentially the same code as
// IsLocationInsideHouse(). It is included to prevent
// ambiguity in scripts but either function will
// give the same results.
//
// Returns: 1 if true and 0 if false.
///////////////////////////////////////////////////////////
exported function IsStaticHouseSign( byref sign )
	if(!sign)
		return 0;
	endif
	if(sign.objtype in {CInt(0x20BD1), CInt(0x20BD2), CInt(0x20BCF), CInt(0x20BD0), CInt(0x260FA)})
		return 1;
	endif
	return 0;

endfunction

///////////////////////////////////////////////////////////
// function IsMultiHouseSign(sign)
//
// Purpose: Tests whether a sign is a multi house sign
// Parameters: loc - an object with the following
// members - x, y, z, realm.
// This is essentially the same code as
// IsLocationInsideHouse(). It is included to prevent
// ambiguity in scripts but either function will
// give the same results.
//
// Returns: 1 if true and 0 if false.
///////////////////////////////////////////////////////////
exported function IsMultiHouseSign( byref sign )
	if(!sign)
		return 0;
	endif
	if(sign.objtype in {0xBCF, 0xBD0, 0xBD1, 0xBD2})
		return 1;
	endif
	return 0;

endfunction

///////////////////////////////////////////////////////////
// function IsLocationInsideHouse(sign, byref loc)
//
// Purpose: Tests whether a location is inside a house
// Parameters: byref loc - an object with the following
// members - x, y, z, realm. The loc parameter can be
// a location returned from a TargetCoordinates()
// function call.
//
// Returns: 1 if true and 0 if false.
///////////////////////////////////////////////////////////
exported function IsLocationInsideHouse(sign, byref loc_or_x, y := error, z := error, realm := error)
	// Accepts either a single location-like object (x/y/z/realm members,
	// e.g. from TargetCoordinates()) or explicit x, y, z[, realm] numbers --
	// matches staticHousing's original call convention, which several of
	// its scripts (lockunlock.src, commands/player/decorate.src) rely on.
	var x := 0;
	var yloc := 0;
	var zloc := 0;
	var rlm := sign.realm;

	if(y == error || z == error)
		if(!loc_or_x)
			return 0;
		endif
		x := loc_or_x.x;
		yloc := loc_or_x.y;
		zloc := loc_or_x.z;
		if(loc_or_x.realm)
			rlm := loc_or_x.realm;
		endif
	else
		x := CInt(loc_or_x);
		yloc := CInt(y);
		zloc := CInt(z);
		if(realm != error)
			rlm := realm;
		endif
	endif

	var fotage := GetObjProperty (sign, "footage");
	var chk := 0;
	foreach thing in fotage
		var minz := CInt(thing[3]) - 12;
		if ( (rlm == sign.realm) &&
			(x >= thing[1] && x <= thing[4]) &&
			(yloc >= thing[2] && yloc <= thing[5]) &&
			(zloc >= minz && zloc <= thing[6]) )
			chk := 1;
			break;
		endif
		if(chk)
			break;
		endif
	endforeach
	return chk;
endfunction

///////////////////////////////////////////////////////////
// function IsObjectInsideHouse(sign, byref loc)
//
// Purpose: Tests whether a location is inside a house
// Parameters: byref loc - an object with the following
// members - x, y, z, realm.
// This is essentially the same code as
// IsLocationInsideHouse(). It is included to prevent
// ambiguity in scripts but either function will
// give the same results.
//
// Returns: 1 if true and 0 if false.
///////////////////////////////////////////////////////////
exported function IsObjectInsideHouse(byref sign, byref object)
	var fotage := GetObjProperty (sign, "footage");
	foreach thing in fotage
		var minz := CInt(thing[3]) - 12;
		if ( (object.realm == sign.realm) &&
			(object.x >= thing[1] && object.x <= thing[4]) &&
			(object.y >= thing[2] && object.y <= thing[5]) &&
			(object.z >= minz && object.z <= thing[6]) )
			return 1;
		endif
	endforeach
	return 0;

endfunction

///////////////////////////////////////////////////////////////
// RefreshHouse(sign)
//
// Refreshes the decay timer using the shared Abandoned_Timeout setting
// (:house:settings), the same value get_abandon_time() reads elsewhere.
//
// 2026-08-10: previously read settings.RefreshTime via
// SH_GetSettingsCfgElem(), but :house:settings has no RefreshTime key --
// that lookup silently resolved to an error/0, so this set decay to
// essentially "right now" instead of extending it. Dead in house's own
// package (which refreshes decay inline via get_abandon_time() instead),
// but staticHousing/customhousing call sign.RefreshHouse() directly, so
// fixed here as part of sharing this method script across all three.
//////////////////////////////////////////////////////////////
exported function RefreshHouse(sign)
	SetObjProperty(sign, "decay", ReadGameClock() + get_abandon_time());
	return 1;
endfunction

////////////////////////////////////////////////
// This is only used by the static housing
// system. It is included in both the static
// house sign and the multi house sign method
// scripts because they are essentially
// copies of each other.
///////////////////////////////////////////////
exported function IsNewHouse( sign )

	return GetObjProperty(sign, "NewHouse") == 1;
endfunction

