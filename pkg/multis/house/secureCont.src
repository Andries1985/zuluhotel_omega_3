use os;
use uo;
use cliloc;

program use_securecont(who, item)

  var house := SystemFindObjectBySerial( GetObjProperty( item, "houseserial" ));
  if(!house)
    SendSysMessageCL( who, 500294 ); // You cannot use that.
    return;
  endif
  var sign := SystemFindObjectBySerial(GetObjProperty(house, "signserial"));
  var secure := 0;

  if(sign)
    secure := sign.HasHousePermission(who, "secure");
  elseif ((GetObjProperty( house, "ownerserial" ) == who.serial) || (GetObjProperty( house, "owneracct" ) == who.acctname))
    secure := 1;
  endif
  if(who.cmdlevel >= 3)
    secure := 1;
  endif
  //Print("Secure access: " + secure);
  if(!secure)
    SendSysMessageCL( who, 500294 ); // You cannot use that.
    return;
  else
    SendViewContainer( who, item );
    SendSysMessage( who, "You open the secure container." );
  endif
endprogram