use uo;

include ":multiCommands:multicommands";

program textcmd_DestroyMulti( mobile, serial )

        var multi;
	if( !serial )
		SendSysMessage( mobile, "Target an item in the multi." );
		var targ := Target( mobile, TGTOPT_NOCHECK_LOS );
                if(!targ)
                        SendSysMessage(mobile, "Cancelled.");
                        return 0;
                endif
		if( !targ.multi )
                        var hserial := GetObjProperty(targ, "houseserial");
                        if(hserial)
                                multi := SystemFindObjectBySerial(CInt(hserial));
                        endif
                        if(!multi)
                                SendSysMessage( mobile, "It doesn't have a multi property." );
                                return 0;
                        endif
                else
                        multi := targ.multi;
		endif
        else
                multi := SystemFindObjectBySerial( CInt( serial ));
                if( multi.errortext )
                        SendSysMessage( mobile, "Error finding multi serial "+serial+" -->"+multi.errortext );
                        return 0;
                endif
	endif

        var dest := Multi_DestroyMulti( multi );
        if( dest.errortext )
                SendSysMessage(mobile, "DestroyMulti failed: " + dest.errortext);
                Print("DestroyMulti failed for serial " + multi.serial + " (objtype " + Hex(multi.objtype) + "): " + dest.errortext);
                return 0;
        endif

        SendSysMessage(mobile, "Multi destroyed.");

	return 1;
endprogram
