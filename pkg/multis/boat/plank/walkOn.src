use uo;
use os;
use math;

include "include/facings";

program PlankWalkOn( mobile, plank, unused last_x, unused last_y, unused last_z )

	// When stepping onto an extended plank, try to disembark the mobile to
	// the nearest reachable tile in front of them. Iterate from close to far
	// so we land on the first walkable tile off the boat. We deliberately
	// avoid a strict LOS check from plank-height to land/water below it,
	// since dragon-boat decorations (figurehead, etc.) can block LOS even
	// when the tile is otherwise reachable.
	var coords := GetCoordsInFrontOf( mobile, 5 );
	var i, sh, target_z;
	var orig_multi := plank ? plank.multi : 0;

	for( i := 1; i <= coords.Size(); i += 1 )
		sh := GetStandingHeight( coords[i].x, coords[i].y, mobile.z, mobile.realm );
		if( sh.errortext )
			continue;
		endif
		target_z := sh.z;

		if( MoveObjectToLocation( mobile, coords[i].x, coords[i].y, target_z, mobile.realm, MOVEOBJECT_FORCELOCATION ) )
			// If we ended up still inside the same boat, keep trying further out.
			if( orig_multi && mobile.multi == orig_multi )
				continue;
			endif
			return 1;
		endif
	endfor

	return 1;
endprogram

function GetCoordsInFrontOf( byref mobile, byref dist )

	var x := mobile.x+ConvertDirectionToLocX( mobile.facing ),
		y := mobile.y+ConvertDirectionToLocY( mobile.facing ),
		xmod := 0,
		ymod := 0;

	case( mobile.facing )
		0: xmod := 0;  ymod := -dist; break;
		1: xmod := +dist; ymod := -dist; break;
		2: xmod := +dist; ymod := 0;  break;
		3: xmod := +dist; ymod := +dist; break;
		4: xmod := 0;  ymod := +dist; break;
		5: xmod := -dist; ymod := +dist; break;
		6: xmod := -dist; ymod := 0;  break;
		7: xmod := -dist; ymod := -dist; break;
		default:
			return error{"errortext":="Invalid facing."};
			break;
	endcase

	return GetCoordsInLine( x, y, x+xmod, y+ymod );
endfunction
