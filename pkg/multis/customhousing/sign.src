///////////////////
//  builds and shows the house sign gump -- rewritten 2026-08-11 onto the
//  same mdgumps (GFxxx) layout used by house/multiSign/use.src and
//  staticHousing/sign/use.src (background 40288, plaque pic 1764, Info /
//  House Lists / Options tabs), replacing the old raw SendDialogGump layout
//  so all three housing packages share one visual language.
///////////////////

function GetPlaqueLines (sign)
	var signname := GetObjProperty (sign, "signname");
	if (!signname or signname.errortext)
		signname := GetObjProperty (sign, "housename");
	endif
	if (!signname or signname.errortext)
		signname := sign.desc;
	endif
	if (!signname or signname.errortext)
		signname := " ";
	endif
	return signname;
endfunction

function GetHouseDecayDisplay (sign)
	var decaytime := GetObjProperty (sign, "decay");
	if (!decaytime or decaytime.errortext)
		return "Unknown";
	endif
	var remaining := CInt (decaytime) - ReadGameClock();
	if (remaining <= 0)
		return "0mo 0d 0h 0m";
	endif

	var months := 0;
	while (remaining >= 2592000)
		months := months + 1;
		remaining := remaining - 2592000;
	endwhile

	var days := 0;
	while (remaining >= 86400)
		days := days + 1;
		remaining := remaining - 86400;
	endwhile

	var hours := 0;
	while (remaining >= 3600)
		hours := hours + 1;
		remaining := remaining - 3600;
	endwhile

	var mins := 0;
	while (remaining >= 60)
		mins := mins + 1;
		remaining := remaining - 60;
	endwhile

	return CStr(months) + "mo " + CStr(days) + "d " + CStr(hours) + "h " + CStr(mins) + "m";
endfunction

// "numomegacache" on the sign tracks *remaining* slots (see
// pkg/opt/omegacache), so the used count shown to players is max-remaining.
function GetOmegaCacheCountDisplay (sign)
	var maxslots := CInt (GetObjProperty (sign, "maxnumomegacache"));
	var remaining := CInt (GetObjProperty (sign, "numomegacache"));
	var used := maxslots - remaining;
	if (used < 0)
		used := 0;
	endif
	return CStr(used) + " / " + CStr(maxslots);
endfunction

// "numhteles" on the sign tracks the number of house teleporter pairs
// already placed (pkg/items/houseExtras/hteleporter); the cap is the
// package-wide houseExtras setting, not tracked per-sign.
function GetTeleporterCountDisplay (sign)
	var used := CInt (GetObjProperty (sign, "numhteles"));
	var htsettings := HE_GetSettingsCfgElem ("settings");
	if (htsettings.LimitHouseTeleporters)
		return CStr(used) + " / " + CStr(CInt(htsettings.MaxHouseTeleporters));
	endif
	return CStr(used);
endfunction

function ShowHouseSignGump (character, sign, owner_name, house_type, decay_display, lockdowns, secures, can_manage)
	GFInitGump();
	GFNoDispose();
	// Plaque (gump art 1764, 205x49) sits above the panel and is centered on
	// its 412-wide span (100..512, centre 306); GFTextMid centers each line
	// within the plaque's own width instead of a hand-tuned x offset.
	GFResizePic(100, 45, 40288, 412, 300);
	GFGumpPic(204, 0, 1764);
	GFTextMid(215, 17, 205, 50, GetPlaqueLines(sign));
	GFResizePic(115, 55, 5100, 382, 25);
	GFTextLine(125, 57, 0, "Info");
	GFButtonPage(178, 59, 5209, 5003, 1);
	GFTextLine(215, 57, 0, "House Lists");
	GFButtonPage(293, 59, 5209, 5003, 2);
	GFTextLine(330, 57, 0, "Options");
	GFButtonPage(390, 59, 5209, 5003, 3);
	GFButtonID(430, 308, 247, 248, 1, 0);

	GFPage(1);
	GFTextLine(135, 95, 2020, "Owned by:");
	GFTextLine(220, 95, 2590, owner_name);
	GFTextLine(135, 118, 2020, "House Type:");
	GFTextLine(220, 118, 2590, house_type);
	GFTextLine(135, 141, 2020, "House Decays At:");
	GFTextLine(250, 141, 2590, decay_display);
	GFTextLine(135, 164, 2020, "Number of locked down items:");
	GFTextLine(370, 164, 2590, CStr(lockdowns));
	GFTextLine(135, 187, 2020, "Number of secure containers:");
	GFTextLine(370, 187, 2590, CStr(secures));
	GFTextLine(135, 210, 2020, "Number of Omega Cache containers:");
	GFTextLine(370, 210, 2590, GetOmegaCacheCountDisplay(sign));
	GFTextLine(135, 233, 2020, "Number of Teleporters:");
	GFTextLine(370, 233, 2590, GetTeleporterCountDisplay(sign));
	if (!can_manage)
		return GFSendGump (character);
	endif

	GFButtonID(125, 308, 2714, 2715, 1, 1);
	GFTextLine(155, 308, 2302, "Change the house name!");

	GFPage(2);
	GFTextLine(155, 95, 2302, "Manage house friends");
	GFButtonID(125, 95, 2714, 2715, 1, 8);
	GFTextLine(155, 118, 2302, "List of banned people");
	GFButtonID(125, 118, 2714, 2715, 1, 11);
	GFTextLine(155, 141, 2302, "Ban someone from the house");
	GFButtonID(125, 141, 2714, 2715, 1, 9);
	GFTextLine(155, 164, 2302, "Remove a ban");
	GFButtonID(125, 164, 2714, 2715, 1, 12);
	GFTextLine(155, 187, 2302, "Eject someone from the house");
	GFButtonID(125, 187, 2714, 2715, 1, 10);

	GFPage(3);
	GFTextLine(155, 95, 2302, "Change the locks");
	GFButtonID(125, 95, 2714, 2715, 1, 16);
	GFTextLine(155, 118, 2302, "Transfer ownership of the house");
	GFButtonID(125, 118, 2714, 2715, 1, 13);
	GFTextLine(155, 141, 2302, "Customize this house");
	GFButtonID(125, 141, 2714, 2715, 1, 20);
	GFTextLine(155, 164, 2302, "Remove Omega Cache Container");
	GFButtonID(125, 164, 2714, 2715, 1, 21);
	GFTextLine(155, 187, 2302, "Demolish the house & get a deed back");
	GFButtonID(125, 187, 2714, 2715, 1, 14);

	return GFSendGump (character);
endfunction

function ShowPagedNameSelectionGump (who, title, action_label, names, action_x := 165, action_y := 335)
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 40288, 400, 300);
	GFResizePic(147, 359, 5100, 310, 25);
	GFTextLine(185, 118, 995, title);
	GFButtonID(270, 360, 247, 248, 1, 1);
	GFTextLine(action_x, action_y, 995, action_label);

	if (names.size() > 10)
		GFButtonPage(425, 363, 5224, 5224, 2);
	endif

	GFPage(1);
	var i := 1;
	for (i := 1; i <= 10; i := i + 1)
		if (names[i])
			var y := 120 + (i * 20);
			GFTextLine(180, y, 0, names[i]);
			GFButtonID(150, y, 210, 211, 1, i + 2);
		endif
	endfor

	GFPage(2);
	for (i := 11; i <= 20; i := i + 1)
		if (names[i])
			var y2 := 120 + ((i - 10) * 20);
			GFTextLine(180, y2, 0, names[i]);
			GFButtonID(150, y2, 210, 211, 1, i + 2);
		endif
	endfor
	GFButtonPage(160, 363, 5223, 5223, 1);

	return GFSendGump (who);
endfunction

function ShowPagedNameListGump (who, title, names)
	GFInitGump();
	GFNoDispose();
	GFResizePic(100, 100, 40288, 400, 300);
	GFResizePic(147, 359, 5100, 310, 25);
	GFTextLine(185, 118, 995, title);
	GFButtonID(270, 360, 247, 248, 1, 1);

	if (names.size() > 10)
		GFButtonPage(425, 363, 5224, 5224, 2);
	endif

	GFPage(1);
	var i := 1;
	for (i := 1; i <= 10; i := i + 1)
		if (names[i])
			var y := 120 + (i * 20);
			GFTextLine(180, y, 0, names[i]);
		endif
	endfor

	GFPage(2);
	for (i := 11; i <= 20; i := i + 1)
		if (names[i])
			var y2 := 120 + ((i - 10) * 20);
			GFTextLine(180, y2, 0, names[i]);
		endif
	endfor
	GFButtonPage(160, 363, 5223, 5223, 1);

	return GFSendGump (who);
endfunction




///////////////////
//  friend/co-owner/ban management -- ported from house's
//  multiSign/use.src (NewFriendsControl/AddBan/DeleteBan/ListBan/Eject),
//  which operate purely on the shared :house: sign core (GetFriendList/
//  AddFriend/RemoveFriend/GetCoOwnerList/AddCoOwner/RemoveCoOwner/
//  GetBanList/AddBan/RemoveBan/GetFriendPermissionProfile/
//  SetFriendPermission) that customhousing signs already use as their
//  MethodScript, so this is a straight visual/UX unification, not a new
//  permission model.
///////////////////

function checklists (hsign, who, list1, list2)
	var junk := 0;
	var lista := GetObjProperty (hsign, list1);
	var listb := GetObjProperty (hsign, list2);
	junk := who.serial in lista;
	if (junk)
		lista.erase (junk);
	endif
	junk := who.serial in listb;
	if (junk)
		listb.erase (junk);
	endif
	SetObjProperty (hsign, list1, lista);
	SetObjProperty (hsign, list2, listb);
endfunction

function AddFriend (hsign, who)
	SendSysMessage (who, "Target the person you wish to name a friend of your household.");
	var targetchr := Target (who);
	if (!targetchr)
		SendSysMessage (who, "Canceled.");
		return;
	endif
	if (!targetchr.isA (POLCLASS_MOBILE))
		SendSysMessage (who, "That cannot be added to the list.", color := 33);
		return;
	endif
	var result := hsign.AddFriend (targetchr);
	if (!result)
		SendSysMessage (who, "That person is already a friend.", color := 33);
		return;
	elseif (result < 0)
		SendSysMessage (who, "Your friend list is full.", color := 33);
		return;
	elseif (targetchr.acctname == GetObjProperty (hsign, "owneracct"))
		SendSysMessage (who, "Canceled.", color := 33);
		return;
	endif
	SendSysMessage (who, targetchr.name + " was friended to your house", color := 66);
	SendSysMessage (targetchr, "You have been made a friend of this house.", color := 88);
endfunction

function AddBan (hsign, who)
	SendSysMessage (who, "Select the victim.", color := 88);
	var targetchr := Target (who);
	if (!targetchr)
		SendSysMessage (who, "Canceled.", color := 33);
		return;
	endif
	if (!targetchr.isA (POLCLASS_MOBILE))
		SendSysMessage (who, "That cannot be added to the list.", color := 33);
		return;
	endif
	var result := hsign.IsBanned (targetchr);
	if (result)
		SendSysMessage (who, "This person is already banned!", color := 42);
		return;
	endif
	if (targetchr.multi.serial == GetObjProperty (hsign, "house_serial"))
		MoveObjectToLocation (targetchr, hsign.x, hsign.y, hsign.z, hsign.realm);
	endif
	if (targetchr.serial == GetObjProperty (hsign, "ownerserial"))
		SendSysMessage (who, "You cannot ban yourself!", color := 33);
		return;
	endif
	checklists (hsign, targetchr, "friendlist", "coowners");
	result := hsign.AddBan (targetchr);
	if (result < 0)
		SendSysMessage (who, "The ban limit for this house has been reached!", color := 33);
		return;
	endif
	SendSysMessage (who, targetchr.name + " has been banned from this house.", color := 66);
	SendSysMessage (targetchr, "You have been banned from this house.", color := 33);
endfunction

function DeleteBan (hsign, who)
	var z := 0;
	var fillname;
	var retval1 := 0;
	var names := {};
	var banlist := hsign.GetBanList();
	var newlist := {};
	foreach thing in banlist
		fillname := SystemFindObjectBySerial (thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if (fillname)
			newlist.append (thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetBanList (newlist);
	retval1 := ShowPagedNameSelectionGump (who, "Lift a Ban", "Remove", names, 170, 340);
	var bancheck, returncheck;
	if (retval1[0] > 2 and retval1[0] <= 22)
		returncheck := retval1[0] - 2;
		bancheck := newlist[returncheck];
		var unbanned := SystemFindObjectBySerial (bancheck);
		var result := hsign.RemoveBan (unbanned);
		if (result > 0)
			SendSysMessage (who, "The banned person has been removed from the banned list.", color := 66);
		elseif (!result)
			SendSysMessage (who, "The ban list is empty.", color := 33);
		elseif (result == -1)
			SendSysMessage (who, "There is no person in that slot.", color := 33);
		endif
	endif
endfunction

function ListBan (hsign, who)
	var z := 0;
	var fillname;
	var names := {};
	var banlist := hsign.GetBanList();
	if (!banlist)
		banlist := {};
	endif
	var newlist := {};
	foreach thing in banlist
		fillname := SystemFindObjectBySerial (thing, SYSFIND_SEARCH_OFFLINE_MOBILES);
		if (fillname)
			newlist.append (thing);
			names[z+1] := fillname.name;
			z := z + 1;
		endif
	endforeach
	hsign.SetBanList (newlist);
	var retval := ShowPagedNameListGump (who, "Enemies of the house", names);
	return retval;
endfunction

function Eject (hsign, who)
	SendSysMessage (who, "Select the victim.", color := 88);
	var targetchr := Target (who);
	if (!targetchr)
		SendSysMessage (who, "Canceled.", color := 33);
		return;
	endif
	if ((!targetchr.multi) and (Distance (who, hsign) > 15))
		return;
	endif
	MoveObjectToLocation (targetchr, hsign.x, hsign.y, hsign.z, hsign.realm, MOVEOBJECT_FORCELOCATION);
	SendSysMessage (who, targetchr.name + " was ejected!");
endfunction

function BuildHouseFriendRows (sign)
	var rows := {};
	var seen := {};
	var allserials := {};
	foreach serial in (sign.GetFriendList())
		allserials.append (serial);
	endforeach
	foreach serial in (sign.GetCoOwnerList())
		if (!(serial in allserials))
			allserials.append (serial);
		endif
	endforeach
	foreach serial in allserials
		if (serial in seen)
			continue;
		endif
		seen.append (serial);
		var mob := SystemFindObjectBySerial (serial);
		if (!mob)
			mob := SystemFindObjectBySerial (serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if (!mob)
			continue;
		endif
		var p := sign.GetFriendPermissionProfile (mob);
		var secure := p[3];
		var tele := p[6];
		rows.append (array (serial, secure, secure, secure, tele, tele, tele, p[1]));
	endforeach
	return rows;
endfunction

function SaveHouseFriendData (sign, byref keys, byref rows)
	var i := 1;
	foreach person in rows
		var serial := person[1];
		var mob := SystemFindObjectBySerial (serial);
		if (!mob)
			mob := SystemFindObjectBySerial (serial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if (!mob)
			i := i + 1;
			continue;
		endif
		var base := i * 100;
		var coowner := ((base + 8) in keys);
		var secure := ((base + 2) in keys) or ((base + 3) in keys) or ((base + 4) in keys);
		var tele := ((base + 5) in keys) or ((base + 6) in keys) or ((base + 7) in keys);
		if (coowner)
			if (!sign.IsAFriend (mob))
				sign.AddFriend (mob);
			endif
			if (!sign.IsACoOwner (mob))
				sign.AddCoOwner (mob);
			endif
			sign.SetFriendPermission (mob, "lockdown", 1);
			sign.SetFriendPermission (mob, "secure", 1);
			sign.SetFriendPermission (mob, "eject", 1);
			sign.SetFriendPermission (mob, "ban", 1);
			sign.SetFriendPermission (mob, "teleporter", 1);
		else
			if (sign.IsACoOwner (mob))
				sign.RemoveCoOwner (mob);
			endif
			sign.SetFriendPermission (mob, "secure", secure);
			sign.SetFriendPermission (mob, "teleporter", tele);
		endif
		i := i + 1;
	endforeach
endfunction

function NewFriendsControl (who, sign, pagenum := 0)
	if (!sign.IsFullHouseManager (who))
		SendSysMessage (who, "You do not have permission to manage house friends.", color := 33);
		return 0;
	endif
	var rows := BuildHouseFriendRows (sign);
	var start := (pagenum * 11) + 1;
	var shown := {};
	var stop := start + 10;
	var i := 0;
	for (i := start; i <= stop; i := i + 1)
		if (rows[i])
			shown.append (rows[i]);
		endif
	endfor

	GFInitGump();
	GFNoClose();
	GFNoDispose();
	GFResizePic(10, 10, 40288, 750, 530);
	GFResizePic(60, 25, 5100, 650, 25);
	GFTextLine(272, 28, 60, "MANAGE HOUSE FRIENDS");
	GFResizePic(40, 80, 2620, 690, 410);
	GFTextLine(60, 110, 2302, "Friend Name");
	GFTextLine(293, 90, 2302, "Secures");
	GFTextLine(250, 110, 2302, "View |");
	GFTextLine(303, 110, 2302, "Add |");
	GFTextLine(342, 110, 2302, "Remove |");
	GFTextLine(460, 90, 2302, "Recall/Gate");
	GFTextLine(406, 110, 2302, "Recall |");
	GFTextLine(464, 110, 2302, "Gate To |");
	GFTextLine(538, 110, 2302, "Gate From");
	GFTextLine(650, 110, 2302, "Co-owner");
	GFButtonID(220, 500, 2714, 2715, 1, 100000);
	GFTextLine(250, 498, 60, "Remove Friend");
	GFButtonID(60, 500, 2714, 2715, 1, 200000);
	GFTextLine(90, 498, 60, "Add Friend");
	GFButtonID(650, 497, 0x850, 0x851, 1, 300000);

	if (pagenum > 0)
		GFTextLine(367, 60, 99, "Page - " + CStr(pagenum + 1));
		GFButtonID(730, 80, 2704, 2705, 1, 500000);
	elseif (rows.size() > 11)
		GFTextLine(367, 60, 99, "Page - 1");
	endif

	GFPage(1);
	var y := 145;
	var idx := 1;
	foreach person in shown
		var mob := SystemFindObjectBySerial (person[1]);
		if (!mob)
			mob := SystemFindObjectBySerial (person[1], SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if (!mob)
			continue;
		endif
		var namecolour := 44;
		if (person[8])
			namecolour := 53;
		endif
		var ch := idx * 100;
		GFRadioButton(47, y, 210, 211, 0, idx);
		GFTextCrop(70, y, 180, 20, namecolour, mob.name);
		GFCheckBox(667, y, 210, 211, person[8], ch + 8);
		if (!person[8])
			GFCheckBox(257, y, 210, 211, person[2], ch + 2);
			GFCheckBox(302, y, 210, 211, person[3], ch + 3);
			GFCheckBox(347, y, 210, 211, person[4], ch + 4);
			GFCheckBox(416, y, 210, 211, person[5], ch + 5);
			GFCheckBox(486, y, 210, 211, person[6], ch + 6);
			GFCheckBox(556, y, 210, 211, person[7], ch + 7);
		else
			GFTextLine(260, y, 2302, "Co-owners have the same authority as owners.");
		endif
		y := y + 30;
		idx := idx + 1;
	endforeach

	if ((start + 11) <= rows.size())
		GFButtonID(730, 471, 2706, 2707, 1, 400000);
	endif

	var res := GFSendGump (who);
	case (res[0])
		100000:
			SaveHouseFriendData (sign, res.keys, shown);
			var selected := 0;
			var i2 := 0;
			for (i2 := 1; i2 <= shown.size(); i2 := i2 + 1)
				if (i2 in res.keys)
					selected := i2;
					break;
				endif
			endfor
			if (!selected)
				SendSysMessage (who, "Select a friend first.", color := 33);
			else
				var rmob := SystemFindObjectBySerial (shown[selected][1]);
				if (!rmob)
					rmob := SystemFindObjectBySerial (shown[selected][1], SYSFIND_SEARCH_OFFLINE_MOBILES);
				endif
				if (rmob)
					sign.RemoveCoOwner (rmob);
					sign.RemoveFriend (rmob);
					SendSysMessage (who, rmob.name + " removed from house friends.", color := 66);
				endif
			endif
			return NewFriendsControl (who, sign, pagenum);
		200000:
			SaveHouseFriendData (sign, res.keys, shown);
			AddFriend (sign, who);
			return NewFriendsControl (who, sign, pagenum);
		300000:
			SaveHouseFriendData (sign, res.keys, shown);
			SendSysMessage (who, "Permissions updated.", color := 66);
			return 1;
		400000:
			SaveHouseFriendData (sign, res.keys, shown);
			return NewFriendsControl (who, sign, pagenum + 1);
		500000:
			SaveHouseFriendData (sign, res.keys, shown);
			if (pagenum > 0)
				return NewFriendsControl (who, sign, pagenum - 1);
			endif
			return NewFriendsControl (who, sign, 0);
	endcase
	return 0;
endfunction




// 2026-08-10: Omega Cache removal for customhousing, mirroring house's
// HouseFunctionRemoveOmegaCache (pkg/multis/house/multiSign/use.src) and
// staticHousing's StaticHouseFunctionRemoveOmegaCache.
function CustomHouseFunctionRemoveOmegaCache (sign, house, character)
	if (!sign.IsFullHouseManager (character))
		SendSysMessage (character, "Only owners and co-owners can remove Omega Cache containers.", color := 33);
		return;
	endif

	SendSysMessage (character, "Choose the Omega Cache container you wish to remove.");
	var cache := Target (character, TGTOPT_NOCHECK_LOS);
	if (!cache)
		SendSysMessage (character, "Canceled.");
		return;
	endif

	if (CInt (cache.objtype) != OMEGACACHE_OBJTYPE)
		SendSysMessage (character, "That is not an Omega Cache container.", color := 33);
		return;
	endif

	var homeinfo := GetObjProperty (sign, "homeinfo");
	if (!homeinfo or cache.x < homeinfo[2] or cache.x > homeinfo[4] or cache.y < homeinfo[3] or cache.y > homeinfo[5] or cache.realm != sign.realm)
		SendSysMessage (character, "That is not in your house.", color := 33);
		return;
	endif

	if (!IsOmegaCacheEmpty (CInt (GetObjProperty (cache, "houseserial"))))
		SendSysMessage (character, "This house Omega Cache still contains stored items. Withdraw them first.", color := 33);
		return;
	endif

	if (!YesNo (character, "Remove this Omega Cache container?"))
		SendSysMessage (character, "Canceled.");
		return;
	endif

	// Avoid destroycache.src's non-empty block re-triggering on a manual,
	// already-confirmed-empty removal.
	EraseObjProperty (cache, "houseserial");
	if (!DestroyItem (cache))
		SendSysMessage (character, "Could not remove that Omega Cache container.", color := 33);
		return;
	endif

	var remaining := CInt (GetObjProperty (sign, "numomegacache")) + 1;
	var maxslots := CInt (GetObjProperty (sign, "maxnumomegacache"));
	if (remaining > maxslots)
		remaining := maxslots;
	endif
	SetObjProperty (sign, "numomegacache", remaining);
	if (house)
		SetObjProperty (house, "numomegacache", remaining);
	endif

	SendSysMessage (character, "Omega Cache container removed. One cache slot was refunded.");
endfunction




