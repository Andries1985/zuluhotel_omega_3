	endif
	if (!can_manage)
		var early_res := GFSendGump (character, gump);
		return early_res;
	endif

	GFAddButton( gump, 125,308,2714,2715, GF_CLOSE_BTN,1);
	GFTextLine( gump, 155, 308, 2302, "Change the house name!");

	GFPage(gump, 2);
	GFTextLine( gump, 155, 95, 2302, "Manage house friends");
	GFAddButton( gump, 125,95,2714,2715, GF_CLOSE_BTN,8);
	GFTextLine( gump, 155, 118, 2302, "List of banned people");
	GFAddButton( gump, 125,118,2714,2715, GF_CLOSE_BTN,11);
	GFTextLine( gump, 155, 141, 2302, "Ban someone from the house");
	GFAddButton( gump, 125,141,2714,2715, GF_CLOSE_BTN,9);
	GFTextLine( gump, 155, 164, 2302, "Remove a ban");
	GFAddButton( gump, 125,164,2714,2715, GF_CLOSE_BTN,12);
	GFTextLine( gump, 155, 187, 2302, "Eject someone from the house");
	GFAddButton( gump, 125,187,2714,2715, GF_CLOSE_BTN,10);

	GFPage(gump, 3);
	GFTextLine( gump, 155, 95, 2302, "Change the locks");
	GFAddButton( gump, 125,95,2714,2715, GF_CLOSE_BTN,16);
	GFTextLine( gump, 155, 118, 2302, "Transfer ownership of the house");
	GFAddButton( gump, 125,118,2714,2715, GF_CLOSE_BTN,13);
	GFTextLine( gump, 155, 141, 2302, "Customize this house");
	GFAddButton( gump, 125,141,2714,2715, GF_CLOSE_BTN,20);
	GFTextLine( gump, 155, 164, 2302, "Remove Omega Cache Container");
	GFAddButton( gump, 125,164,2714,2715, GF_CLOSE_BTN,21);
	GFTextLine( gump, 155, 187, 2302, "Demolish the house & get a deed back");
	GFAddButton( gump, 125,187,2714,2715, GF_CLOSE_BTN,14);
	GFTextLine( gump, 155, 210, 2302, "House Management (lockdowns/secures)");
	GFAddButton( gump, 125,210,2714,2715, GF_CLOSE_BTN,15);

	var send_res := GFSendGump (character, gump);
	return send_res;
endfunction

function ShowPagedNameSelectionGump (who, title, action_label, names, action_x := 165, action_y := 335)
	var gump := GFCreateGump(0, 0, 400, 300);
	GFDisposable(gump, 0);
	GFResizePic( gump, 100, 100, 40288, 400, 300);
	GFResizePic( gump, 147, 359, 5100, 310, 25);
	GFTextLine( gump, 185, 118, 995, title);
	GFAddButton( gump, 270,360,247,248, GF_CLOSE_BTN,1);
	GFTextLine( gump, action_x, action_y, 995, action_label);

	if (names.size() > 10)
		GFAddButton( gump, 425,363,5224,5224, GF_PAGE_BTN,2);
	endif

	GFPage(gump, 1);
	var i := 1;
	for (i := 1; i <= 10; i := i + 1)
		if (names[i])
			var y := 120 + (i * 20);
			GFTextLine( gump, 180, y, 0, names[i]);
			GFAddButton( gump, 150,y,210,211, GF_CLOSE_BTN,i + 2);
		endif
	endfor

	GFPage(gump, 2);
	for (i := 11; i <= 20; i := i + 1)
		if (names[i])
			var y2 := 120 + ((i - 10) * 20);
			GFTextLine( gump, 180, y2, 0, names[i]);
			GFAddButton( gump, 150,y2,210,211, GF_CLOSE_BTN,i + 2);
		endif
	endfor
	GFAddButton( gump, 160,363,5223,5223, GF_PAGE_BTN,1);

	var send_res := GFSendGump (who, gump);
	return send_res;
endfunction

