///////////////////
//  builds and shows the house sign gump -- rewritten 2026-08-11 onto the
//  same mdgumps (GFxxx) layout used by house/multiSign/use.src and
//  staticHousing/sign/use.src (background 40288, plaque pic 1764, Info /
//  House Lists / Options tabs), replacing the old raw SendDialogGump layout
//  so all three housing packages share one visual language.
///////////////////

function GetPlaqueLines (sign)
	var signname := GetObjProperty (sign, "signname");
	if (!signname or signname.errortext)
		signname := GetObjProperty (sign, "housename");
	endif
	if (!signname or signname.errortext)
		signname := sign.desc;
	endif
	if (!signname or signname.errortext)
		signname := " ";
	endif
	return signname;
endfunction

function GetHouseDecayDisplay (sign)
	var decaytime := GetObjProperty (sign, "decay");
	if (!decaytime or decaytime.errortext)
		return "Unknown";
	endif
	var remaining := CInt (decaytime) - ReadGameClock();
	if (remaining <= 0)
		return "0mo 0d 0h 0m";
	endif

	var months := 0;
	while (remaining >= 2592000)
		months := months + 1;
		remaining := remaining - 2592000;
	endwhile

	var days := 0;
	while (remaining >= 86400)
		days := days + 1;
		remaining := remaining - 86400;
	endwhile

	var hours := 0;
	while (remaining >= 3600)
		hours := hours + 1;
		remaining := remaining - 3600;
	endwhile

	var mins := 0;
	while (remaining >= 60)
		mins := mins + 1;
		remaining := remaining - 60;
	endwhile

	return CStr(months) + "mo " + CStr(days) + "d " + CStr(hours) + "h " + CStr(mins) + "m";
endfunction

// "numomegacache" on the sign tracks *remaining* slots (see
// pkg/opt/omegacache), so the used count shown to players is max-remaining.
function GetOmegaCacheCountDisplay (sign)
	var maxslots := CInt (GetObjProperty (sign, "maxnumomegacache"));
	var remaining := CInt (GetObjProperty (sign, "numomegacache"));
	var used := maxslots - remaining;
	if (used < 0)
		used := 0;
	endif
	return CStr(used) + " / " + CStr(maxslots);
endfunction

// "numhteles" on the sign tracks the number of house teleporter pairs
// already placed (pkg/items/houseExtras/hteleporter); the cap is the
// package-wide houseExtras setting, not tracked per-sign.
function GetTeleporterCountDisplay (sign)
	var used := CInt (GetObjProperty (sign, "numhteles"));
	var htsettings := HE_GetSettingsCfgElem ("settings");
	if (htsettings.LimitHouseTeleporters)
		return CStr(used) + " / " + CStr(CInt(htsettings.MaxHouseTeleporters));
	endif
	return CStr(used);
endfunction

// Mirrors :house:multiSign/use.src's GetGuildHouseName() -- kept as a
// separate copy rather than a shared include since this file already
// duplicates the rest of that sign gump (GetTeleporterCountDisplay,
// GetOmegaCacheCountDisplay, ShowHouseSignGump) per-package rather than
// sharing it.
function GetGuildHouseName(house)
	if(!house)
		return "";
	endif

	var guild_house_id := GetObjProperty(house, "GuildHouse");
	if(!guild_house_id || guild_house_id.errortext)
		return "";
	endif

	foreach guild in ListGuilds()
		if(CInt(guild.guildid) == CInt(guild_house_id) && CInt(guild.getprop("GuildHouse")) == CInt(house.serial))
			var guild_name := guild.getprop("GuildName");
			if(guild_name && !guild_name.errortext)
				return guild_name;
			endif
			return "Unknown Guild";
		endif
	endforeach

	return "";
endfunction

function ShowHouseSignGump (character, sign, owner_name, house_type, decay_display, lockdowns, secures, guild_house_name, can_manage)
	var gump := GFCreateGump(0, 0, 412, 300);
	GFDisposable(gump, 0);
	// Plaque (gump art 1764, 205x49) sits above the panel and is centered on
	// its 412-wide span (100..512, centre 306); GFTextMid centers each line
	// within the plaque's own width instead of a hand-tuned x offset.
	GFResizePic( gump, 100, 45, 40288, 412, 300);
	GFGumpPic( gump, 204, 0, 1764);
	GFTextMid( gump, 215, 17, 205, 50, GetPlaqueLines(sign));
	GFResizePic( gump, 115, 55, 5100, 382, 25);
	GFTextLine( gump, 125, 57, 0, "Info");
	GFAddButton( gump, 178,59,5209,5003, GF_PAGE_BTN,1);
