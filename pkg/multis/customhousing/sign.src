		GFAddButton( gump, 425,363,5224,5224, GF_PAGE_BTN,2);
	endif

	GFPage(gump, 1);
	var i := 1;
	for (i := 1; i <= 10; i := i + 1)
		if (names[i])
			var y := 120 + (i * 20);
			GFTextLine( gump, 180, y, 0, names[i]);
		endif
	endfor

	GFPage(gump, 2);
	for (i := 11; i <= 20; i := i + 1)
		if (names[i])
			var y2 := 120 + ((i - 10) * 20);
			GFTextLine( gump, 180, y2, 0, names[i]);
