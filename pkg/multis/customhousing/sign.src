	GFAddButton( gump, 430,308,247,248, GF_CLOSE_BTN,0);

	GFPage(gump, 1);
	GFTextLine( gump, 135, 95, 2020, "Owned by:");
	GFTextLine( gump, 220, 95, 2590, owner_name);
	GFTextLine( gump, 135, 118, 2020, "House Type:");
	GFTextLine( gump, 220, 118, 2590, house_type);
	GFTextLine( gump, 135, 141, 2020, "House Decays At:");
	GFTextLine( gump, 250, 141, 2590, decay_display);
	GFTextLine( gump, 135, 164, 2020, "Number of locked down items:");
	GFTextLine( gump, 370, 164, 2590, CStr(lockdowns));
	GFTextLine( gump, 135, 187, 2020, "Number of secure containers:");
	GFTextLine( gump, 370, 187, 2590, CStr(secures));
	GFTextLine( gump, 135, 210, 2020, "Number of Omega Cache containers:");
	GFTextLine( gump, 370, 210, 2590, GetOmegaCacheCountDisplay(sign));
	GFTextLine( gump, 135, 233, 2020, "Number of Teleporters:");
	GFTextLine( gump, 370, 233, 2590, GetTeleporterCountDisplay(sign));
	if(guild_house_name)
		GFTextLine( gump, 135, 256, 2020, "Guild House:");
