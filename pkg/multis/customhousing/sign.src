endfunction




///////////////////
//  handles add/remove clicks from the main gump's Friends page (button
//  codes 101-108, one per numbered slot). Backed by the shared :house: sign
//  core (sign.GetFriendList/AddFriend/RemoveFriend) instead of the old
//  "housefriends" dictionary.
///////////////////

function AdjustFriendListFromSign (character, sign, friendnum)
	if (friendnum > 8)
		SendSysMessage (character, "Error: invalid gump return/friend number!");
		return;
	endif

	var namedlist := ResolveMemberList (sign.GetFriendList());

	if (friendnum <= namedlist.size())
		var chosenfriend := namedlist[friendnum];
		SendSysMessage (character, "Are you sure you want to remove " + chosenfriend.name + " as a house friend?");
		if (!YesNo (character, "Remove?"))
			SendSysMessage (character, "Canceled.");
			return;
		endif
		sign.RemoveFriend (chosenfriend);
		SendSysMessage (character, "Friend removed.");
		return;
	endif

	SendSysMessage (character, "Who do you want to add as a friend?");
	var friend := Target (character);
	if (!friend)
		SendSysMessage (character, "Canceled.");
		return;
	elseif (!friend.acctname)
		SendSysMessage (character, "Invalid target!  Only players can be house friends.");
		return;
	endif

	var addresult := sign.AddFriend (friend);
	if (!addresult)
		SendSysMessage (character, "That person is already a friend of the house.");
	elseif (addresult < 0)
		SendSysMessage (character, "Your friend list is full.");
	else
		SendSysMessage (character, "New friend added!");
	endif
endfunction




///////////////////
//  resolves a list of mobile serials (as stored by the shared friend/
//  co-owner/ban list methods) into mobile refs, silently dropping any that
//  no longer exist.
///////////////////

function ResolveMemberList (serials)
	var resolved := array {};
	foreach memberserial in serials
		var member := SystemFindObjectBySerial (memberserial);
		if (!member)
			member := SystemFindObjectBySerial (memberserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if (member)
			resolved.append (member);
		endif
	endforeach
	return resolved;
endfunction




///////////////////
//  standalone gump listing co-owners, same add/remove-by-slot UX as the
//  Friends page on the main gump. Co-owners have full manager rights
//  (sign.IsFullHouseManager), same as house/staticHousing.
///////////////////

function ManageCoOwners (character, sign)
	if (!sign.IsFullHouseManager (character))
		SendSysMessage (character, "You do not have permission to manage co-owners.", color := 33);
		return;
	endif

	var showing := 1;
	while (showing)
		var colayout := array {
			"page 0",
			"resizepic 0 50 2620 310 350",
			"gumppic 83 0 100",
			"text 100 29 40 0",
			"text 40 150 40 1",
			"text 40 170 40 2",
			"text 40 190 40 3",
			"text 40 210 40 4",
			"text 40 230 40 5",
			"text 40 250 40 6",
			"text 40 270 40 7",
			"text 40 290 40 8",
			"button 20 155 2104 2103 1 0 1",
			"button 20 175 2104 2103 1 0 2",
			"button 20 195 2104 2103 1 0 3",
			"button 20 215 2104 2103 1 0 4",
			"button 20 235 2104 2103 1 0 5",
			"button 20 255 2104 2103 1 0 6",
			"button 20 275 2104 2103 1 0 7",
			"button 20 295 2104 2103 1 0 8",
			"button 234 68 242 241 1 0 0"
		};
		var codata := array {
			"Co-Owners",		//0
			"New Co-owner",		//1
			"New Co-owner",		//2
			"New Co-owner",		//3
			"New Co-owner",		//4
			"New Co-owner",		//5
			"New Co-owner",		//6
			"New Co-owner",		//7
			"New Co-owner"		//8
		};

		var colist := ResolveMemberList (sign.GetCoOwnerList());
		for i := 1 to colist.size()
			codata[i] := colist[i].name;
		endfor

		var result := SendDialogGump (character, colayout, codata);
		if (!result or !result[0])
			showing := 0;
		else
			var slotnum := CINT (result[0]);
			if (slotnum <= colist.size())
				var chosenco := colist[slotnum];
				SendSysMessage (character, "Are you sure you want to remove " + chosenco.name + " as a co-owner?");
				if (YesNo (character, "Remove?"))
					sign.RemoveCoOwner (chosenco);
					SendSysMessage (character, "Co-owner removed.");
				else
					SendSysMessage (character, "Canceled.");
				endif
			else
				SendSysMessage (character, "Who do you want to add as a co-owner?");
				var newco := Target (character);
				if (!newco)
					SendSysMessage (character, "Canceled.");
				elseif (!newco.acctname or newco.isA (POLCLASS_NPC))
					SendSysMessage (character, "That can't be a co-owner of the house.");
				else
					if (!sign.IsAFriend (newco))
						sign.AddFriend (newco);
					endif
					var coresult := sign.AddCoOwner (newco);
					if (!coresult)
						SendSysMessage (character, "That person is already a co-owner.");
					elseif (coresult < 0)
						SendSysMessage (character, "Your co-owner list is full.");
					else
						SendSysMessage (character, newco.name + " is now a co-owner of your house.");
					endif
				endif
			endif
		endif
	endwhile
endfunction




///////////////////
//  standalone gump listing bans, same add/remove-by-slot UX as Friends.
///////////////////

function ManageBans (character, sign)
	if (!sign.IsFullHouseManager (character))
		SendSysMessage (character, "You do not have permission to manage bans.", color := 33);
		return;
	endif

	var showing := 1;
	while (showing)
		var banlayout := array {
			"page 0",
			"resizepic 0 50 2620 310 350",
			"gumppic 83 0 100",
			"text 100 29 40 0",
			"text 40 150 40 1",
			"text 40 170 40 2",
			"text 40 190 40 3",
			"text 40 210 40 4",
			"text 40 230 40 5",
			"text 40 250 40 6",
			"text 40 270 40 7",
			"text 40 290 40 8",
			"button 20 155 2104 2103 1 0 1",
			"button 20 175 2104 2103 1 0 2",
			"button 20 195 2104 2103 1 0 3",
			"button 20 215 2104 2103 1 0 4",
			"button 20 235 2104 2103 1 0 5",
			"button 20 255 2104 2103 1 0 6",
			"button 20 275 2104 2103 1 0 7",
			"button 20 295 2104 2103 1 0 8",
			"button 234 68 242 241 1 0 0"
		};
		var bandata := array {
			"Banned",		//0
			"Ban someone",		//1
			"Ban someone",		//2
			"Ban someone",		//3
			"Ban someone",		//4
			"Ban someone",		//5
			"Ban someone",		//6
			"Ban someone",		//7
			"Ban someone"		//8
		};

		var banlist := ResolveMemberList (sign.GetBanList());
		for i := 1 to banlist.size()
			bandata[i] := banlist[i].name;
		endfor

		var result := SendDialogGump (character, banlayout, bandata);
		if (!result or !result[0])
			showing := 0;
		else
			var slotnum := CINT (result[0]);
			if (slotnum <= banlist.size())
				var chosenban := banlist[slotnum];
				sign.RemoveBan (chosenban);
				SendSysMessage (character, "Ban lifted for " + chosenban.name + ".");
			else
				SendSysMessage (character, "Who do you want to ban from this house?");
				var newban := Target (character);
				if (!newban)
					SendSysMessage (character, "Canceled.");
				elseif (!newban.acctname)
					SendSysMessage (character, "That can't be banned.");
				elseif (sign.IsCoOwnerOrOwner (newban))
					SendSysMessage (character, "You cannot ban an owner or co-owner!");
				else
					var banresult := sign.AddBan (newban);
					if (!banresult)
						SendSysMessage (character, "That person is already banned.");
					elseif (banresult < 0)
						SendSysMessage (character, "Your ban list is full.");
					else
						sign.RemoveFriend (newban);
						sign.RemoveCoOwner (newban);
						SendSysMessage (character, newban.name + " has been banned from this house.");
					endif
				endif
			endif
		endif
	endwhile
endfunction




///////////////////
//  simple menu of per-friend permission toggles, all target-based -- avoids
//  needing a full permission grid gump. Mirrors house's
//  ToggleHousePermission/ToggleCoOwnerStatus.
///////////////////

function ManageFriendPermissions (character, sign)
	if (!sign.IsFullHouseManager (character))
		SendSysMessage (character, "You do not have permission to manage house friend permissions.", color := 33);
		return;
	endif

	var showing := 1;
	while (showing)
		var permlayout := array {
			"page 0",
			"resizepic 0 50 2620 310 350",
			"gumppic 83 0 100",
			"text 100 29 40 0",
			"text 40 150 40 1",
			"text 40 170 40 2",
			"text 40 190 40 3",
			"text 40 210 40 4",
			"text 40 230 40 5",
			"text 40 250 40 6",
			"button 20 155 2104 2103 1 0 1",
			"button 20 175 2104 2103 1 0 2",
			"button 20 195 2104 2103 1 0 3",
			"button 20 215 2104 2103 1 0 4",
			"button 20 235 2104 2103 1 0 5",
			"button 20 255 2104 2103 1 0 6",
			"button 234 68 242 241 1 0 0"
		};
		var permdata := array {
			"Friend Permissions",					//0
			"Toggle lockdown permission",			//1
			"Toggle secure permission",			//2
			"Toggle eject permission",				//3
			"Toggle ban permission",				//4
			"Toggle teleporter permission",		//5
			"Show permission overview"				//6
		};

		var result := SendDialogGump (character, permlayout, permdata);
		if (!result or !result[0])
			showing := 0;
		else
			case (CINT (result[0]))
				1:	ToggleCustomHousePermission (character, sign, "lockdown", "lockdown");
				2:	ToggleCustomHousePermission (character, sign, "secure", "secure");
				3:	ToggleCustomHousePermission (character, sign, "eject", "eject");
				4:	ToggleCustomHousePermission (character, sign, "ban", "ban");
				5:	ToggleCustomHousePermission (character, sign, "teleporter", "teleporter");
				6:	ShowCustomHousePermissionOverview (character, sign);
			endcase
		endif
	endwhile
endfunction




function ToggleCustomHousePermission (who, sign, perm_key, label)
	SendSysMessage (who, "Target the person whose " + label + " permission you want to toggle.");
	var targetchr := Target (who);
	if (!targetchr)
		SendSysMessage (who, "Canceled.");
		return;
	endif
	if (!targetchr.isA (POLCLASS_MOBILE))
		SendSysMessage (who, "That cannot be modified.");
		return;
	endif
	if (sign.IsCoOwnerOrOwner (targetchr))
		SendSysMessage (who, "Owners and co-owners always have full permissions.");
		return;
	endif
	if (!sign.IsAFriend (targetchr))
		SendSysMessage (who, "That person is not on your friend list.");
		return;
	endif

	var profile := sign.GetFriendPermissionProfile (targetchr);
	var enabled := 0;
	case (perm_key)
		"lockdown": enabled := profile[2];
		"secure": enabled := profile[3];
		"eject": enabled := profile[4];
		"ban": enabled := profile[5];
		"teleporter": enabled := profile[6];
	endcase

	if (enabled)
		sign.SetFriendPermission (targetchr, perm_key, 0);
		SendSysMessage (who, "Disabled " + label + " permission for " + targetchr.name + ".");
	else
		sign.SetFriendPermission (targetchr, perm_key, 1);
		SendSysMessage (who, "Enabled " + label + " permission for " + targetchr.name + ".");
	endif
endfunction




function ShowCustomHousePermissionOverview (who, sign)
	SendSysMessage (who, "House permissions overview:");
	foreach coserial in (sign.GetCoOwnerList())
		var co := SystemFindObjectBySerial (coserial);
		if (!co)
			co := SystemFindObjectBySerial (coserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if (co)
			SendSysMessage (who, co.name + " [co-owner] full access");
		endif
	endforeach
	foreach friendserial in (sign.GetFriendList())
		if (friendserial in (sign.GetCoOwnerList()))
			continue;
		endif
		var fr := SystemFindObjectBySerial (friendserial);
		if (!fr)
			fr := SystemFindObjectBySerial (friendserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if (fr)
			var p := sign.GetFriendPermissionProfile (fr);
			SendSysMessage (who, fr.name + " [friend] L:" + CSTR(p[2]) + " S:" + CSTR(p[3]) + " E:" + CSTR(p[4]) + " B:" + CSTR(p[5]) + " T:" + CSTR(p[6]));
		endif
	endforeach
endfunction




// 2026-08-10: Omega Cache removal for customhousing, mirroring house's
// HouseFunctionRemoveOmegaCache (pkg/multis/house/multiSign/use.src) and
// staticHousing's StaticHouseFunctionRemoveOmegaCache.
function CustomHouseFunctionRemoveOmegaCache (sign, house, character)
	if (!sign.IsFullHouseManager (character))
		SendSysMessage (character, "Only owners and co-owners can remove Omega Cache containers.", color := 33);
		return;
	endif

	SendSysMessage (character, "Choose the Omega Cache container you wish to remove.");
	var cache := Target (character, TGTOPT_NOCHECK_LOS);
	if (!cache)
		SendSysMessage (character, "Canceled.");
		return;
	endif

	if (CInt (cache.objtype) != OMEGACACHE_OBJTYPE)
		SendSysMessage (character, "That is not an Omega Cache container.", color := 33);
		return;
	endif

	var homeinfo := GetObjProperty (sign, "homeinfo");
	if (!homeinfo or cache.x < homeinfo[2] or cache.x > homeinfo[4] or cache.y < homeinfo[3] or cache.y > homeinfo[5] or cache.realm != sign.realm)
		SendSysMessage (character, "That is not in your house.", color := 33);
		return;
	endif

	if (!IsOmegaCacheEmpty (CInt (GetObjProperty (cache, "houseserial"))))
		SendSysMessage (character, "This house Omega Cache still contains stored items. Withdraw them first.", color := 33);
		return;
	endif

	if (!YesNo (character, "Remove this Omega Cache container?"))
		SendSysMessage (character, "Canceled.");
		return;
	endif

	// Avoid destroycache.src's non-empty block re-triggering on a manual,
	// already-confirmed-empty removal.
	EraseObjProperty (cache, "houseserial");
	if (!DestroyItem (cache))
		SendSysMessage (character, "Could not remove that Omega Cache container.", color := 33);
		return;
	endif

	var remaining := CInt (GetObjProperty (sign, "numomegacache")) + 1;
	var maxslots := CInt (GetObjProperty (sign, "maxnumomegacache"));
	if (remaining > maxslots)
		remaining := maxslots;
	endif
	SetObjProperty (sign, "numomegacache", remaining);
	if (house)
		SetObjProperty (house, "numomegacache", remaining);
	endif

	SendSysMessage (character, "Omega Cache container removed. One cache slot was refunded.");
endfunction




