include ":houseExtras:settings";
include ":guilds:include/guildconstants";
include ":guilds:items/guildstone/companions";
include ":containers:storageAreas";
// 2026-08-10: YesNo() used below (Continue?/Sell it?/Remove? prompts) --
// used to come transitively via housefriends.inc's ":mdgumps:yesNo" include,
// which was removed as dead weight (nothing in housefriends.inc itself used
// it). Included directly here, matching customhousedeed.src's package choice.
include ":mdgumps:yesNo";

// 2026-09-03: removed the sign.objtype == 0x17060 ("static" custom house)
// dead-code branch that used to live here (DisownHouse, and this program's
// dispatch to it) -- this script's itemdesc.cfg entry (0xFFF4 only) means
// `sign` can never actually be anything else; real static-housing signs
// (0xBD0/0xBD1/0xBD2/0xBCF/etc.) are routed by their own itemdesc.cfg
// entries straight to :statichousing:sign/use, a separate, already-complete
// system, and never reach this file at all. include/house.inc's
// GetHouseValueOfSign's matching commented-out 0x17060 case was removed the
// same way. FindHouseSign()/FindHouseSignAtLocation() (same file) are a
// different, unrelated case -- fixed 2026-09-03 to recognize real
// static-housing signs via :statichousing:'s own FindStaticHouseForLocation.
program use_house_sign (character, sign)
	//If its a deeded house, make sure its house exists...
	var hserial := ResolveCustomHouseSerial (sign);
	if (!hserial)
		return;
	endif

	MigrateCustomHouseSignOwnership (sign, character);

	// Always resolve the owner's live name, regardless of who is clicking the
	// sign -- previously this only refreshed when a full house manager
	// clicked, so a name change didn't show to anyone else until then.
	var oserial := CInt (GetObjProperty (sign, "ownerserial"));
	var owner_name := "Unknown";
	var owner_obj := SystemFindObjectBySerial (oserial);
	if (!owner_obj)
		owner_obj := SystemFindObjectBySerial (oserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
	endif
	if (owner_obj)
		owner_name := owner_obj.name;
		SetObjProperty (sign, "lastownername", owner_obj.name);
	else
		owner_name := GetObjProperty (sign, "lastownername");
		if (!owner_name or owner_name.errortext)
			owner_name := "Unknown";
		endif
	endif

	var legacy_account := GetObjProperty (sign, "account");
	var can_manage := 0;
	if (sign.IsFullHouseManager (character) or (legacy_account and legacy_account == character.acctname))
		can_manage := 1;
		sign.RefreshHouse();
	endif

	SendSysMessage (character, "You own " + GetAccountHouseCount (character.acctname) + " of " + get_max_houses_per_account() + " houses allowed on this account." );

	var guild_house := 0;
	var guild_house_serial := ResolveCustomHouseSerial (sign);
	if (guild_house_serial)
		guild_house := SystemFindObjectBySerial (guild_house_serial);
	endif
	var guild_house_name := GetGuildHouseName (guild_house);

	var result := ShowHouseSignGump (character, sign, owner_name, "Custom House", GetHouseDecayDisplay (sign), GetLockdowns (sign), GetSecures (sign), guild_house_name, can_manage);

	if (!can_manage)
		if (!legacy_account or character.acctname != legacy_account)
			SendSysMessage (character, "This is not your house!");
		endif
		return;
	endif

	case (result[0])
		1:	RenameHouse (character, sign);
		8:	NewFriendsControl (character, sign);
		9:	AddBan (sign, character);
		10:	Eject (sign, character);
		11:	ListBan (sign, character);
		12:	DeleteBan (sign, character);
		13:
			set_critical (1);
			ChangeOwner (character, sign);
			set_critical (0);
		14:
			var hserial := ResolveCustomHouseSerial (sign);
			var house := SystemFindObjectBySerial (hserial);

				// 2026-08-21: mirrors :house:'s own demolish() guards, which
				// this redeed path never had. Without this, redeeding a
				// house that's a guild's active guild hall left the guild's
				// "GuildHouse" pointer dangling at a serial that no longer
				// exists, and redeeding with a vendor inside just destroyed
				// it with no warning/refund.
				var guild_house_id := GetObjProperty (house, "GuildHouse");
				if (guild_house_id and !guild_house_id.errortext)
					foreach guild in ListGuilds ()
						if (CInt (guild.guildid) == CInt (guild_house_id) and CInt (guild.getprop ("GuildHouse")) == CInt (house.serial))
							SendSysMessage (character, "This house is your active guild house. Select a new guild house first.", color := 33);
							return;
						endif
					endforeach
				endif
				var has_vendor := 0;
				foreach npc in (house.mobiles)
					if (npc.npctemplate == "playervendor")
						has_vendor := 1;
						break;
					endif
				endforeach
				if (has_vendor)
					SendSysMessage (character, "You cannot redeed a house with vendors in it.", color := 33);
					return;
				endif

				// Omega Cache containers are freestanding items placed inside
				// the house footage, not tracked in house.components, so they
				// need their own sweep. Block the redeed if anything is still
				// stored (matching house's own manual-demolish guard); collect
				// the (now confirmed empty) containers to clean up below.
				var homeinfo := GetObjProperty (sign, "homeinfo");
				var cache_items := array {};
				var cache_serials := array {};
				// 2026-08-14: this redeed path never swept for a guildstone at
				// all (unlike :house:'s equivalent), so one left standing here
				// would just orphan in place with no house around it once
				// DestroyMulti ran below. Collected in the same box sweep as
				// the Omega Cache containers, destroyed after MakeADeed below.
				var guildstones := array {};
				// 2026-08-21: teleporters were never swept for at all -- they
				// aren't tracked in house.components either, so nothing ever
				// destroyed/unpaired them on redeed (mirrors :house:'s sweep).
				var teleporters := array {};
				if (homeinfo)
					foreach thing in ListObjectsInBox (homeinfo[2], homeinfo[3], -128, homeinfo[4], homeinfo[5], 127, sign.realm)
						if (thing.objtype == OMEGACACHE_OBJTYPE)
							if (!IsOmegaCacheEmpty (CInt (GetObjProperty (thing, "houseserial"))))
								SendSysMessage (character, "You cannot redeed this house while Omega Cache contents are stored.", color := 33);
								return;
							endif
							cache_items.append (thing);
							cache_serials.append (CInt (GetObjProperty (thing, "houseserial")));
						elseif (thing.objtype == GUILDSTONE_OBJTYPE)
							guildstones.append (thing);
						elseif (thing.objtype == 0x15000)
							teleporters.append (thing);
						endif
					endforeach
				endif

				if (!MakeADeed (character, house))
					return;
				endif
				foreach thing in teleporters
					// May already be gone if it was the *paired* half of a
					// teleporter destroyed earlier in this same loop.
					if (SystemFindObjectBySerial (thing.serial))
						DemolishTeleporter (thing, character);
					endif
				endforeach
				foreach thing in cache_items
					EraseObjProperty (thing, "houseserial");
					DestroyItem (thing);
				endforeach
				// Already confirmed empty above -- safe to drop the DataFile(s)
				// instead of leaving them registered forever for a house that's
				// about to stop existing.
				foreach cache_serial in cache_serials
					DeleteOmegaCacheStore (cache_serial);
				endforeach
				// The guildstone (and any statue-set companion pieces) can only
				// ever sit inside the guild's own house, so it can't survive
				// the house being redeeded. Clear the guild's own stone
				// reference too if the owning guild can still be found.
				foreach thing in guildstones
					DestroyGuildstoneCompanions (thing);
					foreach guild in ListGuilds ()
						if (guild.getprop (GUILD_STONE) == thing.serial)
							guild.eraseprop (GUILD_STONE);
							break;
						endif
					endforeach
					DestroyItem (thing);
				endforeach
				var addons := GetObjProperty (house, "components");
				if (addons.size())
					foreach item in addons
						DestroyItem (SystemFindObjectBySerial (item));
					endforeach
				endif
				var demolished_acct := GetObjProperty (sign, "owneracct");
				if (!demolished_acct)
					demolished_acct := GetObjProperty (sign, "account");
				endif
				if (demolished_acct)
					UnregisterAccountHouseSign (sign, demolished_acct);
				endif
				UnregisterCustomHouseSign (sign);
				ReleaseAll (character, sign);

				// 2026-08-21: the packkey/bankkey created at purchase
				// (customhousedeed.src, tagged with the sign's "lockid") were
				// never destroyed on redeed, unlike :house:'s
				// KP_DestroyOwnedKeysForLockIDs. customhousing tags keys with
				// its own lowercase "lockid" property (not key.inc's
				// "LockID"), so that shared helper can't be reused directly --
				// swept here instead.
				var house_lockid := GetObjProperty (sign, "lockid");
				if (house_lockid)
					foreach thing in EnumerateItemsInContainer (character.backpack)
						if (GetObjProperty (thing, "lockid") == house_lockid)
							DestroyItem (thing);
						endif
					endforeach
					var bankbox := CP_GetStorageContainerForMobile (character, CP_DEFAULT_AREA);
					if (bankbox)
						foreach thing in EnumerateItemsInContainer (bankbox)
							if (GetObjProperty (thing, "lockid") == house_lockid)
								DestroyItem (thing);
							endif
						endforeach
					endif
				endif

				// 2026-08-21: a bare DestroyMulti(house) here could silently
				// leave the house base standing (structure not removed, or
				// removed server-side but not refreshed client-side) even
				// though the sign and every component above were already
				// destroyed -- reported for 3-story custom houses. Mirrors
				// :house:'s own redeed hardening (multiSign/use.src): capture
				// coords/serial first (house may become invalid after),
				// verify the destroy actually took, retry once, and force a
				// client revision refresh so no stale multi shell lingers.
				var hobjtype := house.objtype;
				var hserial2 := house.serial;
				var hx := house.x;
				var hy := house.y;
				var hz := house.z;
				var hrealm := house.realm;
				var destroy_result := DestroyMulti (house);
				var destroy_failed := 0;
				var destroy_err := "";
				if (!destroy_result)
					destroy_failed := 1;
					destroy_err := "DestroyMulti returned false";
				elseif (destroy_result.errortext)
					destroy_failed := 1;
					destroy_err := destroy_result.errortext;
				endif

				var still_exists := SystemFindObjectBySerial (CInt (hserial2));
				if (still_exists)
					var destroy_retry := DestroyMulti (still_exists);
					if ((!destroy_retry) or destroy_retry.errortext or SystemFindObjectBySerial (CInt (hserial2)))
						destroy_failed := 1;
						if (destroy_retry and destroy_retry.errortext)
							destroy_err := destroy_retry.errortext;
						elseif (destroy_err == "")
							destroy_err := "multi serial still exists after retry";
						endif
					endif
				endif

				if (destroy_failed)
					Print ("Custom house redeed failed to remove multi for serial " + CStr (hserial2) + " (objtype " + Hex (hobjtype) + "): " + destroy_err);
					SendSysMessage (character, "Could not fully remove the house structure: " + destroy_err + " Please page a GM.", color := 33);
				endif

				foreach viewer in ListMobilesNearLocation (hx, hy, hz, 24, hrealm)
					if (viewer and viewer.connected)
						IncRevision (viewer);
						MoveObjectToLocation (viewer, viewer.x, viewer.y, viewer.z, viewer.realm, MOVEOBJECT_FORCELOCATION);
					endif
				endforeach
				if (character and character.connected)
					IncRevision (character);
					MoveObjectToLocation (character, character.x, character.y, character.z, character.realm, MOVEOBJECT_FORCELOCATION);
				endif
		15:	HouseManagementGump (character, sign);
		16:	ChangeHouseLocks (character, sign);
		20:
			var customhouse := SystemFindObjectBySerial (ResolveCustomHouseSerial (sign));
			if (customhouse.custom)
				var homeinfo := GetObjProperty (sign, "homeinfo");
				if (!homeinfo)
					SendSysMessage (character, "Error finding house definition.");
					return;
				endif
				//CloseHouseDoors (character, sign);
				MoveObjectToLocation(character, (homeinfo[4] + homeinfo[2]) / 2, (homeinfo[5] + homeinfo[3]) / 2, sign.z, sign.realm, MOVEOBJECT_FORCELOCATION);
				SendPacket (character, "B9000F97DF");
				if (!character.concealed)
					character.concealed := 1;
				endif
				customhouse.acceptcommit(character, 0);
				var customizehouse := SendHousingTool(character, customhouse);
				if (!customizehouse)
					SendSysMessage (character, "Error: " +  customizehouse.errortext);
				endif
			else
				SendSysMessage (character, "Your house can't be customized.");
			endif
		21:
			var omegahouse := SystemFindObjectBySerial (ResolveCustomHouseSerial (sign));
			CustomHouseFunctionRemoveOmegaCache (sign, omegahouse, character);
		default:
			SendSysMessage (character, "Error:  Unknown gump return!");
			return;
	endcase
endprogram


function CloseHouseDoors (character, sign)
	var homeinfo := GetObjProperty (sign, "homeinfo");
	if (!homeinfo)
		SendSysMessage (character, "Error finding house definition.");
		return;	
	endif
	foreach item in ListObjectsInBox (homeinfo[2], homeinfo[3], -127, homeinfo[4], homeinfo[5], 127, sign.realm)
		//Removed as does not work with ZH scripts
		//if (IsDoor (item))
		//	CloseDoor(item);
		//endif
	endforeach

endfunction


///////////////////
// House Management: lock down/unlock items and secure/unsecure containers.
// Fashioned after :house:'s (pkg/multis/house/multiSign/use.src) own live
// HouseManagement() gump -- same permission model (sign.HasHousePermission,
// shared across the whole :house: family via the common multiSign/method
// MethodScript), same target-an-item flow. Loops so the player can perform
// several actions without re-clicking the sign each time.
///////////////////

function HouseManagementGump (character, sign)
	var ok := 1;
	while (ok)
		var gump := GFCreateGump(0, 0, 280, 200);
		GFDisposable(gump, 0);
		GFResizePic( gump, 0, 0, 40288, 280, 200);
		GFTextLine( gump, 70, 15, 20, "House Management");
		GFAddButton( gump, 35,50,2714,2715, GF_CLOSE_BTN,1);
		GFTextLine( gump, 70, 50, 2302, "Lock down an item");
		GFAddButton( gump, 35,72,2714,2715, GF_CLOSE_BTN,2);
		GFTextLine( gump, 70, 72, 2302, "Unlock an item");
		GFAddButton( gump, 35,94,2714,2715, GF_CLOSE_BTN,3);
		GFTextLine( gump, 70, 94, 2302, "Secure a container");
		GFAddButton( gump, 35,116,2714,2715, GF_CLOSE_BTN,4);
		GFTextLine( gump, 70, 116, 2302, "Unsecure a container");
		GFAddButton( gump, 90,160,243,241, GF_CLOSE_BTN,9);
		var result := GFSendGump (character, gump);
		case (result[0])
			1: LockdownItem (sign, character);
			2: UnlockItem (sign, character);
			3: SecureItem (sign, character);
			4: UnsecureItem (sign, character);
			default: ok := 0;
		endcase
		SleepMs(150);
	endwhile
endfunction




function ChangeHouseLocks (character, sign)
	var homeinfo := GetObjProperty (sign, "homeinfo");
	if (!homeinfo)
		SendSysMessage (character, "Error finding house definition.");
		return;	
	endif

	SendSysmessage (character, "Target the new master key.");
	var newkey := Target (character);
	if (!newkey)
		SendSysMessage (character, "Canceled.");
		return;
	//Removed as does not work with ZH scripts
	//elseif (!IsAKey (newkey))
	//	SendSysMessage (character, "That is not a key!");
	//	return;
	elseif (GetObjProperty (newkey, "lockid"))
		SendSysMessage (character, "That seems to be the key to something else already.");
		SendSysMessage (character, "If you use that key, it will no longer work on its previous lock.");
		if (!YesNo (character, "Continue?"))
			SendSysMessage (character, "Canceled.");
			return;
		endif
	endif

	var lockid := ResolveCustomHouseSerial(sign)+1;
	SetObjProperty (newkey, "lockid", lockid); 
	SetObjProperty (sign, "lockid", lockid); 
	foreach item in ListObjectsInBox (sign.x - 32, sign.y - 32, -127, sign.x + 32, sign.y + 32, 127, sign.realm)
		//if (IsDoor (item))
			//if ((item.x >= homeinfo[2] and item.x <= homeinfo[4]) and (item.y >= homeinfo[3] and item.y <= homeinfo[5]) )
			//	item.locked := 1;
			//	SetObjProperty (item, "lockid", lockid);
			//	PrintTextAbove (item, "*LOCKED*");
			//endif
		//endif
	endforeach
	SendSysmessage (character, "Locks Changed.");
endfunction




///////////////////
// called when the character demolishes a house, this function makes a new deed for the house
///////////////////

function MakeADeed (character, house)
	var deedtype := GetDeedType (house);
	if (!deedtype)
		SendSysMessage (character, "Error finding deed type.");
		return 0;
	endif

	if (deedtype == 0x16230 or deedtype == 0x16231)
		var components := GetObjProperty (house, "components");
		var sign := 0;
		var price := 0;
		foreach compo in (components)
			sign := SystemFindObjectBySerial(compo);
			if (sign.objtype == 0x0bd0 or sign.objtype == 0x0bd2)
				price := GetObjProperty (sign, "houseprice");
				break;
			endif
		endforeach
		if (price > 0)
			var discount := CINT (price/10);
			if (discount > 10000)
				discount := 10000;
			endif
			var theprice := price - discount;

			SendSysMessage (character, "The value of this house is " + theprice + " gold.");
			if (!YesNo (character, "Sell it?"))
				SendSysMessage (character, "Canceled.");
				return 0;
			endif
			var newdeed := CreateItemInContainer (character.backpack, deedtype, 1);
			if (!newdeed)
				PrintTextAbovePrivate (character, "*Your backpack is full!*", character);
				return 0;
			endif
			while (theprice > 60000)
				if (CreateItemInContainer (character.backpack, UOBJ_GOLD_COIN, 60000))
					theprice := theprice - 60000;
				else
					SendSysMessage (character, "Error creating gold!  You'll have to page a GM...");
					SetObjProperty (character, "OWEDGOLD", theprice);
					theprice := 0;
				endif
			endwhile
			CreateItemInContainer (character.backpack, UOBJ_GOLD_COIN, theprice);
		endif
	else
		var newdeed := CreateItemInContainer (character.backpack, deedtype, 1);
		if (!newdeed)
			PrintTextAbovePrivate (character, "*Your backpack is full!*", character);
			return 0;
		endif
	endif
	return 1;
endfunction







///////////////////
//  can change the name of the house
///////////////////

function RenameHouse (character, sign)
	var newname := SendTextEntryGump (character, "Name it what?", TE_CANCEL_ENABLE, TE_STYLE_NORMAL, 20);
	if (!newname)
		SendSysMessage (character, "Canceled");
	elseif (len(newname) > 20)
		SendSysMessage (character, "House sign names may not be longer than 20 characters.", color := 33);
	else
		SetObjProperty (sign, "housename", newname);
		SetObjProperty (sign, "signname", newname);
		sign.name := "A House Sign";
	endif
endfunction




