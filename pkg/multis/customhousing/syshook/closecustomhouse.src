use os;
use uo;

Const UOBJECT_BRASS_SIGN := 0x0bd2;
Const UOBJECT_WOOD_SIGN := 0x0bd0;

exported function CloseCustomHouse ( who, house)
	if (who.concealed < 2)
		who.concealed := 0;
	endif
	// 2026-09-22: the lock id comes from the house's own sign (0xFFF4, linked
	// through "signserial"), as "LockID" -- the key package's property. This
	// used to look for a 0x0BD0/0x0BD2 sign that a custom house never has, so
	// every door was re-locked with a lowercase "lockid" of 0 on each close
	// and no key opened it. A 0x0BD0/0x0BD2 sign is still accepted for any
	// classic multi placed through this package.
	var lockid := 0;
	var hsign := SystemFindObjectBySerial (CInt (GetObjProperty (house, "signserial")));
	if (hsign)
		lockid := GetObjProperty (hsign, "LockID");
	endif
	if (!lockid)
		var components := GetObjProperty (house, "components");
		foreach compo in (components)
			var sign := SystemFindObjectBySerial(compo);
			if (sign.objtype == 0xFFF4 or sign.objtype == UOBJECT_BRASS_SIGN or sign.objtype == UOBJECT_WOOD_SIGN)
				lockid := GetObjProperty (sign, "LockID");
				if (lockid)
					break;
				endif
			endif
		endforeach
	endif
	var teleporters := array{};
	foreach item in (house.components)
		if (item.isa (POLCLASS_DOOR))
			// Only re-lock when there is a real id to lock them to; a sign that has
			// not been through MigrateCustomHouseLockIds yet leaves the doors as
			// they are instead of locking them to 0.
			if (lockid)
				item.locked := 1;
				SetObjProperty (item, "LockID", lockid);
				EraseObjProperty (item, "lockid");
			endif
		elseif (item.objtype >= 0x181d and item.objtype <= 0x1828)
			teleporters.append(item);
		endif
	endforeach
	foreach tele in teleporters
		foreach nexttele in teleporters
			if (_nexttele_iter <= _tele_iter)
				continue;
			endif
			if (tele.objtype == nexttele.objtype)
				SetObjProperty (tele, "DestX", nexttele.x);
				SetObjProperty (tele, "DestY", nexttele.y);
				SetObjProperty (tele, "DestZ", nexttele.z);
				SetObjProperty (tele, "DestR", nexttele.realm);
				break;
			endif
		endforeach
		if (!GetObjProperty (tele, "DestX"))
			foreach nexttele in teleporters
				if (_nexttele_iter >= _tele_iter)
					break;
				endif
				if (tele.objtype == nexttele.objtype)
					SetObjProperty (tele, "DestX", nexttele.x);
					SetObjProperty (tele, "DestY", nexttele.y);
					SetObjProperty (tele, "DestZ", nexttele.z);
					SetObjProperty (tele, "DestR", nexttele.realm);
					break;
				endif
			endforeach
		endif
	endforeach
endfunction

program SyshookCloseCustomHouse ()
	Syslog ("Installing CloseCustomHouse syshook...");
	return 1;
endprogram