use math;
use os;
use uo;

include ":statichousing:include/settings";

var settings := STH_GetSettingsCfgElem("Settings");

program walk_on_bantile(who, tile)
	var signserial := CInt(GetObjProperty(tile, "signserial"));
	var sign := SystemFindObjectBySerial(signserial);
	var banlist := GetObjProperty(sign, "banlist");
	if(sign.IsCoOwnerOrOwner(who))
		sign.RefreshHouse();
	endif
	if(!banlist)
		return;
	endif
	if(who.serial in banlist)
		sign.BootBannedFromHouse(who);
	endif
endprogram

// 2026-09-03: GetBanTileDropSpot()/FindBanTileDropNear()/IsBanTileSpot() (the
// safe-drop-spot search added 2026-08-12) moved to the shared method script
// (:house:multiSign/method, exported as sign.GetBanTileDropSpot()) so other
// ban-enforcement call sites (secure containers, lockdown/release) can reuse
// it via sign.BootBannedFromHouse() instead of a third duplicate copy.
// house/walkOn.src had a byte-for-byte duplicate that moved the same way.
