//////////////////////////////////////////////////////////////////////////////////////////
//
// vitalInit.src -- Max-value and regen-rate hooks for Life/Mana/Stamina, wired via
// ../config/vitals.cfg. Replaces pkg/opt/shilhook/regen.src, which ran POLMD's own
// deprecated pre-0.98 flat-CProp regen shim. This is the current ModernDistro
// pattern instead: config-driven, dice-string-capable, per-instance-cached max
// values, and a stacking-safe regen-rate modifier dictionary (see ../include/regen.inc).
//
// 2026-09-30: CustomHitsLevel/CustomManaLevel/CustomStaminaLevel are retired. Every NPC
// template carries HITS/MANA/STAM fields; per-instance overrides go through
// ../include/npcvitals.inc (SetNpcVitalOverride), which writes the same cache entry the
// lookup below reads first. The old "firstTimeCustomHp"/"CustomHPFix" refill band-aid is
// gone too -- it only existed because modsetup.inc used to reset current HP to Str at AI
// start; that now fills to GetMaxHp instead.
//
//////////////////////////////////////////////////////////////////////////////////////////

use uo;
use vitals;
use attributes;
use cfgfile;
use basicio;                       // Print

include "include/attributes";
include ":attributes:regen";
include ":attributes:npcvitals";

// Decision 3 (2026-09-30): a template missing a vital field falls back to attribute x100 and
// logs ONE console warning per template+field so the gap gets noticed and fixed in npcdesc.cfg.
var npcvitals_warned := dictionary;

program VitalInit()
	Print( "using vitalInit.ecl..." );
	return 1;
endprogram

function NpcVitalOrFallback( who, vitalfield, fallback )

	var value := GetNpcVitalSetting( who, vitalfield );
	if( value >= 0 )
		return value;
	endif

	var key := CStr( who.npctemplate ) + ":" + vitalfield;
	if( !npcvitals_warned.exists( key ) )
		npcvitals_warned.insert( key, 1 );
		Print( "vitalInit: npc template '" + who.npctemplate + "' has no " + vitalfield + " field -- using attribute x100. Add one to config/npcdesc.cfg." );
	endif

	return fallback;

endfunction

exported function GetLifeRegenRateExported( who )

	var dict := GetVitalRegenRateModDict(who, VITALID_LIFE);

	// Poison is a hard suppression, not a stackable penalty (matches today's
	// flat SetHpRegenRate(who,-1)): it overrides everything else outright
	// rather than merely subtracting from it.
	if (dict.exists("poison"))
		return Cint(dict["poison"]);
	endif

	var total := CORE_SETTINGS_DEFAULT_REGEN_RATE;
	foreach modname in (dict.keys())
		total := total + Cint(dict[modname]);
	endforeach

	return ClampRegenRate(total);

endfunction

exported function GetLifeMaximumValueExported( who )

	var life := GetAttribute(who, ATTRIBUTEID_STRENGTH) * 100;

	if (who.isa(POLCLASS_NPC))
		life := NpcVitalOrFallback( who, "HITS", life );
	endif

	return life;

endfunction

exported function GetManaRegenRateExported( who )
	return ClampRegenRate(CORE_SETTINGS_DEFAULT_REGEN_RATE + GetVitalRegenRateMod(who, VITALID_MANA));
endfunction

exported function GetManaMaximumValueExported( who )

	var mana := GetAttribute(who, ATTRIBUTEID_INTELLIGENCE) * 100;

	if (who.isa(POLCLASS_NPC))
		mana := NpcVitalOrFallback( who, "MANA", mana );
	endif

	return mana;

endfunction

exported function GetStaminaRegenRateExported( who )
	return ClampRegenRate(CORE_SETTINGS_DEFAULT_REGEN_RATE + GetVitalRegenRateMod(who, VITALID_STAMINA));
endfunction

exported function GetStaminaMaximumValueExported( who )

	var stam := GetAttribute(who, ATTRIBUTEID_DEXTERITY) * 100;

	if (who.isa(POLCLASS_NPC))
		stam := NpcVitalOrFallback( who, "STAM", stam );
	endif

	return stam;

endfunction
