        For FantasiaShard.com
        
        2009-06-04
        
        Last Modifications 2009-10-25
             * Cleaned codes for better performances
             
        Last Modifications 2010-03-10
             * Fixed problems with return values when should fail connecting.
        
        Description: Auto Account Creator. Just like many of you know this is a RunUO/SphereServer
        feature and now a POL feature. What it does exactly is when a person trys to login with
        an unknown(non-existant) account. This script creates the account and logs them in.
        Bugs: There shouldn't be any, but you never really know. So if a bug does come up
        please send me an email or post on the forum where you got this(polserver.com)
*/
use uo;
use os;
use polsys;

include ":accounts:accounts";
include ":accounts:settings";
include ":security:report";
include "include/security";
include "include/string"; // Added for RemoveSpaces()

CONST OFFSET_ACCOUNT_NAME	:= 0x01;
CONST OFFSET_ACCOUNT_PASS	:= 0x1F;
CONST INFO_LEN			:= 30;

// 2026-10-01: where the same two fields sit in the game-login packet (0x91).
CONST OFFSET_GAME_ACCOUNT_NAME	:= 0x05;
CONST OFFSET_GAME_ACCOUNT_PASS	:= 0x23;

enum THEFT_LEVELS
	ACCT_NOT_EXIST		:= 0,
	ACCT_LOGIN_OKAY		:= 1,
	ACCT_LOGIN_FAIL		:= 2,
	ACCT_LOGIN_HACK		:= 3,
	ACCT_NO_DISCORDID	:= 4,
endenum

program Install()

	Print( "INSTALLING: Auto Account/Theft Prevention." );
 
	return 1;
endprogram

exported function LoginHook( connection, byref packet )

	// RemoveSpaces() will also remove null values
	var username := packet.GetString( OFFSET_ACCOUNT_NAME, INFO_LEN );
	var password := packet.GetString( OFFSET_ACCOUNT_PASS, INFO_LEN );
	// Auto-created accounts have no way to supply a real DiscordID from this
	// packet (username/password only), so they're created without one and
	// stay unable to log in again (ACCT_NO_DISCORDID) until staff link one,
	// e.g. via .mkaccount-style linkage. Kept explicit rather than
	// uninitialized so CreateNewAccount() below always gets real values.
	var discordID := "", pin := 0;

	if( username == error )
		return 0;
	elseif( password == error )
		return 0;
	endif

	if(GetGlobalProperty( "blockLogin" ))
		ACCT_DebugPrint( "Login blocked by global flag for user=" + username + " ip=" + connection.ip );
		DeniedMSG( connection, 8);
		return 0;
	endif

	username := Lower( username );
	password := password;

	var theft_level := AcctHackChecks( username, password, connection.ip );
	ACCT_DebugPrint( "LoginHook theft_level=" + CStr( theft_level ) + " user=" + username + " ip=" + connection.ip );
	case( theft_level )
		ACCT_NOT_EXIST:	 // Account doesn't yet exist.
			ACCT_DebugPrint( "LoginHook: account not found for user=" + username );
			break;
		ACCT_LOGIN_OKAY: // Account credentials are valid.
			// 2026-10-01: refusals are final. Returning 0 hands the packet back to the core,
			// which carries on with the normal login whatever message was sent first;
			// RefuseLogin() returns 1, which stops it here. Reason 6 is the client's
			// "concurrency limit" message.
			if( !ACCT_CheckAccountLoginPolicy( username ))
				return RefuseLogin( connection, 6 );
			endif
			ACCT_DebugPrint( "LoginHook: credentials accepted for user=" + username );
			return 0;
			break;
		ACCT_LOGIN_FAIL: // Account credentials are invalid.
			ACCT_DebugPrint( "LoginHook: invalid credentials for user=" + username );
			DeniedMSG( connection, 4);
			return 0;
			break;
		ACCT_LOGIN_HACK: // Too many invalid logins for this IP.
			ACCT_DebugPrint( "LoginHook: hack lockout for user=" + username + " ip=" + connection.ip );
			// 2026-10-01: was "return 0", so the core accepted the right password during a
			// lockout and the lockout stopped nothing. Reason 3 is "account blocked".
			return RefuseLogin( connection, 3 );
			break;
		ACCT_NO_DISCORDID:
			ACCT_DebugPrint( "LoginHook: missing DiscordID for user=" + username );
			return RefuseLogin( connection, 8 );
			break;
	endcase

	var settings := ACCT_GetSettingsCfgElem( "Settings" );
	
	if( !settings.AllowAutoAccounts )
		// Automatic account creation is disabled.
		return 0;
    endif

	var creation := ACCT_GetSettingsCfgElem( "AccountCreation" ),
		min_pass := CInt( creation.MinLengthPass ),
		min_account := CInt( creation.MinLengthAccount ),
		max_pass := CInt( creation.MaxLengthPass ),
		max_account := CInt( creation.MaxLengthAccount ),
		len_name := Len( username ),
		len_pass := Len( password );

	if( len_name < min_account )
			SysLog( "CreateAccount() Error: Username too short." );
			DeniedMSG( connection, 1);
			//DisconnectClient(connection);
			return 0;
	elseif( len_pass < min_pass )
			SysLog( "CreateAccount() Error: Password too short." );
			DeniedMSG( connection, 1);
			return 0;
	elseif( len_name > max_account )
			SysLog( "CreateAccount() Error: Username too long." );
			DeniedMSG( connection, 1);
			return 0;
	elseif( len_pass > max_pass )
			SysLog( "CreateAccount() Error: Password too long." );
			DeniedMSG( connection, 1);
			return 0;
	elseif( !Check_ValidChar( username ))
			SysLog( "CreateAccount() Error: Invalid Username." );
			DeniedMSG( connection, 1);
			return 0;
	elseif( !Check_ValidChar( password ))
			SysLog( "CreateAccount() Error: Invalid Password." );
			DeniedMSG( connection, 1);
			return 0;
	endif

	var account := CreateNewAccount( username, password, discordID, pin, settings.DefaultExpansion );

	account.Set_UO_Expansion( settings.DefaultExpansion );
	//Print(settings.DefaultExpansion);

	// In theory this should only return an error saying "Invalid parameter type".
	// Should never return "Account already exists" because we already looked for the
	// account and let POL handle it. And when it does return "Invalid parameter type"
	// we don't have to worry, POL will do the right job for us and just say that account
	// does not exist.

	if( account.errortext )
		SysLog( "CreateAccount() Error: "+account.errortext );
		return 0;
	endif

	ReportText( "AutoAccount Created:"+username+" IP: "+connection.ip, REPORT_CONSOLE+REPORT_SYSLOG );
    NotifyStaffOnline( "AutoAccount", "Created:"+CStr( username )+" IP: "+connection.ip );
        
	return 0;
endfunction

// 2026-10-01: tells the client why, drops the connection and returns 1, so the core does
// not go on to process the login packet.
function RefuseLogin( connection, reason )

	DeniedMSG( connection, reason );
	DisconnectClient( connection );

	return 1;
endfunction

// 2026-10-01: the game-login packet (0x91) checks the password as well, and a tool can send
// it without ever passing the login screen (0x80), so the lockout has to watch it too.
// Only the lockout acts here: a wrong password is counted, a locked-out address is dropped,
// and everything else is left to the core and to the world-entry check.
exported function GameLoginHook( connection, byref packet )

	var username := packet.GetString( OFFSET_GAME_ACCOUNT_NAME, INFO_LEN );
	var password := packet.GetString( OFFSET_GAME_ACCOUNT_PASS, INFO_LEN );

	if( username == error )
		return 0;
	elseif( password == error )
		return 0;
	endif

	username := Lower( username );

	var theft_level := AcctHackChecks( username, password, connection.ip );
	if( theft_level == ACCT_LOGIN_HACK )
		ACCT_DebugPrint( "GameLoginHook: hack lockout for user=" + username + " ip=" + connection.ip );
		// No message: from this packet on the client expects a compressed stream, so a
		// plain refusal packet would not be readable. The login screen gives the reason.
		DisconnectClient( connection );
		return 1;
	endif

	return 0;
endfunction

function AcctHackChecks( username, password, ip )

	/*
	 * This is just a little password protection, so someone doesn't go around
	 * trying to steal peoples accounts trying 100's of passwords.
	 *
	 * 2026-09-21 rework:
	 *  - The lockout is checked BEFORE the password. It used to be looked at
	 *    only when the password was WRONG, so a locked-out address that sent
	 *    the right password got straight in -- guessing was slowed, never
	 *    blocked.
	 *  - FailureInterval is still SECONDS, as settings.cfg documents, but its
	 *    value there went 3 -> 180: failures only add up inside that window,
	 *    so at 3 seconds one guess every 4 seconds never reached
	 *    MaxLoginFailures.
	 *  - DisableGrace now does what settings.cfg says: an attempt during a
	 *    lockout re-arms it to DisableLength only while MORE than DisableGrace
	 *    minutes remain. The old test compared the lock's clock time to that
	 *    duration, which is always true, so every attempt re-armed the lock.
	 *  - The lock is per account AND per address, so someone guessing from
	 *    elsewhere can't lock the real owner out.
	 *
	 * 2026-10-01: the rework above still let a locked-out address in, because
	 * LoginHook answered ACCT_LOGIN_HACK with "return 0" and the core then ran
	 * its own login. Both hooks now refuse it themselves (LoginHook for packet
	 * 0x80, GameLoginHook for 0x91), and this function is called from both.
	 */

	var account := FindAccount( username );
	if( !account )
		ACCT_DebugPrint( "AcctHackChecks: account lookup failed for user=" + username );
		return ACCT_NOT_EXIST;
	endif

	var settings := ACCT_GetSettingsCfgElem( "Settings" );
	var max_failures := GetConfigInt( settings, "MaxLoginFailures" );
	var failure_interval := GetConfigInt( settings, "FailureInterval" );
	var disable_length := GetConfigInt( settings, "DisableLength" ) * 60;
	var disable_grace := GetConfigInt( settings, "DisableGrace" ) * 60;
	var time_now := POLCore().systime;

	var failed_login := account.GetProp( "#FailedLogin" );
	if( Lower( TypeOf( failed_login )) != "dictionary" )
		failed_login := dictionary{};
	endif

	// Nested ifs on purpose: this repo compiles with ShortCircuitEvaluation=0,
	// so "exists(ip) and failed_login[ip][1]..." would index a missing entry.
	// max_failures < 1 means the lockout is switched off in settings.cfg.
	if( max_failures >= 1 )
		if( failed_login.exists( ip ) )
			if( failed_login[ip][1] >= max_failures )
				if( failed_login[ip][2] >= time_now )
					if( ( failed_login[ip][2] - time_now ) > disable_grace )
						failed_login[ip][2] := time_now + disable_length;
						account.SetProp( "#FailedLogin", failed_login );
					endif
					ACCT_DebugPrint( "AcctHackChecks: locked out user=" + username + " ip=" + ip );
					return ACCT_LOGIN_HACK; // Refused by the caller, right password or not.
				endif

				// The lock has run out -- clean slate for this address.
				ReportText( "Lockout expired on account ["+username+"] - IP ["+ip+"]", REPORT_SYSLOG );
				failed_login.erase( ip );
				account.SetProp( "#FailedLogin", failed_login );
			endif
		endif
	endif

	if( !account.CheckPassword( password ))
		// Failures only add up while they keep arriving inside failure_interval
		// of each other; a gap longer than that starts the count again.
		var fail_count := 1;
		if( failed_login.exists( ip ) )
			if( failed_login[ip][2] >= time_now )
				fail_count := CInt( failed_login[ip][1] ) + 1;
			endif
		endif

		var locked_now := 0;
		if( max_failures >= 1 )
			if( fail_count >= max_failures )
				locked_now := 1;
			endif
		endif

		if( locked_now )
			failed_login[ip] := array{ fail_count, time_now + disable_length };
			ReportText( "Disabling account ["+username+"] - IP ["+ip+"] for "+disable_length+" seconds. Invalid logins >= "+max_failures+"." , REPORT_SYSLOG );
		else
			failed_login[ip] := array{ fail_count, time_now + failure_interval };
			ReportText( "Invalid login credentials for account: "+username+" IP: "+ip, REPORT_SYSLOG );
		endif

		account.SetProp( "#FailedLogin", failed_login );
		ACCT_DebugPrint( "AcctHackChecks: bad password for user=" + username + " ip=" + ip + " count=" + CStr( fail_count ) );
		return ACCT_LOGIN_FAIL; // Let pol tell the user it's an incorrect password.
	endif

	// Right password: forget this address's earlier failures.
	if( failed_login.exists( ip ) )
		failed_login.erase( ip );
		account.SetProp( "#FailedLogin", failed_login );
	endif

	if( !ACCT_NormalizeDiscordID( account.GetProp( "DiscordID" )))
		if( ACCT_AccountHasStaffAccess( account ))
			ACCT_DebugPrint( "AcctHackChecks: staff account without DiscordID allowed user=" + username );
			return ACCT_LOGIN_OKAY;
		endif

		ACCT_DebugPrint( "AcctHackChecks: resolved account=" + account.name + " staff=" + CStr( account.GetProp( "DefaultCmdLevel" )) + " missing DiscordID for user=" + username + " ip=" + ip );
		ACCT_DebugPrint( "AcctHackChecks: missing DiscordID for non-staff user=" + username + " ip=" + ip );
		ReportText( "No Discord ID for account: "+username+" IP: "+ip, REPORT_SYSLOG );
		return ACCT_NO_DISCORDID;
	endif

	// Passed password/hack check, let user login.
	ACCT_DebugPrint( "AcctHackChecks: password and DiscordID checks passed for user=" + username + " ip=" + ip );
	return ACCT_LOGIN_OKAY;
endfunction

function RemoveEndJunk( text )

	var begin := CAsc("!");
	var end := CAsc("~");

	while( 1 )
		if(( CAsc( text[Len( text )] ) < begin ) || ( CAsc( text[Len( text )] ) > end ))
			text[Len( text )] := "";
		else
			break;
		endif
		SleepMS(2);
	endwhile

	return CStr( text );
endfunction

function DeniedMSG( who, reason)
	if(!reason)
		return;
	endif

	// 2026-10-01: the reason is byte 1 of this 2-byte packet. The case below wrote it to
	// byte 2, which is past the end, so the engine refused the write and every refusal
	// reached the client as reason 0, "Incorrect name/password".
	var newpacket := CreatePacket(0x82, 2);
	newpacket.SetInt8(1, 0);

	case(reason)
		1:	//Incorrect name/password.
			newpacket.SetInt8(1,0x00);
			break;
		2:	//Someone is already using this account.
			newpacket.SetInt8(1,0x01);
			break;
		3:	//Your account has been blocked.
			newpacket.SetInt8(1,0x02);
			break;
		4:	//Your account credentials are invalid.
			newpacket.SetInt8(1,0x03);
			break;
		5:	//Communication problem.
			newpacket.SetInt8(1,0x04);
			break;
		6:	//The IGR concurrency limit has been met.
			newpacket.SetInt8(1,0x05);
			break;
		7:	//The IGR time limit has been met.
			newpacket.SetInt8(1,0x06);
			break;
		8:	//General IGR authentication failure.
			newpacket.SetInt8(1,0x07);
			break;
	endcase

	newpacket.SendPacket(who);
	return;
endfunction