use uo;
use os;

include ":accounts:accounts";
include ":alryc:include/speedwalk";

program Logon( who )

	// 2026-10-01: the login policy check that used to sit here now runs first thing in
	// scripts/misc/logon.src (ACCT_AdmitCharacter), which the engine runs before this
	// script, so a refused character is never announced. Only the bookkeeping is left.
	ACCT_SetLastLogin( who.acct );

	var speed_walk := GetObjProperty( who, "SpeedWalk" );
	if( who.cmdlevel >= 2 )
		if( !speed_walk.errortext )
			SendSpeedWalk( who, speed_walk );
		endif
	endif

	return 1;
endprogram
