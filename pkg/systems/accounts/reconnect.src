use uo;
use os;

include ":accounts:accounts";


program Reconnect( who )

	// 2026-10-01: the login policy check that used to sit here now runs first thing in
	// scripts/misc/reconnect.src (ACCT_AdmitCharacter), which the engine runs before this
	// script. Only the bookkeeping is left.
	ACCT_SetLastLogin( who.acct );

	return 1;
endprogram
