use uo;
use os;
use util;

include "include/spelldata";
include "include/damages";
include "include/dotempmods";
include "include/constants/locations";

program banishonhit( parms )

	var attacker 	:= parms[1];
	var defender 	:= parms[2];
	//var weapon 	:= parms[3];
	var armor 	:= parms[4];
	//var basedamage := parms[5];
	var rawdamage	:= parms[6];

	var summoned := GetObjProperty( attacker , "summoned" );
	var animated := GetObjProperty( attacker , "animated" );
	var cursed   := GetObjProperty( armor , "Cursed" );

	if (summoned)
		if( !cursed )
    			PlayObjectCenteredEffect( attacker , FX_SPELL_MANA_VAMPIRE, 7,7);
			PlaySoundEffect( defender , SFX_SPELL_MANA_VAMPIRE );
			PlayStationaryEffect( attacker.x, attacker.y, attacker.z, FX_SPELL_SUMMON_CREATURE, 0xA, 0xA, 0, attacker.realm );
			MoveObjectToLocation(attacker, DEFAULT_LOCATION_NPC_RELOCATION_X, DEFAULT_LOCATION_NPC_RELOCATION_Y, DEFAULT_LOCATION_NPC_RELOCATION_Z, DEFAULT_LOCATION_NPC_RELOCATION_R, MOVEOBJECT_FORCELOCATION);
			// was ApplyTheDamage(x,GetMaxHP(x)+n), silently no-ops above 65535 HP;
			// set KilledBy/KilledBySerial manually so RegisterNPC/ProcessQuestKill still credit the kill
			SetObjProperty( attacker, "KilledBy", defender.name );
			SetObjProperty( attacker, "KilledBySerial", defender.serial );
			attacker.kill();
		else
			PlayObjectCenteredEffect( defender , FX_SPELL_MANA_VAMPIRE, 7,7);
			PlaySoundEffect( attacker , SFX_SPELL_MANA_VAMPIRE );
			SetObjProperty( defender, "KilledBy", defender.name );
			SetObjProperty( defender, "KilledBySerial", defender.serial );
			defender.kill();
		endif

	elseif(animated)
		if( !cursed )
    			PlayObjectCenteredEffect( attacker, FX_SPELL_MANA_VAMPIRE, 7,7);
			PlaySoundEffect( defender , SFX_SPELL_MANA_VAMPIRE );
			SetObjProperty( attacker, "KilledBy", defender.name );
			SetObjProperty( attacker, "KilledBySerial", defender.serial );
			attacker.kill();
		else
			PlayObjectCenteredEffect( defender , FX_SPELL_MANA_VAMPIRE, 7,7);
			PlaySoundEffect( attacker , SFX_SPELL_MANA_VAMPIRE );
			SetObjProperty( defender, "KilledBy", defender.name );
			SetObjProperty( defender, "KilledBySerial", defender.serial );
			defender.kill();
		endif
	else
		ApplyTheDamage( defender , attacker , rawdamage );
	endif

endprogram
