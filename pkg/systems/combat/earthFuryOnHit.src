//////////////////////////////////////////////////////////////////////////////////////////
//
//	earthFuryOnHit :
//
//	Single-element trim of trielementalonhit - Earth. The base "Elemental
//	Fury" enchant is missing this element despite the "tri" name; written
//	for the rituals package's Perilous Theurgy (2026-08-26) so the ritual
//	can grant all 6 base elements individually, Earth included.
//
//////////////////////////////////////////////////////////////////////////////////////////
use uo;

include "include/spelldata";
include "include/damages";
include "include/random";

program earthFuryOnHit( parms )

	var attacker 	 := parms[1];
	var defender 	 := parms[2];
	var weapon 	 := parms[3];
	var armor 	 := parms[4];
	var basedamage := parms[5];
	var rawdamage	 := parms[6];

	var chance := GetObjProperty( armor , "ChanceOfEffect" );
	if(RandomDiceStr("1d100") <= chance)

		var targ;
		if( GetObjProperty( armor , "Cursed" ) )
			targ := defender;
		else
			targ := attacker;
		endif

		var spelldmg := (CalcSpellDamage( defender, targ , 5 ) * 0.5);
		spelldmg := Resisted( defender , targ , 9 , spelldmg );

        if(GetObjProperty( defender , CLASSEID_MAGE) || GetObjProperty( defender , CLASSEID_PALADIN) || GetObjProperty( defender , CLASSEID_MYSTIC_ARCHER))
            spelldmg *= 0.7;
        endif

		PlayStationaryEffect( targ.x , targ.y , targ.z , FX_SPELL_EARTHQUAKE, speed:=7, loop:=7 );
		PlaySoundEffect( targ , SFX_SPELL_EARTHQUAKE );
		ApplyElementalDamage( defender , targ , 1 , spelldmg , DMGID_EARTH );

		if(DEBUG_MODE)
			PrintTextAbovePrivate( defender , "I'm dealing this much spell damage: " +spelldmg, defender );
		endif
	endif

	if( basedamage != rawdamage )
		rawdamage := rawdamage;
		if( rawdamage < 1 )
			rawdamage := 1;
		endif
	endif
	if(DEBUG_MODE)
        PrintTextAbovePrivate( attacker , "I'm dealing this much physical damage: " +rawdamage, attacker );
	endif
	ApplyTheDamage( defender , attacker , rawdamage );

endprogram
