use os;
use uo;
use cfgfile;
use datafile;

include ":areaspawner:areaspawner";

program AreaSpawnerFullRespawn(params)

	set_script_option( SCRIPTOPT_NO_RUNAWAY, 1 );

	var realm	:= params[1];
	var name	:= params[2];
	var prefix	:= "areaspawner";
	if( params.size() >= 3 )
		prefix := params[3];
	endif

	FullRespawnAreaSpawner(realm, name, prefix);

endprogram
