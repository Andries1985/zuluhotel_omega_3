// Synopsis: Manage area-based spawners (realm-scoped, datafile-backed, no world item)

use os;
use uo;
use cfgfile;
use datafile;

include ":areaspawner:areaspawner";
include "include/constants/gumpids";
include "include/client";

const AS_BTN_OK			:= 1;
const AS_BTN_DELETE			:= 2;
const AS_BTN_CANCEL			:= 3;
const AS_BTN_PICKAREA			:= 20;
const AS_BTN_ENTRIES			:= 21;
const AS_BTN_FULLRESPAWN		:= 22;
const AS_BTN_DELETESPAWNER		:= 23;
const AS_BTN_ADD			:= 9001;
const AS_BTN_PREV			:= 9002;
const AS_BTN_NEXT			:= 9003;
const AS_BTN_CLOSE			:= 9004;

const AS_CHK_ISGROUP			:= 52;
const AS_CHK_ROW_BASE			:= 60;	// per-row Enabled toggle on the list gump, id = base + row slot (1-8)

const AS_TXT_NAME			:= 100;
const AS_TXT_MINX			:= 101;
const AS_TXT_MAXX			:= 102;
const AS_TXT_MINY			:= 103;
const AS_TXT_MAXY			:= 104;
const AS_TXT_REF			:= 105;
const AS_TXT_MIN			:= 106;
const AS_TXT_MAX			:= 107;
const AS_TXT_FREQ			:= 108;


program textcmd_areaspawner(who)

	while(1)
		var realm := ShowRealmPicker(who);
		if( !realm )
			return;
		endif
		ShowSpawnerList(who, realm);
	endwhile

endprogram


function ShowRealmPicker(who)

	var realms := AreaSpawnerRealms();
	var labels := array{ "Britannia", "Britannia Alt", "Malas", "Tokuno", "Ilshenar", "Termur" };

	var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
		"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 260 "+CStr(60 + realms.size()*30) };
	var data := array{};
	var tid := 0;

	layout.append( "text 20 15 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
	data.append( "Area Spawner - Choose Realm" );
	tid := tid + 1;

	var i;
	var y := 45;
	for( i := 1; i <= realms.size(); i := i + 1 )
		layout.append( "text 55 "+CStr(y)+" "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
		data.append( labels[i] );
		tid := tid + 1;
		layout.append( "button 20 "+CStr(y-2)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_0)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_1)+" 1 0 "+CStr(i) );
		y := y + 30;
	endfor

	// CANCEL graphic already renders its own "Cancel" text, no extra label needed
	layout.append( "button 20 "+CStr(y)+" "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CLOSE) );

	var keyret := SendDialogGump( who, layout, data );
	if( !keyret || keyret[AS_BTN_CLOSE] )
		return "";
	endif

	for( i := 1; i <= realms.size(); i := i + 1 )
		if( keyret[i] )
			return realms[i];
		endif
	endfor

	return "";

endfunction


function ShowSpawnerList(who, realm)

	var page := 1;
	var perpage := 8;

	while(1)
		var names := GetAreaSpawnerNames(realm);

		var totalpages := 1;
		if( names.size() )
			totalpages := CInt((names.size()-1)/perpage) + 1;
		endif
		if( page > totalpages )
			page := totalpages;
		endif

		var startidx := ((page-1)*perpage) + 1;
		var endidx := startidx + perpage - 1;
		if( endidx > names.size() )
			endidx := names.size();
		endif

		var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
			"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 420 "+CStr(90 + perpage*26) };
		var data := array{};
		var tid := 0;

		layout.append( "text 20 15 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
		data.append( "Area Spawners: "+realm+" (page "+CStr(page)+"/"+CStr(totalpages)+")" );
		tid := tid + 1;

		var rownames := array{};
		var y := 50;
		var slot := 0;
		var idx;
		for( idx := startidx; idx <= endidx; idx := idx + 1 )
			slot := slot + 1;
			var sname := names[idx];
			var record := LoadAreaSpawner(realm, sname);
			var status := "off";
			var pop := "0/0";
			var isenabled := 0;
			if( record )
				if( record.enabled )
					status := "ON";
					isenabled := 1;
				endif
				pop := AreaSpawnerPopulationSummary(record);
			endif

			// unchecked (state 0) shows the X graphic, checked (state 1) shows the checkmark
			layout.append( "checkbox 20 "+CStr(y-2)+" "+CStr(GUMPID_BUTTON_STONE_X_0)+" "+CStr(GUMPID_BUTTON_STONE_CHECK_0)+" "+CStr(isenabled)+" "+CStr(AS_CHK_ROW_BASE+slot) );

			layout.append( "text 80 "+CStr(y)+" "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
			data.append( sname+"  ["+status+"]  pop:"+pop );
			tid := tid + 1;
			layout.append( "button 45 "+CStr(y-2)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_0)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_1)+" 1 0 "+CStr(slot) );

			rownames.append(sname);
			y := y + 26;
		endfor

		layout.append( "button 20 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_ADD_0)+" "+CStr(GUMPID_BUTTON_ADD_1)+" 1 0 "+CStr(AS_BTN_ADD) );
		layout.append( "text 55 "+CStr(y+12)+" "+CStr(Cint(COLOR_GREEN))+" "+CStr(tid) );
		data.append( "Add New Spawner" );
		tid := tid + 1;

		layout.append( "button 190 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_PREVIOUS_0)+" "+CStr(GUMPID_BUTTON_PREVIOUS_1)+" 1 0 "+CStr(AS_BTN_PREV) );
		layout.append( "button 230 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_NEXT_0)+" "+CStr(GUMPID_BUTTON_NEXT_1)+" 1 0 "+CStr(AS_BTN_NEXT) );
		// CANCEL graphic already renders its own "Cancel" text, no extra label needed
		layout.append( "button 300 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CLOSE) );

		var keyret := SendDialogGump( who, layout, data );
		if( !keyret )
			return;
		endif

		// Enabled checkboxes carry valid state on any submit, not just a specific
		// button - apply any toggles regardless of which button was pressed.
		var s;
		for( s := 1; s <= rownames.size(); s := s + 1 )
			var newenabled := Cint(keyret[AS_CHK_ROW_BASE+s]);
			var toggled := LoadAreaSpawner(realm, rownames[s]);
			if( toggled && Cint(toggled.enabled) != newenabled )
				toggled.enabled := newenabled;
				SaveAreaSpawner(realm, rownames[s], toggled, who);
				AreaSpawnerDebug("'"+rownames[s]+"' ("+realm+") enabled set to "+CStr(newenabled)+" via list toggle");
			endif
		endfor

		if( keyret[AS_BTN_CLOSE] )
			return;
		endif

		if( keyret[AS_BTN_ADD] )
			var newname := ShowNamePrompt(who);
			if( newname )
				if( CreateAreaSpawner(realm, newname, who) )
					ShowSpawnerEdit(who, realm, newname);
				else
					SendSysMessage(who, "A spawner named '"+newname+"' already exists (or couldn't be created).");
				endif
			endif
			continue;
		endif

		if( keyret[AS_BTN_PREV] )
			if( page > 1 )
				page := page - 1;
			endif
			continue;
		endif

		if( keyret[AS_BTN_NEXT] )
			if( page < totalpages )
				page := page + 1;
			endif
			continue;
		endif

		for( s := 1; s <= rownames.size(); s := s + 1 )
			if( keyret[s] )
				ShowSpawnerEdit(who, realm, rownames[s]);
				break;
			endif
		endfor
	endwhile

endfunction


function ShowNamePrompt(who)

	var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
		"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 300 120",
		"text 20 15 "+CStr(Cint(COLOR_YELLOW))+" 0",
		"textentry 20 45 250 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_NAME)+" 1",
		// OKAY/CANCEL graphics already render their own text, no extra labels needed
		"button 20 80 "+CStr(GUMPID_BUTTON_OKAY_0)+" "+CStr(GUMPID_BUTTON_OKAY_1)+" 1 0 "+CStr(AS_BTN_OK),
		"button 150 80 "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CANCEL) };
	var data := array{ "New Area Spawner - Enter a Name", "" };

	var keyret := SendDialogGump( who, layout, data );
	if( !keyret || keyret[AS_BTN_CANCEL] || !keyret[AS_BTN_OK] )
		return "";
	endif

	var name := keyret[AS_TXT_NAME] - (CStr(AS_TXT_NAME)+": ");
	if( !name )
		return "";
	endif

	return name;

endfunction


function ShowSpawnerEdit(who, realm, name)

	var done := 0;
	while( !done )
		var record := LoadAreaSpawner(realm, name);
		if( !record )
			SendSysMessage(who, "That area spawner no longer exists.");
			return;
		endif

		var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
			"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 420 360" };
		var data := array{};
		var tid := 0;

		layout.append( "text 20 15 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
		data.append( "Area Spawner: "+name+" ("+realm+") - use the list to toggle Enabled" );
		tid := tid + 1;

		layout.append( "text 20 50 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
		data.append( "Last picked area:" );
		tid := tid + 1;
		layout.append( "text 150 50 "+CStr(Cint(COLOR_GREEN))+" "+CStr(tid) );
		data.append( record.area_label ? record.area_label : "(custom box)" );
		tid := tid + 1;
		layout.append( "button 340 48 "+CStr(GUMPID_BUTTON_MINI_SCROLL_0)+" "+CStr(GUMPID_BUTTON_MINI_SCROLL_1)+" 1 0 "+CStr(AS_BTN_PICKAREA) );
		layout.append( "text 365 50 "+CStr(Cint(COLOR_GREEN))+" "+CStr(tid) );
		data.append( "Pick" );
		tid := tid + 1;

		layout.append( "text 20 120 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
		data.append( "Box minX/maxX/minY/maxY (Pick fills these in, or edit directly):" );
		tid := tid + 1;

		layout.append( "textentry 20 145 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_MINX)+" "+CStr(tid) );
		data.append( CStr(record.minx) );
		tid := tid + 1;
		layout.append( "textentry 90 145 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_MAXX)+" "+CStr(tid) );
		data.append( CStr(record.maxx) );
		tid := tid + 1;
		layout.append( "textentry 160 145 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_MINY)+" "+CStr(tid) );
		data.append( CStr(record.miny) );
		tid := tid + 1;
		layout.append( "textentry 230 145 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_MAXY)+" "+CStr(tid) );
		data.append( CStr(record.maxy) );
		tid := tid + 1;

		layout.append( "text 20 180 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
		data.append( "Population:" );
		tid := tid + 1;
		layout.append( "text 220 180 "+CStr(Cint(COLOR_GREEN))+" "+CStr(tid) );
		data.append( AreaSpawnerPopulationSummary(record) );
		tid := tid + 1;

		layout.append( "button 20 215 "+CStr(GUMPID_BUTTON_OKAY_0)+" "+CStr(GUMPID_BUTTON_OKAY_1)+" 1 0 "+CStr(AS_BTN_ENTRIES) );
		layout.append( "text 55 217 "+CStr(Cint(COLOR_GREEN))+" "+CStr(tid) );
		data.append( "Entries / Edit Groups & NPCs" );
		tid := tid + 1;

		layout.append( "button 20 250 "+CStr(GUMPID_BUTTON_APPLY_0)+" "+CStr(GUMPID_BUTTON_APPLY_1)+" 1 0 "+CStr(AS_BTN_FULLRESPAWN) );
		layout.append( "text 55 252 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
		data.append( "Full Respawn (despawn + refill to max)" );
		tid := tid + 1;

		layout.append( "button 20 285 "+CStr(GUMPID_BUTTON_DELETE_0)+" "+CStr(GUMPID_BUTTON_DELETE_1)+" 1 0 "+CStr(AS_BTN_DELETESPAWNER) );
		layout.append( "text 55 287 "+CStr(Cint(COLOR_RED))+" "+CStr(tid) );
		data.append( "Delete Spawner" );
		tid := tid + 1;

		// CANCEL graphic already renders its own "Cancel" text, no extra label needed
		layout.append( "button 20 320 "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CANCEL) );

		var keyret := SendDialogGump( who, layout, data );
		if( !keyret )
			return;
		endif

		record.minx := Cint(keyret[AS_TXT_MINX] - (CStr(AS_TXT_MINX)+": "));
		record.maxx := Cint(keyret[AS_TXT_MAXX] - (CStr(AS_TXT_MAXX)+": "));
		record.miny := Cint(keyret[AS_TXT_MINY] - (CStr(AS_TXT_MINY)+": "));
		record.maxy := Cint(keyret[AS_TXT_MAXY] - (CStr(AS_TXT_MAXY)+": "));

		SaveAreaSpawner(realm, name, record, who);

		if( keyret[AS_BTN_PICKAREA] )
			var picked := ShowAreaPicker(who, realm);
			if( picked )
				var picked_box := LookupAreaCfgBox(realm, picked);
				if( picked_box )
					record.minx := picked_box.minx;
					record.maxx := picked_box.maxx;
					record.miny := picked_box.miny;
					record.maxy := picked_box.maxy;
					record.area_label := picked_box.label ? picked_box.label : picked;
					SaveAreaSpawner(realm, name, record, who);
				endif
			endif
		elseif( keyret[AS_BTN_ENTRIES] )
			ShowEntriesList(who, realm, name);
		elseif( keyret[AS_BTN_FULLRESPAWN] )
			Start_Script( ":areaspawner:areaspawnerfullrespawn", array{realm,name} );
			SendSysMessage(who, "Full respawn triggered for '"+name+"'.");
		elseif( keyret[AS_BTN_DELETESPAWNER] )
			if( ShowConfirm(who, "Delete area spawner '"+name+"'? This despawns everything it's tracking.") )
				Start_Script( ":areaspawner:areaspawnerdeleterunner", array{realm,name} );
				SendSysMessage(who, "Deleting '"+name+"'.");
				done := 1;
			endif
		else
			done := 1;
		endif
	endwhile

endfunction


function ShowAreaPicker(who, realm)

	var lines := GetRealmAreaLines(realm);
	if( lines == error || !lines )
		SendSysMessage(who, "No areas configured for realm '"+realm+"'.");
		return "";
	endif

	var infos := array{};
	foreach line in lines
		var info := ParseAreaLine(line);
		if( info != error )
			infos.append(info);
		endif
	endforeach

	var page := 1;
	var perpage := 10;

	while(1)
		var totalpages := 1;
		if( infos.size() )
			totalpages := CInt((infos.size()-1)/perpage) + 1;
		endif
		if( page > totalpages )
			page := totalpages;
		endif

		var startidx := ((page-1)*perpage) + 1;
		var endidx := startidx + perpage - 1;
		if( endidx > infos.size() )
			endidx := infos.size();
		endif

		var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
			"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 420 "+CStr(80 + perpage*24) };
		var data := array{};
		var tid := 0;

		layout.append( "text 20 15 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
		data.append( "Pick Area ("+realm+") page "+CStr(page)+"/"+CStr(totalpages) );
		tid := tid + 1;

		var rowids := array{};
		var y := 50;
		var slot := 0;
		var idx;
		for( idx := startidx; idx <= endidx; idx := idx + 1 )
			slot := slot + 1;
			var info := infos[idx];
			layout.append( "text 55 "+CStr(y)+" "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
			data.append( info.area_id+"  -  "+info.name );
			tid := tid + 1;
			layout.append( "button 20 "+CStr(y-2)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_0)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_1)+" 1 0 "+CStr(slot) );
			rowids.append(info.area_id);
			y := y + 24;
		endfor

		layout.append( "button 190 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_PREVIOUS_0)+" "+CStr(GUMPID_BUTTON_PREVIOUS_1)+" 1 0 "+CStr(AS_BTN_PREV) );
		layout.append( "button 230 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_NEXT_0)+" "+CStr(GUMPID_BUTTON_NEXT_1)+" 1 0 "+CStr(AS_BTN_NEXT) );
		// CANCEL graphic already renders its own "Cancel" text, no extra label needed
		layout.append( "button 300 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CLOSE) );

		var keyret := SendDialogGump( who, layout, data );
		if( !keyret || keyret[AS_BTN_CLOSE] )
			return "";
		endif

		if( keyret[AS_BTN_PREV] )
			if( page > 1 )
				page := page - 1;
			endif
			continue;
		endif

		if( keyret[AS_BTN_NEXT] )
			if( page < totalpages )
				page := page + 1;
			endif
			continue;
		endif

		var s;
		for( s := 1; s <= rowids.size(); s := s + 1 )
			if( keyret[s] )
				return rowids[s];
			endif
		endfor
	endwhile

endfunction


function ShowEntriesList(who, realm, name)

	var page := 1;
	var perpage := 8;

	while(1)
		var record := LoadAreaSpawner(realm, name);
		if( !record )
			return;
		endif

		var totalpages := 1;
		if( record.entries.size() )
			totalpages := CInt((record.entries.size()-1)/perpage) + 1;
		endif
		if( page > totalpages )
			page := totalpages;
		endif

		var startidx := ((page-1)*perpage) + 1;
		var endidx := startidx + perpage - 1;
		if( endidx > record.entries.size() )
			endidx := record.entries.size();
		endif

		var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
			"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 460 "+CStr(90 + perpage*26) };
		var data := array{};
		var tid := 0;

		layout.append( "text 20 15 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
		data.append( "Entries: "+name+" (page "+CStr(page)+"/"+CStr(totalpages)+")" );
		tid := tid + 1;

		var rowids := array{};
		var y := 50;
		var slot := 0;
		var idx;
		for( idx := startidx; idx <= endidx; idx := idx + 1 )
			slot := slot + 1;
			var entry := record.entries[idx];
			var summary := entry.source+":"+CStr(entry.ref)+"  "+CStr(entry.min)+"-"+CStr(entry.max)+" @"+CStr(entry.frequency)+"s  ("+CStr(entry.serials.size())+"/"+CStr(entry.target)+")";

			layout.append( "text 55 "+CStr(y)+" "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
			data.append( summary );
			tid := tid + 1;
			layout.append( "button 20 "+CStr(y-2)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_0)+" "+CStr(GUMPID_BUTTON_CIRCLE_GRAY_1)+" 1 0 "+CStr(slot) );

			rowids.append(entry.id);
			y := y + 26;
		endfor

		layout.append( "button 20 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_ADD_0)+" "+CStr(GUMPID_BUTTON_ADD_1)+" 1 0 "+CStr(AS_BTN_ADD) );
		layout.append( "text 55 "+CStr(y+12)+" "+CStr(Cint(COLOR_GREEN))+" "+CStr(tid) );
		data.append( "Add Entry" );
		tid := tid + 1;

		layout.append( "button 190 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_PREVIOUS_0)+" "+CStr(GUMPID_BUTTON_PREVIOUS_1)+" 1 0 "+CStr(AS_BTN_PREV) );
		layout.append( "button 230 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_NEXT_0)+" "+CStr(GUMPID_BUTTON_NEXT_1)+" 1 0 "+CStr(AS_BTN_NEXT) );
		// CANCEL graphic already renders its own "Cancel" text, no extra label needed
		layout.append( "button 300 "+CStr(y+10)+" "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CLOSE) );

		var keyret := SendDialogGump( who, layout, data );
		if( !keyret || keyret[AS_BTN_CLOSE] )
			return;
		endif

		if( keyret[AS_BTN_ADD] )
			ShowEntryEditor(who, realm, name, 0);
			continue;
		endif

		if( keyret[AS_BTN_PREV] )
			if( page > 1 )
				page := page - 1;
			endif
			continue;
		endif

		if( keyret[AS_BTN_NEXT] )
			if( page < totalpages )
				page := page + 1;
			endif
			continue;
		endif

		var s;
		for( s := 1; s <= rowids.size(); s := s + 1 )
			if( keyret[s] )
				ShowEntryEditor(who, realm, name, rowids[s]);
				break;
			endif
		endfor
	endwhile

endfunction


function ShowEntryEditor(who, realm, name, entry_id)

	var record := LoadAreaSpawner(realm, name);
	if( !record )
		return;
	endif

	var source := "group";
	var ref := "";
	var emin := 1;
	var emax := 1;
	var efreq := 60;
	var isnew := 1;

	if( entry_id )
		var idx := FindAreaSpawnerEntryIndex(record, entry_id);
		if( idx )
			var entry := record.entries[idx];
			source := entry.source;
			ref := CStr(entry.ref);
			emin := entry.min;
			emax := entry.max;
			efreq := entry.frequency;
			isnew := 0;
		endif
	endif

	var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
		"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 340 300" };
	var data := array{};
	var tid := 0;

	layout.append( "text 20 15 "+CStr(Cint(COLOR_YELLOW))+" "+CStr(tid) );
	data.append( isnew ? "New Entry" : "Edit Entry" );
	tid := tid + 1;

	layout.append( "text 20 50 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
	data.append( "Group (checked) / NPC template (unchecked):" );
	tid := tid + 1;
	layout.append( "checkbox 280 50 "+CStr(GUMPID_BUTTON_STONE_X_0)+" "+CStr(GUMPID_BUTTON_STONE_CHECK_0)+" "+CStr(source=="group"?1:0)+" "+CStr(AS_CHK_ISGROUP) );

	layout.append( "text 20 80 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
	data.append( "Group# or NPC Template:" );
	tid := tid + 1;
	layout.append( "textentry 200 78 100 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_REF)+" "+CStr(tid) );
	data.append( ref );
	tid := tid + 1;

	layout.append( "text 20 110 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
	data.append( "Min:" );
	tid := tid + 1;
	layout.append( "textentry 200 108 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_MIN)+" "+CStr(tid) );
	data.append( CStr(emin) );
	tid := tid + 1;

	layout.append( "text 20 140 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
	data.append( "Max:" );
	tid := tid + 1;
	layout.append( "textentry 200 138 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_MAX)+" "+CStr(tid) );
	data.append( CStr(emax) );
	tid := tid + 1;

	layout.append( "text 20 170 "+CStr(Cint(COLOR_BLUE_LIGHT))+" "+CStr(tid) );
	data.append( "Frequency (secs):" );
	tid := tid + 1;
	layout.append( "textentry 200 168 60 20 "+CStr(Cint(COLOR_GREEN))+" "+CStr(AS_TXT_FREQ)+" "+CStr(tid) );
	data.append( CStr(efreq) );
	tid := tid + 1;

	// OKAY/CANCEL graphics already render their own text, no extra labels needed
	layout.append( "button 20 220 "+CStr(GUMPID_BUTTON_OKAY_0)+" "+CStr(GUMPID_BUTTON_OKAY_1)+" 1 0 "+CStr(AS_BTN_OK) );

	layout.append( "button 140 220 "+CStr(GUMPID_BUTTON_DELETE_0)+" "+CStr(GUMPID_BUTTON_DELETE_1)+" 1 0 "+CStr(AS_BTN_DELETE) );
	layout.append( "text 175 222 "+CStr(Cint(COLOR_RED))+" "+CStr(tid) );
	data.append( isnew ? "" : "Delete" );
	tid := tid + 1;

	layout.append( "button 260 220 "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CANCEL) );

	var keyret := SendDialogGump( who, layout, data );
	if( !keyret || keyret[AS_BTN_CANCEL] )
		return;
	endif

	if( keyret[AS_BTN_DELETE] && !isnew )
		if( ShowConfirm(who, "Remove this entry? Any mobs it spawned will be despawned.") )
			record := RemoveAreaSpawnerEntryAndDespawn(record, entry_id);
			SaveAreaSpawner(realm, name, record, who);
		endif
		return;
	endif

	if( !keyret[AS_BTN_OK] )
		return;
	endif

	var newsource := keyret[AS_CHK_ISGROUP] ? "group" : "npc";
	var newref := keyret[AS_TXT_REF] - (CStr(AS_TXT_REF)+": ");
	if( newsource == "group" )
		newref := CInt(newref);
	endif
	var newmin := Cint(keyret[AS_TXT_MIN] - (CStr(AS_TXT_MIN)+": "));
	var newmax := Cint(keyret[AS_TXT_MAX] - (CStr(AS_TXT_MAX)+": "));
	var newfreq := Cint(keyret[AS_TXT_FREQ] - (CStr(AS_TXT_FREQ)+": "));

	if( isnew )
		record := AddAreaSpawnerEntry(record, newsource, newref, newmin, newmax, newfreq);
	else
		record := UpdateAreaSpawnerEntry(record, entry_id, newsource, newref, newmin, newmax, newfreq);
	endif

	SaveAreaSpawner(realm, name, record, who);

endfunction


function ShowConfirm(who, prompt)

	var layout := array{ "page 0", GUMPID_SETTING_NO_DISPOSE,
		"resizepic 0 0 "+CStr(GUMPID_BKGND_STONESLAB)+" 320 140",
		"text 20 15 "+CStr(Cint(COLOR_RED))+" 0",
		// OKAY/CANCEL graphics already render their own text, no extra labels needed
		"button 40 90 "+CStr(GUMPID_BUTTON_OKAY_0)+" "+CStr(GUMPID_BUTTON_OKAY_1)+" 1 0 "+CStr(AS_BTN_OK),
		"button 180 90 "+CStr(GUMPID_BUTTON_CANCEL_0)+" "+CStr(GUMPID_BUTTON_CANCEL_1)+" 1 0 "+CStr(AS_BTN_CANCEL) };
	var data := array{ prompt };

	var keyret := SendDialogGump( who, layout, data );
	if( !keyret || !keyret[AS_BTN_OK] )
		return 0;
	endif

	return 1;

endfunction
