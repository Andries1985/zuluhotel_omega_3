// Synopsis: Manage area-based spawners (realm-scoped, datafile-backed, no world item)

use os;
use uo;
use cfgfile;
use datafile;

include ":areaspawner:areaspawner";
include ":areaspawner:areaspawnergump";

program textcmd_areaspawner(who)

	while(1)
		var kind := ShowSpawnerTypePicker(who, "Area Spawner - Choose Type");
		if( !kind )
			return;
		endif

		// ShowSpawnerTypePicker only ever returns one of these 5 kinds (or ""
		// for cancel, handled above) - every kind is fully built now, so
		// there's no longer a "not implemented yet" case to fall through to
		var prefix := AreaSpawnerKindPrefix(kind, 0);
		while(1)
			var realm := ShowRealmPicker(who, "Area Spawner - Choose Realm");
			if( !realm )
				break;
			endif
			ShowSpawnerList(who, realm, prefix, AreaSpawnerTypeLabel(kind)+" Spawners", kind);
		endwhile
	endwhile

endprogram
