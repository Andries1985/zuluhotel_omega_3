use os;
use uo;
use cfgfile;
use datafile;

include ":areaspawner:areaspawner";

// No more constant polling - individual spawners are kept full by on-demand
// kicks (Enable toggled on, entry added/edited, a death) fired from
// areaspawnergump.inc / RemoveAreaSpawnerSerial. This script only exists to
// (a) prime every already-enabled spawner once at shard boot, since nothing
// else would kick a fully-idle-but-enabled spawner after a restart, and
// (b) run the rare coarse safety-net sweep, mirroring spawnpoint's allspawner.
program AreaSpawnerManager()

	set_script_option( SCRIPTOPT_NO_RUNAWAY, 1 );
	set_priority(5);

	AreaSpawnerKickAllEnabled(0);

	while(1)
		Sleep(AREASPAWNER_SAFETYNET_INTERVAL);
		AreaSpawnerKickAllEnabled(0);
	endwhile

endprogram
