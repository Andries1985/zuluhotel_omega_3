// Synopsis: Reset a targeted player's Powerhour usage and tracking properties.
//Reset Powerhour on a Player

use os;
use uo;

include "include/client";
include ":powerhour:include/powerhour"; // 2026-10-08: shared property names and PPH_ClearFlags

program resetph( who )

    var mobile := target(who);
    
    if (!mobile)
        SendSysMessage(who, "Canceled", FONT_NORMAL, 43);
        return 0;
    endif

    if (mobile.isa(POLCLASS_NPC)) // 2026-09-22: was == POLCLASS_NPC (a number), never true
        SendSysMessage(who, "You cannot reset Powerhour on NPCs.", FONT_NORMAL, 43);
        return 0;
    endif

    SetObjProperty(mobile, "usedpph", 0);

    EraseObjProperty(mobile, PPH_PROP_USE_TIME);
    EraseObjProperty(mobile, PPH_PROP_WEEKDAY);

    PPH_ClearFlags(mobile);
    // 2026-10-08: the durable type too -- left behind, the next logon would try to resume a reset hour.
    EraseObjProperty(mobile, PPH_PROP_ACTIVE);

    // activateph() (setph.src) is sleeping out the hour in its own script
    // instance and stores its PID here -- kill it directly instead of
    // waiting for it to wake up on its own.
    var pph_pid := GetObjProperty(mobile, PPH_PROP_PID);
    if(pph_pid)
        var process := GetProcess(CInt(pph_pid));
        if(process)
            process.kill();
        endif
    endif
    EraseObjProperty(mobile, PPH_PROP_PID);

    EraseObjProperty(mobile, PPH_PROP_SETTING);

endprogram