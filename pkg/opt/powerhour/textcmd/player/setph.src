// Synopsis: Activate your hunting power hour bonus
use uo;
use os;

include "include/client";
include ":mdgumps:gumps_ex";
// 2026-10-08: eligibility, type names and the end-of-hour cleanup come from the shared include
// (same rule .ph shows); the local week/hour/starttime constants and their copy of the rule are gone.
include ":powerhour:include/powerhour";

const ph_gump_id := 3900;
const ph_title_color := 1097;
const ph_option_color := 2212;
const ph_radio_off := 5844;
const ph_radio_on := 5845;

const btn_cancel := 1;
const btn_okay := 2;

program textcmd_setPH(who)

	var time_now := POLCore().systime;

	var active := PPH_ActiveType(who);
	if(active)
		SendSysMessage( who, "You are already under the influence of the " + PH_TypeName(active) + " Powerhour!", FONT_BOLD, PH_MSG_COLOR_BAD );
		SendSysMessage( who, "Remaining minutes left: " + CInt(PPH_SecondsRemaining(who, time_now) / PH_MINUTE), FONT_BOLD, PH_MSG_COLOR_GOOD );
		return;
	endif

	if( GetObjProperty(who, "#SettingPH") == 1)
		SendSysMessage( who, "You have the gump window open already!", FONT_NORMAL, 2595 );
		return 0;
	endif

	if( PPH_IsEligible(who, time_now) )

		SetObjProperty(who, "#SettingPH", 1);

		var gumpdata := SendPHGump(who);
		if(!gumpdata || !gumpdata[btn_okay])
			SendSysMessage( who, "Canceled.", FONT_NORMAL, 2595 );
			EraseObjProperty(who, "#SettingPH");
			return;
		endif

		// 2026-10-10: the radios are read directly (as ZH2.5 1.1.4 does); the old loop over
		// "gumpdata.keys" had no parentheses, a member read that may yield nothing (gotcha 22).
		var playerchoice := 0;
		if(gumpdata[100])
			playerchoice := 100;
		elseif(gumpdata[200])
			playerchoice := 200;
		elseif(gumpdata[300])
			playerchoice := 300;
		endif

		// 2026-10-29: the same type running server-wide already gives everything a personal one would, so the
		// week's powerhour would be wasted; a different type still adds something (ZH2.5 1.1.5 port)
		var choice_type := PH_TYPE_NONE;
		if(playerchoice == 100)
			choice_type := PH_TYPE_HUNT;
		elseif(playerchoice == 200)
			choice_type := PH_TYPE_RES;
		elseif(playerchoice == 300)
			choice_type := PH_TYPE_SKILL;
		endif
		if(choice_type != PH_TYPE_NONE)
			if(PH_ActiveType() == choice_type)
				SendSysMessage( who, "A server-wide " + PH_TypeName(choice_type) + " Powerhour is already running. Save your personal powerhour for later, or pick another type.", FONT_NORMAL, PH_MSG_COLOR_BAD );
				EraseObjProperty(who, "#SettingPH");
				return;
			elseif(PH_PendingType() == choice_type)
				SendSysMessage( who, "A server-wide " + PH_TypeName(choice_type) + " Powerhour is about to start. Save your personal powerhour for later, or pick another type.", FONT_NORMAL, PH_MSG_COLOR_BAD );
				EraseObjProperty(who, "#SettingPH");
				return;
			endif
		endif

		case(playerchoice)
			100:	activateph(who, "#PPHH");
			200:	activateph(who, "#PPHC");
			300:	activateph(who, "#PPHS");
			default:
				// No radio button was selected before OKAY was clicked -- without
				// this, #SettingPH is left set forever (nothing else clears it),
				// permanently locking the player out of .setph until a GM runs
				// .resetph.
				SendSysMessage( who, "You must select a powerhour option first.", FONT_NORMAL, 2595 );
				EraseObjProperty(who, "#SettingPH");
		endcase
	else
		SendSysMessage( who, "You have already started a Personal Powerhour this week. Try again next week!", FONT_NORMAL, 2595 );
	endif

endprogram


function SendPHGump(who)

	var width := 300;
	var height := 300;

	var gump := GFCreateGump(350, 200, width, height);
	GFDisposable(gump, 0);

	GFResizePic(gump, 0, 0, ph_gump_id, width, height);							// Resizable background (3900)

	//var title_x_correction := 25;	// GFTextMid's width estimate for "<[ ]" runs narrow, so nudge right to true-center it
	GFTextMid(gump, 30, 8, width-40, ph_title_color, "PERSONAL POWERHOUR");	// Title (in the title bar cutout at the top)

	var wrap_x := 30;
	var wrap_y := 66;
	GFDrawWrappedText(gump, wrap_x, wrap_y,
		GFWordWrap("Your Powerhour will continue if you disconnect.", 260), 2578);

	GFSetRadioGroup(gump, 1);

	var y_pos := 130;
	GFRadioButton(gump, 40, y_pos, ph_radio_off, ph_radio_on, 0, 100);
	GFTextLine(gump, 90, y_pos+2, ph_option_color, "Hunting Powerhour");

	y_pos += 34;
	GFRadioButton(gump, 40, y_pos, ph_radio_off, ph_radio_on, 0, 200);
	GFTextLine(gump, 90, y_pos+2, ph_option_color, "Half-resources Powerhour");

	y_pos += 34;
	GFRadioButton(gump, 40, y_pos, ph_radio_off, ph_radio_on, 0, 300);
	GFTextLine(gump, 90, y_pos+2, ph_option_color, "Double-skillgain Powerhour");

	var btn_width := 63;
	var btn_gap := 10;
	GFAddButton(gump, CInt(width/2) - btn_width - btn_gap, height-50, 243, 241, GF_CLOSE_BTN, btn_cancel);						// Cancel button (left of center)
	GFAddButton(gump, CInt(width/2) + btn_gap, height-50, 249, 248, GF_CLOSE_BTN, btn_okay);		// Okay button (right of center)

	return GFSendGump(who, gump);
endfunction


function activateph(who, choice)

	var use_time := POLCore().systime;

	SetObjProperty(who, choice, 1);

	SetObjProperty(who, "pph_use_time", use_time);
	SetObjProperty(who, "pph_use_weekday", PH_WeekdayOf(use_time));
	SetObjProperty(who, "#PPHPid", GetPid());		// Lets .resetph kill this sleeping instance directly
	// Durable (non-"#") record of which type is active -- "#"-prefixed
	// properties like "choice" itself aren't reliably persisted across a
	// server restart in this repo, but logon.src's resume-after-reboot logic
	// needs to know which of #PPHH/#PPHC/#PPHS to re-set. This is that
	// durable source of truth; logon.src reads it instead of the "#" flags.
	SetObjProperty(who, "pph_active_type", choice);

	SendSysMessage( who, "Your " + PH_TypeName(PPH_ActiveType(who)) + " Powerhour has started!", FONT_BOLD, PH_MSG_COLOR_GOOD );

	Sleep(PH_DURATION);

	// 2026-10-08 (from ZH2.5 1.1.4): reset (.resetph) and started again while we slept -- the new
	// powerhour, its flags and its pid are not ours to end.
	if(CInt(GetObjProperty(who, "pph_use_time")) != use_time)
		return;
	endif

	PPH_Finish(who); // 2026-10-08: shared with resumeph.src -- "has ended" message + flags, pid, active type
endfunction
