// Synopsis: Place, remove or respawn the Arcomage NPC spawnpoints (.arcomagenpcs place|remove|respawn|list|here <n>)
// 2026-10-23: new package. Points come from :arcomage:spawnpoints (config/spawnpoints.cfg).
// Each placed spawnpoint carries ArcomagePoint=<rule set #> and is listed in the global
// property ArcomagePoints, so remove/respawn touch these points and nothing else. Points are
// made with "despawn on destroy" on, so destroying one also removes its NPC.
use uo;
use os;
use basic;
use basicio;
use cfgfile;
use polsys;

include "include/constants/propids";

const ARCO_POINTS_CFG := ":arcomage:spawnpoints";
const ARCO_POINTS_GPROP := "ArcomagePoints";
const ARCO_POINT_TAG := "ArcomagePoint";
const ARCO_SPAWNPOINT_OBJTYPE := 0xA300;

program textcmd_arcomagenpcs( who, text )

	var args := SplitWords( Lower( text ) );
	case( args[1] )
		"place":   ArcoPlaceAll( who );
		"remove":  ArcoRemoveAll( who );
		"respawn":
			ArcoRemoveAll( who );
			ArcoPlaceAll( who );
		"list":    ArcoListPoints( who );
		"here":    ArcoHere( who, CInt( args[2] ) );
		default:
			SendSysMessage( who, "Usage: .arcomagenpcs place | remove | respawn | list | here <rule set #>" );
	endcase

endprogram

function ArcoGetRegistry()

	var registry := GetGlobalProperty( ARCO_POINTS_GPROP );
	if( !registry )
		registry := dictionary;
	endif
	return registry;

endfunction

// The live spawnpoint for rule set n, or 0.
function ArcoFindPoint( registry, n )

	var serial := CInt( registry[n] );
	if( !serial )
		return 0;
	endif
	var point := SystemFindObjectBySerial( serial );
	if( !point )
		return 0;
	elseif( point.objtype != ARCO_SPAWNPOINT_OBJTYPE )
		return 0;
	elseif( CInt( GetObjProperty( point, ARCO_POINT_TAG ) ) != n )
		return 0;
	endif
	return point;

endfunction

function ArcoPlaceAll( who )

	var cfg := ReadConfigFile( ARCO_POINTS_CFG );
	if( !cfg )
		SendSysMessage( who, "Can't read " + ARCO_POINTS_CFG + ".", 3, 38 );
		return 0;
	endif

	var registry := ArcoGetRegistry();
	var placed := 0;
	var already := 0;
	var no_coords := array;
	var failed := array;
	var keys := GetConfigIntKeys( cfg );
	keys.sort();
	foreach n in keys
		var elem := FindConfigElem( cfg, n );
		if( ArcoFindPoint( registry, n ) )
			already := already + 1;
			continue;
		endif
		var x := CInt( GetConfigInt( elem, "X" ) );
		var y := CInt( GetConfigInt( elem, "Y" ) );
		if( !x && !y )
			no_coords.append( n );
			continue;
		endif

		var pt_data := array{
			"NPC",                          // 1  type
			GetConfigString( elem, "Template" ), // 2  template
			1,                              // 3  max
			0,                              // 4  appear range
			0,                              // 5  wander range
			1,                              // 6  respawn delay, minutes
			0,                              // 7  disabled
			0,                              // 8  spawn in group
			1,                              // 9  despawn on destroy
			0,                              // 10 expire time
			0,                              // 11 expire count
			0,                              // 12 start hour
			0,                              // 13 end hour
			"Arcomage rule set " + CStr( n ), // 14 note
			0                               // 15 trigger tiles
		};
		var desc := GetItemDescriptor( ARCO_SPAWNPOINT_OBJTYPE );
		desc.Movable := 0;
		desc.CProps.insert( PROPID_SPAWNPOINT_SETTING, pt_data );
		desc.CProps.insert( ARCO_POINT_TAG, n );
		var point := CreateItemAtLocation( x, y, CInt( GetConfigInt( elem, "Z" ) ), desc, 1, GetConfigString( elem, "Realm" ) );
		if( !point )
			failed.append( CStr( n ) + " (" + point.errortext + ")" );
			continue;
		endif
		registry[n] := point.serial;
		placed := placed + 1;

		// Spawn now rather than waiting for the spawnpoint manager's next pass (as .forcespawn does).
		EraseObjProperty( point, PROPID_SPAWNPOINT_NEXT_SPAWNING );
		Start_Script( ":spawnpoint:checkpoint", point );
	endforeach

	SetGlobalProperty( ARCO_POINTS_GPROP, registry );

	SendSysMessage( who, "Arcomage: placed " + CStr( placed ) + ", already placed " + CStr( already ) + ".", 3, 68 );
	if( no_coords.size() )
		SendSysMessage( who, "No coordinates yet in spawnpoints.cfg for rule sets: " + ArcoJoin( no_coords ), 3, 53 );
	endif
	if( failed.size() )
		SendSysMessage( who, "Could not place: " + ArcoJoin( failed ), 3, 38 );
	endif
	return placed;

endfunction

function ArcoRemoveAll( who )

	var registry := ArcoGetRegistry();
	var removed := 0;
	var keys := registry.keys();
	foreach n in keys
		var point := ArcoFindPoint( registry, n );
		if( point )
			if( DestroyItem( point ) )
				removed := removed + 1;
			else
				SendSysMessage( who, "Could not remove the point for rule set " + CStr( n ) + ".", 3, 38 );
				continue;
			endif
		endif
		registry.erase( n );
	endforeach

	SetGlobalProperty( ARCO_POINTS_GPROP, registry );
	SendSysMessage( who, "Arcomage: removed " + CStr( removed ) + " spawnpoints and their NPCs.", 3, 68 );
	return removed;

endfunction

function ArcoListPoints( who )

	var cfg := ReadConfigFile( ARCO_POINTS_CFG );
	var rules_cfg := ReadConfigFile( ":arcomage:rulesets" );
	var registry := ArcoGetRegistry();
	var keys := GetConfigIntKeys( cfg );
	keys.sort();
	foreach n in keys
		var elem := FindConfigElem( cfg, n );
		var name := GetConfigString( FindConfigElem( rules_cfg, n ), "NpcName" );
		var status;
		var point := ArcoFindPoint( registry, n );
		if( point )
			status := "placed at " + CStr( point.x ) + " " + CStr( point.y ) + " " + CStr( point.z ) + " " + point.realm;
		elseif( !CInt( GetConfigInt( elem, "X" ) ) && !CInt( GetConfigInt( elem, "Y" ) ) )
			status := "no coordinates";
		else
			status := "not placed";
		endif
		SendSysMessage( who, CStr( n ) + ". " + name + ": " + status );
	endforeach

endfunction

// Prints a ready-to-paste spawnpoints.cfg block for where the admin stands.
function ArcoHere( who, n )

	if( n < 1 )
		SendSysMessage( who, "Usage: .arcomagenpcs here <rule set #>" );
		return 0;
	endif

	var lines := array{
		"Point " + CStr( n ),
		"{",
		"	Template        arcomage" + ArcoTwoDigits( n ),
		"	X               " + CStr( who.x ),
		"	Y               " + CStr( who.y ),
		"	Z               " + CStr( who.z ),
		"	Realm           " + who.realm,
		"}"
	};
	Print( "[Arcomage] spawnpoints.cfg block for rule set " + CStr( n ) + ":" );
	foreach line in lines
		Print( line );
		SendSysMessage( who, line, 3, 53 );
	endforeach
	SendSysMessage( who, "Also printed to the server console.", 3, 68 );
	return 1;

endfunction

function ArcoTwoDigits( n )

	if( n < 10 )
		return "0" + CStr( n );
	endif
	return CStr( n );

endfunction

function ArcoJoin( items )

	var joined := "";
	foreach item in items
		if( joined != "" )
			joined := joined + ", ";
		endif
		joined := joined + CStr( item );
	endforeach
	return joined;

endfunction
