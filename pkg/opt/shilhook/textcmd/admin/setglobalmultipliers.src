	// Text entries
	text_entries[SKILLID_FORENSICS+1]	:= GFTextEntry( gump, 210, 70 , 50, 20, 0, GetMultiplier( multipliers, SKILLID_FORENSICS	) );


	// Send the gump;
	var keyret := GFSendGump( who, gump );


	// Store the new info
	var i;
	var mult;

	for( i := 1; i <= len( text_entries ); i := i + 1 )
		mult := GFExtractData( keyret, text_entries[i] );
		if( !Cdbl( mult ) )
			mult := LOCKING_VALUE;
		else
			mult := Cdbl( mult );
		endif
		multipliers[i] :=  mult;
	endfor
	
	SetGlobalProperty( "SkillPointsMultiplier", multipliers );
		LogCommand(who, GetProcess(GetPid()).name, "Set Multipliers: "+multipliers);
endprogram


function GetMultiplier( the_multipliers, skillid )

	var multiplier := Cdbl( the_multipliers[skillid+1] );
	if( !multiplier )
		multiplier := "1.00";
	elseif( Cint( multiplier ) == LOCKING_VALUE )
		multiplier := "0.00";
	elseif( Cint( multiplier ) >= 0 )
		var units	:= Cint( multiplier );
		var decimals	:= Cint( Cint( multiplier * 100 ) - Cint( units * 100 ) );
		if( !decimals )
			decimals := "00";
		elseif( decimals < 10 )
			decimals := "0" + decimals;
		endif
		multiplier := units + "." + decimals;
	else
		var units	:= Abs(Cint( multiplier ));
		var decimals	:= Abs(Cint( Cint( multiplier * 100 ) - Cint( units * 100 ) ));
		if( !decimals )
			decimals := "00";
		elseif( decimals < 10 )
			decimals := "0" + decimals;
		endif
		multiplier := "-" + units + "." + decimals;
	endif
	
	return multiplier;
	
endfunction
