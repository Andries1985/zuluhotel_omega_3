// Synopsis: Set global economy multipliers for skills and resources
use uo;
use os;
use math;
use cfgfile;
include ":staff:include/staff";
include "include/client";
include ":mdgumps:gumps";
include ":mdgumps:gumps_ex";

const LOCKING_VALUE	:= 9999;

program set_var_multiplierss( who )

	var text_entries := array;
	var multipliers  := GetGlobalProperty( "SkillPointsMultiplier" );
	if( !multipliers )
		multipliers := array;
	endif
	
	
