/////////////////////////////////////////////////////////////////////////////
//  Dye Cabinet -- acts as its own dye bottle AND its own dye tub in one
//  double-click: picks a color directly (SelectColor, same as usedyes.src,
//  including its anti-exploit ban trap), then applies that color to a
//  targeted item (same permission checks as dyecheck.src). No bottle is
//  ever needed on it -- crafting-station rollout, 2026-09-12. Real dye
//  bottles must stay tub-only; this cabinet is deliberately NOT one of the
//  objtypes usedyes.src recognizes as a valid tub target.
/////////////////////////////////////////////////////////////////////////////

use os;
use uo;
use cfgfile;
use vitals;

include "include/attributes";
include ":containers:storageAreas";

var ALLOWED := 0;
var cmdlvl := 0;
var dye_cfg := ReadConfigFile( "dyeitems" );

program dyecabinet( who, cabinet )

	if( !ReserveItem(cabinet) )
		return;
	endif

	var color := SelectColor( who, cabinet );

	if( color > 1001 )
		// Same anti-exploit trap as usedyes.src -- a color value in this
		// range only comes from a known client bug-abuse path.
		var account := who.acct;
		DestroyItem(cabinet);
		SendSysMessage( who, "Bug abusers aren't tolerated here." );
		SetBaseSkill( who, 34, 0 );
		who.setStr(1);
		who.setInt(1);
		who.setDex(1);
		PlayLightningBoltEffect(who);
		EraseObjProperty( who, "StatsState" );

		var bank_region := CP_DEFAULT_AREA;
		var bankbox := CP_GetStorageContainerForMobile( who, bank_region, CP_CREATE );
		if( bankbox )
			foreach item in EnumerateItemsInContainer(bankbox)
				DestroyItem(item);
			endforeach
		endif

		Detach();
		ReleaseItem(cabinet);

		Sleep(60);
		var countdown;
		for( countdown := 60; countdown > 0; countdown := countdown - 1 )
			SendSysMessage( who, "Say goodbye to your account in " + countdown + " seconds .", 0x0, 33 );
			Sleep(1);
		endfor

		SendSysMessage( who, "Hoping to not see you again...", 0x0, 33 );
		Sleep(2);
		account.ban();
		return;
	elseif( color == 1 )
		cabinet.color := 0;
	else
		cabinet.color := color;
	endif

	SendSysMessage( who, "Select something to dye" );

	var target_item := Target( who, TGTOPT_NOCHECK_LOS );
	if( !target_item )
		SendSysMessage( who, "Canceled" );
		ReleaseItem(cabinet);
		return;
	endif

	if( !ReserveItem(target_item) )
		ReleaseItem(cabinet);
		return;
	endif

	if( NOT Accessible(who, target_item) )
		SendSysmessage( who, "You cannot reach that!" );
		ReleaseItem(cabinet);
		ReleaseItem(target_item);
		return;
	endif

	if( GetObjProperty( target_item, "Undyeable" ) )
		SendSysMessage( who, target_item.desc + " cannot be colored" );
		ReleaseItem(cabinet);
		ReleaseItem(target_item);
		return;
	endif

	var element;
	var allowdye := 10;

	if( !dye_cfg )
		SendSysmessage( who, "Could not open dyeitems.cfg" );
		syslog( "Unable to open dyeitems.cfg" );
		ReleaseItem(cabinet);
		ReleaseItem(target_item);
		return;
	endif

	element := FindConfigElem( dye_cfg, target_item.objtype );
	if( element )
		allowdye := Cint(GetConfigInt(element, "player"));
	else
		allowdye := 4;
	endif

	if( ALLOWED )
		cmdlvl := who.cmdlevel;
	else
		cmdlvl := 0;
	endif

	if( cmdlvl >= allowdye )
		target_item.color := cabinet.color;
	else
		SendSysMessage( who, target_item.desc + " cannot be colored" );
	endif

	ReleaseItem(cabinet);
	ReleaseItem(target_item);

endprogram
