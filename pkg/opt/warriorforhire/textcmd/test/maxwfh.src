// Synopsis: Max a Warrior for Hire's combat skills and raise its stats to its master's or given values
// Usage: .maxwfh               - skills to 130.0, stats raised to the master's base stats (never lowered)
//        .maxwfh <str> <int> <dex> - skills to 130.0, stats set to exactly these values
use uo;
use os;

include "include/attributes";
include ":staff:include/staff";
include ":warriorforhire:include/wfhcommon";
include ":warriorforhire:include/wfhvitals";

// 2026-10-10: ported from ZH2.5 Patch 1.1.4. Skills go to WFH_SKILL_CAP_TENTHS (wfhcommon.inc since
// 2026-10-19, was a local 1300 copy), the ceiling a warrior's own skill growth stops at.
const MAXWFH_STAT_MIN := 10;
const MAXWFH_STAT_MAX := 300;

program textcmd_maxwfh(who, text)

	// Parse the optional stats before targeting so a typo doesn't waste a target cursor.
	var stats := 0;
	var words := SplitWords(CStr(text));
	if( words.size() )
		if( words.size() != 3 )
			SendSysMessage(who, "Usage: .maxwfh  or  .maxwfh <str> <int> <dex>");
			return 0;
		endif
		stats := { CInt(words[1]), CInt(words[2]), CInt(words[3]) };
		foreach value in stats
			if( value < MAXWFH_STAT_MIN or value > MAXWFH_STAT_MAX )
				SendSysMessage(who, "Stats must be whole numbers from " + MAXWFH_STAT_MIN + " to " + MAXWFH_STAT_MAX + ". Nothing changed.");
				return 0;
			endif
		endforeach
	endif

	SendSysMessage(who, "Target the Warrior for Hire to max.");
	var targetted := Target(who, TGTOPT_NOCHECK_LOS);
	if( !targetted )
		SendSysMessage(who, "Cancelled.");
		return 0;
	endif
	if( !targetted.npctemplate )
		SendSysMessage(who, "That is not a Warrior for Hire.");
		return 0;
	endif
	if( !GetObjProperty(targetted, "WarriorForHire") )
		SendSysMessage(who, "That is not a Warrior for Hire.");
		return 0;
	endif

	var skillids := WfhTrackedSkills();
	foreach skillid in skillids
		SetBaseSkillBaseValue(targetted, skillid, WFH_SKILL_CAP_TENTHS);
	endforeach

	var basestr := GetStrength(targetted) - GetStrengthMod(targetted);
	var baseint := GetIntelligence(targetted) - GetIntelligenceMod(targetted);
	var basedex := GetDexterity(targetted) - GetDexterityMod(targetted);

	if( stats )
		basestr := stats[1];
		baseint := stats[2];
		basedex := stats[3];
	else
		// Same ceiling the warrior grows toward on its own (GainStat in warrior.src).
		var masterserial := GetObjProperty(targetted, "master");
		var master := 0;
		if( masterserial )
			master := SystemFindObjectBySerial(masterserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
		endif
		if( master )
			var masterstr := GetStrength(master) - GetStrengthMod(master);
			var masterint := GetIntelligence(master) - GetIntelligenceMod(master);
			var masterdex := GetDexterity(master) - GetDexterityMod(master);
			if( masterstr > basestr )
				basestr := masterstr;
			endif
			if( masterint > baseint )
				baseint := masterint;
			endif
			if( masterdex > basedex )
				basedex := masterdex;
			endif
		else
			SendSysMessage(who, "No master found, so stats were left alone. Use .maxwfh <str> <int> <dex> to set them.");
		endif
	endif

	SetBaseStrength(targetted, basestr);
	SetBaseIntelligence(targetted, baseint);
	SetBaseDexterity(targetted, basedex);

	// HP = Str, Mana = Int, Stam = Dex, like a player (vitalInit.src), then topped up. The AI loop refreshes the
	// heart's mirror CProps.
	SetWfhVitalCeilingsAndFill(targetted);

	SendSysMessage(who, targetted.name + ": combat skills 130.0, Str " + basestr + " Int " + baseint + " Dex " + basedex + ", HP " + GetMaxHP(targetted) + ".");
	LogCommand(who, GetProcess(GetPid()).name, targetted.name + "/" + targetted.serial, "Str " + basestr + " Int " + baseint + " Dex " + basedex);

endprogram
