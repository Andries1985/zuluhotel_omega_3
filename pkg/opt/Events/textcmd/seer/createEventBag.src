// Synopsis: Create an event loot bag for a targeted mobile
use uo;

include "include/random";
include ":staff:include/staff";
include ":Events:bag"; // 2026-09-23: the shared prize table; the local copy that used to follow the program is gone

program createEventBag(who)

	var targ := Target( who, TGTOPT_NOCHECK_LOS);
	if(!targ)
		SendSysMessage(who, "Canceled.");
		return;
	endif

	LogCommand(who, GetProcess(GetPid()).name, who.name+" granted a reward bag to "+targ.name);

	var bag := CreateItemInBackpack( targ, 0x0E76 );
	bag.name := "an Event Reward Bag";
	var cd := Random(3000);
	bag.color := cd;

	var prize := GetPrize();
	var item;
	var itemID := prize[1];
	if(!itemID)
		SendSysMessage(who, "Something went wrong, no item!");
		return;
	else
		item := CreateItemInContainer( bag, itemID );
		item.movable := 1;
		if(!item.movable)
			var tries := 0;
			while(!item.movable || tries > 100)
				item.movable := 1;
				tries := tries+1;
				sleepms(100);
			endwhile
		endif
	endif
	var name := prize[2];
	if(name)
		item.name := name;
	endif
	var color := prize[3];
	if(color)
		item.color := color;
	endif
	CreateItemInContainer( bag, 0x4001AA );
	CreateItemInContainer( bag, 0x4001AB );
	CreateItemInContainer( bag, 0x4001AB );
return;
endprogram
