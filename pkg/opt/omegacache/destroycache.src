// destroycache.src — Omega Cache DestroyScript
//
// Safety net: blocks destruction if the house's Omega Cache DataFile
// contains stored items. Re-credits numomegacache on the house when
// destruction is allowed.
//
// Primary removal path is through House Management gump.
// This script handles GM deletion, script deletion, and other edge cases.

use uo;
use os;

include "include/client";
include "include/omegacache_utils";

program destroy_omegacache(item)

	var house_serial := GetObjProperty(item, "houseserial");

	// If no house link, allow destruction (orphaned item)
	if(!house_serial)
		return 1;
	endif

	var house := SystemFindObjectBySerial(CInt(house_serial));

	// Block destruction of the last container if cache has stored items
	if(!IsOmegaCacheEmpty(house_serial) and house)
		var cache_count := 0;
		foreach nearby in (house.items)
			if(nearby.objtype == OMEGACACHE_OBJTYPE)
				cache_count := cache_count + 1;
			endif
		endforeach
		// count includes the item being destroyed, so <=1 means this is the last one
		if(cache_count <= 1)
			return 0;
		endif
	endif

	// Re-credit the house's omega cache slot
	if(house)
		var current := CInt(GetObjProperty(house, "numomegacache"));
		var max := CInt(GetObjProperty(house, "maxnumomegacache"));
		if(max <= 0)
			max := GetMaxOmegaCacheForHouse(CInt(GetObjType(house)));
			SetObjProperty(house, "maxnumomegacache", max);
		endif
		current := current + 1;
		if(current > max)
			current := max;
		endif
		SetObjProperty(house, "numomegacache", current);

		var sign := SystemFindObjectBySerial(CInt(GetObjProperty(house, "signserial")));
		if(sign)
			SetObjProperty(sign, "numomegacache", current);
			SetObjProperty(sign, "maxnumomegacache", max);
		endif
	endif

	return 1;

endprogram
