use uo;
use os;

include "include/spelldata";
include "include/recalling";
include "include/objtype";
include "include/client";
//include ":housing:utility";
include "../pkg/multis/house/include/utility";
include "include/attributes";
include "include/housetravel";	// 2026-10-02: FindHouseAtSpot / CanTravelIntoHouse / DestroyRefusedRune

program cast_earth_portal( caster )

	//var circle := 10;
	var circle := GetCircle( SPELLID_EARTH_PORTAL );

	if( IsForbiddenAreaToGateFrom( caster ) )
		// 2026-09-22: the book waits on #Casting; returning without clearing it
		// left every double-click refused until relog.
		SendSysMessage( caster, "You can't gate from there." );
		EraseObjProperty( caster , "#Casting" );
		return 0;
	endif

	var antigate := ListItemsNearLocation(caster.x, caster.y, caster.z, 10, caster.realm);
	foreach item in antigate
		if (item.objtype == 0xa3c9)
			SendSysMessage( caster, "You can't gate from here." );
			EraseObjProperty( caster , "#Casting" );
			return;
		endif
	endforeach

	// 2026-10-02: house test by footprint (housetravel.inc) instead of the engine's
	// supporting-multi test, so a courtyard and a static house count as "in a house" too.
	var from_house := FindHouseAtSpot( caster.x, caster.y, caster.z, caster.realm );
	if( !CanTravelIntoHouse( caster, from_house, GATE_FROM ) )
		SendSysMessage( caster, "You can't gate from this house." );
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	if (TryToCast( caster, SPELLID_EARTH_PORTAL ) != SUCCESS);
		Print("Cannot cast spell!");
		EraseObjProperty(caster, "#Casting");
		return 0;
	endif

	SendSysmessage( caster, "Select a rune to gate from." );

	var cast_on := CanTargetThing( caster , circle , TGTOPT_CHECK_LOS );

	if (!cast_on)
		EraseObjProperty( caster , "#Casting" );
		return;
	elseif( !Accessible( caster, cast_on ) )
		SendSysMessage( caster, "You can't reach that." );
		EraseObjProperty( caster , "#Casting" );
		return 0;
	elseif( cast_on.objtype != UOBJ_RUNE && cast_on.objtype != 0x7100 && cast_on.objtype != UOBJ_RUNIC_ATLAS_EW && cast_on.objtype != UOBJ_RUNIC_ATLAS_NS )
		SendSysmessage( caster, "You can only cast that on a recall rune or a runebook!" );
		EraseObjProperty( caster , "#Casting" );
		return 0;
	elseif( !ReserveItem( cast_on ) )
		EraseObjProperty( caster , "#Casting" );	// 2026-10-02: every exit clears #Casting (see the 2026-09-22 note above)
		return 0;
	endif

	var tox := Cint(GetObjProperty( cast_on, "x" ));
	var toy := Cint(GetObjProperty( cast_on, "y" ));
	var toz := Cint(GetObjProperty( cast_on, "z" ));
	var torealm := GetObjProperty( cast_on, "realm" );

	if( !tox and !toy and !toz and !torealm )
		SendSysmessage(caster, "That is a blank rune!");
		EraseObjProperty( caster , "#Casting" );	// 2026-10-02
		return;
	endif

	if( IsForbiddenAreaToGateTo( caster, tox, toy, torealm ) )
		SendSysMessage(caster, "The destination is a magic place with protection.");
		if( cast_on.objtype != 0x7100 && cast_on.objtype != UOBJ_RUNIC_ATLAS_EW && cast_on.objtype != UOBJ_RUNIC_ATLAS_NS )
			DestroyItem( cast_on );
		endif
		EraseObjProperty( caster , "#Casting" );	// 2026-10-02
		return;
	endif

	var owner;
	var lamp;
	var Near_Items := ListItemsNearLocation(tox, toy, toz, 10, torealm);
	foreach thing in Near_Items
		if (thing.objtype == 0xf156)
			lamp := thing;
			owner := GetObjProperty(lamp,"Owner");
		endif
	endforeach
	if (lamp and owner)
		if (caster.serial != owner)
			SendSysMessage( caster, "You can't gate to this house." );
			EraseObjProperty( caster , "#Casting" );	// 2026-10-02
			return;
		endif
	endif

	var antigate2 := ListItemsNearLocation(tox, toy, toz, 10, torealm);
	foreach item in antigate2
		if (item.objtype == 0xa3c9)
			SendSysMessage( caster, "You can't gate there." );
			EraseObjProperty( caster , "#Casting" );	// 2026-10-02
			return;
		endif
	endforeach

	// 2026-10-02: the destination's house is found by footprint, ignoring the rune's z (see
	// pkg/std/spells/recall.src). A refused rune is destroyed; a runebook loses that entry.
	var house := FindHouseAtSpot( tox, toy, toz, torealm );
	if( !CanTravelIntoHouse( caster, house, GATE_TO ) )
		SendSysMessage( caster, "You can't gate to this house." );
		DestroyRefusedRune( caster, cast_on, house, tox, toy, toz, torealm );
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	Set_critical( 1 );

	if( !caster )
		EraseObjProperty( caster , "#Casting" );
		return;
	endif

	var gate1 := CreateItemAtLocation( caster.x, caster.y, caster.z, UOBJ_BLACK_MOONGATE, 1, caster.realm );
	var gate2 := CreateItemAtLocation( tox, toy, toz, UOBJ_BLACK_MOONGATE2, 1, torealm );

	if( !gate1 || !gate2 || !caster )
		DestroyItem(gate1);
		DestroyItem(gate2);
		EraseObjProperty( caster , "#Casting" );	// 2026-10-02
        return;
	endif

	// 2026-09-22: a save inside the 60 s window brought the far gate (0x7012 was
	// SaveOnExit 1) back after a restart with nobody left to remove it.
	gate1.saveonexit := 0;
	gate2.saveonexit := 0;

	SetObjProperty( gate1 , "GateDestX" , gate2.x );
	SetObjProperty( gate1 , "GateDestY" , gate2.y );
	SetObjProperty( gate1 , "GateDestZ" , gate2.z );
	SetObjProperty( gate1 , "GateDestRealm" , gate2.realm );
	SetObjProperty( gate2 , "GateDestX" , gate1.x );
	SetObjProperty( gate2 , "GateDestY" , gate1.y );
	SetObjProperty( gate2 , "GateDestZ" , gate1.z );
	SetObjProperty( gate2 , "GateDestRealm" , gate1.realm );

	ReleaseItem(cast_on);
	Detach();

	set_critical( 0 );

	PlaySoundEffect( caster, SFX_SPELL_EARTH_PORTAL );
	EraseObjProperty( caster , "#Casting" );

	Sleep( 60 );

	set_critical( 1 );

	DestroyItem( gate1 );
	DestroyItem( gate2 );

	set_critical(0);

endprogram
