use uo;

include "include/itemutil";

program randomTome(who, scroll)
	if(!IsInContainer(who.backpack, scroll))
		SendSysMessage(who, "That item need to be in your main backpack!");
		return;
	endif
	// 2026-09-22: create first; the tome was destroyed before the Power Tome
	// was created, so a full backpack lost it.
	var tome := CreateItemInBackpack( who, 0x4001AA );
	if(!tome)
		SendSysMessage(who, "You need more room in your backpack.");
		return;
	endif
	var des := DestroyItem(scroll);
	if(!des)
		DestroyItem(tome);
		return;
	endif
endprogram