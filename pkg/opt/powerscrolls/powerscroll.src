use uo;

include "include/random";
include "include/attributes";
include "include/itemutil";
include ":mdgumps:yesNo";

program powerscroll(who, scroll)

	if( !ReserveItem( scroll ) )
		return;
	endif
	
	if( !Accessible( who , scroll ) )
		SendSysMessage( who , "You can't reach that." );
		return;
	endif

	if( !IsInContainer( who.backpack , scroll ) )
		SendSysmessage( who, "That item has to be in your backpack." );
		return;
	endif

	var matrix := GetObjProperty(who, "pScrollMatrix");
	if(!matrix)
		matrix := {};
	endif
	// Pads a legacy 49-entry matrix (from before Throwing/id 50 existed) up to
	// SKILLID_MAX, not just fresh allocations.
	var padi;
	for(padi := Len(matrix); padi < SKILLID_MAX; padi := padi+1)
		matrix.append(0);
	endfor
	SetObjProperty(who, "pScrollMatrix", matrix);

	var skill := GetObjProperty(scroll, "skill");
	// Must be checked before NormalizeSkillAndSlot()/matrix[] below -- 666 is
	// the "already spent" sentinel (set just before this scroll's own
	// DestroyItem() call further down) and isn't a real skillid/slot, so
	// normalizing it falls through to NormalizeSkillAndSlot()'s default case
	// (slot := 666), an out-of-bounds index into a matrix only sized to
	// SKILLID_MAX. Guarding here means a scroll that somehow survived being
	// marked spent (e.g. that DestroyItem() call failed) can't crash this one.
	if(skill == 666)
		DestroyItem(scroll);
		return;
	endif

	var norm := NormalizeSkillAndSlot(skill);
	if(matrix[norm.slot] > 15)
		SendSysMessage(who, "You can't raise this cap any higher.");
		return;
	endif

	if( YesNo( who , "Are you sure?" ))
	else
		SendSysMessage( who , "Canceled." );
		return;
	endif

	var chance := chances(matrix, norm.slot);

	if(chance > Random(101))
		var des := DestroyItem(scroll);
		sleepMS(200);
		if(!des)
			return;
		endif
		var skillName := GetAttributeIdBySkillId(norm.skillid);
		SendSysMessage(who, "Your "+skillName+" skill cap is increased by 5, type .showcaps to see your current skillcaps.");
		matrix[norm.slot] := matrix[norm.slot]+5;
		if(matrix[norm.slot] > 20)
			matrix[norm.slot] := 20;
		endif
		SetObjProperty(who, "pScrollMatrix", matrix);
		
		PlayObjectCenteredEffect(who, 0x6F61, 0x1, 10);		//0x6F61  is wings here
		PlayObjectCenteredEffect(who, 0x373A, 0x1, 10);		//Sparkle effect
		PlaySoundEffect(who, 0x5C1);
	else
		SendSysMessage(who, "This tome has no power.");
		SetObjProperty(scroll, "skill", 666);
		DestroyItem(scroll);
		PlayObjectCenteredEffect(who, 0x3735, 0x1, 20);
		PlaySoundEffect(who, 0x5D0);
	endif
	return;

endprogram

function chances(matrix, slot)
	var chance := 0;

	if(matrix[slot] < 5)
		chance := 80;
	elseif(matrix[slot] < 10)
		chance := 60;
	elseif(matrix[slot] < 15)
		chance := 40;
	else
		chance := 20;
	endif
	return chance;
endfunction