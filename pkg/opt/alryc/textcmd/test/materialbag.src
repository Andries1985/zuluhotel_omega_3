// Synopsis: Drop 13 backpacks (Logs, Ore, Ingots, Hides, Tailoring, Materials, Fish, Crustaceans, Fishing Tools, Special Fishing Items, Alchemy, Cooking, Misc) of every crafting/fishing/potion/food material plus one of every crafting tool at your feet for testing
use uo;

include "include/objtype";
include ":staff:include/staff";

const MATERIAL_STACK_AMOUNT := 5000;
// 2026-09-14: fish/crustaceans/lures/scrolls/potions aren't bulk crafting
// materials (quest rewards, tiered catches, alchemy end-products), so they
// get a much smaller stack.
const FISHING_STACK_AMOUNT := 100;
const ALCHEMY_STACK_AMOUNT := 100;
const MISC_STACK_AMOUNT := 100;
const CRAFTING_BACKPACK := 0x9B2;

function FillMaterials(chest, materials, amount := MATERIAL_STACK_AMOUNT)
	foreach objtype in materials
		CreateItemInContainer(chest, objtype, amount);
	endforeach
endfunction

program materialbag(who)
	// Only objtypes confirmed to have a live itemdesc entry in this repo are listed below.
	// Several "standard" POL wood/board/exotic-ore constants (objtype.inc) are vestigial
	// on this shard and have no itemdesc entry at all -- they are intentionally omitted.

	var logsChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var oreChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var ingotsChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var hidesChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var tailoringChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var materialsChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var fishChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var crustChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var fishToolsChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var fishSpecialChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var alchemyChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var cookingChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);
	var miscChest := CreateItemAtLocation(who.x, who.y, who.z, CRAFTING_BACKPACK, 1, who.realm);

	if (!logsChest or !oreChest or !ingotsChest or !hidesChest or !tailoringChest or !materialsChest
		or !fishChest or !crustChest or !fishToolsChest or !fishSpecialChest or !alchemyChest
		or !cookingChest or !miscChest)
		SendSysMessage(who, "Couldn't create a backpack at your feet.");
		return 0;
	endif

	logsChest.name := "Logs Backpack";
	logsChest.movable := 1;
	logsChest.color := 1102;

	oreChest.name := "Ore Backpack";
	oreChest.movable := 1;
	oreChest.color := 2101;

	ingotsChest.name := "Ingots Backpack";
	ingotsChest.movable := 1;
	ingotsChest.color := 2406;

	hidesChest.name := "Hides Backpack";
	hidesChest.movable := 1;
	hidesChest.color := 1828;

	tailoringChest.name := "Tailoring Backpack";
	tailoringChest.movable := 1;
	tailoringChest.color := 1358;

	materialsChest.name := "Materials Backpack";
	materialsChest.movable := 1;
	materialsChest.color := 1150;

	fishChest.name := "Fish Backpack";
	fishChest.movable := 1;
	fishChest.color := 1153;

	crustChest.name := "Crustaceans Backpack";
	crustChest.movable := 1;
	crustChest.color := 2101;

	fishToolsChest.name := "Fishing Tools Backpack";
	fishToolsChest.movable := 1;
	fishToolsChest.color := 1102;

	fishSpecialChest.name := "Special Fishing Items Backpack";
	fishSpecialChest.movable := 1;
	fishSpecialChest.color := 1358;

	alchemyChest.name := "Alchemy Backpack";
	alchemyChest.movable := 1;
	alchemyChest.color := 1153;

	cookingChest.name := "Cooking Backpack";
	cookingChest.movable := 1;
	cookingChest.color := 1358;

	miscChest.name := "Misc Backpack";
	miscChest.movable := 1;
	miscChest.color := 1150;

	var ore := {
		UOBJ_IRON_ORE, UOBJ_BRONZE_ORE, UOBJ_DULLCOPPER_ORE, UOBJ_ORICHALCUM_ORE,
		UOBJ_ONYX_ORE, UOBJ_PYRITE_ORE, UOBJ_MALACHITE_ORE, UOBJ_AZURITE_ORE,
		UOBJ_PLATINUM_ORE, UOBJ_LAVAROCK_ORE, UOBJ_MYSTIC_ORE, UOBJ_ZULU_ORE,
		UOBJ_SPIKE_ORE, UOBJ_FRUITY_ORE, UOBJ_GREYVIXEN_ORE, UOBJ_SILVERROCK_ORE,
		UOBJ_SPECTRAL_ORE, UOBJ_UNDEAD_ORE, UOBJ_DARKPAGAN_ORE, UOBJ_OLDBRITAIN_ORE,
		UOBJ_VIRGINITY_ORE, UOBJ_BLACKDWARF_ORE, UOBJ_REDELVEN_ORE,
		UOBJ_DRIPSTONE_ORE, UOBJ_EXECUTOR_ORE, UOBJ_PEACHBLUE_ORE, UOBJ_DESTRUCTION_ORE,
		UOBJ_ANRA_ORE, UOBJ_GODDESS_ORE, UOBJ_CRYSTAL_ORE, UOBJ_DOOM_ORE,
		UOBJ_SAPPHIRE_ORE, UOBJ_RUBY_ORE, UOBJ_DIAMOND_ORE
	};

	var ingots := {
		UOBJ_IRON_INGOT, UOBJ_BRONZE_INGOT, UOBJ_DULLCOPPER_INGOT, UOBJ_ORICHALCUM_INGOT,
		UOBJ_ONYX_INGOT, UOBJ_PYRITE_INGOT, UOBJ_MALACHITE_INGOT, UOBJ_AZURITE_INGOT,
		UOBJ_PLATINUM_INGOT, UOBJ_LAVAROCK_INGOT, UOBJ_MYSTIC_INGOT, UOBJ_ZULU_INGOT,
		UOBJ_SPIKE_INGOT, UOBJ_FRUITY_INGOT, UOBJ_GREYVIXEN_INGOT, UOBJ_SILVERROCK_INGOT,
		UOBJ_SPECTRAL_INGOT, UOBJ_UNDEAD_INGOT, UOBJ_DARKPAGAN_INGOT, UOBJ_OLDBRITAIN_INGOT,
		UOBJ_VIRGINITY_INGOT, UOBJ_BLACKDWARF_INGOT, UOBJ_REDELVEN_INGOT,
		UOBJ_DRIPSTONE_INGOT, UOBJ_EXECUTOR_INGOT, UOBJ_PEACHBLUE_INGOT, UOBJ_DESTRUCTION_INGOT,
		UOBJ_ANRA_INGOT, UOBJ_GODDESS_INGOT, UOBJ_CRYSTAL_INGOT, UOBJ_DOOM_INGOT,
		UOBJ_SAPPHIRE_INGOT, UOBJ_RUBY_INGOT, UOBJ_DIAMOND_INGOT
	};

	// This shard's wood-variety system lives entirely on colored LOGS (0x7300-0x7316 plus
	// base/goddess logs) -- there is no separate "board" objtype at all, so boards are omitted.
	// All 23 colored objtypes confirmed present in pkg/std/lumberjacking/itemdesc.cfg.
	var logs := { UOBJ_LOGS, UOBJ_LOGS_GODDESS, 0x0DE1 /* Kindling */ };
	var logcolor;
	for (logcolor := 0x7300; logcolor <= 0x7316; logcolor := logcolor + 1)
		logs.append(logcolor);
	endfor

	var hides := {
		UOBJ_HIDES_NORMAL1, UOBJ_HIDES_NORMAL2, UOBJ_HIDES_RAT, UOBJ_HIDES_DRAGON,
		UOBJ_HIDES_TROLL, UOBJ_HIDES_LIZARD, UOBJ_HIDES_SERPENT, UOBJ_HIDES_OSTARD,
		UOBJ_HIDES_BALRON, UOBJ_HIDES_LAVA, UOBJ_HIDES_NECROMANCER, UOBJ_HIDES_LICHE,
		UOBJ_HIDES_WYRM, UOBJ_HIDES_GOLDEN_DRAGON, UOBJ_HIDES_WOLF, UOBJ_HIDES_BEAR,
		UOBJ_HIDES_ICE_CRYSTAL, UOBJ_HIDES_BALROG, UOBJ_HIDES_ORC, UOBJ_HIDES_TERATHAN,
		UOBJ_HIDES_DAEMON, UOBJ_HIDES_SILVER_DRAGON, UOBJ_HIDES_ANGEL
	};

	var cloth := {
		UOBJ_BOLT_OF_CLOTH1, UOBJ_BOLT_OF_CLOTH2, UOBJ_BOLT_OF_CLOTH3, UOBJ_BOLT_OF_CLOTH4,
		UOBJ_BOLT_OF_CLOTH5, UOBJ_BOLT_OF_CLOTH6, UOBJ_BOLT_OF_CLOTH7, UOBJ_BOLT_OF_CLOTH8,
		UOBJ_CLOTH1, UOBJ_CLOTH2, UOBJ_CLOTH3, UOBJ_CLOTH4, UOBJ_CLOTH5,
		UOBJ_CLOTH6, UOBJ_CLOTH7, UOBJ_CLOTH8, UOBJ_CLOTH9, UOBJ_CLOTH10,
		UOBJ_WOOL,
		0x0E1D // Ball of Yarn
	};

	// 2026-09-14: Bandages/Blank Map/Blank Scroll folded in here -- they moved
	// out of categories.cfg's Miscellaneous category into their own Bandages/
	// Cartography/SpellbookScrolls categories, but none of those are big
	// enough on their own to earn a dedicated bag.
	var misc := {
		UOBJ_SAND, UOBJ_CLAY, UOBJ_GLASS,
		0x0E20, // Bloody Bandages
		0x0E21, // Bandages
		0x6001, // Blank Map
		0x14EB, // Blank Map (variant)
		0x0E34  // Blank Scroll
	};

	// Coins (to test melting them into ingots via Tongs+forge) and the coin-melted
	// ingots themselves (to test the ingots directly without melting).
	var preciousmetals := {
		UOBJ_GOLD_COIN, UOBJ_SILVER_COIN, UOBJ_COPPER_COIN,
		UOBJ_GOLD_INGOT, UOBJ_SILVER_INGOT, UOBJ_COIN_COPPER_INGOT
	};

	// Bowcraft (pkg/std/bowcraft): Logs -> Shafts, Shafts + Feathers -> Arrows/Bolts.
	// Feathers has no other source in this bag. Plain Arrow/Bolt included too so
	// the Bowcraft Tool gump's Improve-to-elemental recipes have something to
	// upgrade right away instead of requiring a craft-from-scratch step first.
	var bowcraft := {
		UOBJ_FEATHER, UOBJ_SHAFTS, UOBJ_ARROW, UOBJ_BOLT,
		UOBJ_FIRE_ARROW, UOBJ_ICE_ARROW, UOBJ_THUNDER_BOLT
	};

	// pkg/opt/omegacache/categories.cfg's own "Tinkering" category, in full.
	// Lockpick through Springs are non-stackable tools tracked as pinned
	// single entries; Clock Parts through Barrel Lid are the genuinely
	// stackable crafting components confirmed by the 2026-09-14 audit.
	var tinkering := {
		0x14FB, // Lockpick
		0x1051, // Axle and Gears
		0x1053, // Gears
		0x1055, // Hinge
		0x104E, // Clock Frame
		0x1059, // Sextant Parts
		0x105D, // Springs
		0x104F, // Clock Parts
		0x105B, // Axle
		0x10E1, // Barrel Hoops
		0x1EB1, // Barrel Staves
		0x1DB8  // Barrel Lid
	};

	var reagents := {
		UOBJ_BATWING, UOBJ_BLACKMOOR, UOBJ_BLACK_PEARL, UOBJ_BLOOD_MOSS,
		UOBJ_BLOODSPAWN, UOBJ_VIAL_OF_BLOOD, UOBJ_BONE, UOBJ_BRIMSTONE,
		UOBJ_DAEMON_BONE, UOBJ_FERTILE_DIRT, UOBJ_DRAGONS_BLOOD, UOBJ_EXECUTIONERS_CAP,
		UOBJ_GARLIC, UOBJ_GINSENG, UOBJ_MANDRAKE_ROOT, UOBJ_EYE_OF_NEWT,
		UOBJ_NIGHTSHADE, UOBJ_OBSIDIAN, UOBJ_PIG_IRON, UOBJ_PUMICE,
		UOBJ_SULPHUROUS_ASH, UOBJ_SPIDER_SILK, UOBJ_SERPENT_SCALE, UOBJ_VOLCANIC_ASH,
		UOBJ_DEAD_WOOD, UOBJ_WYRMS_HEART
	};

	// 2026-09-14: full Cooking Backpack, mirroring pkg/opt/omegacache/categories.cfg's
	// own "Food" and "RawFoodAndHerbs" categories exactly (the old hand-picked
	// "cooking" list above was a strict subset of both -- every objtype in it
	// duplicated something already in one of these two, so it's retired in favor
	// of these two comprehensive lists instead).

	// -- Food: every drink/cooked-food/produce objtype in Category Food (categories.cfg) --
	var food := {
		0x099B, 0x099F, 0x09C7, 0x1F96, 0x1F98, 0x1F9A, 0x1F9C, 0x1F9E, 0x09AD,
		0x1F85, 0x09EE, 0x1F8D, 0x1F7D, 0x1F89, 0x1F91, 0x1045, 0x0976, 0x1E8A,
		0x09EC, 0x1726, 0xC803, 0xC804, 0x097E, 0x1608, 0x160A, 0xC923, 0x097B,
		0x1E1E, 0x09B7, 0x09F2, 0xC912, 0xC942, 0xC943, 0x0C6D, 0x0C70, 0x09B5,
		0x09B6, 0xC920, 0xC921, 0x171F, 0x1727, 0x1728, 0x172A, 0x172C, 0x172D,
		0x09D0, 0x0D1A, 0x09D1, 0x0C5C, 0x0C6A, 0x0C72, 0x0C77, 0x0C7A, 0x0C7C,
		0x0D3A, 0x1AA2, 0xC800, 0xC805, 0x1E1C, 0x0C64, 0x0C65, 0x0C66, 0x0C67,
		0x0977, 0x0978, 0x0979, 0x097C, 0x097D, 0x098C, 0x0994, 0x09C1, 0x09C8,
		0x09D2, 0x09D3, 0x09E9, 0x09EA, 0x0C5D, 0x0C6B, 0x0C6C, 0x0C6E, 0x0C71,
		0x0C73, 0x0C74, 0x0C75, 0x0C78, 0x0C79, 0x0C7B, 0x0CBD, 0x103B, 0x103C,
		0x1040, 0x1041, 0x1044, 0x160B, 0x160C, 0x1720, 0x1721, 0x1722, 0x1723,
		0x1724, 0x1729, 0x172B, 0x1AD3, 0x1E1D, 0x1E1F, 0x09B8, 0xC900, 0xC901,
		0xC902, 0xC903, 0xC910, 0xC911, 0xC922, 0xC930, 0xC931, 0xC932, 0xC933,
		0xC934, 0xC935, 0xC936, 0xC940, 0xC941, 0xC944, 0xC945, 0xC946, 0xC947,
		0xC950, 0x15F9, 0x15FA, 0x15FB, 0x15FC, 0x15FE, 0x15FF, 0x1600, 0x1601,
		0x1602,

		// 2026-09-14: added after the stackability re-audit confirmed these
		// cooking.cfg outputs are genuinely stackable.
		0x10170, // Corn Muffin
		0x9EB,   // Muffins
		0x9FA,   // Muffins (variant)
		0x283E,  // Sushi Rolls
		0x2840,  // Sushi Platter
		0x284C,  // Bowl of Green Tea
		0x284D,  // Miso Soup
		0x30128, // White Miso Soup
		0x30129, // Red Miso Soup
		0x3012A, // Awase Miso Soup
		0x2BE2,  // Gingerbread Cookie
		0xA0D8,  // Hotdog
		0xA0DA   // Hamburger
	};

	// -- RawFoodAndHerbs: raw ingredients/intermediates not already in Food above --
	var rawfoodandherbs := {
		0x18DE, 0x18E3, 0x18E7, 0x18EB, 0x1EBD, 0x09F1, 0x097A, 0x09B9, 0x09C9,
		0x1607, 0x1609, 0x09C0, 0x1E15, 0x1E16, 0x1E17, 0x1E18, 0x09BA, 0x103D,
		0x103F, 0x1083, 0x1042, 0xC801, 0xC802, 0x0C82, 0x1039, 0x103A, 0x1046
	};

	// 2026-09-14: full Fish/Crustaceans/FishingTools/SpecialFishingItems
	// spread, matching pkg/opt/omegacache/categories.cfg's own 4-way split.

	// -- Fish: Regular (42) + Rare (13 species, E/S = 26) + Legendary (14 species, E/S = 28) --
	var fish := {
		// Regular
		0x30300, 0x30301, 0x30302, 0x30303, 0x30304, 0x30305, 0x30306, 0x30307,
		0x30308, 0x30309, 0x3030A, 0x3030B, 0x3030C, 0x3030D, 0x3030E, 0x3030F,
		0x30310, 0x30311, 0x30312, 0x30313, 0x30314, 0x30315, 0x30316, 0x30317,
		0x30318, 0x30319, 0x3031A, 0x3031B, 0x3031C, 0x30325, 0x30326, 0x30327,
		0x30328, 0x30329, 0x3032A, 0x3032B, 0x3032C, 0x30335, 0x30336, 0x30337,
		0x30338, 0x30339,
		// Rare
		0x3032D, 0x3032E, 0x3031D, 0x30321, 0x3031E, 0x30322, 0x3033A, 0x3033B,
		0x3033C, 0x3033D, 0x30342, 0x30343, 0x30344, 0x30345, 0x30346, 0x30347,
		0x3034C, 0x3034D, 0x3034E, 0x3034F, 0x30354, 0x30355, 0x30356, 0x30357,
		0x30360, 0x30361,
		// Legendary
		0x3031F, 0x30323, 0x30320, 0x30324, 0x3032F, 0x30330, 0x30331, 0x30332,
		0x30333, 0x30334, 0x3033E, 0x3033F, 0x30340, 0x30341, 0x30348, 0x30349,
		0x3034A, 0x3034B, 0x30350, 0x30351, 0x30352, 0x30353, 0x30358, 0x30359,
		0x3035A, 0x3035B, 0x3035C, 0x3035D
	};

	// -- Crustaceans: Regular (12) + Rare (3 species, E/S = 6) + Legendary (5 species, E/S = 10) --
	var crustaceans := {
		0x30362, 0x30363, 0x30364, 0x30365, 0x30366, 0x30367, 0x30368, 0x30369,
		0x3036A, 0x3036B, 0x3036C, 0x3036D,
		0x3036E, 0x3036F, 0x30370, 0x30371, 0x30372, 0x30373,
		0x30374, 0x30375, 0x30376, 0x30377, 0x30378, 0x30379, 0x3037A, 0x3037B,
		0x3037C, 0x3037D
	};

	// -- Fishing Tools: net, trap, all 6 lure tiers --
	var fishtools := {
		0x9603,  // Special Fishing Net
		0x3037E, // Crustacean Trap
		0x30387, // Big Fish Lure
		0x30385, // Rare Fish Lure
		0x30386, // Legendary Fish Lure
		0x3038A, // Big Crustacean Lure
		0x30388, // Rare Crustacean Lure
		0x30389  // Legendary Crustacean Lure
	};

	// -- Special Fishing Items: 9 old shells + 10 Scroll of the Depths tiers --
	var fishspecial := {
		0x80AE, 0x80BE, 0x80CE, 0x80DE, 0x80EE, 0x81AE, 0x81BE, 0x81CE, 0x81DE,
		0x2270, 0x2271, 0x2272, 0x2273, 0x2274, 0x2275, 0x2276, 0x2277, 0x2278, 0x2279
	};

	// Every potion objtype this shard tracks, copied from
	// pkg/opt/omegacache/categories.cfg's own "Potions" category (the base
	// 22 DC-range potions, the CProp-variant Special Potion, all Mage-class
	// variants, all AlchemyPlus potions, and the Invisibility Totem -- kept
	// in even though it's not literally a potion, since it's alchemy-made
	// and already grouped here).
	var alchemy := {
		0xDC01, 0xDC02, 0xDC03, 0xDC04, 0xDC05, 0xDC06, 0xDC07, 0xDC08, 0xDC09,
		0xDC0B, 0xDC0C, 0xDC0D, 0xDC0E, 0xDC0F, 0xDC10, 0xDC11, 0xDC12, 0xDC14,
		0xDC15, 0xDC16, 0xDC17, 0xDCE6, 0x7059,
		0xFF19, 0xFF1A, 0xFF1B, 0xFF1C, 0xFF1D, 0xFF1E, 0xFF1F, 0xFF20, 0xFF22,
		0xFF23, 0xFF24, 0xFF25, 0xFF26, 0xFF27, 0xFF28, 0xFF29, 0xFF2A, 0xFF2B,
		0xFF2C, 0xFF2D, 0xFF2F, 0xFF30, 0xFF31, 0xFF32, 0xFF33, 0xFF34, 0xFF35,
		0xFF36, 0xFF38, 0xFF39, 0xFF3A, 0xFF3B, 0xFF3C, 0xFF3D, 0xFF3E, 0xFF3F,
		0xFF40,
		0xFF4E, 0xFF4F, 0xFF50, 0xFF51, 0xFF52, 0xFF53, 0xFF54, 0xFF55, 0xFF56,
		0xFF57, 0xFF59, 0xFF5A, 0xFF5B, 0xFF5C, 0xFF5D, 0xFF5E, 0xFF62, 0xFF63,
		0xFF64, 0xFF65, 0xFF66, 0xFF67, 0xFF68, 0xFF69, 0xFF6A, 0xFF6B, 0xFF6C,
		0xFF6D, 0xFF6E, 0xFF6F, 0xFF70, 0xFF71, 0xFF72, 0xFF73, 0xFF74, 0xFF75,
		0xFF76, 0xFF77, 0xFF78, 0xFF79, 0xFF7A, 0xFF7B, 0xFF7C, 0xFF7D, 0xFF7E,
		0xFF7F, 0xFF80, 0xFF81, 0xFF82, 0xFF83, 0xFF84, 0xFF85, 0xFF86, 0xFF87,
		0xFF88, 0xFF89, 0xFF8A, 0xFF8B, 0xFF8C, 0xFF8D, 0xFF8E, 0xFF8F, 0xFF90,
		0xFF92, 0xFF93, 0xFF94, 0xFF95,
		0xFFA2,

		// AlchemyPlus-specific crafting inputs not covered by the general
		// "reagents" pile below: gems (Star Sapphire/Amethyst/Diamond are actual
		// AlchemyPlus reagents -- Tamla Heal/Grand Mage Refresh Elixir/Elixer --
		// the rest of Category Gems is included too for completeness) plus an
		// empty bottle (needmortar/consume_bottle is set on nearly every
		// AlchemyPlus recipe).
		UOBJ_GEM_STAR_SAPPHIRE, UOBJ_GEM_AMETHYST, UOBJ_GEM_DIAMOND, UOBJ_EMPTY_BOTTLE,
		UOBJ_GEM_EMERALD, UOBJ_GEM_SAPPHIRE, UOBJ_GEM_RUBY, UOBJ_GEM_CITRINE,
		UOBJ_GEM_TOURMALINE, UOBJ_GEM_AMBER,
		0x213F, // Dark Sapphire
		0x2140, // Turquoise
		0x2141, // Perfect Emerald
		0x2142, // Ecru Citrine
		0x2143, // White Pearl
		0x2144, // Fire Ruby
		0x2145, // Blue Diamond
		0x2146  // Brilliant Amber
	};

	// pkg/opt/omegacache/categories.cfg's own "SpecialItems" category.
	var specialitems := {
		0x7004, // Dragon Egg
		0x7005, // Ostard Egg
		0x7006, // Frenzied Egg
		0x4000AA, // Omega Token
		0x4001AB  // Transcendence Scroll
	};

	// pkg/opt/omegacache/categories.cfg's own "Miscellaneous" category.
	// 2026-09-14: trimmed back to match -- Bandages/Blank Map/Blank Scroll/
	// Empty Bottle/Kindling/the Tinkering-tool items all moved to their own
	// categories (Bandages/Cartography/SpellbookScrolls/Reagents/Logs/
	// Tinkering) earlier, and are now sourced from the bags matching those
	// categories instead (misc/logs/reagents(alchemy)/tinkering above).
	var miscitems := {
		0x1422, // Beeswax
		0x142A, // Pot of Wax
		0x1428, // Dipping Stick
		0x12AC  // Tarot Cards
	};

	FillMaterials(logsChest, logs);
	FillMaterials(oreChest, ore);
	FillMaterials(ingotsChest, ingots);
	FillMaterials(hidesChest, hides);
	FillMaterials(tailoringChest, cloth);
	FillMaterials(materialsChest, misc);
	FillMaterials(materialsChest, preciousmetals);
	FillMaterials(materialsChest, bowcraft);
	FillMaterials(materialsChest, tinkering);
	FillMaterials(materialsChest, reagents);
	FillMaterials(cookingChest, food);
	FillMaterials(cookingChest, rawfoodandherbs);
	FillMaterials(fishChest, fish, FISHING_STACK_AMOUNT);
	FillMaterials(crustChest, crustaceans, FISHING_STACK_AMOUNT);
	FillMaterials(fishToolsChest, fishtools, FISHING_STACK_AMOUNT);
	FillMaterials(fishSpecialChest, fishspecial, FISHING_STACK_AMOUNT);
	FillMaterials(alchemyChest, alchemy, ALCHEMY_STACK_AMOUNT);
	FillMaterials(miscChest, specialitems, MISC_STACK_AMOUNT);
	FillMaterials(miscChest, miscitems, MISC_STACK_AMOUNT);

	// One of every crafting tool, so every skill can be tested without having
	// to go find/buy the tool separately. Lives in the materials chest.
	CreateItemInContainer(materialsChest, "SmithyHammer", 1);
	CreateItemInContainer(materialsChest, "Tongs", 1);
	CreateItemInContainer(materialsChest, "Saw", 1);
	CreateItemInContainer(materialsChest, "TinkersTools", 1);
	CreateItemInContainer(materialsChest, "SewingKit", 1);
	CreateItemInContainer(materialsChest, "Scissors", 1);
	CreateItemInContainer(materialsChest, "rollingpin", 1);
	CreateItemInContainer(materialsChest, "woodenbowl", 1);
	CreateItemInContainer(materialsChest, "fryingpan", 1);
	CreateItemInContainer(materialsChest, "FishingPole", 1);
	CreateItemInContainer(materialsChest, 0x0e9b, 1);
	CreateItemInContainer(materialsChest, "BowcraftTool", 1);

	SendSysMessage(who, "Dropped 13 backpacks at your feet -- Logs, Ore, Ingots, Hides, Tailoring, Materials, Cooking (" + MATERIAL_STACK_AMOUNT + " of each), Fish, Crustaceans, Fishing Tools, Special Fishing Items (" + FISHING_STACK_AMOUNT + " of each), Alchemy (" + ALCHEMY_STACK_AMOUNT + " of each), and Misc (" + MISC_STACK_AMOUNT + " of each).");
	LogCommand(who, GetProcess(GetPid()).name);
	return 1;
endprogram
