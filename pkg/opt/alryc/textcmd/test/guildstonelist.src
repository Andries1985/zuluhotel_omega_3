function SpawnGuildstoneList(who, loc, tiles)

	var created := 0;

	// Pass 1: every standalone (non-set) tile, packed tight in the usual
	// 20-wide diagonal grid.
	var per_row := 20;
	var row := 0;
	var col := 0;
	var i;

	for (i := 1; i <= tiles.size(); i := i + 1)
		var entry := tiles[i];
		var set_label := entry[3];
		if (set_label != "")
			continue;
		endif

		var row_start_x := loc.x + (row * 4);
		var row_start_y := loc.y + (row * 4);
		var x := row_start_x + (col * 2);
		var y := row_start_y - (col * 2);

		created := created + SpawnGuildstoneItem(who, loc, x, y, entry);

		col := col + 1;
		if (col >= per_row)
			col := 0;
			row := row + 1;
		endif
	endfor

	// Pass 2: multi-piece statue sets, grouped onto one shared row per
	// piece-count (all doubles together, all triples together, and so on).
	// Each piece is placed at its real measured offset from the set's
	// anchor (piece 1), captured in-client by hand-positioning the pieces
	// against each other -- these are NOT decorative spacing, they're what
	// makes the pieces line up into one statue. SET_GAP is the padding
	// between one set and the next on the same row (double the singles'
	// tight per-tile spacing). Row offsets are flat tile counts (not row
	// units like pass 1) -- calibrated against lava-tile markers placed
	// in-client: first sets row starts SETS_ROW_GAP past the last singles
	// row, each further size-row is SET_ROW_STEP past the previous one.
	var SET_GAP := 4;
	var SETS_ROW_GAP := 8;
	var SET_ROW_STEP := 10;

	var sets_base_offset := (row * 4) + SETS_ROW_GAP;
	var size_to_row := dictionary;
	var size_to_x := dictionary;
	var next_size_row := 0;

	i := 1;
	while (i <= tiles.size())
		var entry := tiles[i];
		var group_size := entry[4];

		if (group_size > 0)
			if (!size_to_row[group_size])
				size_to_row[group_size] := sets_base_offset + (next_size_row * SET_ROW_STEP);
				size_to_x[group_size] := 0;
				next_size_row := next_size_row + 1;
			endif

			var this_row := size_to_row[group_size];
			var anchor_offset := size_to_x[group_size];
			var anchor_x := loc.x + this_row + anchor_offset;
			var anchor_y := loc.y + this_row - anchor_offset;

			var min_dx := 0;
			var max_dx := 0;
			var piece;
			for (piece := 0; piece < group_size; piece := piece + 1)
				var piece_entry := tiles[i + piece];
				var dx := piece_entry[5];
				var dy := piece_entry[6];
				var x := anchor_x + dx;
				var y := anchor_y + dy;
				created := created + SpawnGuildstoneItem(who, loc, x, y, piece_entry);

				if (dx < min_dx)
					min_dx := dx;
				endif
				if (dx > max_dx)
					max_dx := dx;
				endif
			endfor

			size_to_x[group_size] := anchor_offset + (max_dx - min_dx) + 1 + SET_GAP;

			i := i + group_size;
		else
			i := i + 1;
		endif
	endwhile

	SendSysMessage(who, "Created " + created + " of " + tiles.size() + " guildstone/statue items.");

endfunction

function SpawnGuildstoneItem(who, loc, x, y, entry)

	var objtype := entry[1];
	var desc := entry[2];
	var set_label := entry[3];

	var item := CreateItemAtLocation(x, y, loc.z, objtype, 1, loc.realm);
	if (!item)
		return 0;
	endif

	item.movable := 0;
	var name := Hex(objtype);
	if (desc != "")
		name := name + " - " + desc;
	endif
	if (set_label != "")
		name := name + " [" + set_label + "]";
	endif
	item.name := name;
	SetObjProperty(item, "StaffCreatedSerial", who.serial);
	SetObjProperty(item, "StaffCreatedName", who.name);

	return 1;

endfunction
