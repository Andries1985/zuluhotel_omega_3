// Synopsis: Drop one sort chest per equipment layer at your feet, each pre-loaded with every layer objtype that has no existing script usage, plus 5 bags (NON-RENDERING/PAPERDOLL ONLY/IN-WORLD ONLY/WRONG GRAPHIC/CORRECT) to sort them into after in-game testing
use uo;
use cfgfile;
include ":staff:include/staff";

const SORT_CHEST_GRAPHIC := 0x0E40;
const SORT_BAG_GRAPHIC := 0x9B2;

function ComboTag(combo, layer_num)
	if (combo == "fully_dead")
		return "predicted NON-RENDERING (dead everywhere)";
	elseif (combo == "paperdoll_only")
		return "predicted PAPERDOLL ONLY (dead in-world)";
	elseif (combo == "inworld_only")
		return "predicted IN-WORLD ONLY (dead on paperdoll)";
	elseif (combo == "both_have_data")
		return "predicted HAS DATA both places - verify correct/wrong";
	elseif (combo == "untested")
		if (layer_num == 1 or layer_num == 2)
			return "UNTESTED - weapons use the wearer's own action/stance, not a per-item body - no prediction possible";
		endif
		return "UNTESTED - AnimID 0";
	endif
	return combo;
endfunction

function JoinFrom(words, startidx)
	var result := "";
	var i;
	for (i := startidx; i <= len(words); i := i + 1)
		if (i > startidx)
			result := result + " ";
		endif
		result := result + words[i];
	endfor
	return result;
endfunction

function AddPiece(chest, objtype, label)
	var item := CreateItemInContainer(chest, objtype, 1);
	if (item)
		item.name := label;
	endif
	return item;
endfunction

function MakeLayerChest(who, layer_num, layerhex, layername, itemlines)
	var chest := CreateItemAtLocation(who.x, who.y, who.z, SORT_CHEST_GRAPHIC, 1, who.realm);
	if (!chest)
		return 0;
	endif
	chest.name := "Layer " + layerhex + " (" + layername + ") Sort Chest";
	chest.color := 1153;

	var nonRenderBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	var paperdollOnlyBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	var inworldOnlyBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	var wrongGraphicBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	var correctBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	if (!nonRenderBag or !paperdollOnlyBag or !inworldOnlyBag or !wrongGraphicBag or !correctBag)
		return 0;
	endif
	nonRenderBag.name := "NON-RENDERING (" + layerhex + ")";
	nonRenderBag.color := 0x020;
	paperdollOnlyBag.name := "PAPERDOLL ONLY (" + layerhex + ")";
	paperdollOnlyBag.color := 0x489;
	inworldOnlyBag.name := "IN-WORLD ONLY (" + layerhex + ")";
	inworldOnlyBag.color := 0x059;
	wrongGraphicBag.name := "WRONG GRAPHIC (" + layerhex + ")";
	wrongGraphicBag.color := 0x481;
	correctBag.name := "CORRECT (" + layerhex + ")";
	correctBag.color := 0x044;

	var i;
	for (i := 1; i <= len(itemlines); i := i + 1)
		var words := SplitWords(itemlines[i]);
		if (len(words) < 2)
			continue;
		endif
		var objtype := CInt(words[1]);
		if (!objtype)
			continue;
		endif
		var combo := words[2];
		var desc := JoinFrom(words, 3);
		var label := desc + " - " + words[1] + " [" + ComboTag(combo, layer_num) + "]";
		AddPiece(chest, objtype, label);
	endfor
	return 1;
endfunction

program missingequipment(who)
	var cfg := ReadConfigFile(":alryc:missingequipment");
	if (!cfg)
		SendSysMessage(who, "missingequipment.cfg could not be loaded from :alryc:config.");
		return 0;
	endif

	var madeCount := 0;
	var totalItems := 0;
	var layer_num;
	foreach layer_num in GetConfigIntKeys(cfg)
		var elem := FindConfigElem(cfg, layer_num);
		if (!elem)
			continue;
		endif
		var layername := GetConfigString(elem, "Name");
		var itemlines := GetConfigStringArray(elem, "Item");
		if (!itemlines)
			continue;
		endif
		var layerhex := Hex(layer_num);
		madeCount := madeCount + MakeLayerChest(who, layer_num, layerhex, layername, itemlines);
		totalItems := totalItems + len(itemlines);
	endforeach

	SendSysMessage(who, "Dropped " + madeCount + " layer sort chests at your feet -- " + totalItems + " total unsorted items across all layers. Equip each, sort into NON-RENDERING/PAPERDOLL ONLY/IN-WORLD ONLY/WRONG GRAPHIC/CORRECT, then save.");
	LogCommand(who, GetProcess(GetPid()).name);
	return 1;
endprogram
