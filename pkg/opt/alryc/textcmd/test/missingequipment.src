// Synopsis: Drop one sort chest per equipment layer at your feet, each pre-loaded with every layer objtype that has no existing script usage, plus WORKING/DOESN'T RENDER/OTHER bags to sort them into
use uo;
include ":staff:include/staff";

const SORT_CHEST_GRAPHIC := 0x0E40;
const SORT_BAG_GRAPHIC := 0x9B2;

function AddPiece(chest, objtype, label)
	var item := CreateItemInContainer(chest, objtype, 1);
	if (item)
		item.name := label;
	endif
	return item;
endfunction

function MakeLayerChest(who, layerhex, layername, objtypes, labels)
	var chest := CreateItemAtLocation(who.x, who.y, who.z, SORT_CHEST_GRAPHIC, 1, who.realm);
	if (!chest)
		return 0;
	endif
	chest.name := "Layer " + layerhex + " (" + layername + ") Sort Chest";
	chest.color := 1153;

	var workingBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	var deadBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	var otherBag := CreateItemInContainer(chest, SORT_BAG_GRAPHIC, 1);
	if (!workingBag or !deadBag or !otherBag)
		return 0;
	endif
	workingBag.name := "WORKING (" + layerhex + ")";
	workingBag.color := 0x044;
	deadBag.name := "DOESN'T RENDER (" + layerhex + ")";
	deadBag.color := 0x020;
	otherBag.name := "OTHER (" + layerhex + ")";
	otherBag.color := 0x481;

	var i;
	for (i := 1; i <= len(objtypes); i := i + 1)
		AddPiece(chest, objtypes[i], labels[i]);
	endfor
	return 1;
endfunction

