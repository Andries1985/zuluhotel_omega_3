const NOVAL := -999999;

function PromptInt( who , msg )
//Reproduces the file's existing convention: cancel and literal 0 are indistinguishable
//(same as the original single shared prompt); 9999 explicitly resets/clears to 0.

	SendSysmessage( who , msg + " Enter 9999 to reset. Hit Esc to cancel." );
	var val := Cint(RequestInput( who , who.backpack , "Enter a value." ));

	if( !val )
		Dbg( "PromptInt(\"" + msg + "\"): cancelled/blank" );
		return NOVAL;
	endif

	if( val == 9999 )
		Dbg( "PromptInt(\"" + msg + "\"): reset to 0" );
		return 0;
	endif

	Dbg( "PromptInt(\"" + msg + "\"): entered " + val );
	return val;

endfunction

function ClampInt( who , val , lo , hi )

	if( val < lo or val > hi )
		SendSysmessage( who , "Value must be between " + lo + " and " + hi + ". Not applied." );
		Dbg( "ClampInt: rejected " + val + " (range " + lo + "-" + hi + ")" );
		return NOVAL;
	endif

	return val;

endfunction

function PickTierValue( who , choices , title )
//Small button-list gump offering only the legal tier values for a property, plus a
//Clear/Remove option. Returns the picked value, 0 for Clear, or NOVAL if cancelled.

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 " + (65 + (len(choices)+1)*22)
							);

	var data2 := array( title );

	layout2.append( "text 75 20 5 0" );

	var y := 50;
	var i;
	for( i := 1 ; i <= len(choices) ; i := i + 1 )
		layout2.append( "text 85 " + y + " 0 " + len(data2) );
		data2.append( CStr(choices[i]) );
		layout2.append( "button 250 " + (y+5) + " 2118 2117 1 0 " + i );
		y := y + 22;
	endfor

	layout2.append( "text 85 " + y + " 0 " + len(data2) );
	data2.append( "Clear / Remove" );
	layout2.append( "button 250 " + (y+5) + " 2118 2117 1 0 " + (len(choices)+1) );

	var result := SendDialogGump( who , layout2 , data2 );

	if( !result[0] )
		Dbg( "PickTierValue(\"" + title + "\"): cancelled" );
		return NOVAL;
	elseif( result[0] == (len(choices)+1) )
		Dbg( "PickTierValue(\"" + title + "\"): Clear/Remove picked" );
		return 0;
	else
		Dbg( "PickTierValue(\"" + title + "\"): picked " + choices[result[0]] );
		return choices[result[0]];
	endif

endfunction

function PickStringChoice( who , choices , title )
//Same idea as PickTierValue but for a small set of named string choices (e.g. the
//Enchanted tier). Returns the picked string, "CLEAR" if Clear/Remove was picked, or ""
//if cancelled.

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 " + (65 + (len(choices)+1)*22)
							);

	var data2 := array( title );

	layout2.append( "text 75 20 5 0" );

	var y := 50;
	var i;
	for( i := 1 ; i <= len(choices) ; i := i + 1 )
		layout2.append( "text 85 " + y + " 0 " + len(data2) );
		data2.append( CStr(choices[i]) );
		layout2.append( "button 250 " + (y+5) + " 2118 2117 1 0 " + i );
		y := y + 22;
	endfor

	layout2.append( "text 85 " + y + " 0 " + len(data2) );
	data2.append( "Clear / Remove" );
	layout2.append( "button 250 " + (y+5) + " 2118 2117 1 0 " + (len(choices)+1) );

	var result := SendDialogGump( who , layout2 , data2 );

	if( !result[0] )
		Dbg( "PickStringChoice(\"" + title + "\"): cancelled" );
		return "";
	elseif( result[0] == (len(choices)+1) )
		Dbg( "PickStringChoice(\"" + title + "\"): Clear/Remove picked" );
		return "CLEAR";
	else
		Dbg( "PickStringChoice(\"" + title + "\"): picked " + choices[result[0]] );
		return choices[result[0]];
	endif

endfunction

function SetSkillAdvCategoryFlag( item )
//RenameBySkill (namingbyenchant.inc) divides skilladvamount by 5 ONLY if WeapAdv is set -
//without it, a weapon skill mod (stored on the raw 5-30 scale) looks up "Name30" instead
//of "Name6" in modenchantdesc.cfg, which doesn't exist, so it silently gets NO naming
//adjective. starteqp.inc's ApplyWeapSkillMod/ShieldApplyArSkillMod set WeapAdv/ShieldAdv
//for exactly this reason - mirror that here whenever a skill mod is (re)applied, so the
//category always matches whatever scale GetSkillTierChoicesForItem just used.

	var shieldgfx := GetShieldGraphics();
	if( item.graphic in shieldgfx )
		EraseObjProperty( item , "WeapAdv" );
		SetObjProperty( item , "ShieldAdv" , 1 );
	elseif( item.Attribute )
		SetObjProperty( item , "WeapAdv" , 1 );
		EraseObjProperty( item , "ShieldAdv" );
	else
		EraseObjProperty( item , "WeapAdv" );
		EraseObjProperty( item , "ShieldAdv" );
	endif

endfunction

function EditElementalDamage( who , item )
//Composite CProp editor for "ElementalDamage" ("FIRE:25 AIR:25 ..." - space-separated
//TYPE:pct tokens, read directly by the general damage pipeline in
//pkg/systems/combat/include/hitscriptinc.inc regardless of item.hitscript/OnHitScript).
//Confirmed NOT mutually exclusive with SlayType/hitscripts - ElementalDamage is applied
//on every hit independent of whatever hitscript is set, so a slayer weapon can also carry
//elemental damage with no conflict. Loops on its own (like the main tool) so a GM can set
//several elements in one session.

	var elements := { "FIRE","AIR","EARTH","WATER","NECRO","HOLY","POISON","ACID","PHYSICAL","MAGIC","ASTRAL","NO_RESIST" };
	var pcts := {20,25,50,65,75,85,95,100,115};

	var done := 0;
	var safeexit := 0;
	while( !done and safeexit < 100 )
		safeexit := safeexit + 1;

		var pkeys := array;
		var pvals := array;
		var current := GetObjProperty( item , "ElementalDamage" );
		if( current )
			foreach token in SplitWords( CStr(current) , " " )
				var kv := SplitWords( token , ":" );
				if( len(kv) == 2 )
					pkeys.append( kv[1] );
					pvals.append( kv[2] );
				endif
			endforeach
		endif

		var layout2 := array(
					"page 0",
					"resizepic 50  0   2600 260 " + (65 + (len(elements)+1)*22)
								);
		var data2 := array( "Elemental Damage - pick an element to set/clear:" );
		layout2.append( "text 75 20 5 0" );

		var y := 50;
		var i, j;
		for( i := 1 ; i <= len(elements) ; i := i + 1 )
			var label := elements[i];
			for( j := 1 ; j <= len(pkeys) ; j := j + 1 )
				if( pkeys[j] == elements[i] )
					label := elements[i] + " (" + pvals[j] + "%)";
				endif
			endfor
			layout2.append( "text 85 " + y + " 0 " + len(data2) );
			data2.append( label );
			layout2.append( "button 260 " + (y+5) + " 2118 2117 1 0 " + i );
			y := y + 22;
		endfor

		layout2.append( "text 85 " + y + " 0 " + len(data2) );
		data2.append( "Done / Close" );
		layout2.append( "button 260 " + (y+5) + " 2118 2117 1 0 " + (len(elements)+1) );

		var result := SendDialogGump( who , layout2 , data2 );
		if( !result[0] or result[0] == (len(elements)+1) )
			done := 1;
			break;
		endif

		var chosen := elements[result[0]];
		var pctval := PickTierValue( who , pcts , "Select " + chosen + " damage % (Clear to remove):" );
		if( pctval != NOVAL )
			var newkeys := array;
			var newvals := array;
			for( j := 1 ; j <= len(pkeys) ; j := j + 1 )
				if( pkeys[j] != chosen )
					newkeys.append( pkeys[j] );
					newvals.append( pvals[j] );
				endif
			endfor
			if( pctval )
				newkeys.append( chosen );
				newvals.append( CStr(pctval) );
			endif

			var rebuilt := "";
			for( j := 1 ; j <= len(newkeys) ; j := j + 1 )
				if( rebuilt != "" )
					rebuilt := rebuilt + " ";
				endif
				rebuilt := rebuilt + newkeys[j] + ":" + newvals[j];
			endfor

			if( rebuilt != "" )
				SetObjProperty( item , "ElementalDamage" , rebuilt );
			else
				EraseObjProperty( item , "ElementalDamage" );
			endif
			Dbg( "ElementalDamage now: " + rebuilt );
		endif
	endwhile

endfunction

function ChangeToGMCounterpart( who , item )
//Scans the full itemdesc config for every entry that (a) shares this item's graphic and
//(b) carries an IsGMItem CProp - i.e. every unique/GM weapon or armor piece that LOOKS
//like the targeted item (same base shape, e.g. every katana-shaped GM item for a katana,
//every plate-breastplate-shaped GM item for a breastplate). objtype is read-only on an
//existing item (confirmed - no setter exists anywhere in this codebase or the uo.em
//module), so this destroys the old item and creates a fresh instance of the chosen GM
//objtype in its place, re-equipping it if the old one was worn.

	SendSysmessage( who , "Scanning itemdesc for GM counterparts of graphic " + Hex(item.graphic) + "..." );

	//Scoped to :combat:itemdesc rather than the full merged ":*:itemdesc" - every IsGMItem
	//weapon/armor entry found while researching this tool lived in that one package
	//(pkg/systems/combat/config/itemdesc.cfg), and scanning the whole shard's merged
	//catalog (every reagent/food/deco item included) would be far slower for no benefit
	//if GM items really are confined to combat. Widen this back to ":*:itemdesc" if a GM
	//counterpart is ever added somewhere else and this stops finding it.
	var itemcfg := ReadConfigFile( ":combat:itemdesc" );
	var keys := GetConfigStringKeys( itemcfg );

	var names := array;
	var objtypes := array;

	foreach key in keys
		var elem := itemcfg[key];
		if( elem.Graphic and CInt(elem.Graphic) == item.graphic )
			var cprops := GetConfigStringArray( elem , "CProp" );
			foreach cprop in cprops
				var parts := SplitWords( cprop );
				if( len(parts) >= 2 and parts[1] == "IsGMItem" )
					var gmname := "";
					var p;
					for( p := 2 ; p <= len(parts) ; p := p + 1 )
						if( gmname != "" )
							gmname := gmname + " ";
						endif
						gmname := gmname + parts[p];
					endfor
					names.append( gmname );
					objtypes.append( CInt(key) );
					break;
				endif
			endforeach
		endif
	endforeach

	Dbg( "ChangeToGMCounterpart: found " + len(names) + " candidate(s) for graphic " + Hex(item.graphic) );

	if( !len(names) )
		SendSysmessage( who , "No GM counterpart found for graphic " + Hex(item.graphic) + "." );
		return 0;
	endif

	var pick;
	if( len(names) == 1 )
		if( !YesNo( who , "Convert this item to \"" + names[1] + "\"? This destroys the current item." ) )
			return 0;
		endif
		pick := 1;
	else
		var layout2 := array(
					"page 0",
					"resizepic 50  0   2600 300 " + (65 + (len(names)+1)*22)
								);
		var data2 := array( "Select the GM counterpart to convert to:" );
		layout2.append( "text 75 20 5 0" );

		var y := 50;
		var i;
		for( i := 1 ; i <= len(names) ; i := i + 1 )
			layout2.append( "text 85 " + y + " 0 " + len(data2) );
			data2.append( names[i] );
			layout2.append( "button 280 " + (y+5) + " 2118 2117 1 0 " + i );
			y := y + 22;
		endfor

		var result := SendDialogGump( who , layout2 , data2 );
		if( !result[0] )
			return 0;
		endif
		pick := result[0];
	endif

	//Figure out where the replacement belongs: re-equip on the same mobile if the old
	//item was worn, otherwise drop it in the same container, otherwise the same spot.
	var oldcontainer := item.container;
	var wearer := 0;
	if( oldcontainer and oldcontainer.isa( POLCLASS_CHARACTER ) )
		wearer := oldcontainer;
	endif

	var oldx := item.x;
	var oldy := item.y;
	var oldz := item.z;
	var oldrealm := item.realm;
	var oldobjtype := item.objtype;
	var oldgraphic := item.graphic;

	LogCommand(who, GetProcess(GetPid()).name, "objtype "+Hex(oldobjtype)+"/"+item.serial, "Converting to GM counterpart: "+names[pick]);
	DestroyItem( item );

	var newitem;
	if( wearer )
		newitem := CreateItemInBackpack( wearer , objtypes[pick] );
		if( newitem )
			EquipItem( wearer , newitem );
		endif
	elseif( oldcontainer )
		newitem := CreateItemInContainer( oldcontainer , objtypes[pick] );
	else
		newitem := CreateItemAtLocation( oldx , oldy , oldz , objtypes[pick] , 1 , oldrealm );
	endif

	if( !newitem )
		SendSysmessage( who , "Failed to create the GM counterpart - the original item is gone." );
		Dbg( "ChangeToGMCounterpart: create FAILED for objtype " + Hex(objtypes[pick]) );
		return 0;
	endif

	Dbg( "ChangeToGMCounterpart: " + Hex(oldgraphic) + "/" + Hex(oldobjtype) + " -> " + Hex(newitem.objtype) + " (\"" + names[pick] + "\") desc=\"" + newitem.desc + "\"" );
	SendSysmessage( who , "Converted to " + newitem.desc + "." );

	return newitem;

endfunction

function ClearOtherStatMods( item , keep )
//str/int/dex are mutually exclusive on a real drop - never more than one.

	if( keep != "str" and GetObjProperty( item , "str" ) )
		Dbg( "ClearOtherStatMods: erasing str (keeping " + keep + ")" );
		EraseObjProperty( item , "str" );
	endif
	if( keep != "int" and GetObjProperty( item , "int" ) )
		Dbg( "ClearOtherStatMods: erasing int (keeping " + keep + ")" );
		EraseObjProperty( item , "int" );
	endif
	if( keep != "dex" and GetObjProperty( item , "dex" ) )
		Dbg( "ClearOtherStatMods: erasing dex (keeping " + keep + ")" );
		EraseObjProperty( item , "dex" );
	endif

endfunction

function ClearOtherElementalGroup( item , keep )
//The nine-way ApplyEnchant "elemental" pick - exactly one of these ever appears together.

	var props := {	"AirProtection", "EarthProtection", "FireProtection",
			"WaterProtection", "HolyProtection", "NecroProtection",
			"FreeAction", "HealingIncrease", "PhysicalProtection"	};

	foreach prop in props
		if( prop != keep and GetObjProperty( item , prop ) )
			Dbg( "ClearOtherGroup: erasing " + prop + " (keeping " + keep + ")" );
			EraseObjProperty( item , prop );
		endif
	endforeach

endfunction

function ClearOtherChargeImmunity( item , keep )
//ApplyEnchant's charge-immunity pick - exactly one of these three.

	var props := { "MagicImmunity", "PoisonImmunity", "SpellReflect" };

	foreach prop in props
		if( prop != keep and GetObjProperty( item , prop ) )
			Dbg( "ClearOtherGroup: erasing " + prop + " (keeping " + keep + ")" );
			EraseObjProperty( item , prop );
		endif
	endforeach

endfunction

function ClearOtherPermanentImmunity( item , keep )
//ApplyEnchant's permanent-immunity pick - exactly one of these three.

	var props := { "PermMagicImmunity", "PermPoisonImmunity", "Permmr" };

	foreach prop in props
		if( prop != keep and GetObjProperty( item , prop ) )
			Dbg( "ClearOtherGroup: erasing " + prop + " (keeping " + keep + ")" );
			EraseObjProperty( item , prop );
		endif
	endforeach

endfunction

function ResetHitscriptPropsExcep( item , excep := "" )
//Local replacement for itemutil.inc's ResetAllHitscriptPropsExcep, kept separate on
//purpose so this parallel tool never touches the shared include. Also clears
//HitscriptNumber/OnHitscriptNumber, which the shared version does not - their absence
//is what breaks the CProp display/edit path after picking an Effect/Greater/Special
//hitscript (see SetAnEffectScriptFromList and friends below, which now write them).

	var cprops := {	"ChanceOfEffect",
				"EffectCircle"	,
				"HitWithSpell"	,
				"Poisonlvl"	,
				"Powerlevel"	,
				"ProtectedType"	,
				"SlayType"	,
				"HitscriptNumber"	,
				"OnHitscriptNumber"	};

	foreach cprop in cprops
		if( cprop != excep )
			EraseObjProperty( item , cprop );
		endif
	endforeach

endfunction

function EditItemInt( who , item , result )

	var val;

	case( result )
		1:	//x value
			val := PromptInt( who , "X coordinate." );
			if( val != NOVAL )
				MoveObjectToLocation( item , val , item.y , item.z , item.realm, MOVEOBJECT_FORCELOCATION );
			endif
			break;

		2:	//y value
			val := PromptInt( who , "Y coordinate." );
			if( val != NOVAL )
				MoveObjectToLocation( item , item.x , val , item.z , item.realm, MOVEOBJECT_FORCELOCATION );
			endif
			break;

		3:	//z value
			val := PromptInt( who , "Z coordinate." );
			if( val != NOVAL )
				MoveObjectToLocation( item , item.x , item.y , val , item.realm, MOVEOBJECT_FORCELOCATION );
			endif
			break;

		4:	//graphic number
			val := PromptInt( who , "New graphic (decimal). You may also type a 0x... hex value." );
			if( val != NOVAL )
				item.graphic := val;
			endif
			break;

		5:	//Hp
			val := PromptInt( who , "New current HP." );
			if( val != NOVAL )
				item.hp := val;
			endif
			break;

		6:	//Mhp mod - HP/AR/Dmg mod tier, legal range per starteqp.inc's ApplyHPMod
			val := PickTierValue( who , {5,10,15,20,25,30} , "Select the HP bonus:" );
			if( val != NOVAL )
				item.maxhp_mod := val;
				if( val )
					DebugRenameItem( item );
				endif
			endif
			break;

		7:	//Ar/Dmg mod - same tier family as case 6, applies to whichever stat this item uses
			val := PickTierValue( who , {5,10,15,20,25,30} , "Select the Ar/Dmg bonus:" );
			if( val != NOVAL )
				if( item.ar )
					item.ar_mod := val;
				else
					item.dmg_mod := val;
				endif
				if( val )
					DebugRenameItem( item );
				endif
			endif
			break;

		8:	//Skillid - raw fallback; use the "Change Skill from list" button for a validated pick.
			//Note: like the rest of this file's shared-prompt convention, a literal "0" is
			//indistinguishable from cancel, so skill id 0 (Alchemy) can't be typed directly
			//here - use "Change Skill from list" (case 45) for that skill specifically.
			val := PromptInt( who , "Skill id (0-" + SKILLID__HIGHEST + "). Use \"Change Skill\" for a validated pick." );
			if( val != NOVAL )
				val := ClampInt( who , val , 0 , SKILLID__HIGHEST );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "skilladv" , val );
					SetSkillAdvCategoryFlag( item );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "skilladv" );
				endif
			endif
			break;

		9:	//Skill Gain - now category-aware, same tier set the skill picker (case 45) uses
			val := PickTierValue( who , GetSkillTierChoicesForItem( item ) , "Select the skill gain amount:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "skilladvamount" , val );
					SetSkillAdvCategoryFlag( item );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "skilladvamount" );
				endif
			endif
			break;

		10:	//Strength mod - one of str/int/dex only, tier per starteqp.inc's ApplyStatMod
			val := PickTierValue( who , {2,4,6,8,10,12} , "Select the Strength bonus:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "str" , val );
					ClearOtherStatMods( item , "str" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "str" );
				endif
			endif
			break;

		11:	//Intelligence mod
			val := PickTierValue( who , {2,4,6,8,10,12} , "Select the Intelligence bonus:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "int" , val );
					ClearOtherStatMods( item , "int" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "int" );
				endif
			endif
			break;

		12:	//Dexterity mod
			val := PickTierValue( who , {2,4,6,8,10,12} , "Select the Dexterity bonus:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "dex" , val );
					ClearOtherStatMods( item , "dex" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "dex" );
				endif
			endif
			break;

		16:	//Air Protection - elemental group, %-tier per starteqp.inc's ApplyElementalImmunity
			val := PickTierValue( who , {25,50,65,75,85,95} , "Select Air Protection %:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "AirProtection" , val );
					ClearOtherElementalGroup( item , "AirProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "AirProtection" );
				endif
			endif
			break;

		17:	//Earth Protection
			val := PickTierValue( who , {25,50,65,75,85,95} , "Select Earth Protection %:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "EarthProtection" , val );
					ClearOtherElementalGroup( item , "EarthProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "EarthProtection" );
				endif
			endif
			break;

		18:	//Fire Protection
			val := PickTierValue( who , {25,50,65,75,85,95} , "Select Fire Protection %:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "FireProtection" , val );
					ClearOtherElementalGroup( item , "FireProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "FireProtection" );
				endif
			endif
			break;

		19:	//Water Protection
			val := PickTierValue( who , {25,50,65,75,85,95} , "Select Water Protection %:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "WaterProtection" , val );
					ClearOtherElementalGroup( item , "WaterProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "WaterProtection" );
				endif
			endif
			break;

		20:	//Holy Protection
			val := PickTierValue( who , {25,50,65,75,85,95} , "Select Holy Protection %:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "HolyProtection" , val );
					ClearOtherElementalGroup( item , "HolyProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "HolyProtection" );
				endif
			endif
			break;

		21:	//Necro Protection
			val := PickTierValue( who , {25,50,65,75,85,95} , "Select Necro Protection %:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "NecroProtection" , val );
					ClearOtherElementalGroup( item , "NecroProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "NecroProtection" );
				endif
			endif
			break;

		22:	//Physical Protection - elemental group, but keeps the generator's raw 1-6 tier (not %)
			val := PromptInt( who , "Physical Protection tier (1-6)." );
			if( val != NOVAL and val != 0 )
				val := ClampInt( who , val , 1 , 6 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "PhysicalProtection" , val );
					ClearOtherElementalGroup( item , "PhysicalProtection" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "PhysicalProtection" );
				endif
			endif
			break;

		23:	//Healing Increase - elemental group, also keeps the generator's raw 1-6 tier
			val := PromptInt( who , "Healing Increase tier (1-6)." );
			if( val != NOVAL and val != 0 )
				val := ClampInt( who , val , 1 , 6 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "HealingIncrease" , val );
					ClearOtherElementalGroup( item , "HealingIncrease" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "HealingIncrease" );
				endif
			endif
			break;

		24:	//FreeAction - a binary flag on real drops, elemental group
			if( GetObjProperty( item , "FreeAction" ) )
				EraseObjProperty( item , "FreeAction" );
			else
				SetObjProperty( item , "FreeAction" , 1 );
				ClearOtherElementalGroup( item , "FreeAction" );
			endif
			DebugRenameItem( item );
			break;

		25:	//Magic immunity charges - charge-immunity group, tier per ApplyProtection
			val := PickTierValue( who , {15,20,25,30,35,40} , "Select Magic Immunity charges:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "MagicImmunity" , val );
					ClearOtherChargeImmunity( item , "MagicImmunity" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "MagicImmunity" );
				endif
			endif
			break;

		26:	//Poison immunity charges
			val := PickTierValue( who , {15,20,25,30,35,40} , "Select Poison Immunity charges:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "PoisonImmunity" , val );
					ClearOtherChargeImmunity( item , "PoisonImmunity" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "PoisonImmunity" );
				endif
			endif
			break;

		27:	//Spell reflect charges
			val := PickTierValue( who , {15,20,25,30,35,40} , "Select Spell Reflection charges:" );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "SpellReflect" , val );
					ClearOtherChargeImmunity( item , "SpellReflect" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "SpellReflect" );
				endif
			endif
			break;

		28:	//Permanent magic immunity circle - permanent-immunity group, raw 1-6 tier
			val := PromptInt( who , "Permanent Magic Immunity circle (1-6)." );
			if( val != NOVAL and val != 0 )
				val := ClampInt( who , val , 1 , 6 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "PermMagicImmunity" , val );
					ClearOtherPermanentImmunity( item , "PermMagicImmunity" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "PermMagicImmunity" );
				endif
			endif
			break;

		29:	//Permanent poison immunity level
			val := PromptInt( who , "Permanent Poison Immunity level (1-6)." );
			if( val != NOVAL and val != 0 )
				val := ClampInt( who , val , 1 , 6 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "PermPoisonImmunity" , val );
					ClearOtherPermanentImmunity( item , "PermPoisonImmunity" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "PermPoisonImmunity" );
				endif
			endif
			break;

		30:	//Permanent magic reflect circle
			val := PromptInt( who , "Permanent Magic Reflection circle (1-6)." );
			if( val != NOVAL and val != 0 )
				val := ClampInt( who , val , 1 , 6 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "Permmr" , val );
					ClearOtherPermanentImmunity( item , "Permmr" );
					DebugRenameItem( item );
				else
					EraseObjProperty( item , "Permmr" );
				endif
			endif
			break;

		31:	//Charges amount - usescript charges, not part of the enchant vocabulary; left free
			val := PromptInt( who , "Number of charges." );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "charges" , val );
				else
					EraseObjProperty( item , "charges" );
				endif
			endif
			break;

		32:	//Present color - manual override, deliberately not renamed/reconciled
			val := PromptInt( who , "New color." );
			if( val != NOVAL )
				item.color := val;
			endif
			break;

		33:	//Color on IDing
			val := PromptInt( who , "New EnchantColor (shown once identified)." );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "EnchantColor" , val );
				else
					EraseObjProperty( item , "EnchantColor" );
				endif
				DebugRenameItem( item );
			endif
			break;

		34:	//Curse level - admin concept, no drop-legal range to enforce
			val := PromptInt( who , "New curse level." );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "Cursed" , val );
				else
					EraseObjProperty( item , "Cursed" );
				endif
			endif
			break;

		35:	//Ar Bonus/Normal Range
			if( item.attribute == SKILLID_ARCHERY )
				//NormalRange - no confirmed generator source, left unconstrained
				val := PromptInt( who , "New Normal Range." );
				if( val != NOVAL )
					if( val )
						SetObjProperty( item , "NormalRange" , val );
					else
						EraseObjProperty( item , "NormalRange" );
					endif
				endif
			else
				val := PickTierValue( who , {1,2,3,4,5,6} , "Select the Ar Bonus:" );
				if( val != NOVAL )
					if( val )
						SetObjProperty( item , "ArBonus" , val );
						DebugRenameItem( item );
					else
						EraseObjProperty( item , "ArBonus" );
					endif
				endif
			endif
			break;

		36:	//Chance of effect - dynamic per-hitscript value, left unconstrained
			val := PromptInt( who , "Chance of effect." );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "ChanceOfEffect" , val );
				else
					EraseObjProperty( item , "ChanceOfEffect" );
				endif
			endif
			break;

		37:	//As Circle
			val := PromptInt( who , "Effect circle." );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "EffectCircle" , val );
				else
					EraseObjProperty( item , "EffectCircle" );
				endif
			endif
			break;

		38:	//Hitscript/OnHitscript CProp - dynamic property name/value, left unconstrained
			val := PromptInt( who , "New value for " + data[57] + "." );
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , data[57] , val );
				else
					EraseObjProperty( item , data[57] );
				endif
			endif
			break;

		84:	//Magic Penalty - crafting-material CProp, real items only ever carry -1 to -3
			val := PromptInt( who , "Magic Penalty (enter as -1 to -3, or the positive magnitude)." );
			if( val != NOVAL and val != 0 )
				if( val > 0 )
					val := 0 - val;
				endif
				val := ClampInt( who , val , -3 , -1 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "MagicPenalty" , val );
				else
					EraseObjProperty( item , "MagicPenalty" );
				endif
			endif
			break;

		85:	//Default Dex - crafting CProp; on a real item this only ever offsets an existing
			//negative base-template penalty, so it never nets positive
			val := PromptInt( who , "DefaultDex offset (enter as <= 0, or the positive magnitude)." );
			if( val != NOVAL and val != 0 )
				if( val > 0 )
					val := 0 - val;
				endif
				val := ClampInt( who , val , -20 , 0 );
			endif
			if( val != NOVAL )
				if( val )
					SetObjProperty( item , "DefaultDex" , val );
				else
					EraseObjProperty( item , "DefaultDex" );
				endif
			endif
			break;

		86:	//Speed Mod - native field (not a CProp), the exceptional-crafting weapon speed buff
			val := PromptInt( who , "Weapon speed_mod bonus." );
			if( val != NOVAL and val != 0 )
				val := ClampInt( who , val , 1 , 20 );
			endif
			if( val != NOVAL )
				item.speed_mod := val;
			endif
			break;
	endcase

endfunction

function EditItemString( who , item , result )

	SendSysmessage( who, "Enter a new name. Enter 9999 to reset. Hit Esc to cancel." );
	var newname := RequestInput( who , who.backpack , "Enter a new name." );
	
	if( !newname )
		return;
	endif
	
	case( result )
	
		40:	SetName( item , newname );
			break;
			
		41:	if( newname == "9999" )
				EraseObjProperty( item , "StaticName" );
			else
				SetObjProperty( item , "StaticName" , newname );
			endif
			break;
			
		42:	if( newname == "9999" )
				EraseObjProperty( item , "StaticCursedName" );
			else
				SetObjProperty( item , "StaticCursedName" , newname );
			endif
			break;
			
		79:	if( newname == "9999" )
				EraseObjProperty( item , "BaseName" );
			else
				SetObjProperty( item , "BaseName" , newname );
			endif
			break;
			
	endcase

endfunction

function EditQuality( who , item )

	SendSysmessage( who, "Changes are made immediately, double values supported. Hit Esc to cancel." );
	var val := CDbl(RequestInput( who, who.backpack, "Enter a new value."));

	if( !val )
		return;
	endif

	item.quality := val;

	//Quality has NO effect on its own - confirmed against the engine source. Real combat
	//damage/AR come from hp_/maxhp() (an internal, non-quality-scaled ratio), while
	//EScript's own item.maxhp getter IS quality-scaled (maxhp() * quality()). Crafting
	//captures that boost by setting hp:=maxhp right after creation (see
	//pkg/std/blacksmithy/make_blacksmith_items.src); mirror that here so a GM-set quality
	//actually behaves like a freshly crafted item instead of being cosmetic.
	var oldhp := item.hp;
	item.hp := item.maxhp;
	Dbg( "EditQuality: quality=" + val + " hp refreshed " + oldhp + " -> " + item.hp + " (maxhp=" + item.maxhp + ")" );

endfunction

function GetSkillTierChoicesForItem( item )
//The legal skilladvamount scale isn't one number - it depends on what kind of item this
//is, per starteqp.inc: weapons roll a raw 5-30 (x5) tier, shields roll that same tier
//then halve it (n/2, truncated), armor and misc/jewelry both keep a raw 1-6 tier, and
//misc/jewelry alone can also hit the "Legendary" tier of 10.

	var shieldgfx := GetShieldGraphics();
	if( item.graphic in shieldgfx )
		return {2,5,7,10,12,15};
	elseif( item.Attribute )
		return {5,10,15,20,25,30};
	elseif( item.ar )
		return {1,2,3,4,5,6};
	else
		return {1,2,3,4,5,6,10};
	endif

endfunction

function ChangeFromSkillList( who , item )

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 450",
				"resizepic 100 405 5100 150 25",
				"text 125 30 5 0"
							);
				
	var data2 := array(
				"Select a skill"
							);
							
	var cfg := ReadConfigFile( ":combat:modenchantdesc" );
	var count	:= 0;
	var done	:= 0;
	var page	:= 1;
	var perpage	:= 17;
	var y 	:= 55;
	var i;

	layout2.append( "page " + page );
	if( SKILLID__HIGHEST > perpage )
		layout2.append( "button 200 406 5540 5541 0 " + (page + 1) );
	endif
	
	for( i := 1 ; i <= SKILLID__HIGHEST+1 ; i := i + 1 )
		if( done == perpage )
			done 	:= 0;
			page 	:= page + 1;
			y 	:= 55;
			
			layout2.append( "page " + page );
			layout2.append( "button 130 406 5537 5538 0 " + (page - 1) );
			if( SKILLID__HIGHEST > (count + perpage) )
				layout2.append( "button 200 406 5540 5541 0 " + (page + 1) );
			endif
		endif
		
		layout2.append( "text 75 " + y + " 0 " + len(data2) );
		layout2.append( "button 250 " + (y + 5) + " 2118 2117 1 0 " + i );
		data2.append( cfg[i-1].Skill );

		y 	:= y + 20;
		done 	:= done + 1;
		count 	:= count + 1;
	endfor

	
	SendSysmessage( who , "Select a skill." );
	var res := SendDialogGump( who , layout2 , data2 );
	//print( res[0] );
	if( !res[0] )
		SendSysmessage( who , "Canceled" );
		return;
	endif
	
	var choices := GetSkillTierChoicesForItem( item );
	var val := PickTierValue( who , choices , "Increase " + cfg[res[0]-1].Skill + " by:" );
	Dbg( "ChangeFromSkillList: skill=" + cfg[res[0]-1].Skill + " picked=" + val );
	if( val == NOVAL or !val )
		SendSysmessage( who , "Canceled" );
		return;
	endif

	SetObjProperty( item , "skilladv" , res[0]-1 );
	SetObjProperty( item , "skilladvamount" , val );
	SetSkillAdvCategoryFlag( item );

endfunction

function SetUseScriptFromList( who , item )

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 420",
				"resizepic 100 375 5100 150 25",
				"text 105 30 5 0"
							);
				
	var data2 := array(
				"Select an usescript"
							);
							
	var usecfg 	:= ReadConfigFile( ":shilitems:usescriptdesc" );
	var usescripts := GetConfigStringKeys( usecfg );
	var count	:= 0;
	var done	:= 0;
	var page	:= 1;
	var buttonret	:= 1;
	var perpage	:= 15;
	var y 	:= 50;

	layout2.append( "page " + page );
	if( len(usescripts) > perpage )
		layout2.append( "button 200 376 5540 5541 0 " + (page + 1) );
	endif
	
	foreach usescript in usescripts

		if( done == perpage )
			done 	:= 0;
			page 	:= page + 1;
			y 	:= 50;
			
			layout2.append( "page " + page );
			layout2.append( "button 130 376 5537 5538 0 " + (page - 1) );
			if( len(usescripts) > (count + perpage) )
				layout2.append( "button 200 376 5540 5541 0 " + (page + 1) );
			endif
		endif
		
		layout2.append( "text 75 " + y + " 0 " + len(data2) );
		layout2.append( "button 250 " + (y + 5) + " 2118 2117 1 1 " + buttonret );
		data2.append( usecfg[usescript].Desc );

		y 	:= y + 20;
		done 	:= done + 1;
		count 	:= count + 1;
		
	endforeach
			
	
	SendSysmessage( who , "Select an usescript." );
	var result := SendDialogGump( who , layout2 , data2 );
	if( !result[0] )
		return;
	endif
	
	var script := usescripts[result[0]];
	item.usescript := script.Script;
	
	if( usecfg[script].RequireCharges )
		if( YesNo( who , "Use Charges?" ) )
			AskForIntPropVal( who , item , "charges" , "How many charges do you want to put in it? Interger only. Hit Esc to cancel" , "Enter a value." );
		else
			SetObjProperty( item , "RequireNoCharges" , 1 );
			EraseObjProperty( item , "charges" );
		endif
	endif
	
	if( usecfg[script].CastSpell )
		var previous := GetObjProperty( item , "HitWithSpell" );
		if( SetSpellFromList( who , item ) )
			var current := GetObjProperty( item , "HitWithSpell" );
			SetObjProperty( item , "SpellId" , current );
			if( previous )
				SetObjProperty( item , "HitWithSpell" , previous );
			endif
		endif
	endif
		
	if( usecfg[script].HaveAnim )
		if( YesNo( who , "Play Anim?" ) )
			ChooseAnimFromList( who , item );
		endif
	endif
	
	if( usecfg[script].HaveDelay )
		if( YesNo( who , "Have Delay?" ) )
			AskForIntPropVal( who , item , "SpellDelayMs" , "Enter the delay in ms. Hit Esc to cancel." , "Enter a value." );
		endif
	endif

	var misc := usecfg[script].MiscProp;
	if( misc )
		if( YesNo( who , "Have " + misc + "?" ) )
			AskForIntPropVal( who , item , misc , "Enter a value for " + misc + ". Hit Esc to cancel." , "Enter a value." );
		else
			EraseObjProperty( item , misc );
		endif
	endif

endfunction

function SetSpellFromList( who , item )

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 300",
				"resizepic 100 255 5100 150 25",
				"text 125 30 5 0"
							);
				
	var data2 := array(
				"Select a spell"
							);
							
	var spellcfg 	:= ReadConfigFile( "::spells" );
	var count	:= 0;
	var done	:= 0;
	var page	:= 1;
	var perpage	:= 8;
	var y 	:= 80;
	var i;

	layout2.append( "page " + page );
	layout2.append( "text 140 50 5 " + len(data2) );
	data2.append( "1st Circle" );
	
	if( SPELLID_HIGHEST > perpage )
		layout2.append( "button 200 256 5540 5541 0 " + (page + 1) );
	endif

	for( i := 1 ; i <= SPELLID_HIGHEST ; i := i + 1 )

		if( done == perpage )
			done 	:= 0;
			page 	:= page + 1;
			y 	:= 80;
			
			layout2.append( "page " + page );
			
			layout2.append( "button 125 256 5537 5538 0 " + (page - 1) );
			
			case( page )
			
				2:	layout2.append( "text 135 50 5 " + len(data2) );
					data2.append( "2nd Circle" );
					
				3:	layout2.append( "text 135 50 5 " + len(data2) );
					data2.append( "3rd Circle" );
					
				4:
				5:
				6:
				7:
				8:	layout2.append( "text 135 50 5 " + len(data2) );
					data2.append( page + "th Circle" );
					
				9:	layout2.append( "text 122 50 5 " + len(data2) );
					data2.append( "Lesser Chants" );
					
				10:	layout2.append( "text 120 50 5 " + len(data2) );
					data2.append( "Greater Chants" );
					
				11:	layout2.append( "text 116 50 5 " + len(data2) );
					data2.append( "1st Earth Circle" );
					
				12:	layout2.append( "text 114 50 5 " + len(data2) );
					data2.append( "2nd Earth Circle" );
					
			endcase

			if( SPELLID_HIGHEST > (count + perpage) )
				layout2.append( "button 200 256 5540 5541 0 " + (page + 1) );
			endif
		endif
		
		layout2.append( "text 85 " + y + " 0 " + len(data2) );
		data2.append( spellcfg[i].Name );
		layout2.append( "button 250 " + (y + 5) + " 2118 2117 1 0 " + i );

		y 	:= y + 20;
		done 	:= done + 1;
		count 	:= count + 1;

	endfor
			
	var result := SendDialogGump( who , layout2 , data2 );
	if( !result[0] )
		return 0;
	endif
	
	SetObjProperty( item , "HitWithSpell" , result[0] );
	return result[0];

endfunction

function AskForIntPropVal( who , item , prop , msg1 , msg2 )

	SendSysmessage( who , msg1 );
	var val := Cint(RequestInput( who , who.backpack , msg2 ));
	if( val )
		SetObjProperty( item , prop , val );
	else
		SetObjProperty( item , prop , 0 );
	endif
	return val;
endfunction

function SetCreatureTypeFromList( who , item )

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 300",
				"resizepic 100 255 5100 150 25",
				"text 99 30 5 0"
							);
				
	var data2 := array(
				"Select a creature type"
							);
							
	var cfg;
	if( item.ar )
		cfg := ReadConfigFile( ":combat:onhitscriptdesc" );
	else
		cfg := ReadConfigFile( ":combat:hitscriptdesc" );
	endif

	var amount	:= cfg["data"].NbSlayer;
	var start	:= cfg["data"].NbSpell + 1;
	var last	:= start + amount;
	var count	:= 0;
	var done	:= 0;
	var page	:= 1;
	var perpage	:= 9;
	var y 	:= 60;
	var i;

	layout2[len(layout2)+1] := "page " + page;
	if( amount > perpage )
		layout2[len(layout2)+1] := "button 190 256 5540 5541 0 " + (page + 1);
	endif
	
	for( i := start ; i < last ; i := i + 1 )
		if( done == perpage )
			done 	:= 0;
			page 	:= page + 1;
			y 	:= 60;
			
			layout2.append( "page " + page );
			layout2.append( "button 125 256 5537 5538 0 " + (page - 1) );
			if( amount > (count + perpage) )
				layout2.append( "button 200 256 5540 5541 0 " + (page + 1) );
			endif
		endif
		
		layout2.append( "text 85 " + y + " 0 " + len(data2) );
		layout2.append( "button 250 " + (y + 5) + " 2118 2117 1 0 " + i );
		data2.append( cfg[i].Type );
		
		y 	:= y + 20;
		done 	:= done + 1;
		count 	:= count + 1;
	endfor
			
	SendSysmessage( who , "Select a creature type." );
	var result := SendDialogGump( who , layout2 , data2 );
	if( !result[0] )
		SendSysmessage( who , "Canceled" );
		return 0;
	endif

	//Reset stale CProps from whatever hitscript was here before, THEN record which
	//config row this one is - same fix as the Effect/Greater/Special pickers below.
	//Without this, SetNameByEnchant (namingbyenchant.inc) has no HitscriptNumber/
	//OnHitscriptNumber to look up, so a slayer/protected item never gets its naming
	//adjective even though SlayType/ProtectedType is set correctly.
	ResetHitscriptPropsExcep( item );
	if( item.ar )
		SetObjProperty( item , "OnHitscriptNumber" , result[0] );
		SetObjProperty( item , "ProtectedType" , cfg[result[0]].Type );
		Dbg( "SetCreatureTypeFromList: OnHitscriptNumber=" + result[0] + " ProtectedType=" + cfg[result[0]].Type );
	else
		SetObjProperty( item , "HitscriptNumber" , result[0] );
		SetObjProperty( item , "SlayType" , cfg[result[0]].Type );
		Dbg( "SetCreatureTypeFromList: HitscriptNumber=" + result[0] + " SlayType=" + cfg[result[0]].Type );
	endif

	return cfg[result[0]].Type;

endfunction

function SetAnEffectScriptFromList( who , item )

	var layout2 := array(
				"page 0",
				"resizepic 50  0   2600 250 300",
				"resizepic 100 255 5100 150 25",
				"text 115 30 5 0"
							);
				
	var data2 := array(
				"Select an effect"
							);
							
	var cfg;
	if( item.ar )
		cfg	:= ReadConfigFile( ":combat:onhitscriptdesc" );
	else
		cfg	:= ReadConfigFile( ":combat:hitscriptdesc" );
	endif
	
	var amount	:= cfg["data"].NbEffect;
	var start	:= cfg["data"].NbSpell + cfg["data"].NbSlayer + 1;
	var last	:= start + amount;
	var count	:= 0;
	var done	:= 0;
	var page	:= 1;
	var perpage	:= 9;
	var y 	:= 60;
	var i;
	var CProp, CPropVal;

	layout2[len(layout2)+1] := "page " + page;
	if( amount > perpage )
		layout2[len(layout2)+1] := "button 190 256 5540 5541 0 " + (page + 1);
	endif
	
	for( i := start ; i < last ; i := i + 1 )
		if( done == perpage )
			done 	:= 0;
			page 	:= page + 1;
			y 	:= 60;
			
			layout2.append( "page " + page );
			layout2.append( "button 125 256 5537 5538 0 " + (page - 1) );
			if( amount > (count + perpage) )
				layout2.append( "button 200 256 5540 5541 0 " + (page + 1) );
			endif
		endif
		
		layout2.append( "text 85 " + y + " 0 " + len(data2) );
		layout2.append( "button 250 " + (y + 5) + " 2118 2117 1 0 " + i );
		data2.append( cfg[i].Name );

		y 	:= y + 20;
		done 	:= done + 1;
		count 	:= count + 1;
	endfor
			
	
	SendSysmessage( who , "Select an effect." );
	var result := SendDialogGump( who , layout2 , data2 );
	if( !result[0] )
		return 0;
	endif

	if( item.ar )
		SetObjProperty( item , "OnHitScript" , cfg[result[0]].OnHitscript );
	else
		item.hitscript := cfg[result[0]].Hitscript;
	endif

	//Reset stale CProps from whatever hitscript was here before, THEN record which
	//config row this one is - without this, the gump can never show or re-edit the
	//CProp value it's about to set below (see ResetHitscriptPropsExcep).
	ResetHitscriptPropsExcep( item );
	if( item.ar )
		SetObjProperty( item , "OnHitscriptNumber" , result[0] );
		Dbg( "hitscript picker: OnHitscriptNumber := " + result[0] );
	else
		SetObjProperty( item , "HitscriptNumber" , result[0] );
		Dbg( "hitscript picker: HitscriptNumber := " + result[0] );
	endif

	CProp := cfg[result[0]].CProp;
	if( CProp )
		CPropVal := cfg[result[0]].CPropVal;
		if( !CPropVal )
			SendSysmessage( who, "What is the value of " + CProp + "? Integer only. Hit Esc to cancel." );
        		CPropVal := Cint(RequestInput( who, who.backpack, "Enter the value."));
			if( !CPropVal )
				CPropVal := 0;
			endif
		endif
		SetObjProperty( item , CProp , CPropVal );
	endif
	
	return {CProp, CPropVal};
	
endfunction

