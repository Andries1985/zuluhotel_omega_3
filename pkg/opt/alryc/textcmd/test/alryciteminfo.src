use basic;
use polsys;
use basicio;	//for Print() - debug console output, see DBG_ON below

include ":staff:include/staff";
//include "util/bank";
include "include/namingbyenchant";
include "include/spelldata";
include "include/itemutil";
include ":mdgumps:yesNo";

//Set to 0 to silence all [alryciteminfo] console debug prints once this is verified working.
const DBG_ON := 1;

function Dbg( msg )

	if( DBG_ON )
		Print( "[alryciteminfo] " + msg );
	endif

endfunction

function DebugRenameItem( item )
//Thin logging wrapper around the shared SetNameByEnchant (namingbyenchant.inc) so every
//naming-relevant edit prints a visible before/after - this is the direct check for
//whether Bug 2 (item never showing what was done to it) is actually fixed.

	var before := item.desc;
	SetNameByEnchant( item );
	Dbg( "SetNameByEnchant: \"" + before + "\" -> \"" + item.desc + "\"" );

endfunction

