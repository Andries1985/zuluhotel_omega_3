use uo;
use os;
use polsys;

include "include/spelldata";
include "include/client";
include "include/dotempmods";
include "include/areas";
include "include/damages";
include ":attributes:regen";

program processtempmods( parms )

	set_script_option( SCRIPTOPT_CAN_ACCESS_OFFLINE_MOBILES , 1 );
	
	var who	:= parms[1];
	var plvl	:= parms[2];
	var msg	:= parms[3];
	var caster := parms[4];
	var serial	:= who.serial;
	var shuriken := parms[5];
	var credit := parms[6];	// 2026-10-29: who gets the kill, set by SetPoison (ZH2.5 1.1.5 port)

	if (IsInSafeArea(who) && !IsInBox(who, 5508, 5527, 1655, 1674))
		return 0;
	endif
	
	plvl := cint(plvl);
	
	// The tier is capped at 6 here, so the hit script giving a Thief min(9, tier + class level) adds nothing past 6.
	if ( plvl > 6 )
		plvl := 6;
	endif

	var protected;
	if(caster)
		if(GetObjProperty( caster , CLASSEID_THIEF ))
			protected := PoisonProtected( who , plvl, 1);
		else
			protected := PoisonProtected( who , plvl );
		endif
	else
		protected := PoisonProtected( who , plvl );
	endif

	if( protected == IMMUNED )
		return;
	endif
	
	if( protected == CURSED )
		plvl := plvl + 2;
	endif
	
	if (plvl < 1) 
		return;
	endif
	
	var current := 0;
	set_critical(1);

	var currentmod := GetObjProperty( who , "poison" );
	
	if( currentmod )
		current := Cint( currentmod[1] );
	else
		currentmod := {};
	endif
	
	var level := GetClasseLevel(caster);
	var newPsnDmg;
	
	if(!GetObjProperty( caster , CLASSEID_THIEF ))
		// Non-spec = 12 DMG.
		newPsnDmg := plvl*2;
		// If NPC multiply damage by x.
		if(who.IsA(POLCLASS_NPC))
			newPsnDmg := newPsnDmg * 3;
		endif
	else
		// Based on Potion level (plvl) 6, with integer division (level * 4 / 6 = 0, 1, 2, 2, 3, 4):
		// Spec 1 = 11, 2 = 16, 3 = 25, 4 = 26, 5 = 31, 6 = 39 DMG. (2026-10-04: the old comment said 18, 23, 24, 28, 33, 39.)
		case(level)
			1: newPsnDmg := (plvl*(2+(level * 4/6))-1);
			2: newPsnDmg := (plvl*(2+(level * 4/6))-2);
			3: newPsnDmg := (plvl*(3+(level * 4/6))-5);
			4: newPsnDmg := (plvl*(3+(level * 4/6))-4);
			5: newPsnDmg := (plvl*(3+(level * 4/6))-5);
			6: newPsnDmg := (plvl*(3+(level * 4/6))-3);
		endcase

		if(shuriken)
			// Based on Potion level (plvl) 6, same integer division: Spec 1 = 15, 2 = 21, 3 = 29, 4 = 31, 5 = 38, 6 = 44 DMG.
			// (2026-10-04: the old comment said 18, 23, 28, 33, 38, 45.)
			case(level)
				1: newPsnDmg := (plvl*(3+(level * 4/6))-3);
				2: newPsnDmg := (plvl*(3+(level * 4/6))-3);
				3: newPsnDmg := (plvl*(3+(level * 4/6))-1);
				4: newPsnDmg := (plvl*(3+(level * 4/6))+1);
				5: newPsnDmg := (plvl*(4+(level * 4/6))-4);
				6: newPsnDmg := (plvl*(4+(level * 4/6))-4);
			endcase
		endif
		// If NPC multiply damage by x.
		if(who.IsA(POLCLASS_NPC))
			newPsnDmg := newPsnDmg * 5;
		endif
	endif
	//PvP slowdown
	// 2026-09-21: always applied to a player victim now. This was
	// "... && GetGlobalProperty("ReducePoison") && DEBUG_MODE": poison ticks are
	// dealt with ApplyRawDamage (below), so they never get ApplyTheDamage's 0.6
	// or melee's 0.5, and this line -- the ONLY scaling poison has -- needed
	// debug mode on. With debug off, poison hit players at full strength and the
	// .reducepoison GM command silently did nothing. hitscriptinc.inc's physical
	// block shows the pattern this was copied from: a GM-tunable global in debug
	// mode, a FIXED value otherwise -- poison never got its fixed value.
	// Now: the GM's .reducepoison number if one is set, else 0.6 (the same
	// factor ApplyTheDamage uses). Same victim-based condition as before, so it
	// covers monster poison on a player too, exactly as the old line did.
	if(!who.IsA(POLCLASS_NPC))
		var psn_pvp_mult := GetGlobalProperty("ReducePoison");
		if(!psn_pvp_mult)
			psn_pvp_mult := 0.6;
		endif
		newPsnDmg *= psn_pvp_mult;
	endif
	if(DEBUG_MODE)
		PrintTextAbovePrivate( caster , "My Poison damage is: " + newPsnDmg, caster );
	endif
	if( who.poisoned )
		var currPsnDmg := GetObjProperty(who, "psnDmg");
		if(!currPsnDmg || (currPsnDmg < newPsnDmg) )
			SetObjProperty(who, "psnDmg", newPsnDmg);
			SetPoisonCredit(who, credit);	// 2026-10-29: credit moves only when a stronger poisoning lands (ZH2.5 1.1.5 port)
		endif
		set_critical(0);
		return;
	else
		SetObjProperty(who, "psnDmg", newPsnDmg);
		SetPoisonCredit(who, credit);	// 2026-10-29: fresh poisoning lands (ZH2.5 1.1.5 port)
	endif

	var duration := Cint(30);
	if(GetObjProperty(caster, CLASSEID_THIEF))
		duration := 30+(level*5);
	endif
		
	//var newpoisonregenmod := GetPoisonRegenMod( plvl );
	var current_clock := Cint(ReadGameClock());
	
	if( plvl > current )
		SetVitalRegenRateMod(who, VITALID_LIFE, "poison", -1);
	endif

	var mmod := { plvl , Cint(current_clock + duration) };

	if( !current )
		who.SetPoisoned();
		IncRevision(who);
		BuffOn( who , "poison" , newPsnDmg , duration );	// 2026-10-25: poison icon on a fresh poisoning (ZH2.5 1.1.5 port)
		if( msg )
			PrintTextAbovePrivate( who , msg , who );
		endif	
		currentmod := mmod;
	else
		AddToPoisonMod( currentmod , mmod );
	endif

	SetObjProperty( who , "poison" , currentmod );

	set_critical(0);
			
	// 2026-10-29: ticks go through PoisonTick -> ApplyTheDamage so a poison kill credits the poisoner
	// (kill credit, champion/quest/loot). A Thief's poison pierces poison protection (PoisonProtected
	// above), so its ticks ignore attack-type immunity as well (ZH2.5 1.1.5 port)
	var tick_type := DMGID_POISON;
	if( GetObjProperty( caster , CLASSEID_THIEF ) )
		tick_type := tick_type + DMGID_NO_RESIST;
	endif

	var timer := 0;
	repeat
	
	sleep(1);
	
	if(CInt(ReadGameClock() % 5) == 0)
		// 2026-10-29: StoreDamage now happens inside ApplyTheDamage (LottoDrops); the dead KilledBy write below is gone (ZH2.5 1.1.5 port)
		PoisonTick(who, Cint(GetObjProperty(who, "psnDmg")), tick_type);
	endif

	timer := timer + 1;

	if (GetHP(who) < 1)
		PoisonTick(who, 5, tick_type);
		break;
	endif

	currentmod := GetObjProperty( who , "poison" );

	until ( (timer >= duration) || !who.connected || who.dead || !currentmod);
	
	//Sleep(duration+1);
	CurePoison(who);
	IncRevision(who);
	if( !who )
		who := SystemFindObjectBySerial( cint(serial) , SYSFIND_SEARCH_OFFLINE_MOBILES );
	endif
	
	if( who )
		Set_Critical(1);
		currentmod := GetObjProperty( who , "poison" );
	
		if( !currentmod )
			Set_Critical( 0 );
			return;
		endif
	
		if( ReadGameClock() >= Cint(currentmod[2]) )
			CurePoison( who );
			IncRevision(who);
		endif
		Set_Critical(0);
	endif
	
endprogram


// 2026-10-29: writes the poison credit only when a poisoning LANDS (fresh, or stronger than the current
// psnDmg); a blocked, equal or weaker poisoning leaves it where it is. A landed poisoning with no
// poisoner (trap, food, failed Poisoning, self) clears PoisonedBySerial so nobody is credited (ZH2.5 1.1.5 port)
function SetPoisonCredit( who, credit )
	if( credit.IsA(POLCLASS_MOBILE) and credit != who )
		SetObjProperty(who, "PoisonedBy", credit.name);
		SetObjProperty(who, "PoisonedBySerial", credit.serial);
	else
		EraseObjProperty(who, "PoisonedBy");	// 2026-10-29: death.src falls back to the name, so clear it too
		EraseObjProperty(who, "PoisonedBySerial");
	endif
endfunction

// 2026-10-29: one tick of poison damage. With a poisoner it goes through ApplyTheDamage (kill credit,
// hitlist, a pet's master gets it); pvp_cut 0 because newPsnDmg above already carries the PvP factor
// (ReducePoison / 0.6), so players must not be cut twice. No poisoner or self-poison stays raw (ZH2.5 1.1.5 port)
function PoisonTick( who, dmg, tick_type )

	var poisoner := 0;
	var pserial := CInt(GetObjProperty(who, "PoisonedBySerial"));
	if( pserial )
		poisoner := SystemFindObjectBySerial(pserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
	endif

	if( poisoner.IsA(POLCLASS_MOBILE) and poisoner != who )
		return ApplyTheDamage(who, poisoner, dmg, tick_type, 0);
	endif
	// 2026-10-29: same attack-type immunity test ApplyTheDamage makes, so a poison-immune NPC is immune
	// whether or not anyone gets the credit
	dmg := CInt(dmg);
	if( IsImmunedFromThisDamageType( who, dmg, tick_type ) )
		return 0;
	endif
	return ApplyRawDamage(who, dmg);

endfunction
