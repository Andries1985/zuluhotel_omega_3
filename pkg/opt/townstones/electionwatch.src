use uo;
use os;
use basic;
use datafile;
use cfgfile;

include "tstone";

const TOWNSTONE_DATAFILE := ":townstone:townstone_data";
const WATCHER_PROP := "#TownstoneElectionWatcherRunning";
const WATCHER_INTERVAL_SECONDS := 5;
const TOWNSTONE_OBJTYPE := 0xa320;
const TOWNSTONE_SEARCH_RANGE := 10000;
// Player towns aren't confined to Britannia (playertowns.cfg configures
// Zento, a Tokuno region) -- search every realm the shard defines instead
// of hardcoding one, or a townstone placed anywhere else is invisible here.
var TOWNSTONE_REALMS := {"britannia", "britannia_alt", "ilshenar", "malas", "termur", "tokuno"};


var user;
var stone;
var citizen;
var city;
var mayor;
var mayorserial;
var populacao;
var eleicoes;
var pleibicito;
var candidatos;
var votepercent;
var votos;
var timer;
var Pleibicito_Result;
var nextcitizenelection;


program TownstoneElectionWatcher()
	if(GetGlobalProperty(WATCHER_PROP))
		return;
	endif

	SetGlobalProperty(WATCHER_PROP, 1);
	SysLog("[TownstoneElectionWatcher] started");

	while(1)
		var active_count := ProcessActiveTownstones();
		if(active_count <= 0)
			break;
		endif

		Sleep(WATCHER_INTERVAL_SECONDS);
	endwhile

	EraseGlobalProperty(WATCHER_PROP);
	SysLog("[TownstoneElectionWatcher] stopped");
endprogram


function ProcessActiveTownstones()
	var townstones := {};
	foreach realm_name in TOWNSTONE_REALMS
		var found := ListItemsNearLocationOfType(0, 0, LIST_IGNORE_Z, TOWNSTONE_SEARCH_RANGE, TOWNSTONE_OBJTYPE, realm_name);
		if(found and found.size())
			foreach item in found
				townstones.append(item);
			endforeach
		endif
	endforeach
	if(!townstones.size())
		return 0;
	endif

	var now := ReadGameClock();
	var active_count := 0;

	foreach item in townstones
		if(!item)
			continue;
		endif

		if(!CInt(GetObjProperty(item, "town")))
			continue;
		endif

		LoadTownstoneState(item);
		if(!(eleicoes or pleibicito))
			continue;
		endif

		var poll_full_participation := (pleibicito and populacao > 0 and votos >= populacao);
		if((timer > 0 and timer <= now) or poll_full_participation)
			eleicao(item);
			LoadTownstoneState(item);
		endif

		if(eleicoes or pleibicito)
			active_count := active_count + 1;
		endif
	endforeach

	return active_count;
endfunction


function LoadTownstoneState(item)
	stone := CInt(GetObjProperty(item, "town"));
	city := GetTownName(stone);
	if(!city)
		city := CStr(GetObjProperty(item, "regionname"));
	endif

	mayor := GetObjProperty(item, "mayor");
	mayorserial := CInt(GetObjProperty(item, "mayorserial"));
	populacao := CInt(GetObjProperty(item, "populacao"));
	eleicoes := CInt(GetObjProperty(item, "eleicao"));
	pleibicito := GetObjProperty(item, "pleibicito");
	candidatos := GetObjProperty(item, "candidatos");
	votepercent := CInt(GetObjProperty(item, "votepercent"));
	votos := CInt(GetObjProperty(item, "votos"));
	timer := CInt(GetObjProperty(item, "timer"));
	Pleibicito_Result := GetObjProperty(item, "Pleibicito_Result");
	nextcitizenelection := CInt(GetObjProperty(item, "nextcitizenelection"));
	citizen := GetObjProperty(item, "citizen");

	if(!citizen)
		citizen := {};
	endif
	if(!candidatos)
		candidatos := {};
	endif
	if(!populacao)
		populacao := 0;
	endif
	if(!votos)
		votos := 0;
	endif
	if(!votepercent)
		votepercent := 0;
	endif
	if(!mayor or !mayorserial)
		mayor := "No mayor";
		mayorserial := 0;
	endif
	if(!timer)
		timer := 0;
	endif
	if(!nextcitizenelection)
		nextcitizenelection := 0;
	endif
	if(!Pleibicito_Result)
		Pleibicito_Result := {};
	endif
	if(len(pleibicito) < 2 or !pleibicito)
		pleibicito := 0;
	endif
endfunction

