// Synopsis: Remove all members from a targeted town and clean member name suffixes
use uo;
use os;
use basic;
use datafile;
use cfgfile;
include ":townstone:tstone";

const TOWNSTONE_DATAFILE := ":townstone:townstone_data";

program textcmd_cleartownmembers(who)

	SendSysMessage(who, "Select the town stone to clear.");
	var stone := Target(who);

	if(!stone)
		SendSysMessage(who, "Cancelled.");
		return;
	endif

	var town_id := CInt(GetObjProperty(stone, "town"));
	if(!town_id)
		SendSysMessage(who, "That target is not a valid town stone.");
		return;
	endif

	var town_list := GetGlobalProperty("townlist");
	var town_name := town_list[town_id];
	if(!town_name)
		town_name := "Unknown Town";
	endif

	var citizens := GetObjProperty(stone, "citizen");
	if(!citizens)
		citizens := {};
	endif

	var scanned_characters := 0;
	var cleared_members := 0;
	var fixed_names := 0;

	foreach acct_name in ListAccounts()
		var account := FindAccount(acct_name);
		if(!account)
			continue;
		endif

		var slot := 0;
		while(slot <= 6)
			var character := account.GetCharacter(slot);
			if(character)
				scanned_characters := scanned_characters + 1;

				var char_town := CInt(GetObjProperty(character, "town"));
				if((char_town == town_id) or IsCitizenAccount(citizens, character.acctname))
					EraseObjProperty(character, "town");
					cleared_members := cleared_members + 1;

					var cleaned_name := StripTownSuffix(character.name, town_name);
					if(cleaned_name != character.name)
						character.name := cleaned_name;
						fixed_names := fixed_names + 1;
					endif
				endif
			endif

			slot := slot + 1;
			SleepMS(1);
		endwhile
		SleepMS(1);
	endforeach

	SetObjProperty(stone, "citizen", {});
	SetObjProperty(stone, "populacao", 0);
	SetObjProperty(stone, "candidatos", {});
	SetObjProperty(stone, "votos", 0);
	SetObjProperty(stone, "votepercent", 0);
	SetObjProperty(stone, "eleicao", 0);

	EraseObjProperty(stone, "mayor");
	EraseObjProperty(stone, "mayorserial");
	EraseObjProperty(stone, "pleibicito");
	EraseObjProperty(stone, "Pleibicito_Result");
	EraseObjProperty(stone, "timer");
	SyncTownstoneState(stone);

	SendSysMessage(who, "Town reset complete for " + town_name + ". Members cleared: " + cleared_members + ", names fixed: " + fixed_names + ", characters scanned: " + scanned_characters + ".");

endprogram


// OpenTownstoneDataFile / SyncTownstoneState moved to tstone.inc (2026-09-01)


function IsCitizenAccount(citizen_list, account_name)
	if(!citizen_list or !account_name)
		return 0;
	endif

	var i;
	for(i := 1; i <= citizen_list.size(); i := i + 1)
		if(Lower(CStr(citizen_list[i])) == Lower(CStr(account_name)))
			return 1;
		endif
	endfor

	return 0;
endfunction


// StripTownSuffix / StripExactSuffix moved to tstone.inc (2026-09-01)
