// potionkeg.src -- Potion Keg double-click handler (rewritten 2026-09-15).
// Used to run its own Autoloop-yes/no fill/empty loop inline; that's now
// shared with the Potion Vat via kegvat.inc's 1/Number/Max picker gump, see
// the Multi-Item Crafting plan.

use uo;

include "kegvat";

program potionkeg( who, keg )
	KegVat_ShowOperateGump( who, keg );
endprogram
