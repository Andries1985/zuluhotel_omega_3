	GFTextEntry(mobedit, 408, 80, 59, 20, TEXT_COLOR, new_stats[28+SKILLID_DETECTINGHIDDEN], 28+SKILLID_DETECTINGHIDDEN);
	GFTextEntry(mobedit, 408, 102, 59, 20, TEXT_COLOR, new_stats[28+SKILLID_SNOOPING], 28+SKILLID_SNOOPING);
	GFTextEntry(mobedit, 408, 124, 59, 20, TEXT_COLOR, new_stats[28+SKILLID_NECROMANCY], 28+SKILLID_NECROMANCY);
