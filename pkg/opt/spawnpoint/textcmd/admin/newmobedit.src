		GFTextLine(mobedit, 280, 125, TEXT_COLOR, "Suffix");
		GFTextEntry(mobedit, 336, 80, 118, 20, TEXT_COLOR, new_stats[87], 87);
		GFTextEntry(mobedit, 336, 102, 118, 20, TEXT_COLOR, new_stats[93], 93);
		GFTextEntry(mobedit, 336, 125, 118, 20, TEXT_COLOR, new_stats[94], 94);

		GFTextRight(mobedit, 402, 147, TEXT_COLOR, "Lootgroup");
