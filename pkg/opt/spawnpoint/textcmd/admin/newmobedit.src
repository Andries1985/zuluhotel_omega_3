	GFTextEntry(mobedit, 408, 234, 59, 20, TEXT_COLOR, new_stats[28+SKILLID_SPELLWEAVING], 28+SKILLID_SPELLWEAVING);
	GFTextEntry(mobedit, 408, 256, 59, 20, TEXT_COLOR, new_stats[28+SKILLID_MYSTICISM], 28+SKILLID_MYSTICISM);
	GFTextEntry(mobedit, 408, 278, 59, 20, TEXT_COLOR, new_stats[28+SKILLID_IMBUING], 28+SKILLID_IMBUING);

	if (is_npc)
		GFPage(mobedit, 10);

		// 2026-10-25: AI, titles and loot (ZH2.5 1.1.5 port)
