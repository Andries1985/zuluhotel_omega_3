// Synopsis: Open a mob edit gump for a targeted spawn point or NPC
//Edited August 25, 2024

////////////////////////////////////
//Created by Developer Alryc
//Aug 25, 2024
///////////////////////////////////

use uo;
use os;
use vitals;
use attributes;
use file;
use cfgfile;
use basic;	// 2026-10-25: SplitWords for the lootgroup export

include "include/attributes";
include ":attributes:npcvitals";	// SetNpcVitalOverride (2026-09-30)
include "include/client";
include ":mdgumps:gumps";
include ":mdgumps:gumps_ex";
include ":mdgumps:requestGump";	// 2026-10-25: RequestGump for the Custom HP button (ZH2.5 1.1.5 port)
include ":attributes:regen";	// 2026-10-25: SetVitalRegenRateMod -- applies a regen edit at once, same call modsetup.inc makes at AI start
include "include/spelldata";
include "include/npcspellnames";	// 2026-10-25: GetNpcSpellNames() for the Spells checkbox gump (ZH2.5 1.1.5 port)
include "include/npcdifficulty";	// 2026-10-25: GetSnoopDifficulty/GetStealDifficulty/GetNpcDifficultyOverride (ZH2.5 1.1.5 port)
include "include/math";
include ":admin:include/adminpanel";

const TEXT_COLOR := 657;

// 2026-10-25: NPC pages and staged edits (ZH2.5 1.1.5 port, adapted to ZH3.0 vitals)
const BTN_CUSTOM_HITS := 500;
const MAX_CUSTOM_HITS := 100000;
const BTN_SPELLS := 501;
const SPELLS_PER_COLUMN := 15;
// Spell checkboxes are SPELL_CHK_BASE + the spell's index in the list
const SPELL_CHK_BASE := 100;
// Checkbox ids share the reply keys with the text entries, so a checkbox for stat N uses CHK_BASE+N
const CHK_BASE := 1000;

// AI scripts whose combat event reaches cast_offensive_spell() in npccast.inc; any other script ignores its spell list
var CASTER_SCRIPTS := array{ "bardok", "chaosmultikillpcs", "chaosspellkillpcs", "critterhealer", "doppel",
	"doppelganger", "dragonking", "formationkillpcs", "formationleader", "glutton", "goodcaster",
	"newbiemultikillpcs", "rikktor", "soulwhisperer", "spellkillpcs", "spiderlord", "stormkillpcs",
	"sum", "waterdragonking", "tamed", ":quests:ai/sutek" };

// NPC-only stats (86 is the MoveSpeed word, 28-85 the skills):
// 87 script, 88 lootgroup, 89 magic item level, 90 magic item chance, 91 worn items drop,
// 92 pack items drop, 93 title prefix, 94 title suffix, 95 LesserBoss, 96 Boss, 97 SuperBoss,
// 98 Champion, 99 tame difficulty, 100 snoop difficulty, 101 steal difficulty, 102 provoke difficulty,
// 103 peace difficulty, 104 HP regen, 105 Mana regen, 106 Stamina regen (points per minute, text)
var NPC_TEXT_FIELDS := array{ 86, 87, 88, 93, 94, 104, 105, 106 };
var NPC_NUMBER_FIELDS := array{ 89, 90, 98, 99, 100, 101, 102, 103 };
var NPC_CHECK_FIELDS := array{ 91, 92, 95, 96, 97 };

var old_stats := array;
var new_stats := array;
var desc_list := array;
var gump_ret;
var is_npc := 0;
// The Custom HP and Spells buttons only stage these; Apply writes them, Cancel drops them
var hits_changed := 0;
var hits_value := 0;		// staged max HP in points, 0 = back to the template
var npc_spells := array;
var orig_spells := array;
var spells_changed := 0;
var spells_to_template := 0;
var earth, fire, water, air, necro, poison, physical, freeaction, holy := 0;
var healing, magicimmunity, magicreflection := 0;

program textcmd_mobedit(who)

	desc_list[1] := "Name";
	// 2026-10-25: the save-to-cfg button writes ZH3.0's npcdesc template field names (STR/HITS/...), no CustomHitsLevel (ZH2.5 1.1.5 port)
	desc_list[2] := "STR";
	desc_list[3] := "DEX";
	desc_list[4] := "INT";
	desc_list[5] := "HITS";
	desc_list[6] := "STAM";
	desc_list[7] := "MANA";
	desc_list[8] := "RunSpeed";	// 2026-09-30: was labelled "MoveSpeed" but it always edited mobile.run_speed (the engine step pacing)
	desc_list[86] := "MoveSpeed";	// 2026-09-30: the AI think-delay word (Fastest/Fast/Normal/Slow/Slowest); instance override of the template field
	desc_list[9] := "ObjType";
	desc_list[10] := "Color";
	desc_list[11] := "AR";
	desc_list[12] := "EarthProtection";
	desc_list[13] := "FireProtection";
	desc_list[14] := "WaterProtection";
	desc_list[15] := "AirProtection";
	desc_list[16] := "HolyProtection";
	desc_list[17] := "NecroProtection";
	desc_list[18] := "PhysicalProtection";
	desc_list[19] := "PermPoisonImmunity";
	desc_list[20] := "FreeAction";
	desc_list[21] := "HealingIncrease";
	// 2026-10-25: 22, 25, 26, 27 were ME, Absorbsion, Warding and Antidotes; removed, nothing reads those CProps (ZH2.5 1.1.5 port)
	desc_list[23] := "PermMagicImmunity";
	desc_list[24] := "Permmr";
	desc_list[28] := "alchemy";
	desc_list[29] := "anatomy";
	desc_list[30] := "animallore";
	desc_list[31] := "itemidentification";
	desc_list[32] := "armslore";
	desc_list[33] := "parry";
	desc_list[34] := "begging";
	desc_list[35] := "blacksmithy";
	desc_list[36] := "bowcraft";
	desc_list[37] := "peacemaking";
	desc_list[38] := "camping";
	desc_list[39] := "carpentry";
	desc_list[40] := "cartography";
	desc_list[41] := "cooking";
	desc_list[42] := "detectinghidden";
	desc_list[43] := "enticement";
	desc_list[44] := "evaluatingintelligence";
	desc_list[45] := "healing";
	desc_list[46] := "fishing";
	desc_list[47] := "forensics";
	desc_list[48] := "herding";
	desc_list[49] := "hiding";
	desc_list[50] := "provocation";
	desc_list[51] := "inscription";
	desc_list[52] := "lockpicking";
	desc_list[53] := "magery";
	desc_list[54] := "magicresistance";
	desc_list[55] := "tactics";
	desc_list[56] := "snooping";
	desc_list[57] := "musicianship";
	desc_list[58] := "poisoning";
	desc_list[59] := "archery";
	desc_list[60] := "spiritspeak";
	desc_list[61] := "stealing";
	desc_list[62] := "tailoring";
	desc_list[63] := "taming";
	desc_list[64] := "tasteidentification";
	desc_list[65] := "tinkering";
	desc_list[66] := "tracking";
	desc_list[67] := "veterinary";
	desc_list[68] := "swordsmanship";
	desc_list[69] := "macefighting";
	desc_list[70] := "fencing";
	desc_list[71] := "wrestling";
	desc_list[72] := "lumberjacking";
	desc_list[73] := "mining";
	desc_list[74] := "meditation";
	desc_list[75] := "stealth";
	desc_list[76] := "removetrap";
	desc_list[77] := "necromancy";
	desc_list[78] := "focus";
	desc_list[79] := "chivalry";
	desc_list[80] := "bushido";
	desc_list[81] := "ninjitsu";
	desc_list[82] := "spellweaving";
	desc_list[83] := "mysticism";
	desc_list[84] := "imbuing";
	desc_list[85] := "throwing";
	desc_list[87] := "Script";
	desc_list[88] := "lootgroup";
	desc_list[89] := "MagicItemLevel";
	desc_list[90] := "MagicItemChance";
	desc_list[95] := "LesserBoss";
	desc_list[96] := "Boss";
	desc_list[97] := "SuperBoss";
	desc_list[98] := "Champion";
	desc_list[99] := "tameskill";
	desc_list[100] := "snoopme";
	desc_list[101] := "stealme";
	desc_list[102] := "provoke";
	desc_list[103] := "peacemake";
	desc_list[104] := "HITSREGEN";
	desc_list[105] := "MANAREGEN";
	desc_list[106] := "STAMREGEN";

	var mobile := target(who);

	if (!mobile)
		SendSysMessage(who, "Canceled", FONT_NORMAL, 43);
		return 0;
	endif

	if (mobile.isa(POLCLASS_NPC))
		is_npc := 1;
		npc_spells := GetNpcSpells(mobile);
		orig_spells := npc_spells;
	endif

	//Calculate Stats
	old_stats[0] := 0;
	old_stats[1] := mobile.name;
	old_stats[2] := GetStrength(mobile);
	old_stats[3] := GetDexterity(mobile);
	old_stats[4] := GetIntelligence(mobile);
	old_stats[5] := GetMaxHP(mobile);
	old_stats[6] := GetMaxStamina(mobile);
	old_stats[7] := GetMaxMana(mobile);
	if (is_npc)
		old_stats[8] := mobile.run_speed;
		old_stats[86] := EffectiveMoveSpeedWord(mobile);
	else
		old_stats[8] := 0;
		old_stats[86] := "";
	endif
	old_stats[9] := mobile.graphic;
	old_stats[10] := mobile.color;
	old_stats[11] := mobile.ar;
	
	//Calculate Immunities of the mobile and put into array
	CalculateProtections(mobile);

	var i := 0;
	var j := 28;
	for (i := 0; i < 58; i := i+1)
		old_stats[j] := GetBaseSkill(mobile, i);
		j +=1;
	endfor
	if (is_npc)
		LoadNpcSettings(mobile);
	endif
	//Print($"Old Stats Array 1:" +old_stats);

	new_stats := old_stats;
	//Print($"New Stats Array 2:" +new_stats);

	var safeexit;
	while ((gump_ret[0] !=100) && (gump_ret[0] != 999) && (gump_ret[0] != 777) && (safeexit < 1000))
		gump_ret := gump_mobedit(who);
		safeexit +=1;
		if( gump_ret[0] == 100 )
			SendSysMessage(who, "Cancel button pressed", FONT_NORMAL, 43);
			return 0;
		elseif( !gump_ret[0] )
			// 2026-10-25: a right-click close returns 0, which used to fall into the "Warrior level 0" branch below, stage all eight warrior skills at 0 and reopen up to 1000 times (ZH2.5 1.1.5 port)
			SendSysMessage(who, "Canceled", FONT_NORMAL, 43);
			return 0;
		endif

		new_stats[1] := GetGumpText(gump_ret, 1);

		for (i := 2; i <= 85; i := i+1)
			new_stats[i] := Cint(GFExtractData(gump_ret, i));
		endfor

		if (is_npc)
			foreach field in NPC_TEXT_FIELDS
				new_stats[field] := GetGumpText(gump_ret, field);	// 2026-10-25: a blank entry yields "" (86 was CStr(error) when blank)
			endforeach
			foreach field in NPC_NUMBER_FIELDS
				new_stats[field] := CInt(GFExtractData(gump_ret, field));
			endforeach
			foreach field in NPC_CHECK_FIELDS
				new_stats[field] := 0;
				if (gump_ret[CHK_BASE + field])
					new_stats[field] := 1;
				endif
			endforeach
		endif

		if ( gump_ret[0] == BTN_CUSTOM_HITS )
			SetCustomHitsLevel(who, mobile);
		elseif ( gump_ret[0] == BTN_SPELLS )
			EditNpcSpells(who, mobile);
		elseif ( gump_ret[0] > 42 )
			// not a level button
		elseif ( gump_ret[0] <= 7 )
			var skill_change := GetLevelSkill(gump_ret[0]);
			new_stats[28+SKILLID_ANATOMY ] := skill_change;
			new_stats[28+SKILLID_FENCING ] := skill_change;
			new_stats[28+SKILLID_HEALING ] := skill_change;
			new_stats[28+SKILLID_MACEFIGHTING ] := skill_change;
			new_stats[28+SKILLID_PARRY ] := skill_change;
			new_stats[28+SKILLID_SWORDSMANSHIP ] := skill_change;
			new_stats[28+SKILLID_TACTICS ] := skill_change;
			new_stats[28+SKILLID_WRESTLING ] := skill_change;
		elseif ( gump_ret[0] <= 14 )
			var skill_change := GetLevelSkill(gump_ret[0]);
			new_stats[28+SKILLID_ANIMALLORE ] := skill_change;
			new_stats[28+SKILLID_TAMING ] := skill_change;
			new_stats[28+SKILLID_ARCHERY ] := skill_change;
			new_stats[28+SKILLID_CAMPING ] := skill_change;
			new_stats[28+SKILLID_COOKING ] := skill_change;
			new_stats[28+SKILLID_FISHING ] := skill_change;
			new_stats[28+SKILLID_TRACKING ] := skill_change; 
			new_stats[28+SKILLID_VETERINARY ] := skill_change;
			new_stats[28+SKILLID_FORENSICS ] := skill_change;
		elseif ( gump_ret[0] <= 21 )
			var skill_change := GetLevelSkill(gump_ret[0]);
			new_stats[28+SKILLID_ALCHEMY ] := skill_change;
			new_stats[28+SKILLID_EVALINT ] := skill_change;
			new_stats[28+SKILLID_INSCRIPTION ] := skill_change;
			new_stats[28+SKILLID_ITEMID ] := skill_change;
			new_stats[28+SKILLID_MAGERY ] := skill_change;
			new_stats[28+SKILLID_MEDITATION ] := skill_change;
			new_stats[28+SKILLID_MAGICRESISTANCE ] := skill_change;
			new_stats[28+SKILLID_SPIRITSPEAK ] := skill_change;
		elseif ( gump_ret[0] <= 28 )
			var skill_change := GetLevelSkill(gump_ret[0]);
			new_stats[28+SKILLID_HIDING ] := skill_change;
			new_stats[28+SKILLID_LOCKPICKING ] := skill_change;
			new_stats[28+SKILLID_POISONING ] := skill_change;
			new_stats[28+SKILLID_REMOVETRAP ] := skill_change;
			new_stats[28+SKILLID_STEALING ] := skill_change;
			new_stats[28+SKILLID_STEALTH ] := skill_change;
			new_stats[28+SKILLID_THROWING ] := skill_change;
			new_stats[28+SKILLID_TACTICS ] := skill_change;
		elseif ( gump_ret[0] <= 35 )
			var skill_change := GetLevelSkill(gump_ret[0]);
			new_stats[28+SKILLID_ARMSLORE ] := skill_change;
			new_stats[28+SKILLID_BLACKSMITHY ] := skill_change;
			new_stats[28+SKILLID_BOWCRAFT ] := skill_change;
			new_stats[28+SKILLID_CARPENTRY ] := skill_change;
			new_stats[28+SKILLID_LUMBERJACKING ] := skill_change;
			new_stats[28+SKILLID_MINING ] := skill_change;
			new_stats[28+SKILLID_TAILORING ] := skill_change;
			new_stats[28+SKILLID_TINKERING ] := skill_change;
		elseif ( gump_ret[0] <= 42 )
			// 2026-10-25: was a copy of the Crafter branch, so the Bard level buttons set crafter skills (ZH2.5 1.1.5 port)
			var skill_change := GetLevelSkill(gump_ret[0]);
			new_stats[28+SKILLID_BEGGING ] := skill_change;
			new_stats[28+SKILLID_CARTOGRAPHY ] := skill_change;
			new_stats[28+SKILLID_ENTICEMENT ] := skill_change;
			new_stats[28+SKILLID_HERDING ] := skill_change;
			new_stats[28+SKILLID_MUSICIANSHIP ] := skill_change;
			new_stats[28+SKILLID_PEACEMAKING ] := skill_change;
			new_stats[28+SKILLID_PROVOCATION ] := skill_change;
			new_stats[28+SKILLID_TASTEID ] := skill_change;
		endif
	endwhile
	if (gump_ret[0] == 100)//Exit
		return 0;
	elseif (gump_ret[0] == 777)  //Save Button
        SendSysMessage(who, "Saved mob info to cfg!", FONT_NORMAL, 43);
        var props := array;
        //Print($"props is currently 1: " +props);
        var last_prop := 85;
        if (is_npc)
            last_prop := 106;
        endif
        for (i := 1; i <= last_prop; i := i + 1)
            // 2026-10-25: skip the removed/unnamed slots; the mob as it is now, never a staged edit (ZH2.5 1.1.5 port)
            if (i == 88 && is_npc)
                // 2026-10-25: one "lootgroup" line per group, as templates list them (the gump shows them joined with "/")
                var lootgroupids := SplitWords(CStr(old_stats[88]), "/");
                foreach lootgroupid in lootgroupids
                    if (lootgroupid != "0")	// JoinLootGroups shows "0" for none
                        props.append(array { "lootgroup", lootgroupid });
                    endif
                endforeach
            elseif (desc_list[i])
                props.append(array { desc_list[i], old_stats[i] });
            endif
        endfor
        if (is_npc)
            // 2026-10-25: the template's repeated "spell" lines; HITS/MANA/STAM above carry the vitals, never CustomHitsLevel
            foreach spellname in orig_spells
                props.append(array { "spell", spellname });
            endforeach
        endif
        //Print($"props is currently 2: ");
        //foreach el in (props)
            //Print($"elem: {el[1]} -> {el[2]}");
        //endforeach
        AppendConfigFileElem( ":spawnpoint:newnpcs", "npctemplate", old_stats[1], props );
	elseif (gump_ret[0] == 999)//Apply Button
		if (old_stats == new_stats && !hits_changed && !spells_changed)
			SendSysMessage(who, "No change detected.");
			return 0;
		endif
		// 2026-10-25: staged Custom HP and Spells go first, so an HP typed into the gump still lands on top of the new maximum (ZH2.5 1.1.5 port)
		if (is_npc)
			ApplyStagedNpcEdits(who, mobile);
		endif
		if (!new_stats[1])
			SendSysMessage(who, "Name can't be blank, left as "+mobile.name+".");
		elseif (old_stats[1] != new_stats[1])
			RecordCharacterNameChange(mobile, new_stats[1], ADMINPANEL_INITIATOR_STAFF);
			mobile.name := new_stats[1];
			SendSysMessage(who, "Changing Name to: "+new_stats[1]);
		endif
		if (old_stats[2] != new_stats[2])
			SetBaseStrength(mobile, Cint(new_stats[2]) - GetStrengthMod(mobile));
			SendSysMessage(who, "Changing STR to: "+new_stats[2]);
		endif
		if (old_stats[3] != new_stats[3])
			SetBaseDexterity(mobile, new_stats[3] - GetDexterityMod(mobile));
			SendSysMessage(who, "Changing DEX to: "+new_stats[3]);
		endif
		if (old_stats[4] != new_stats[4])
			SetBaseIntelligence(mobile, new_stats[4] - GetIntelligenceMod(mobile));
			SendSysMessage(who, "Changing INT to: "+new_stats[4]);
		endif
		if (old_stats[5] != new_stats[5])
			// 2026-09-23: was SetVital raw hundredths on the current value only (HP 500 became 5
			// current hit points and no new maximum); players only ever had a current value to set.
			// 2026-09-30: the NPC ceiling goes through SetNpcVitalOverride (CustomHitsLevel retired).
			if (is_npc)
				SetNpcVitalOverride(mobile, "HITS", Cint(new_stats[5]));
			endif
			SetHp(mobile, Cint(new_stats[5]));
			SendSysMessage(who, "Changing HP to: "+new_stats[5]);
		endif
		if (old_stats[6] != new_stats[6])
			if (is_npc)
				SetNpcVitalOverride(mobile, "STAM", Cint(new_stats[6]));
			endif
			SetStamina(mobile, Cint(new_stats[6]));
			SendSysMessage(who, "Changing Stamina to: "+new_stats[6]);
		endif
		if (old_stats[7] != new_stats[7])
			if (is_npc)
				SetNpcVitalOverride(mobile, "MANA", Cint(new_stats[7]));
			endif
			SetMana(mobile, Cint(new_stats[7]));
			SendSysMessage(who, "Changing Mana to: "+new_stats[7]);
		endif
		if (old_stats[8] != new_stats[8])
			if (is_npc)
				mobile.run_speed := Cint(new_stats[8]);
			endif
		endif
		if (is_npc && old_stats[86] != new_stats[86])
			// 2026-09-30: MoveSpeed accepts only the five words; blank clears the override (back to the template).
			var msword := CanonicalMoveSpeedWord(new_stats[86]);
			if (!CStr(new_stats[86]))
				EraseObjProperty(mobile, "MoveSpeed");
				SendSysMessage(who, "MoveSpeed override cleared -- back to the template value.");
			elseif (msword)
				SetObjProperty(mobile, "MoveSpeed", msword);
				SendSysMessage(who, "Changing MoveSpeed to: "+msword);
			else
				SendSysMessage(who, "MoveSpeed must be Fastest, Fast, Normal, Slow or Slowest -- not changed.");
			endif
		endif
		if (old_stats[9] != new_stats[9])
			mobile.graphic := Cint(new_stats[9]);
			SendSysMessage(who, "Changing Mobile Graphic to: "+mobile.graphic);
		endif
		if (old_stats[10] != new_stats[10])
			mobile.color := Cint(new_stats[10]);
			SendSysMessage(who, "Changing Mobile Color to: "+mobile.color);
		endif
		if (old_stats[11] != new_stats[11])
			mobile.ar_mod := 0;
			SendSysMessage(who, "Adding AR_MOD of " +new_stats[11]+ " to base AR of "+mobile.ar);
			mobile.ar_mod := (Cint(new_stats[11]) - mobile.ar); // 2026-09-23: was who.ar, the staff member's own armour
		endif
		if (old_stats[12] != new_stats[12])
			EraseObjProperty(mobile, "EarthProtection");
			SetObjProperty(mobile, "EarthProtection", Cint(new_stats[12]));
			SendSysMessage(who, "Changing Earth Protection to: "+new_stats[12]);
		endif
		if (old_stats[13] != new_stats[13])
			EraseObjProperty(mobile, "FireProtection");
			SetObjProperty(mobile, "FireProtection", Cint(new_stats[13]));
			SendSysMessage(who, "Changing Fire Protection to: "+new_stats[13]);
		endif
		if (old_stats[14] != new_stats[14])
			EraseObjProperty(mobile, "WaterProtection");
			SetObjProperty(mobile, "WaterProtection", Cint(new_stats[14]));
			SendSysMessage(who, "Changing Water Protection to: "+new_stats[14]);
		endif
		if (old_stats[15] != new_stats[15])
			EraseObjProperty(mobile, "AirProtection");
			SetObjProperty(mobile, "AirProtection", Cint(new_stats[15]));
			SendSysMessage(who, "Changing Air Protection to: "+new_stats[15]);
		endif
		if (old_stats[16] != new_stats[16])
			EraseObjProperty(mobile, "HolyProtection");
			SetObjProperty(mobile, "HolyProtection", Cint(new_stats[16]));
			SendSysMessage(who, "Changing Holy Protection to: "+new_stats[16]);
		endif
		if (old_stats[17] != new_stats[17])
			EraseObjProperty(mobile, "NecroProtection");
			SetObjProperty(mobile, "NecroProtection", Cint(new_stats[17]));
			SendSysMessage(who, "Changing Necro Protection to: "+new_stats[17]);
		endif
		if (old_stats[18] != new_stats[18])
			EraseObjProperty(mobile, "PhysicalProtection");
			SetObjProperty(mobile, "PhysicalProtection", Cint(new_stats[18]));
			SendSysMessage(who, "Changing Physical Protection to: "+new_stats[18]);
		endif
		if (old_stats[19] != new_stats[19])
			EraseObjProperty(mobile, "PermPoisonImmunity");
			SetObjProperty(mobile, "PermPoisonImmunity", Cint(new_stats[19]));
			SendSysMessage(who, "Changing Perm PoisonImmunity to: "+new_stats[19]);
		endif
		if (old_stats[20] != new_stats[20])
			EraseObjProperty(mobile, "FreeAction");
			SetObjProperty(mobile, "FreeAction", Cint(new_stats[20]));
			SendSysMessage(who, "Changing Free Action to: "+new_stats[20]);
		endif
		if (old_stats[21] != new_stats[21])
			EraseObjProperty(mobile, "HealingIncrease");
			SetObjProperty(mobile, "HealingIncrease", Cint(new_stats[21]));
			SendSysMessage(who, "Changing Healing Increase to: "+new_stats[21]);
		endif
		// 2026-10-25: these two wrote "magicimmunity"/"magicreflection", but every reader and this tool's own load use PermMagicImmunity/Permmr, so the edit never showed or took effect; 22 and 25-27 removed, nothing read them (ZH2.5 1.1.5 port)
		if (old_stats[23] != new_stats[23])
			EraseObjProperty(mobile, "PermMagicImmunity");
			SetObjProperty(mobile, "PermMagicImmunity", Cint(new_stats[23]));
			SendSysMessage(who, "Changing Blackrock to: "+new_stats[23]);
		endif
		if (old_stats[24] != new_stats[24])
			EraseObjProperty(mobile, "Permmr");
			SetObjProperty(mobile, "Permmr", Cint(new_stats[24]));
			SendSysMessage(who, "Changing Moonstone to: "+new_stats[24]);
		endif

		j := 28;
		for (i := 0; i < 58; i := i+1)
			if (old_stats[j] != new_stats[j])
				SetBaseSkill(mobile, i, new_stats[j]);
				SendSysMessage(who, "Changing "+GetAttributeIdBySkillId(i)+" to: "+new_stats[j]);
			endif
			j +=1;
		endfor

		if (is_npc)
			ApplyNpcSettings(who, mobile);
		endif
	endif
endprogram

function gump_mobedit(who)

	var mobedit := GFCreateGump();
	
	GFPage(mobedit, 0);
	
	var btn_y := 364;
	if (is_npc)
		// 2026-10-25: NPCs get two more rows (Custom HP, Spells) above the Cancel/Apply row (ZH2.5 1.1.5 port)
		btn_y := 444;
		GFResizePic(mobedit, 16, 19, 9300, 473, 461);	// background first, the buttons below sit on top of it
		GFAddButton(mobedit, 30, 392, 4005, 4006, GF_CLOSE_BTN, BTN_CUSTOM_HITS);
		if (hits_changed && hits_value)
			GFTextLine(mobedit, 65, 394, TEXT_COLOR, "Custom HP: "+hits_value+" (set on Apply)");
		elseif (hits_changed)
			GFTextLine(mobedit, 65, 394, TEXT_COLOR, "Custom HP: template (set on Apply)");
		else
			GFTextLine(mobedit, 65, 394, TEXT_COLOR, "Custom HP: max "+old_stats[5]+" (edit)");
		endif
		GFAddButton(mobedit, 30, 416, 4005, 4006, GF_CLOSE_BTN, BTN_SPELLS);
		GFTextLine(mobedit, 65, 418, TEXT_COLOR, "Spells: "+npc_spells.size()+" (edit)");
	else
		GFResizePic(mobedit, 16, 19, 9300, 473, 381);	// 2026-09-30: +30px for the Move Speed row
	endif
	GFTextLine(mobedit, 207, 25, TEXT_COLOR, "Edit Mobile");
	GFResizePic(mobedit, 273, 62, 83, 199, 233);
	//Cancel
	GFAddButton(mobedit, 30, btn_y, 2121, 2120, GF_CLOSE_BTN, 100);
	//Apply
	GFAddButton(mobedit, 100, btn_y, 2123, 2124, GF_CLOSE_BTN, 999);
	//Log to file
	GFAddButton(mobedit, 170, btn_y, 5202, 5203, GF_CLOSE_BTN, 777);

	//PageButtons	
