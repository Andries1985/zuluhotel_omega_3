		GFTextEntry(mobedit, 408, 147, 59, 20, TEXT_COLOR, new_stats[88], 88);
		GFTextEntry(mobedit, 408, 170, 59, 20, TEXT_COLOR, new_stats[89], 89);
		GFTextEntry(mobedit, 408, 192, 59, 20, TEXT_COLOR, new_stats[90], 90);
		GFCheckBox(mobedit, 418, 216, 210, 211, new_stats[91], CHK_BASE + 91);
		GFCheckBox(mobedit, 418, 238, 210, 211, new_stats[92], CHK_BASE + 92);

		GFPage(mobedit, 11);

		// Boss and skill flags
		GFResizePic(mobedit, 399, 258, 9550, 57, 22);
		GFTextRight(mobedit, 402, 46, TEXT_COLOR, "Boss / Flags");
		GFTextRight(mobedit, 402, 80, TEXT_COLOR, "Lesser Boss");
		GFTextRight(mobedit, 402, 102, TEXT_COLOR, "Boss");
		GFTextRight(mobedit, 402, 125, TEXT_COLOR, "Super Boss");
		GFTextRight(mobedit, 402, 147, TEXT_COLOR, "Champion (0-4)");
		GFTextRight(mobedit, 402, 170, TEXT_COLOR, "Tame Diff (0 no)");
		GFTextRight(mobedit, 402, 192, TEXT_COLOR, "Snoop Diff (0 no)");
		GFTextRight(mobedit, 402, 215, TEXT_COLOR, "Steal Diff (0 no)");
		GFTextRight(mobedit, 402, 237, TEXT_COLOR, "Provoke Diff (0 no)");
		GFTextRight(mobedit, 402, 260, TEXT_COLOR, "Peace Diff (0 no)");
		GFCheckBox(mobedit, 418, 80, 210, 211, new_stats[95], CHK_BASE + 95);
		GFCheckBox(mobedit, 418, 102, 210, 211, new_stats[96], CHK_BASE + 96);
		GFCheckBox(mobedit, 418, 125, 210, 211, new_stats[97], CHK_BASE + 97);
		GFTextEntry(mobedit, 408, 147, 59, 20, TEXT_COLOR, new_stats[98], 98);
		GFTextEntry(mobedit, 408, 170, 59, 20, TEXT_COLOR, new_stats[99], 99);
		GFTextEntry(mobedit, 408, 192, 59, 20, TEXT_COLOR, new_stats[100], 100);
		GFTextEntry(mobedit, 408, 215, 59, 20, TEXT_COLOR, new_stats[101], 101);
		GFTextEntry(mobedit, 408, 237, 59, 20, TEXT_COLOR, new_stats[102], 102);
		GFTextEntry(mobedit, 408, 260, 59, 20, TEXT_COLOR, new_stats[103], 103);

		GFPage(mobedit, 12);

		// 2026-10-25: per-instance regen, points per minute (the HITSREGEN/MANAREGEN/STAMREGEN slot of npcvitals.inc); blank = back to the template
		GFTextRight(mobedit, 402, 46, TEXT_COLOR, "Regen (points per minute)");
		GFTextRight(mobedit, 402, 80, TEXT_COLOR, "Hit Points");
		GFTextRight(mobedit, 402, 102, TEXT_COLOR, "Mana");
		GFTextRight(mobedit, 402, 125, TEXT_COLOR, "Stamina");
		GFTextEntry(mobedit, 408, 80, 59, 20, TEXT_COLOR, new_stats[104], 104);
		GFTextEntry(mobedit, 408, 102, 59, 20, TEXT_COLOR, new_stats[105], 105);
		GFTextEntry(mobedit, 408, 125, 59, 20, TEXT_COLOR, new_stats[106], 106);
		GFTextLine(mobedit, 280, 160, TEXT_COLOR, "Blank = template value");
		GFTextLine(mobedit, 280, 180, TEXT_COLOR, "Engine default is 12");
	endif

	return GFSendGump(who, mobedit);

endfunction

// 2026-10-25: GFExtractData errors on a blank text entry (the reply is only "<id>: "), so treat that as "" (ZH2.5 1.1.5 port)
function GetGumpText(reply, id)

	var text := GFExtractData(reply, id);
	if (text == error)
		return "";
	endif

	return text;

endfunction

// Level buttons come in rows of 7: 1-6 give 75/90/105/120/135/150, the 7th clears to 0
// 2026-10-25: integer modulo; the old (d/7 - int(d/7))*7 float trick could land a hair under the step and give 148.5 (ZH2.5 1.1.5 port)
function GetLevelSkill(button)

	var level := CInt(button) % 7;
	if (!level)
		return 0;
	endif

	return 60 + (15 * level);

endfunction

// Effective MoveSpeed word for the editor: instance override, else the template field, else "".
function EffectiveMoveSpeedWord(mobile)

	var word := GetObjProperty(mobile, "MoveSpeed");
	if (!word)
		var cfg := ReadConfigFile("::npcdesc");
		word := GetConfigString(cfg[mobile.npctemplate], "MoveSpeed");
	endif
	if (!word)
		return "";
	endif

	return CStr(word);

endfunction

// The five accepted words in their canonical spelling, or "" if the text is not one of them.
function CanonicalMoveSpeedWord(text)

	case (Lower(CStr(text)))
		"fastest":	return "Fastest";
		"fast":		return "Fast";
		"normal":	return "Normal";
		"slow":		return "Slow";
		"slowest":	return "Slowest";
	endcase

	return "";

endfunction

function CalculateProtections(who)

	earth := CInt(GetObjProperty(who, "EarthProtection"));
	fire := CInt(GetObjProperty(who, "FireProtection"));
	water := CInt(GetObjProperty(who, "WaterProtection"));
	air := CInt(GetObjProperty(who, "AirProtection"));
	holy := CInt(GetObjProperty(who, "HolyProtection"));

	necro := CInt(GetObjProperty(who, "NecroProtection"));
	physical := CInt(GetObjProperty(who, "PhysicalProtection"));
	poison := CInt(GetObjProperty(who, "PermPoisonImmunity"));
	freeaction := CInt(GetObjProperty(who, "FreeAction"));

	healing := CInt(GetObjProperty(who, "HealingIncrease"));

	magicimmunity := CInt(GetObjProperty(who, "PermMagicImmunity"));
	magicreflection := CInt(GetObjProperty(who, "Permmr"));

	old_stats[12] := earth;
	old_stats[13] := fire;
	old_stats[14] := water;
	old_stats[15] := air;
	old_stats[16] := holy;
	old_stats[17] := necro;
	old_stats[18] := physical;
	old_stats[19] := poison;
	old_stats[20] := freeaction;
	old_stats[21] := healing;
	old_stats[22] := 0;	// 2026-10-25: unused, was ME (ZH2.5 1.1.5 port)
	old_stats[23] := magicimmunity;
	old_stats[24] := magicreflection;
	old_stats[25] := 0;	// unused, was Absorbsion
	old_stats[26] := 0;	// unused, was Warding
	old_stats[27] := 0;	// unused, was Antidotes
endfunction

///////////////////////////////////////////////////////////////////////////////////////
// 2026-10-25: NPC pages, staged edits, tame/snoop/steal/provoke/peace, regen
// (ZH2.5 1.1.5 port, adapted to ZH3.0 template fields and npcvitals.inc)
///////////////////////////////////////////////////////////////////////////////////////

// Asks for a new max HP and stages it; ApplyStagedNpcEdits writes it when Apply is pressed
function SetCustomHitsLevel(who, mobile)

	var template_hits := GetNpcVitalTemplateValue(mobile, "HITS");
	if (!template_hits)
		template_hits := "none";
	endif

	var entered := RequestGump(who, "Enter the new maximum HP (1 - "+MAX_CUSTOM_HITS+")", "0 puts the npc back on its template HITS ("+template_hits+").", old_stats[5], CANCEL_BTN_ON);
	if (TypeOf(entered) != "String")
		SendSysMessage(who, "Custom HP unchanged.", FONT_NORMAL, 43);
		return 0;
	endif

	var level := CInt(entered);
	if ((!level && entered != "0") || level < 0 || level > MAX_CUSTOM_HITS)
		SendSysMessage(who, "Enter a number from 0 to "+MAX_CUSTOM_HITS+".", FONT_NORMAL, 43);
		return 0;
	endif

	hits_value := level;
	hits_changed := 1;
	if (level)
		SendSysMessage(who, "Max HP "+level+" is set when you press Apply.");
	else
		SendSysMessage(who, "Max HP goes back to the template when you press Apply.");
	endif

	return 1;

endfunction

// Writes what the Custom HP and Spells buttons staged
function ApplyStagedNpcEdits(who, mobile)

	if (hits_changed)
		// SetNpcVitalOverride / ClearNpcVitalOverride both RecalcVitals, so the vitalInit.src max hook runs on the new entry
		if (hits_value)
			SetNpcVitalOverride(mobile, "HITS", hits_value);
			SendSysMessage(who, "Changing max HP to: "+hits_value);
		else
			ClearNpcVitalOverride(mobile, "HITS");
			SendSysMessage(who, "Max HP is back on the template value.");
		endif
		SetHP(mobile, GetMaxHP(mobile));
	endif

	if (spells_changed)
		// Matching the template keeps it on the template (and any doubled-up spells it lists)
		if (spells_to_template)
			EraseObjProperty(mobile, "CustomSpells");
			SendSysMessage(who, "Spells set to the template's "+npc_spells.size()+".");
		else
			SetObjProperty(mobile, "CustomSpells", npc_spells);
			SendSysMessage(who, "Spells saved: "+npc_spells.size()+".");
		endif
	endif

endfunction

// Reads the AI / Loot, Flags and Regen page values off the npc (instance props first, then its npcdesc template)
function LoadNpcSettings(mobile)

	var elem := FindConfigElem(ReadConfigFile("::npcdesc"), mobile.npctemplate);

	old_stats[87] := mobile.script;

	// CustomLoot is { MagicItemChance, MagicItemLevel, lootgroup }, same as the customnpc spawnpoint gump
	var cloot := GetObjProperty(mobile, "CustomLoot");
	if (cloot)
		old_stats[88] := CStr(CInt(cloot[3]));
		old_stats[89] := CInt(cloot[2]);
		old_stats[90] := CInt(cloot[1]);
	else
		old_stats[88] := JoinLootGroups(GetConfigStringArray(elem, "lootgroup"));
		old_stats[89] := CInt(GetConfigInt(elem, "MagicItemLevel"));
		old_stats[90] := CInt(GetConfigInt(elem, "MagicItemChance"));
	endif

	old_stats[91] := ItemsDrop(GetWornItems(mobile));
	old_stats[92] := ItemsDrop(GetPackItems(mobile));
	old_stats[93] := CStr(mobile.title_prefix);
	old_stats[94] := CStr(mobile.title_suffix);
	old_stats[95] := HasFlag(mobile, "LesserBoss");
	old_stats[96] := HasFlag(mobile, "Boss");
	old_stats[97] := HasFlag(mobile, "SuperBoss");
	old_stats[98] := CInt(GetObjProperty(mobile, "Champion"));
	old_stats[99] := GetTameDifficulty(mobile, elem);
	old_stats[100] := GetSnoopDifficulty(mobile);
	old_stats[101] := GetStealDifficulty(mobile);
	old_stats[102] := GetShownBardDifficulty(mobile, elem, "provoke");
	old_stats[103] := GetShownBardDifficulty(mobile, elem, "peacemake");
	old_stats[104] := RegenText(mobile, "HITSREGEN");
	old_stats[105] := RegenText(mobile, "MANAREGEN");
	old_stats[106] := RegenText(mobile, "STAMREGEN");

endfunction

function ApplyNpcSettings(who, mobile)

	var refresh := 0;

	if (old_stats[87] != new_stats[87])
		if (!new_stats[87])
			SendSysMessage(who, "Script can't be blank, left as "+mobile.script+".");
		else
			mobile.script := new_stats[87];
			RestartScript(mobile);
			SendSysMessage(who, "Changing Script to: "+mobile.script);
		endif
	endif

	if (old_stats[88] != new_stats[88] || old_stats[89] != new_stats[89] || old_stats[90] != new_stats[90])
		// Same rule as the customnpc spawnpoint gump: loot is admin+ only
		if (who.cmdlevel > 3)
			var lootgroup := CInt(new_stats[88]);
			SetObjProperty(mobile, "CustomLoot", array{ CInt(new_stats[90]), CInt(new_stats[89]), lootgroup });
			SendSysMessage(who, "Changing Loot to: Lootgroup "+lootgroup+", Magic Item Level "+new_stats[89]+", Magic Item Chance "+new_stats[90]);
			if (CStr(lootgroup) != new_stats[88])
				SendSysMessage(who, "Custom loot only holds one lootgroup, kept "+lootgroup+".", FONT_NORMAL, 43);
			endif
		else
			SendSysMessage(who, "Loot unchanged, need admin+ rights for that.", FONT_NORMAL, 43);
		endif
	endif

	if (old_stats[91] != new_stats[91])
		SetItemsNoLoot(GetWornItems(mobile), !new_stats[91]);
		SendSysMessage(who, "Worn items drop on death: "+YesNoText(new_stats[91]));
	endif
	if (old_stats[92] != new_stats[92])
		SetItemsNoLoot(GetPackItems(mobile), !new_stats[92]);
		SendSysMessage(who, "Backpack items drop on death: "+YesNoText(new_stats[92]));
	endif

	if (old_stats[93] != new_stats[93])
		mobile.title_prefix := new_stats[93];
		SendSysMessage(who, "Changing Title Prefix to: "+new_stats[93]);
	endif
	if (old_stats[94] != new_stats[94])
		mobile.title_suffix := new_stats[94];
		SendSysMessage(who, "Changing Title Suffix to: "+new_stats[94]);
	endif

	if (old_stats[95] != new_stats[95])
		SetFlag(mobile, "LesserBoss", new_stats[95]);
		SendSysMessage(who, "Lesser Boss: "+YesNoText(new_stats[95]));
		refresh := 1;
	endif
	if (old_stats[96] != new_stats[96])
		SetFlag(mobile, "Boss", new_stats[96]);
		SendSysMessage(who, "Boss: "+YesNoText(new_stats[96]));
		refresh := 1;
	endif
	if (old_stats[97] != new_stats[97])
		SetFlag(mobile, "SuperBoss", new_stats[97]);
		SendSysMessage(who, "Super Boss: "+YesNoText(new_stats[97]));
		refresh := 1;
	endif
	if (old_stats[98] != new_stats[98])
		SetNumberProp(mobile, "Champion", new_stats[98]);
		SendSysMessage(who, "Changing Champion to: "+CInt(GetObjProperty(mobile, "Champion")));
	endif

	if (old_stats[99] != new_stats[99])
		if (new_stats[99] > 0)
			EraseObjProperty(mobile, "notame");
			EraseObjProperty(mobile, "untamable");
			SetObjProperty(mobile, "tamableAt", CInt(new_stats[99]));
			SendSysMessage(who, "Changing Tame Difficulty to: "+new_stats[99]);
			if (GetObjProperty(mobile, "SuperBoss"))
				SendSysMessage(who, "Super Bosses can never be tamed.", FONT_NORMAL, 43);
			endif
		else
			EraseObjProperty(mobile, "tamableAt");
			// untamable, not notame: taming checks both, but Spell Bind, Control Undead,
			// Beastal Bond and herding only check untamable (same prop .untamable sets)
			SetObjProperty(mobile, "untamable", 1);
			SendSysMessage(who, "Npc can no longer be tamed or controlled.");
		endif
	endif

	// snoopme / stealme are kept even at 0: GetNpcDifficultyField (include/npcdifficulty) reads a 0 instance value as "cannot"
	if (old_stats[100] != new_stats[100])
		SetObjProperty(mobile, "snoopme", MaxZero(new_stats[100]));
		SendSysMessage(who, "Changing Snoop Difficulty to: "+MaxZero(new_stats[100]));
	endif
	if (old_stats[101] != new_stats[101])
		SetObjProperty(mobile, "stealme", MaxZero(new_stats[101]));
		SendSysMessage(who, "Changing Steal Difficulty to: "+MaxZero(new_stats[101]));
	endif

	// provoke / peacemake: instance props beat the template fields in provocation.src / peacemaking.src, 0 = immune
	if (old_stats[102] != new_stats[102])
		SetObjProperty(mobile, "provoke", MaxZero(new_stats[102]));
		if (MaxZero(new_stats[102]))
			SendSysMessage(who, "Changing Provoke Difficulty to: "+MaxZero(new_stats[102]));
		else
			SendSysMessage(who, "Npc can no longer be provoked.");
		endif
	endif
	if (old_stats[103] != new_stats[103])
		SetObjProperty(mobile, "peacemake", MaxZero(new_stats[103]));
		if (MaxZero(new_stats[103]))
			SendSysMessage(who, "Changing Peacemaking Difficulty to: "+MaxZero(new_stats[103]));
		else
			SendSysMessage(who, "Npc can no longer be peaced.");
		endif
	endif

	if (old_stats[104] != new_stats[104])
		ApplyRegenEdit(who, mobile, "HITSREGEN", VITALID_LIFE, new_stats[104], "HP");
	endif
	if (old_stats[105] != new_stats[105])
		ApplyRegenEdit(who, mobile, "MANAREGEN", VITALID_MANA, new_stats[105], "Mana");
	endif
	if (old_stats[106] != new_stats[106])
		ApplyRegenEdit(who, mobile, "STAMREGEN", VITALID_STAMINA, new_stats[106], "Stamina");
	endif

	// Boss name colours come from the name colour hook; a forced move resends the mobile to nearby clients
	if (refresh)
		MoveObjectToLocation(mobile, mobile.x, mobile.y, mobile.z, mobile.realm, MOVEOBJECT_FORCELOCATION);
	endif

endfunction

function MaxZero(value)

	value := CInt(value);
	if (value < 0)
		return 0;
	endif

	return value;

endfunction

// Regen in points per minute as the npc has it now: instance entry, else the template field, else the engine default
function RegenText(mobile, field)

	var setting := GetNpcVitalSetting(mobile, field);	// hundredths per minute, -1 = no field
	if (setting < 0)
		setting := CORE_SETTINGS_DEFAULT_REGEN_RATE;
	endif

	if (setting % 100)
		return CStr(CDbl(setting) / 100);
	endif

	return CStr(setting / 100);

endfunction

// Stores the typed rate in the npc's HITSREGEN/MANAREGEN/STAMREGEN slot (blank = back to the template), then applies it
// at once the way modsetup.inc does at AI start, so the edit works without restarting the AI.
function ApplyRegenEdit(who, mobile, field, vitalid, text, label)

	if (!text)
		ClearNpcVitalOverride(mobile, field);
		SendSysMessage(who, label+" regen is back on the template value.");
	else
		var points := CDbl(text);
		if (points < 0 || (points == 0 && text[1, 1] != "0"))
			SendSysMessage(who, label+" regen must be a number of points per minute (0 or more) -- not changed.", FONT_NORMAL, 43);
			return 0;
		endif
		SetNpcVitalOverride(mobile, field, points);
		SendSysMessage(who, "Changing "+label+" regen to: "+points+" per minute");
	endif

	var setting := GetNpcVitalSetting(mobile, field);
	if (setting >= 0)
		SetVitalRegenRateMod(mobile, vitalid, "template", setting - CORE_SETTINGS_DEFAULT_REGEN_RATE);
	else
		ClearVitalRegenRateMod(mobile, vitalid, "template");
	endif

	return 1;

endfunction

function JoinLootGroups(groups)

	if (!groups.size())
		return "0";
	endif

	var text := "";
	foreach group in groups
		if (text)
			text := text+"/";
		endif
		text := text+group;
	endforeach

	return text;

endfunction

// Hair, beard and the mount piece are equipped too but aren't loot
function GetWornItems(mobile)

	var skip_layers := array{ LAYER_HAIR, LAYER_BEARD, LAYER_MOUNT, LAYER_PACK };
	var items := array;
	var worn := ListEquippedItems(mobile);
	foreach item in worn
		if (!(item.layer in skip_layers))
			items.append(item);
		endif
	endforeach

	return items;

endfunction

function GetPackItems(mobile)

	if (!mobile.backpack)
		return array;
	endif

	return EnumerateItemsInContainer(mobile.backpack);

endfunction

// 1 unless every item is flagged noloot (death.src destroys those instead of leaving them on the corpse)
function ItemsDrop(items)

	foreach item in items
		if (!GetObjProperty(item, "noloot"))
			return 1;
		endif
	endforeach

	if (items.size())
		return 0;
	endif

	return 1;

endfunction

function SetItemsNoLoot(items, noloot)

	foreach item in items
		if (noloot)
			SetObjProperty(item, "noloot", 1);
		else
			EraseObjProperty(item, "noloot");
		endif
	endforeach

endfunction

function HasFlag(mobile, prop)

	if (GetObjProperty(mobile, prop))
		return 1;
	endif

	return 0;

endfunction

function SetFlag(mobile, prop, on)

	if (on)
		SetObjProperty(mobile, prop, 1);
	else
		EraseObjProperty(mobile, prop);
	endif

endfunction

// 0 or less erases the prop
function SetNumberProp(mobile, prop, value)

	value := CInt(value);
	if (value > 0)
		SetObjProperty(mobile, prop, value);
	else
		EraseObjProperty(mobile, prop);
	endif

endfunction

// Mirrors pkg/std/taming/taming.src: notame/untamable block it, tamableAt overrides the template tameskill
function GetTameDifficulty(mobile, elem)

	if (GetObjProperty(mobile, "notame") || GetObjProperty(mobile, "untamable"))
		return 0;
	endif

	var difficulty := CInt(GetObjProperty(mobile, "tamableAt"));
	if (!difficulty)
		difficulty := CInt(GetConfigInt(elem, "tameskill"));
	endif

	return difficulty;

endfunction

// Mirrors provocation.src / peacemaking.src: an instance prop beats the template, 0 means never;
// otherwise invul templates can't be provoked/peaced and a missing template value defaults to 100, capped at 150
function GetShownBardDifficulty(mobile, elem, field)

	var custom := GetNpcDifficultyOverride(mobile, field);
	if (custom >= 0)
		return custom;
	endif

	if (!elem || elem.Privs == "invul")
		return 0;
	endif

	var difficulty := CInt(GetConfigInt(elem, field));
	if (!difficulty)
		difficulty := 100;
	elseif (difficulty > 150)
		difficulty := 150;
	endif

	return difficulty;

endfunction

function GetTemplateSpells(mobile)

	var elem := FindConfigElem(ReadConfigFile("::npcdesc"), mobile.npctemplate);
	if (!elem)
		return array;
	endif

	return GetConfigStringArray(elem, "spell");

endfunction

// A CustomSpells CProp (even an empty one) replaces the template's spell lines, see cast_offensive_spell() in npccast.inc
function GetNpcSpells(mobile)

	var custom := GetObjProperty(mobile, "CustomSpells");
	if (custom != error)
		return custom;
	endif

	return GetTemplateSpells(mobile);

endfunction

// Every spell npccast.inc can cast, plus whatever this npc already has, alphabetical
function GetAllMobSpells()

	var found := dictionary;
	var known := GetNpcSpellNames();
	foreach spell in known
		found[spell] := 1;
	endforeach

	foreach spell in npc_spells
		found[spell] := 1;
	endforeach

	return found.keys();

endfunction

// Compares as sets: a template that lists a spell twice (to cast it more often) still matches
function SameSpells(list_a, list_b)

	foreach spell in list_a
		if (!(spell in list_b))
			return 0;
		endif
	endforeach
	foreach spell in list_b
		if (!(spell in list_a))
			return 0;
		endif
	endforeach

	return 1;

endfunction

// Checkbox list of every mob spell; Save stages the choice for Apply
function EditNpcSpells(who, mobile)

	var all_spells := GetAllMobSpells();
	var per_page := SPELLS_PER_COLUMN * 3;
	var pages := CInt((all_spells.size() + per_page - 1) / per_page);
	if (pages < 1)
		pages := 1;
	endif

	var gump := GFCreateGump();
	GFPage(gump, 0);
	GFResizePic(gump, 16, 19, 9300, 500, 470);
	GFTextLine(gump, 40, 30, TEXT_COLOR, "Spells for "+mobile.name+" - tick the ones it should cast");
	if (!(mobile.script in CASTER_SCRIPTS))
		GFTextLine(gump, 40, 50, 33, "AI script '"+mobile.script+"' doesn't cast spells, use spellkillpcs");
	endif

	//Cancel
	GFAddButton(gump, 30, 430, 2121, 2120, GF_CLOSE_BTN, 2);
	//Save
	GFAddButton(gump, 100, 430, 2123, 2124, GF_CLOSE_BTN, 1);
	//Back to the template's own spells
	GFAddButton(gump, 170, 432, 4005, 4006, GF_CLOSE_BTN, 3);
	GFTextLine(gump, 205, 433, TEXT_COLOR, "Template");

	var page := 1;
	var i;
	GFPage(gump, page);
	GFTextLine(gump, 330, 433, TEXT_COLOR, "Page 1 of "+pages);
	for (i := 1; i <= all_spells.size(); i := i + 1)
		var slot := (i - 1) % per_page;
		if (i > 1 && slot == 0)
			GFAddButton(gump, 470, 430, 4005, 4006, GF_PAGE_BTN, page + 1);
			page := page + 1;
			GFPage(gump, page);
			GFAddButton(gump, 435, 430, 4014, 4015, GF_PAGE_BTN, page - 1);
			GFTextLine(gump, 330, 433, TEXT_COLOR, "Page "+page+" of "+pages);
		endif

		var x := 40 + (CInt(slot / SPELLS_PER_COLUMN) * 155);
		var y := 75 + ((slot % SPELLS_PER_COLUMN) * 23);
		var checked := 0;
		if (all_spells[i] in npc_spells)
			checked := 1;
		endif
		GFCheckBox(gump, x, y, 210, 211, checked, SPELL_CHK_BASE + i);
		GFTextLine(gump, x + 25, y, TEXT_COLOR, all_spells[i]);
	endfor

	var result := GFSendGump(who, gump);

	var chosen := array;
	if (result[0] == 1)
		for (i := 1; i <= all_spells.size(); i := i + 1)
			if (result[SPELL_CHK_BASE + i])
				chosen.append(all_spells[i]);
			endif
		endfor
	elseif (result[0] == 3)
		chosen := GetTemplateSpells(mobile);
	else
		SendSysMessage(who, "Spells unchanged.", FONT_NORMAL, 43);
		return 0;
	endif

	// Staged like the other fields; ApplyStagedNpcEdits writes it when Apply is pressed
	var template_spells := GetTemplateSpells(mobile);
	spells_to_template := SameSpells(chosen, template_spells);
	if (spells_to_template)
		npc_spells := template_spells;
	else
		npc_spells := chosen;
	endif
	spells_changed := 1;
	SendSysMessage(who, npc_spells.size()+" spell(s) are set when you press Apply.");

	return 1;

endfunction

function YesNoText(value)

	if (value)
		return "yes";
	endif

	return "no";

endfunction
