// Synopsis: Warden Julia, the seventh ritual quest-giver. Say "quest" to
// open the quest-giver gump (lists whatever quests.cfg entries have
// "Giver julia" -- Quests 22-24: Spell Bouncing, Spell Warding, Venom
// Mastery). Also periodically shouts a reminder at nearby players who
// haven't completed her quest(s) yet. Formerly "Elsbeth Farrow" --
// renamed to a real Ultima character (Julia, the gypsy/thief companion
// from Ultima VII, fitting for someone who tracks what's stolen) per the
// user's naming pass. Scaffolded directly from thragg.src -- only the
// idle shout line differs.
use npc;
use os;
use uo;

include "include/eventid";
include ":quests:questnpcgump";
include ":quests:queststate";
include "ai/setup/modsetup";

const JULIA_SHOUT_RANGE := 10;

var me := Self();

EnableEvents(SYSEVENT_SPEECH, 2);

while(1)
	var event := os::wait_for_event(15);
	if(event)
		case(event.type)
			SYSEVENT_SPEECH:
				HandleQuestGiverSpeech(me, event);
		endcase
	else
		var should_shout := 0;
		foreach mobile in ListMobilesNearLocation(me.x, me.y, me.z, JULIA_SHOUT_RANGE, me.realm)
			if(!mobile.npctemplate && QP_GiverHasUndoneQuest(me, mobile))
				SendSysMessage(mobile, me.name+": I have a task for you, traveler!", 3, 73);
				should_shout := 1;
			endif
		endforeach

		if(should_shout)
			Say("Every traveler Bonecrusher's ogres rob adds to a pile they'll never understand, traveler.");
		endif
	endif
endwhile
