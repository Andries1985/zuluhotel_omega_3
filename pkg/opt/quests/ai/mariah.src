// Synopsis: Arch-Mage Mariah, the first ritual quest-giver. Say "quest" to
// open the quest-giver gump (lists whatever quests.cfg entries have
// "Giver mariah" -- Quests 2-5: Consecration, Create Focus, Attunement,
// Purification). Also periodically shouts a reminder at nearby players who
// haven't completed her quest(s) yet. Formerly "Valthor" -- renamed to a
// real Ultima character (Mariah, the series' recurring archmage companion,
// Ultima V/VI/VII) per the user's naming pass. Scaffolded directly from
// questpkg_testgiver.src.
use npc;
use os;
use uo;

include "include/eventid";
include ":quests:questnpcgump";
include ":quests:queststate";
include "ai/setup/modsetup";

const MARIAH_SHOUT_RANGE := 10;

var me := Self();

EnableEvents(SYSEVENT_SPEECH, 2);

while(1)
	var event := os::wait_for_event(15);
	if(event)
		case(event.type)
			SYSEVENT_SPEECH:
				HandleQuestGiverSpeech(me, event);
		endcase
	else
		var should_shout := 0;
		foreach mobile in ListMobilesNearLocation(me.x, me.y, me.z, MARIAH_SHOUT_RANGE, me.realm)
			if(!mobile.npctemplate && QP_GiverHasUndoneQuest(me, mobile))
				SendSysMessage(mobile, me.name+": I have a task for you, traveler!", 3, 73);
				should_shout := 1;
			endif
		endforeach

		if(should_shout)
			Say("The dead do not rest easy at Dracham Cemetery, traveler.");
		endif
	endif
endwhile
