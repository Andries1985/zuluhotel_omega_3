// Synopsis: Cinderwarden Rudyom, the fourth ritual quest-giver. Say
// "quest" to open the quest-giver gump (lists whatever quests.cfg entries
// have "Giver rudyom" -- Quests 12-15: Physical Ward, Quick Healing,
// Vital Infusion, Blood Seeking). Also periodically shouts a reminder at
// nearby players who haven't completed his quest(s) yet. Formerly
// "Kaelthorne" -- renamed to a real Ultima character (Rudyom, the
// fire-magic wizard from Ultima VII's "Forge of Virtue") per the user's
// naming pass. Scaffolded directly from nystul.src -- only the idle
// shout line differs.
use npc;
use os;
use uo;

include "include/eventid";
include ":quests:questnpcgump";
include ":quests:queststate";
include "ai/setup/modsetup";

const RUDYOM_SHOUT_RANGE := 10;

var me := Self();

EnableEvents(SYSEVENT_SPEECH, 2);

while(1)
	var event := os::wait_for_event(15);
	if(event)
		case(event.type)
			SYSEVENT_SPEECH:
				HandleQuestGiverSpeech(me, event);
		endcase
	else
		var should_shout := 0;
		foreach mobile in ListMobilesNearLocation(me.x, me.y, me.z, RUDYOM_SHOUT_RANGE, me.realm)
			if(!mobile.npctemplate && QP_GiverHasUndoneQuest(me, mobile))
				SendSysMessage(mobile, me.name+": I have a task for you, traveler!", 3, 73);
				should_shout := 1;
			endif
		endforeach

		if(should_shout)
			Say("The gates of Brimstone have swallowed better than you, traveler.");
		endif
	endif
endwhile
