use uo;
use guilds;

include ":guilds:include/guilds";

program ondelete( who )

var guild := who.guild;

// In a guild
if (guild)
	
	// Player isn't the GM, just a member
	if (guild.getprop("GuildMaster") != who.serial)
		RemoveMember(who);
		foreach member in (guild.members)
			SendSysMessage(member, who.name+" has left the guild, and the world...", 3, 43);
		endforeach
	else
	
	// Player is the GM

		// Player is only guild member!
		if ( guild.members.size() < 2)
			DisbandGuild(guild);
			
		// More players in the guild
		else
			ChangeGuildMaster(who);
			RemoveMember(who);
		endif
	endif
// Not in a guild, remove any recruit props from guilds though
else

	// 2026-09-22: was a scan of the legacy "Recruits" property nothing writes;
	// the live join-request lists kept the deleted serial (a blank applicant
	// in the master's gump). Drop it from every guild's JoinGuildRequest.
	var guilds := ListGuilds();
	foreach thing in guilds
		var requests := thing.getprop("JoinGuildRequest");
		if (requests and !requests.errortext)
			var kept := {};
			foreach req in requests
				if (req != who.serial)
					kept.append(req);
				endif
			endforeach
			if (kept.size() != requests.size())
				if (kept.size())
					thing.setprop("JoinGuildRequest", kept);
				else
					thing.eraseprop("JoinGuildRequest");
				endif
			endif
		endif
	endforeach
endif

endprogram