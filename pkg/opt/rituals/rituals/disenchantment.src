/*
        CUT 2026-08-26: removed from the rituals package during the revival pass.
        TargOptions restricted this to cursed items, but the effect (destroy +
        recreate from scratch) wiped everything about the item - color, quality,
        enchant mods, name - not just the curse. Purification (BanishCurse) covers
        the intended "remove a curse" use case without the collateral damage.
        Left in place, commented out, rather than deleted.

use uo;
use os;

include "include/string";
// include ":loot:identify";
// include ":rituals:rituals";
include "include/namingbyenchant";
include "../pkg/opt/rituals/include/rituals";

program ritual_disanchantment( parms )

        var mobile := parms[1],
            spell_id := parms[2];

        var item := PerformRitual( mobile, spell_id );
	if( !item )
                ChangeLightLevel( mobile, 0 );
		return 0;
	endif

        ApplyRitualEffect( mobile, item );

        return 1;
endprogram

function ApplyRitualEffect( mobile, item )

        var new_item := CreateItemInContainer( item.container, item.objtype );
        if( new_item.errortext )
                SendSysMessage( mobile, "Error creating ritual item -->"+new_item.errortext );
                return 0;
        endif

        DestroyItem( item );
	SetNameByEnchant( new_item );

	SendSysMessage( mobile, "This "+TruncateArticle( new_item.desc )+" is now completely disenchanted." );

        return 1;
endfunction
*/
