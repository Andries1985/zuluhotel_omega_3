use uo;
use os;

include "include/string";
// include ":loot:identify";
// include ":rituals:rituals";
include "include/classes";
include "include/namingbyenchant";
include "../pkg/opt/rituals/include/rituals";

program ritual_physicalWard( parms )

        var mobile := parms[1],
            spell_id := parms[2];

        var item := PerformRitual( mobile, spell_id );
	if( !item )
                ChangeLightLevel( mobile, 0 );
		return 0;
	endif

        ApplyRitualEffect( mobile, item );

        return 1;
endprogram

function ApplyRitualEffect( mobile, item )

        var item_desc := TruncateArticle( item.desc );

        if( RitualHasOtherImmunity( item, "PhysicalProtection" ))
		SendSysMessage( mobile, "This "+item_desc+" already carries a different enchantment and cannot hold another." );
                return 0;
        endif

        var protection := CInt( GetObjProperty( item, "PhysicalProtection" ));
        if( protection >= 6 )
		SendSysMessage( mobile, "This "+item_desc+" already have a more powerful enchantment on it." );
                return 0;
        endif

	SetObjProperty( item, "PhysicalProtection", protection + 1 );
	SetNameByEnchant( item );

	SendSysMessage( mobile, "This "+item_desc+" will now protect its wearer from physical attacks." );

        return 1;
endfunction
