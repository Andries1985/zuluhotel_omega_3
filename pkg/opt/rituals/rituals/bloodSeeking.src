use uo;
use os;

include "include/string";
//include ":loot:identify";
//include ":rituals:rituals";
include "include/namingbyenchant";
include "../pkg/opt/rituals/include/rituals";

program ritual_bloodSeeking( parms )

        var mobile := parms[1],
            spell_id := parms[2];

        var item := PerformRitual( mobile, spell_id );
	if( !item )
                ChangeLightLevel( mobile, 0 );
		return 0;
	endif

        ApplyRitualEffect( mobile, item );

        return 1;
endprogram

function ApplyRitualEffect( mobile, item )

        var item_desc := TruncateArticle( item.desc );

        // 2026-09-28: dropped the RitualHasHitscript check here - a Fury/Slayer/Poisonlvl
        // weapon can also carry a damage bonus. Confirmed against starteqp.inc/namingbyenchant.inc:
        // nothing in the engine or loot generator ever required these to be exclusive, and a real
        // hand-authored weapon in itemdesc.cfg already combines a special Hitscript with a SlayType.
        var dmg_mod := item.dmg_mod;
        if( dmg_mod >= 30 )
		SendSysMessage( mobile, "There's already a stronger enchantment on this item." );
                return 0;
        endif

	item.dmg_mod := dmg_mod + 5;
	SetNameByEnchant( item );

	SendSysMessage( mobile, "This "+item_desc+" is now sharper than ever." );

        return 1;
endfunction
