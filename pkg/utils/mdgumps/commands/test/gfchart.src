//--> control <--
//
// CONTROL:TEXTCMD/GM/CONTROL.SRC
//
// Displays a 640x480 GUMP colour-chart :)
//
// Creator: TJ Houston (Myrathi)
// Contact: myrathi@templar.dhs.org
//
// Created: 05-Apr-2000
// Updated: 24-Apr-2000
//
use uo;
use basic;

//include ":gumps:old-gumps";
include ":mdgumps:gumps_ex";


// Gump constants
//
const WINX_MAX := 640;
const WINY_MAX := 490;
const BKGND_GOLDTRIM            := 2620;  // Gold-press, black backing
const HUES_PER_PAGE             := 100;
const HUE_MAX                   := 3000;
const PAGE_MAX                  := 30; // HUE_MAX / HUES_PER_PAGE

program textcmd_gfchart( who )

	// Check to see if it's ICP calling this script
	// if so, who[1] holds "ICP"
	// and... who[2] holds <player> or '-1' (test run)
	//
	var me;
	if ( who[1] == "ICP" )
		me := who[2];
	else
		me := who;
	endif

	// Check for ICP doing a "test run". If so, return "I'm here!" :-)
	if ( me == -1 )
		return 1;
	endif

	who := me;

	// Continue with the normal text-command :)

	var BTN_BACK := 900,
		BTN_NEXT := 901,
		BTN_GOTO := 902,
		BTN_BGGO := 903;
	var base := 0; // 0-based offset into the 1-3000 hue range; page shows base+1 .. base+HUES_PER_PAGE
	var bg_gump := BKGND_GOLDTRIM; // panel background gump id, changeable via the BG Gump box

	while ( 1 )
		var exit_but;

		//GFInitGump();
		var gump := GFCreateGump( 50,50 );
	//	GFNoClose();
	//	GFNoMove();

		GFResizePic(gump, 0, 0, bg_gump, WINX_MAX+3, WINY_MAX+4);
		GFTextMid(gump, 0, 20, WINX_MAX, 67, "Text and Gump Colour Chart" );

		// Page jump box and BG-gump box, stacked in the top-left corner, inset
		// further from the corner than before (clear of the centred title;
		// hue row 1 is pushed down to clear both).
		GFTextLine(gump, 24, 25, 32, "Page:" );
		GFResizePic(gump, 66, 20, GFGetCfgConst("BackGrounds", "GOLDTRIM"), 40, 22);
		var page_txt := GFTextEntry(gump, 69, 22, 34, 18, 32, CStr(CInt(base/HUES_PER_PAGE)+1) );
		GFAddButton(gump, 109, 20, 0xA9A, 0xA9B, GF_CLOSE_BTN, BTN_GOTO); // Go (checkmark)

		GFTextLine(gump, 24, 55, 32, "BG Gump:" );
		GFResizePic(gump, 92, 50, GFGetCfgConst("BackGrounds", "GOLDTRIM"), 54, 22);
		var bg_txt := GFTextEntry(gump, 95, 52, 48, 18, 32, CStr(bg_gump) );
		GFAddButton(gump, 150, 50, 0xA9A, 0xA9B, GF_CLOSE_BTN, BTN_BGGO); // Set BG (checkmark)

		// Back/Next are the small ~20px arrow icons; Cancel is the ~66px "CANCEL" art,
		// so Cancel keeps its original wide gap and Back/Next sit further left of it.
		// All three sit further from the right edge than before.
		GFAddButton(gump, WINX_MAX - 164, 23, 4014, 4016, GF_CLOSE_BTN, BTN_BACK); // Back
		GFTooltip(gump, 1011067); // Previous Page
		GFAddButton(gump, WINX_MAX - 129, 23, 4005, 4007, GF_CLOSE_BTN, BTN_NEXT); // Next
		GFTooltip(gump, 1011066); // Next Page
		exit_but :=	GFAddButton(gump, WINX_MAX - 87, 23, 0x849, 0x848, 1); // Cancel  (0x81C, 0x81B = OKAY)

		// Columns are 35/35/30 hues wide (still 100 per page).
		var i;
		for( i := 1; i <= 35 ; i := i + 1 )
			GFTextLine(gump, 32, i*11+73, base+i, "aeiouAEIOU12345 - " + CStr(base+i) );
			GFTextLine(gump, 222, i*11+73, base+i+35, "aeiouAEIOU12345 - " + CStr(base+i+35) );
			if ( i <= 30 )
				GFTextLine(gump, 412, i*11+73, base+i+70, "aeiouAEIOU12345 - " + CStr(base+i+70) );
			endif
		endfor

		var retv := GFSendGump( who, gump );
		if ( !retv && (retv <> 0) )
			SendSysMessage( who, "Please close any other user-gumps and try again." );
			return;
		endif

		if ( retv[exit_but] )
			break;
		elseif ( retv[BTN_NEXT] )
			if ( base + HUES_PER_PAGE < HUE_MAX )
				base += HUES_PER_PAGE;
			endif
		elseif ( retv[BTN_BACK] )
			if ( base > 0 )
				base -= HUES_PER_PAGE;
			endif
		elseif ( retv[BTN_GOTO] )
			var page := CInt( GFExtractData( retv, page_txt ) );
			if ( page < 1 )
				page := 1;
			elseif ( page > PAGE_MAX )
				page := PAGE_MAX;
			endif
			base := (page-1) * HUES_PER_PAGE;
		elseif ( retv[BTN_BGGO] )
			var new_bg := CInt( GFExtractData( retv, bg_txt ) );
			if ( new_bg > 0 )
				bg_gump := new_bg;
			endif
		else
			break;
		endif
	endwhile

endprogram
