use uo;
use os;
use cliloc;

include ":containers:checks";
include "include/housing";

program canInsert( mobile, container, move_type, unused inserttype, unused adding_item, unused existing_stack, unused amount_to_add )
	// 2026-09-13: kept as a defensive no-op -- doesn't actually cover the
	// crash below (that flag only affects module functions that convert a
	// character parameter, not raw member access like mobile.x).
	set_script_option( SCRIPTOPT_CAN_ACCESS_OFFLINE_MOBILES, 1 );

	// 2026-09-16: some system-initiated moves call this hook with `mobile`
	// as a bare 0, not a real character -- confirmed via engine source, see
	// GetHouseSign's own comment in scripts/include/housing.inc for the
	// full trace. Real root cause of the "Operator - not supported for
	// Error and Integer" crash; guard it the same way MOVETYPE_COREMOVE
	// already fails open below.
	if( !mobile )
		return 1;
	endif

	if( move_type == MOVETYPE_COREMOVE )
		return 1;
	elseif( mobile.cmdlevel >= 2 )
		return 1;
	elseif( CP_IsLocked( container ))
		SendSysMessage( mobile, "You can't insert items into locked containers.", color := 33 );
		return 0;
	elseif( ContainerIsSecured( mobile, container ) )
		SendSysMessageCL ( mobile, 1010565, color := 33 ); // You do not have permission to place things in this container.
		return 0;
	endif

	return 1;
endprogram

function ContainerIsSecured( mobile, container )
	// 2026-09-22: see canRemove.src -- the shared check in housing.inc replaces
	// the "secured" struct lookup that never matched a real house secure.
	var secure_cont := FindHouseSecureContainer( container );
	if ( !secure_cont )
		// Nothing to worry about.
		return 0;
	elseif ( HouseSecureAccessAllowed( mobile, secure_cont ) )
		return 0;
	else
		return 1;
	endif
endfunction