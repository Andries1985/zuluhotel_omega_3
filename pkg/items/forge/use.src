use uo;
use os;

include ":blacksmithy:blacksmithgump";
include ":crafting:craftingfunctions";

program Animate_Large_Forge_Items( mobile, forge )

	if( !ReserveItem( forge ) )
		return;
	endif

	if( !NearForgeAndAnvil(mobile) )
		SendSysmessage( mobile , "You must be near a forge and an anvil to smith items!" );
		return;
	endif

	var items := GetObjProperty( forge, "OtherItems" );
	if( !items || items.errortext )
		SendSysMessage( mobile, "This forge appears to be broken, please page a gm.", 0x3, 0x22 );
		return 0;
	endif

	// 2026-09-15: bellows animation moved to a background script
	// (animatebellows.src) instead of running inline here -- it used to run
	// AFTER RunBlacksmithGump returned, so the ~5s bellows sequence only
	// played once the player had already finished (or backed out of) the
	// whole crafting session, and they couldn't do anything else until it
	// ended. Now it plays concurrently with the gump being open instead.
	Start_Script(":forge:animatebellows", {mobile, items});

	RunBlacksmithGump( mobile );
	return 1;
endprogram
