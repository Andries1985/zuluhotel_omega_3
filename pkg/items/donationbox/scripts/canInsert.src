/*
        Donation box: CanInsert hook.

        Always accept inserts (no lock/secure logic). Core moves pass through.
*/
use uo;

program canInsert( unused mobile, unused container, move_type, unused inserttype, unused adding_item, unused existing_stack, unused amount_to_add )
	if (move_type == MOVETYPE_COREMOVE)
		return 1;
	endif
	return 1;
endprogram
