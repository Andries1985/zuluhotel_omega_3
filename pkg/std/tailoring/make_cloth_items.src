// make_cloth_items.src
//
// Use a sewing kit to work cloth/hide into cloth-based items. The actual
// gump flow (RunTailoringGump) and everything it calls now lives in
// tailoringfunctions.inc (split out 2026-09-20, same pattern as
// blacksmithgump.inc) so other entry points -- Tailoring stations in
// general, and the Autoloom's facing/animation wrapper in autoloom_use.src
// specifically -- can open the exact same gump without including a file
// that has a program block.

// tailoringfunctions.inc declares every other module it needs itself.
use uo;

include "tailoringfunctions";

program use_sewing_kit( character, sewing_kit )

	if( !ReserveItem( sewing_kit ) )
		return;
	endif

	RunTailoringGump( character );

return;
endprogram
