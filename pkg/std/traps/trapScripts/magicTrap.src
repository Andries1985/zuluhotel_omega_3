/* Magic trap trigger.
 */

use uo;
use os;
use util;

include "include/client";
include "include/dotempmods";

program trapScript(params)
	var mobile := params[1];
	//var object := params[2];
	var trap_info := params[3];
	//var trap_index := params[4];
	params := 0; // Not needed anymore.

	SendSysMessage(mobile, "You set off a trap!");
	PlayObjectCenteredEffect(mobile, FX_EXPLODE_3, 10, 10);

	if ( trap_info.Strength )
		if ( trap_info.Strength["d"] )
			ApplyRawDamage(mobile, RandomDiceRoll(trap_info.Strength));
		else
			ApplyRawDamage(mobile, RandomDiceRoll(CInt(trap_info.Strength)));
		endif
	else
		ApplyRawDamage(mobile, RandomDiceRoll("10d5"));
	endif

	return 1;
endprogram
