const CARPENTER_SOUND	:= 0x23e;
const UOBJECT_CHEST	:= 0x0e42;
const UOBJECT_POISON_POTION := 0x0f0a;
const UOBJECT_PURPLE_POTION := 0x0f0d;
const EXPLOSION_SOUND	:= 0x208;
const EXPLOSION_ANIM	:= 0x36b0;
const POISON_SOUND 	:= 0x247;
const HIT_ACTION	:= 0x148b;

const DIVIDER		:= 4;
const APPEAR_AT		:= -10;
const POINTS_MULTIPLIER	:= 10;
//const GOLD_COLOR	:= 0x0033;
const TINKER_LOCKABLE	:= 90;
const FAME_BONUS	:= 10;

// Non-objtype button-id sentinels for the category gump's Options. All real
// recipe objtypes in tinker.cfg are well under this.
const TK_BTN_POTIONKEG	:= 900021;
const TK_BTN_TOTEM	:= 900022;
const TK_BTN_TRAP	:= 900023;

var tinker_cfg	:= ReadConfigFile( "tinker" );
// tinker.cfg's own Category/MaterialType fields drive the gump now (see
// craftmenu.inc) -- Log/Ingot Difficulty/Quality still live in Carpentry's
// and Blacksmithy's own resource tables, the same ones Bowcraft/Blacksmithy
// already reuse for their own material selection (CraftMenu_GetFamily-
// QualityDifficulty reads them directly, but TryToMakeItem below still needs
// carpentry_cfg/blacksmithy_cfg for the CoMaterial statues' second material).
var carpentry_cfg   := ReadConfigFile( ":carpentry:carpentry" );
var blacksmithy_cfg := ReadConfigFile( ":blacksmithy:blacksmithy" );

// 2026-08-30 -- OSI-style crafting gump, ported onto the shared
// pkg/systems/crafting/include/craftmenu framework (see bowcraft.src for the
// reference pattern). The tinker tool now opens the gump directly (no
// upfront targeting) with Wood/Metal/Glass/Clay categories side-by-side --
// auto-detecting Log/Ingot from backpack + Omega Cache like Bowcraft, with
// Glass/Clay as plain fixed materials. The non-recipe hardware combos (axle+
// gears, clock parts, etc.) are tinkering-exclusive parts, so their trigger
// moved from "use the tool, then target the part" onto the parts' own Script
// (see itemdesc.cfg) -- this same program now runs when any of them is
// double-clicked, dispatching on the part's own objtype instead. Potion Keg
// assembly, the obsidian totem, and chest-trapping still need a targeted
// item that ISN'T tinkering-exclusive (Empty Bottle, arbitrary containers),
// so those stay reachable as gump Options that do their own targeting, same
// pattern as Bowcraft/Tailoring's Repair Item.
program MakeTinkerItems( character , item )

	if( !ReserveItem( item ) )
		return;
	endif

	case( item.objtype )

		UOBJ_AXLE:		TryToMakeComplex( character , item , UOBJ_AXLE_AND_GEARS , UOBJ_GEARS , CARPENTER_SOUND );
					return;

		UOBJ_GEARS:		TryToMakeComplex( character , item , UOBJ_AXLE_AND_GEARS , UOBJ_AXLE , CARPENTER_SOUND );
					return;

		UOBJ_CLOCK_FRAME:	TryToMakeComplex( character , item , UOBJ_CLOCK , UOBJ_CLOCK_PARTS , SFX_ANVIL );
					return;

		UOBJ_CLOCK_PARTS:	TryToMakeComplex( character , item , UOBJ_CLOCK , UOBJ_CLOCK_FRAME , SFX_ANVIL );
					return;

		UOBJ_SPRINGS:		TryToMakeComplex( character , item , UOBJ_CLOCK_PARTS , UOBJ_AXLE_AND_GEARS , SFX_ANVIL );
					return;

		UOBJ_HINGE:		TryToMakeComplex( character , item , UOBJ_SEXTANT_PARTS , UOBJ_AXLE_AND_GEARS , SFX_ANVIL );
					return;

		UOBJ_SEXTANT_PARTS:	TryToMakeComplex( character , item , UOBJ_SEXTANT , 0 , SFX_ANVIL );
					return;

		UOBJ_AXLE_AND_GEARS:	SendSysMessage( character , "Select either some springs or a hinge." );
					var thing := Target( character , TGTOPT_CHECK_LOS );
					if( !thing )
						return;
					endif

					if( !Accessible( character , thing ) or !thing.movable )
						SendSysmessage( character , "You can't reach that!" );
						return;
					endif

					if( !ReserveItem( thing ) )
						return;
					endif

					case( thing.objtype )
						UOBJ_SPRINGS:	TryToMakeComplex( character , item , UOBJ_CLOCK_PARTS , UOBJ_SPRINGS , SFX_ANVIL );
								return;

						UOBJ_HINGE:	TryToMakeComplex( character , item , UOBJ_SEXTANT_PARTS , UOBJ_HINGE , SFX_ANVIL );
								return;

						default:	SendSysMessage( character , "You must select either a hinge or springs." );
								return;
					endcase

		default:		RunTinkeringGump( character );
	endcase

endprogram


// Top-level loop: category/selection gump -> detail gump -> back to top,
// until the player crafts something, picks an Option, or closes out
// entirely. The gump flow itself lives in the shared craftmenu.inc -- this
// is just the tinkering-specific wiring: Potion Keg/Totem/Trap handling, and
// dispatching a completed pick into TryToMakeItem below.
function RunTinkeringGump( character )

	while( 1 )
		var extra_options := array{
			struct{ label := "Assemble Potion Keg", value := TK_BTN_POTIONKEG },
			struct{ label := "Make Obsidian Totem", value := TK_BTN_TOTEM },
			struct{ label := "Set a Trap", value := TK_BTN_TRAP }
		};
		var choice := CraftMenu_ShowCategoryGump( character, tinker_cfg, "Tinkering", SKILLID_TINKERING, APPEAR_AT, extra_options, DIVIDER );
		if( !choice )
			return;
		endif

		if( choice == TK_BTN_POTIONKEG )
			SendSysmessage( character, "Select a keg, barrel tap, barrel lid, or empty bottles." );
			var keg_part := Target( character, TGTOPT_CHECK_LOS );
			if( keg_part and Accessible(character, keg_part) and ReserveItem(keg_part) )
				TryToMakePotionKeg( character, keg_part );
			endif
			return;
		endif

		if( choice == TK_BTN_TOTEM )
			SendSysmessage( character, "Select the obsidian." );
			var obs := Target( character, TGTOPT_CHECK_LOS );
			if( !obs )
				return;
			endif
			if( obs.objtype != UOBJ_OBSIDIAN )
				SendSysMessage( character, "That's not obsidian." );
				return;
			endif
			if( Accessible(character, obs) and ReserveItem(obs) )
				MakeTotem( character, obs );
			endif
			return;
		endif

		if( choice == TK_BTN_TRAP )
			SendSysmessage( character, "What would you like to trap?" );
			var chest := Target( character, TGTOPT_CHECK_LOS );
			if( chest and Accessible(character, chest) and ReserveItem(chest) )
				SetTrap( character, chest );
			endif
			return;
		endif

		var element := tinker_cfg[choice];
		if( !element )
			continue;
		endif

		var detail := CraftMenu_ShowDetailGump( character, tinker_cfg, choice, SKILLID_TINKERING, "Tinkering", array{}, DIVIDER );
		if( !detail )
			continue;
		endif

		TryToMakeItem( character, detail.slot1, choice );
		return;
	endwhile

endfunction


function TryToMakeComplex( character , use_on , to_be_done_objtype , needed_objtype , sfx );

	var itemname;
	var points;
	var skill;
	var have_it;
	var have_it_qual := 1;

	if( needed_objtype )
		have_it := FindObjtypeInContainer( character.backpack , needed_objtype );
		if( !have_it )
			return;
		endif
		have_it_qual := have_it.quality;
	endif

	var element := FindConfigElem( tinker_cfg , to_be_done_objtype );
	if( element )
	   	itemname := element.Name;
		skill 	 := element.Skill;
	else
		return;
	endif

	points	:= Cint( skill * POINTS_MULTIPLIER );

	_Play_Sound( character , sfx );
	
	sendDiff( character , skill );

	if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )

		var theitem := CreateItemInBackpack( character , to_be_done_objtype );
		if( !theitem )
			SendSysMessage( character , "Error in creation process please report this bug to staff." );
			DestroyItem( use_on );
			if( have_it )
				DestroyItem( have_it );
			endif
			return;
		endif

		theitem.movable := 1;
		var item_cfg	:= ReadConfigFile( ":*:itemdesc" );
		// Not Needed since price calculated in vendor AI based on quality
		// var sell_price := item_cfg[to_be_done_objtype].VendorBuysFor;

		var result_qual := Cint( ( use_on.quality + have_it_qual ) / 2 );
		if( theitem.quality )
			if( result_qual )
				theitem.quality := result_qual;
			endif
		endif

		var excep_ch	:= 10;
	  	if( GetObjProperty( character , CLASSEID_CRAFTER ) )
			excep_ch := Cint( excep_ch * ClasseBonus( character , CLASSEID_CRAFTER ) );
		else
			skill := skill + 20;
		endif

		if( skill < 90 )
			skill := 90;
		endif

		if( element.Exceptional and (GetObjProperty(character, "ForceExceptional") or ((Random(100) < excep_ch) and CheckSkill( character , SKILLID_TINKERING , skill , 0 ))) )
			if( theitem.quality )
				//Made something Exceptional
				// 2026-09-01: now shares the same helper bowcraft.src uses instead
				// of its own inline copy of this formula.
				var multiplier := CalcExceptionalQualityMultiplier( character, GetObjProperty( character, CLASSEID_CRAFTER ) );
				var newquality := Cint(theitem.quality * multiplier);
				newquality := Cdbl(newquality);
				newquality := newquality / 100;
				theitem.quality := newquality;
			endif

			itemname := "Exceptional " + itemname;
//			if( YesNo( character , "Add Builder Mark?" ) )
					SetObjProperty( theitem , "CraftedBy" , character.name );
//			endif

			/* Not needed since SellPrice calculated on quality now in vendor AI
			if( sell_price )
				theitem.buyprice := Cint( sell_price * 2 );
			endif
			*/
			SendSysmessage( character , "You make an exceptional item and put it in your pack" );
			SetObjProperty( theitem , "IsExceptional" , 1 );
			if( skill >= 130 )
				SendSysmessage( character , "This masterpiece will make you famous around the world." );
				AwardFame( character , FAME_BONUS );
			elseif( GetObjProperty( character , CLASSEID_CRAFTER ) and skill >= 110 )
				SendSysmessage( character , "This masterpiece will make you famous around the world." );
				AwardFame( character , FAME_BONUS );
			endif
		else

			SendSysmessage( character , "You create the item and place it in your pack." );
		endif

		if( use_on.objtype == UOBJ_GOLD_INGOT )
			theitem.color := GOLD_COLOR;
		else
			theitem.color := use_on.color;
		endif

		SetObjProperty( theitem , "BaseName" , itemname );
		SetName( theitem , itemname );

	else
		SendSysmessage( character , "You fail to create the item and destroy the material." );

	endif

	DestroyItem( use_on );
	if( have_it )
		DestroyItem( have_it );
	endif

endfunction


function _Play_Sound( who , sfx )

	PlaySoundEffect( who , sfx );
	Sleep (2);
	PlaySoundEffect( who , sfx );
	Sleep (2);
	if( !GetObjProperty( who, CLASSEID_CRAFTER ))
		PlaySoundEffect( who , sfx );
		Sleep (2);
	endif

endfunction


// item is the recipe's own key/objtype (a plain number, as returned by
// CraftMenu_ShowCategoryGump/ShowDetailGump) -- category browsing, recipe
// visibility, and material defaulting/picking are all handled by the shared
// craftmenu.inc now; this only does the tinkering-specific craft attempt.
function TryToMakeItem( character , resourceRequest , item )

	var material;
	var itemname;
	var give_deed;
	var deedname;

	var element := FindConfigElem( tinker_cfg , item );
	if( element )
		material := element.Material;
		deedname := element.Name;
	else
		return;
	endif

	// Crystal Items (Metal: Crystal Items) need an Elven Anvil/Forge nearby --
	// this used to gate the OLD submenu itself (choice==29) before any
	// individual recipe was even shown; now it's a craft-time gate instead,
	// same idea as Carpentry's NearASoulforge check.
	if( element.Category == "Metal: Crystal Items" )
		if( !NearAnElvenAnvilOrForge(character) )
			SendSysMessage(character,"You must be closer to an Elven Anvil or Forge!");
			return;
		endif
	endif

	var sfx;
	case( element.MaterialType )
		"Log":		sfx := CARPENTER_SOUND;
		"Ingot":	sfx := SFX_ANVIL;
		"Glass":	sfx := SFX_GLASSBREAK4;
		"Clay":		sfx := SFX_HAMMER;
		default:	sfx := CARPENTER_SOUND;
	endcase

	// Difficulty this specific resolved material (whichever wood/ore ended
	// up in resourceRequest -- default or hand-picked) contributes to the
	// skill roll below -- 0 for Glass/Clay, which don't have a quality table.
	var resource_diff := CraftMenu_GetFamilyQualityDifficulty( element.MaterialType, CInt(resourceRequest.objtype) );
	if( GetEffectiveSkill( character , SKILLID_TINKERING ) < resource_diff )
		SendSysmessage( character, "You aren't skilled enough to make anything with this yet." );
		return;
	endif

	// Statues (and any future combo recipe) require a second, player-chosen
	// material -- either wood or ore -- gated by that material's own craft
	// skill (Carpentry for logs, Blacksmithy for ingots), on top of the base
	// Tinkering requirement above. The chosen material's name/hue is what
	// ends up on the finished item, not the clay.
	var material2 := element.CoMaterial;
	var secondaryRequest;
	var skillid2;
	var skill2;
	var points2;

	if( material2 )
		SendSysmessage( character , "Select the second material (wood or ore) for this item." );
		var use_with := Target( character , TGTOPT_CHECK_LOS );
		if( !use_with )
			return;
		endif

		if( !Accessible( character , use_with ) or !use_with.movable )
			SendSysmessage( character , "You can't reach that!" );
			return;
		endif

		if( !IsInContainer( character.backpack , use_with ) )
			SendSysmessage( character , "That item has to be in your backpack." );
			return;
		endif

		var use_with_diff;

		if( IsLog( use_with ) )
			skillid2 := SKILLID_CARPENTRY;
			use_with_diff := carpentry_cfg[use_with.objtype].Difficulty;
		elseif( IsIngot( use_with ) )
			skillid2 := SKILLID_BLACKSMITHY;
			use_with_diff := blacksmithy_cfg[use_with.objtype].Difficulty;
		else
			SendSysmessage( character , "That must be wood or metal ore." );
			return;
		endif

		secondaryRequest := MakeBackpackRequest( character, use_with );

		if(GetGlobalProperty("PHC") || GetObjProperty(character, "#PPHC"))
			material2 := CInt(Ceil(material2/2));
		endif

		skill2 := element.CoSkill + CInt( use_with_diff / DIVIDER );
		if( skill2 < 1 )
			skill2 := 1;
		elseif( skill2 > 150 )
			skill2 := 150;
		endif

		if( GetEffectiveSkill( character , skillid2 ) < skill2 )
			SendSysmessage( character , "You aren't skilled enough with that material to use it here." );
			return;
		endif

		if( GetAvailableResource(character, secondaryRequest).total < material2 )
			SendSysmessage( character , "You don't have enough of that material." );
			return;
		endif

		points2 := CInt( (skill2 + CInt(material2 / 3)) * POINTS_MULTIPLIER / 3 );
	endif

	var skill := element.Skill + CInt( resource_diff / DIVIDER );
	if( skill < 1 )
		skill := 1;
	elseif( skill > 150 )
		skill := 150;
	endif
	var points	:= CInt( (skill + element.Material) * POINTS_MULTIPLIER );

	//Require half resources during Crafting PH
	if(GetGlobalProperty("PHC") || GetObjProperty(character, "#PPHC"))
		material := CInt(Ceil(material/2));
	endif

	var excep_ch := 10;
	var excep_diff	:= skill;

	if( GetObjProperty( character, CLASSEID_CRAFTER ) )
		excep_ch := Cint( excep_ch * ClasseBonus( character, CLASSEID_CRAFTER ) );
		excep_diff += 20;
	else
		excep_diff += 40;
	endif

	if( excep_diff < 90 )
		excep_diff := 90;
	endif


	
	LeaseResource( character, resourceRequest, material );
	if( material2 )
		LeaseResource( character, secondaryRequest, material2 );
	endif

	// Loop count was already fixed by CraftMenu_ShowDetailGump
	// (AutoLoop_initFixed for Make Max/Now, or AutoLoop_init with a capped
	// maxx for Make Number) -- do NOT call AutoLoop_init again here, it
	// would overwrite that count (e.g. turning Make Now's fixed 1 back into
	// an "ask every time" prompt).
	while( AutoLoop_more() && GetAvailableResource(character, resourceRequest).total >= material && (!material2 || GetAvailableResource(character, secondaryRequest).total >= material2) && NOT character.dead)

		sendDiff( character , skill );
		if( material2 )
			sendSecDiff( character , skill2 );
			CheckSkill( character , skillid2 , skill2 , points2 );
		endif

		itemname := element.Name;
		deedname := element.Name;
		give_deed := element.MakeDeed;

		if( item in { 0x1085 , 0x1086 , 0x1087 , 0x1088 , 0x1089 , 0x108a , 0x1535 } )
			SendSysmessage( character , "Select a gem for this item." );
			var thegem := Target( character , TGTOPT_CHECK_LOS );
			if( !thegem )
				break;
			endif

			if( (thegem.objtype > 0xf30) or (thegem.objtype < 0xf0f) )
				SendSysmessage( character , "That is not a gem!" );
				break;
			endif

			if( !Accessible( character , thegem ) )
				SendSysmessage( character , "You can't reach that!" );
				break;
			endif

			var item_cfg := ReadConfigFile( ":*:itemdesc" );
			itemname := item_cfg[thegem.objtype].Name + " " + itemname;
			SubtractAmount( thegem , 1 );
		endif

		_Play_Sound( character , sfx );

		var namingResource := resourceRequest;
		if( material2 )
			namingResource := secondaryRequest;
		endif

		if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )

			var theitem;
			var cprops := GetConfigStringArray( tinker_cfg[resourceRequest.objtype], "CProp" );
			var randomchance := Random(150);

			if( GetObjProperty(character, "ForceExceptional") or (( randomchance < excep_ch ) && CheckSkill( character, SKILLID_TINKERING, excep_diff, 0 )) )

				//Made something Exceptional
				if( give_deed )
					var product_desc := GetItemDescriptor(CInt(give_deed));
					ApplyMaterialPropertiesDeed(product_desc, namingResource, 1, character, SKILLID_TINKERING, deedname);
					theitem := CreateItemInBackpack( character , product_desc );
					itemname := GetObjProperty( theitem , "DeedName" );
					SetName( theitem, itemname );
					IncRevision(theitem);
				else
					//Non Deed Item
					var product_desc := GetItemDescriptor(CInt(item));
					ApplyMaterialProperties(product_desc, namingResource, 1, character, SKILLID_TINKERING);
					theitem := CreateItemInBackpack( character , product_desc );
					IncRevision(theitem);
				endif

				if( skill >= 130 )
					SendSysmessage( character , "This masterpiece will make you famous around the world." );
					AwardFame( character , FAME_BONUS );
				elseif( GetObjProperty( character , CLASSEID_CRAFTER ) and skill >= 110 )
					SendSysmessage( character , "This masterpiece will make you famous around the world." );
					AwardFame( character , FAME_BONUS );
				endif
			else
				//Failed to make Exceptional, make normal item
				if( give_deed )
					var product_desc := GetItemDescriptor(CInt(give_deed));
					ApplyMaterialPropertiesDeed(product_desc, namingResource, 0, character, SKILLID_TINKERING, deedname);
					theitem := CreateItemInBackpack( character , product_desc );
					itemname := GetObjProperty( theitem , "DeedName" );
					SetName( theitem, itemname );
					IncRevision(theitem);
				else
					//Non Deed Item
					var product_desc := GetItemDescriptor(CInt(item));
					ApplyMaterialProperties(product_desc, namingResource, 0, character, SKILLID_TINKERING);
					theitem := CreateItemInBackpack( character , product_desc );
					IncRevision(theitem);
					//itemname := GetObjProperty( theitem , "BaseName" );
				endif
				SendSysmessage( character, "You create the item and place it in your pack." );
			endif

			if( !theitem )
				ConsumeResource( character, resourceRequest, material );
				if( material2 )
					ConsumeResource( character, secondaryRequest, material2 );
				endif
				SendSysmessage( character, "Your backpack is full." );
				break;
			endif

				// skill := skill + Cint( resource_diff / DIVIDER );

				// if( skill < 1 )
				// 	skill := 1;
				// elseif( skill > 130 )
				// 	skill := 130;
				// endif

				// points	:= Cint( (skill + Cint(element.Material / 3)) * POINTS_MULTIPLIER );

				//SendSysmessage( character , "Difficulty: "+skill );

				// if( CheckSkill( character , SKILLID_TINKERING , skill , points ) )

				// 	var theitem := CreateItemInBackpack( character , to_make_objtype );
				// 	if( theitem )

				// 		theitem.movable := 1;
						

				// 		// if( resource_name )
				// 		// 	itemname := resource_name + " " + itemname;
				// 		// endif

				// 		// if( theitem.quality and resource_qual )
				// 		// 	theitem.quality := resource_qual;
				// 		// endif

				// 		if( GetObjProperty( character , CLASSEID_CRAFTER ) )
				// 			excep_ch	:= Cint( excep_ch * ClasseBonus( character , CLASSEID_CRAFTER ) );
				// 		else
				// 			skill		:= skill + 10;
				// 		endif

				// 		if( skill < 90 )
				// 			skill := 90;
				// 		endif

				// 		if( element.Exceptional and (Random(100) < excep_ch) and CheckSkill( character , SKILLID_TINKERING , skill , 0 ) )
							
				// 			// if( theitem.quality )
				// 			// 	//Made something Exceptional
				// 			// 	var armslore := GetEffectiveSkill( character , SKILLID_ARMSLORE );
				// 			// 	var multiplier := 5 + Cint( armslore / 10 );

				// 			// 	if( GetObjProperty( character , CLASSEID_CRAFTER ) )
				// 			// 		multiplier := Cint( multiplier * ClasseBonus( character , CLASSEID_CRAFTER ) );
				// 			// 	endif

				// 			// 	multiplier	:= 100 + multiplier;
				// 			// 	var newquality := Cint(theitem.quality * multiplier);
				// 			// 	newquality := Cdbl(newquality);
				// 			// 	newquality := newquality / 100;
				// 			// 	theitem.quality := newquality;
				// 			// endif

				// 			// itemname := "Exceptional " + itemname;
				// 			// if(GetObjProperty(character, "ToggleBuildMark"))
				// 			// 	if( YesNo( character , "Add Builder Mark?" ) )
