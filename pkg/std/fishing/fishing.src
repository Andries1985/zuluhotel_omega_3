function maplevel()

	var rand := random(100000);
	if(rand < 50000)
		return 0x6003;
	elseif(rand < 80000)
		return 0x6004;
	elseif(rand < 95000)
		return 0x6005;
	else
		return 0x6005;
	endif

endfunction
