Const UACTION_FISHING := 0x9;
Const SFX_SKILL_FISHING	:= 0x0240;

//Dead code - SOS bottles are never spawned (spawn function is disabled in fishing.inc
//and Item 0x9600/0x9601/0x9602 are commented out in itemdesc.cfg), so nothing can ever
//be targeted with objtype 0x9601 and none of this is reachable.
//Const UOBJECT_TREASURE_CHEST := 0x0E40;
//Const UOBJ_SOS_BOTLE_TILE := 0x9602;
//Const UOBJ_SOS_BOTLE := 0x9600;

//Dead code - declared but never referenced (the range check below uses a literal 15).
//Const FISHING_RANGE := 6;

program use_fishpole( character , pole )

	if(!ReserveItem(pole)) return; endif

	var use_on := Targetcoordinates(character);
	var water := check_for_water(use_on);

	if (!use_on) SendSysMessage(character, "Canceled"); return; endif

	//Dead code - 0x9601 (SOS message-in-a-bottle) can never be targeted; see note above FetchBottle.
	//if (use_on.item.objtype == 0x9601)
	//	if (FetchBottle(character)==1)
	//		return;
	//	else
	//		return;
	//	endif
	//endif

	if ( coordist(character.x,character.y,use_on.x, use_on.y) > 15 )
		SendSysmessage(character,"That is too far away");
		return 0;
	endif

	if(character.multi)
		SendSysMessage(character, "You can't fish from a house.");
		return 0;
	endif	

	if( !CheckLosAt(character, use_on.x, use_on.y, use_on.z) )
		SendSysMessage(character, "You can't see that.");
		return 0;
	endif

	if(!water)
		SendSysmessage(character,"You can't use that on this");
		return 0;
	endif

	//Region membership (safe area / dungeon) is resolved once - the character can't move
	//without breaking the autoloop (the movement check further down, and AutoLoop_more()
	//itself, both abort it the instant position changes), so it can't change mid-session.
	//deep_water is deliberately NOT cached here: a character anchored on a boat can have the
	//water under them go from deep to shallow and back between casts (other boats/dock
	//planks drifting into IsDeepWater()'s check radius) without the character ever moving,
	//so that's rechecked fresh every cast down in the loop instead.
	var in_safe_area := IsInSafeArea(character);
	var in_dungeon := IsFishingInDungeon(character);

	Autoloop_init (character);

 	while (Autoloop_more() && NOT character.dead)

	var newsplash;
	var tool_bon	:= GetObjProperty( pole , "FishingBonus" );
	//Recomputed every cast (not just once before the loop) so equipping/unequipping a
	//blade mid-session takes effect on the very next catch instead of requiring a restart.
	var equipped	:= whatequipped(character, pole);

	//Lure state is likewise re-read every cast, same reasoning as tool_bon above - applying
	//a lure mid-session (or running one out) takes effect on the very next catch.
	var lure_tier	:= GetObjProperty( pole , "LureTier" );
	var rare_div	:= 500;
	var legendary_div := 5000;
	var big_lure	:= 0;
	if (lure_tier == "Rare")
		rare_div := 50;
	elseif (lure_tier == "Legendary")
		legendary_div := 500;
	elseif (lure_tier == "Big")
		big_lure := 1;
	endif

	//Charge is spent on every cast, whether or not it lands a fish - matches OSI's Hook
	//convention (50 uses of the effect, not 50 successful catches).
	if (lure_tier)
		var lure_charges := CInt(GetObjProperty(pole, "LureCharges")) - 1;
		if (lure_charges > 0)
			SetObjProperty(pole, "LureCharges", lure_charges);
		else
			EraseObjProperty(pole, "LureTier");
			EraseObjProperty(pole, "LureCharges");
			SendSysmessage(character, "Your lure is spent.");
		endif
		//Keeps the pole's tooltip (charges remaining, or the lure line disappearing entirely
		//once spent) in sync - see the IncRevision note in lure/use.src.
		IncRevision(pole);
		Print("[Lure] "+character.name+" cast pole with "+lure_tier+" lure, "+CStr(Max(lure_charges,0))+" charges left (rare_div="+CStr(rare_div)+" legendary_div="+CStr(legendary_div)+" big_lure="+CStr(big_lure)+")");
	endif

	Performaction(character, UACTION_FISHING);
	PlaySoundEffect(character, SFX_SKILL_FISHING);

	newsplash := CreateItemAtLocation(use_on.x, use_on.y, use_on.z, 0x352d, 1, use_on.realm);
	newsplash.movable := 0;
	sleepms(800);
	newsplash.graphic := 0x352e;
	sleepms(800);
	newsplash.graphic := 0x352f;
	sleepms(800);
	newsplash.graphic := 0x3530;
	sleepms(800);
	DestroyItem(newsplash);
	var x := character.x;
	var y := character.y;
	var loop := 2;
	while ( (character.x==x) and (character.y==y) and loop >0)
		sleep(1);
		loop := loop-1;
	endwhile

	/*** that's another check for player movement (autoloop just did it) ***/	
	if(loop)
		SendSysMessage(character, "You must be patient while fishing");
		Autoloop_finish ();
		return 0;
	endif

	//No GetHarvestDifficulty gate here on purpose - it's a fluctuating per-poll value, not a
	//stable "is there fish here" flag, and gating on it caused false aborts. HarvestResource()'s
	//actual return value below is the real check, same as mining.src's ore/wood harvesting.

	//Fresh every cast - see the comment above Autoloop_init() for why this can't be cached
	//the way the region checks above it are.
	var deep_water := IsDeepWater(use_on.x, use_on.y, use_on.realm);
	var fishing_location := GetFishingLocation(deep_water, in_dungeon);
	var thepoints := Cint(get_default_points(SKILLID_FISHING) * GetFishingPointsMultiplier(deep_water, in_safe_area, in_dungeon));

	if (CheckSkill(character, SKILLID_FISHING, -1, thepoints))
		if (Random(70)<5)
			do_something(character);
			else
			var fish_amount := HarvestResource( "fish", use_on.x, use_on.y, 1, 1, use_on.realm );

			//This has to be checked before the Random()+1 below - HarvestResource can
			//legitimately return 0 when the local pool is drained, and Random(0)+1 would
			//mask that by always coming back as 1.
			if (!fish_amount)
				SendSysMessage(character, "You've fished these waters dry. Try somewhere else, or wait for them to replenish.");
				Autoloop_finish ();
				return;
			endif

			var level := GetClasseLevel(character);
			fish_amount := Cint(Random(fish_amount) + 1);

			if( GetObjProperty( character , CLASSEID_RANGER ) || GetObjProperty( character , CLASSEID_MYSTIC_ARCHER ) )
				fish_amount := Cint( fish_amount + level);

			endif

			SendSysmessage(character, "You catch a fish!");
			ResolveFishCatch(character, fish_amount, equipped, deep_water, fishing_location, tool_bon, rare_div, legendary_div, thepoints, big_lure);
		endif
	else
		SendSysMessage(character, "They don't seem to be biting.");
	endif

 endwhile

 Autoloop_finish ();
 SendSysMessage (character, "You stop fishing.");

endprogram


function do_something(character)
	var tnum := Random(15)+1;
	var it;
	case (tnum)
		1:	
			CreateItemInBackpack( character,0x9603,1);
			SendSysmessage(character, "You just found a special fishing net.");
		
		2:	
			if (Random(11)<1)
				it := CreateItemInBackpack( character, maplevel(), 1 );
				SendSysMessage(character,"You find a tattered old map!");
			endif

		3:  
			if (Random(10)<3)
				CreateItemInBackpack( character, 0xeed, Random(200)+1);
			endif

		4:
			CreateItemInBackpack( Character, RandomShell(Character), 1 );
			SendSysMessage(character,"You find something valuable!");

		7:
			//Case 7 alone is a 1/15 chance (same as cases 1 and 4) - gating it down to
			//3/20 here brings the overall odds to 1/15 * 3/20 = 1/100, without touching
			//cases 1-4's odds.
			if (Random(20)<3)
				CreateItemInBackpack( character, 0x1EB7, 1 );
				SendSysmessage(character, "You just found a taxidermy kit.");
			endif

		/*
		5: 
			if (Random(10)<3 and  checkcity(character)==0)
			it := createnpcfromtemplate("waterelemental", character.x-1 , character.y, character.z, 0, character.realm);
				if (!it.errortext)
				     SendSysmessage(character, "You attract the attention of a water elemental");
				endif
			endif
		6: 
			if (Random(10)<1)
	          it := createnpcfromtemplate("walrus", character.x-1, character.y, character.z, 0, character.realm);
	          if (!it.errortext)
	                SendSysmessage(character, "A walrus comes by to see what you're doing");
	          endif
			endif
		*/
	endcase

endfunction


function RandomShell(Character)

	case (Random(7))
	0: return 0x80ae;
	1: return 0x80be;
	2: return 0x80ce;
	3:
	4:
	5:
	6: if ( getEffectiveskill(Character,SKILLID_FISHING) > 120 )
		if ( Random(4) == 2 )
			return 0x80de;
		else
			return 0x80ee;
		endif
	else
		return 0x80ce;
	endif

endcase

endfunction


