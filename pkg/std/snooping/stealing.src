// Developer Turek - ZHS

// NOT USED — the live Stealing skill is bound to :stealing:stealing
// (pkg/std/stealing/stealing.src) via attributes.cfg's "Attribute Stealing"
// Script line. Nothing references ":snooping:stealing". Kept around rather
// than deleted since something may yet turn out to depend on it; verify
// before relying on any change made here.

//   DATE			UPDATES
// 4/23/2002	-	Items can no longer be stolen from ones backpack.



use uo;
use os;
use cfgfile;

include "include/client";
include "include/skillpoints";
include "include/utility";
include "include/eventid";
include "include/attributes";
include "include/random";
include "include/canstack";
include ":karmafame:karmafame";

const STACK_CAP := 60000;


program stealing(who)

	freehands(who);
	needgloves(who);
	

	SendSysmessage(who, "What item would you like to attempt to steal?");

	var itemtaken  := Target(who);

	if (!itemtaken) 
		sendsysmessage(who, "canceled"); 
		return;
	endif

	if(!getobjproperty(itemtaken,"cansteal"))
	sendsysmessage(who, "this item can not be stolen.");
	return;
	endif;

	nearvictim(who, itemtaken);

	var difficulty:= getobjproperty(itemtaken,"stealdiff");
	var thepoints:= difficulty*20;

	if (CheckSkill(who, SKILLID_STEALING, difficulty, thepoints))
	// they succeed
	
	if(itemtaken.objtype != 0xeed )
		setobjproperty(itemtaken,"cansteal",0);
		setobjproperty(itemtaken,"stolen",1);
	else
		eraseobjproperty(itemtaken,"cansteal");
		eraseobjproperty(itemtaken,"stealdiff");
	endif
	itemtaken.movable:= 1;
	StealIntoContainer(itemtaken, who.backpack);
	SendSysmessage(who, "You have successfully stolen the item.");

		var karma:=GetKarma(who);
		var lossKarma:=0;

			if (karma>-625)
				lossKarma:=0-(Random(200)+1);
			endif

		AwardKarma(who, lossKarma);

		var fame:=GetFame(who);
		var lossfame:=0;
		if (fame>-625)
			lossfame:=0-(Random(200)+1);
		endif
		AwardFame(who, lossfame);

		return;



	else
	// they have failed

	tellplayers(who);
	callguard(who);
	who.setcriminal(1);

	var karma2:=GetKarma(who);
		var lossKarma2:=0;

			if (karma2>-625)
				lossKarma2:=0-(Random(200)+1);
			endif

		AwardKarma(who, lossKarma2);

		var fame2:=GetFame(who);
		var lossfame2:=0;
		if (fame2>-625)
			lossfame2:=0-(Random(200)+1);
		endif
		AwardFame(who, lossfame2);

		return;
	endif


endprogram


// Stolen items were always dropped in with a plain MoveItemToContainer,
// which never merges with a matching stack already in the backpack --
// same root cause .move had (see scripts/textcmd/player/move.src).
function StealIntoContainer(item, cont)

	if (!item.stackable)
		MoveItemToContainer(item, cont);
		return;
	endif

	var carrier := FindOpenStack(item, cont);
	if (!carrier)
		MoveItemToContainer(item, cont);
		return;
	endif

	var space := STACK_CAP - carrier.amount;
	if (item.amount <= space)
		AddAmount(carrier, item.amount);
		SubtractAmount(item, item.amount);
	else
		AddAmount(carrier, space);
		SubtractAmount(item, space);
		MoveItemToContainer(item, cont);
	endif

endfunction

function FindOpenStack(item, cont)
	foreach dest in EnumerateItemsInContainer(cont, ENUMERATE_ROOT_ONLY)
		if (dest.stackable && dest.amount < STACK_CAP && CanStack(item, dest))
			return dest;
		endif
	endforeach
	return 0;
endfunction

function freehands(who)

	if(GetEquipmentByLayer(who, LAYER_HAND1) || GetEquipmentByLayer(who, LAYER_HAND2))
		sendsysmessage(who, "You need empty hands to perform this action!");
		exit;
	endif

endfunction





function needgloves(who)

	var weargloves:= 0;

    	foreach item in listequippeditems(who)

    		if (item.objtype == 0xc639) 
			weargloves:= 1;
		endif
		
	endforeach
	
	if(weargloves == 0)
		sendsysmessage(who,"You need to equip thief gloves to do that");
		exit;
	endif

	return 1;

endfunction

function tellplayers(who)

	var targets:=ListMobilesNearLocation(who.x, who.y, who.z, 10, who.realm);

	foreach mobile in targets
		if ((mobile.serial!=who.serial) and (mobile.dead==0) and (!mobile.criminal))
			SendSysmessage(mobile, "You notice "+who.name+" stealing!");
		elseif(mobile.serial==who.serial)
			SendSysmessage(who, "You are caught stealing!");
		endif
	endforeach

endfunction

function callguard(who)

var postarget:=ListMobilesNearLocation(who.x, who.y, who.z, 10, who.realm);
	foreach mobile in postarget
		if ((mobile.serial!=who.serial) and (mobile.npctemplate) and ((mobile.graphic == 400) or (mobile.graphic == 401)))
			printtextaboveprivate(mobile, "Guards! Stop "+who.name+" you thief!", who);
		endif
	endforeach

endfunction

function nearvictim(who, itemtaken)

var victimserial := getobjproperty(itemtaken, "victimserial");
if (victimserial)
	var victim := SystemFindObjectBySerial(victimserial);
	if (!victim)
		victim := SystemFindObjectBySerial(victimserial, SYSFIND_SEARCH_OFFLINE_MOBILES);
	endif
	if (victim && victim.realm == who.realm && Distance(who, victim) <= 2)
		return 1;
	endif
	sendsysmessage(who, "Your victim is too far away");
	exit;
endif

var close:= 0;
var posvictim:=ListMobilesNearLocation(who.x, who.y, who.z, 2, who.realm);

	foreach mobile in posvictim
		if ((mobile.serial!=who.serial) and (mobile.npctemplate))
			close:= 1;
		endif

	endforeach



	if (close == 1)
		return 1; 
	endif

	if (close == 0) 
	sendsysmessage(who, "Your victim is too far away");
	exit;
	endif

endfunction


