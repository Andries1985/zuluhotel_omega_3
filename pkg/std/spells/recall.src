use uo;

include "include/objtype";
include "include/spelldata";
include "include/areas";
include "include/client";
include "include/recalling";
include "include/traveldebug";	// 2026-10-01 TEMP debug: console tracing for the recall-into-house report
include "include/housetravel";	// 2026-10-02: FindHouseAtSpot / CanTravelIntoHouse / DestroyRefusedRune
//include ":housing:utility";
include "../pkg/multis/house/include/utility";

program cast_recall( caster, spell_id )

	var shp	:= GetHP(caster);
		// For scrolls, StartSpellScript isn't working >:(
		if (TypeOf(caster) == "Array")
					spell_id := caster[2];
			caster := caster[1];

		endif
	if (!can_cast(caster, 4))
		return;
	endif

	if( IsForbiddenAreaToRecallFrom( caster ) )
		SendSysMessage( caster, "You can't recall from here." );
		return 0;
	endif

	// 2026-10-02: house test by footprint (housetravel.inc) instead of the engine's
	// supporting-multi test, so a courtyard and a static house count as "in a house" too.
	var from_house := FindHouseAtSpot( caster.x, caster.y, caster.z, caster.realm );
	if( !CanTravelIntoHouse( caster, from_house, RECALL_TO ) )
		SendSysMessage( caster, "You can't recall from this house." );
		return;
	endif

	if (TryToCast( caster, spell_id ) != SUCCESS);
		EraseObjProperty(caster, "#Casting");
		return 0;
	endif

	SendSysmessage( caster, "Select a rune to recall from." );

	var cast_on := CanTargetThing(caster, 4, TGTOPT_CHECK_LOS );
	if(!cast_on)
		return;
	elseif( !Accessible( caster, cast_on ) )
		SendSysMessage( caster, "You can't reach that." );
		return 0;
	elseif( cast_on.objtype != UOBJ_RUNE && cast_on.objtype != 0x7100 && cast_on.objtype != UOBJ_RUNIC_ATLAS_EW && cast_on.objtype != UOBJ_RUNIC_ATLAS_NS )
		SendSysmessage( caster, "You can only cast that on a recall rune or a runebook!" );
		return 0;
	elseif( !ReserveItem( cast_on ) )
		return 0;
	endif

	var tox := CInt( GetObjProperty( cast_on, "x" ) );
	var toy := CInt( GetObjProperty( cast_on, "y" ) );
	var toz := CInt( GetObjProperty( cast_on, "z" ) );
	var torealm := GetObjProperty( cast_on, "realm" );
	//var sx  := caster.x;
	//var sy  := caster.y;
	//var sz  := caster.z;
	//var srealm  := caster.realm;

	if( !tox && !toy && !toz && !torealm )
		SendSysmessage( caster, "This is a blank rune!") ;
		return 0;

	elseif( IsForbiddenAreaToRecallTo( caster, tox, toy, torealm ) )
		SendSysMessage( caster, "You can't recall to this place." );
		if( cast_on.objtype == UOBJ_RUNE || cast_on.objtype == 0x1f14)
			DestroyItem(cast_on);
		endif
		return 0;

	endif

	TravelDebugDest( "RECALL", caster, tox, toy, toz, torealm );	// 2026-10-01 TEMP debug

	// 2026-10-02: the destination's house is found by footprint, ignoring the rune's z. The old
	// test (GetStandingHeight at the rune's z) saw no house when the rune was marked higher than
	// the floor of a house placed there later, and the move then dropped the caster inside.
	// A refused rune is destroyed (a runebook loses that entry), as forbidden areas already do.
	var house := FindHouseAtSpot( tox, toy, toz, torealm );
	var allowed := CanTravelIntoHouse( caster, house, RECALL_TO );
	TravelDebugHouse( "RECALL", caster, house, allowed );	// 2026-10-01 TEMP debug
	if( !allowed )
		SendSysMessage( caster, "You can't recall to this house." );
		DestroyRefusedRune( caster, cast_on, house, tox, toy, toz, torealm );
		return;
	endif

	var owner;
	var lamp;
	var Near_Items := ListItemsNearLocation(tox, toy, toz, 10, torealm);
	foreach thing in Near_Items
		if (thing.objtype == 0xf156)
			lamp := thing;
			owner := GetObjProperty(lamp,"Owner");
		endif
	endforeach
	if (lamp and owner)
		if (caster.serial != owner)
			SendSysMessage( caster, "You can't recall to this house." );
			return;
		endif
	endif

	PlaySoundEffect( caster, SFX_SPELL_RECALL1 );
	sleepms(250);
	var moved := MoveObjectToLocation( caster, tox, toy, toz, torealm );
	TravelDebugLanded( "RECALL", caster, moved );	// 2026-10-01 TEMP debug
	// 2026-10-02: the move can fail (something now stands on that spot); it used to fail silently.
	if( !moved )
		SendSysMessage( caster, "Something blocks that location." );
		return;
	endif
	PlaySoundEffect( caster, SFX_SPELL_RECALL2 );

endprogram
