use uo;
use os;

include "include/spelldata";
include "include/client";
include "include/attributes";
include "include/buffs";	// 2026-10-25: BuffOn / BuffOff for the reactive armor icon (ZH2.5 1.1.5 port)

program reactivearmor( caster, spell_id )

	var circle := 1;

		// For scrolls, StartSpellScript isn't working >:(
		if (TypeOf(caster) == "Array")
					spell_id := caster[2];
			caster := caster[1];

		endif
	if (!Can_Cast(caster,circle))
		return;
	endif

		if (TryToCast( caster, spell_id ) != SUCCESS);
			EraseObjProperty(caster, "#Casting");
			return 0;
		endif
	// 2026-09-21: the same helpful targeting the other buffs use. This was a bare
	// Target( caster ): no line of sight, no range, not even a check that the
	// target was a mobile, and moving or taking damage didn't break the cast.
   	var cast_on := CanTargetSpell( caster, circle, TGTOPT_HELPFUL + TGTOPT_CHECK_LOS );

    	if (!cast_on)
		return;
    	endif

	PlaySoundEffect(cast_on, SFX_SPELL_REACTIVE_ARMOR);
	PlayObjectCenteredEffect( cast_on, FX_SPELL_REACTIVE_ARMOR , SPEED_SPELL_REACTIVE_ARMOR , LOOP_SPELL_REACTIVE_ARMOR );
	var magery 	:= GetEffectiveSkill(caster, SKILLID_MAGERY);
	var power 	:= ModifyWithMagicEfficiency( caster , Cint( magery / 15 ) );
	var duration  := ModifyWithMagicEfficiency( caster , Cint( magery / 5 ) );
	
	if( GetObjProperty( caster , CLASSEID_MAGE ) )
		power := Cint( power * CLASSE_BONUS );
		duration := Cint( duration * CLASSE_BONUS );
	elseif( GetObjProperty( caster , CLASSEID_PALADIN ) )
		power := Cint( (power * CLASSE_BONUS) * 2 );
		duration := Cint( (duration * CLASSE_BONUS) * 2 );
	endif

	SetObjProperty( cast_on , "ReactiveArmor" , power );
	// 2026-09-21: each cast stamps its pid and only clears the armor if the
	// stamp is still its own. It used to erase "ReactiveArmor" unconditionally
	// after the sleep, so a recast (after the first armor was used up by a hit)
	// had its NEW armor removed early by the OLD cast's timer.
	var my_pid := GetPid();
	SetObjProperty( cast_on , "#ReactiveArmorPid" , my_pid );
	BuffOn( cast_on , "reactivearmor" , power , duration );	// 2026-10-25: buff bar icon (ZH2.5 1.1.5 port)
	SendBoostMessage( caster, cast_on, "reactive armor", power, duration, 0 );
	Detach();
	Sleep( duration );
	if( CInt( GetObjProperty( cast_on , "#ReactiveArmorPid" ) ) == my_pid )
		EraseObjProperty( cast_on , "ReactiveArmor" );
		EraseObjProperty( cast_on , "#ReactiveArmorPid" );
		BuffOff( cast_on , "reactivearmor" );	// 2026-10-25: icon off (ZH2.5 1.1.5 port)
	endif

endprogram
