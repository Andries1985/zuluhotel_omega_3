use uo;
use os;

include "include/spelldata";
include "include/client";
include "include/attributes";

const SPELL_EFFECT_TYPE_MOVING 	:= MOVING_SPELL_INVISIBILITY;
const SPELL_EFFECT_ID		:= FX_SPELL_INVISIBILITY;
const SPELL_EFFECT_SPEED	:= SPEED_SPELL_INVISIBILITY;
const SPELL_EFFECT_LOOP		:= LOOP_SPELL_INVISIBILITY;

program cast_invis( parms, spell_id )

	var circle := 6;
	var caster;
	var cast_on;
	var fromhit;

	if (parms[1] == "#MOB")
		caster := parms[2];
		cast_on := parms[3];
		if (parms[4])
			circle := parms[4];
		endif
		if (parms[5])
			fromhit := parms[5];
		endif

	else
		caster := parms;
		// For scrolls, StartSpellScript isn't working >:(
		if (TypeOf(parms) == "Array")
			caster := parms[1];
			spell_id := parms[2];
		endif
		if (TryToCast( caster, spell_id ) != SUCCESS);
			EraseObjProperty(caster, "#Casting");
			return 0;
		endif
		cast_on := CanTargetSpell(caster, circle, TGTOPT_HELPFUL + TGTOPT_CHECK_LOS );
		if (!cast_on)
			return;
		endif
	endif

	// 2026-09-21: reflection removed from this HELPFUL spell, matching Agility/
	// Bless/Cunning/Strength/Protection where the same block is commented out.
	// Cast on a friend with Magic Reflect up, it used to land on the caster
	// instead and burn the friend's reflect charges.
	/*if( !fromhit )
		detach();
		cast_on := Reflected( caster , cast_on , circle );
	endif*/

        PlaySoundEffect(caster, SFX_SPELL_INVISIBILITY);
        PlaySoundEffect(cast_on, SFX_SPELL_INVISIBILITY);

		SetObjProperty(cast_on, "StealthCD", ReadGameClock()+10);
        cast_on.hidden := 1;

	// 2026-09-21: this used to be "sleep(duration); cast_on.hidden := 0;" with no
	// check of whose hide it still was. Be revealed, hide again with the Hiding
	// skill (or a second Invisibility), and this old timer un-hid you later for
	// no visible reason. Now each cast stamps its pid and owns the hide only
	// while that stamp is its own; the timer also ends the moment the target is
	// revealed, and hiding.src clears the stamp on a successful skill hide.
	var my_pid := GetPid();
	SetObjProperty( cast_on, "#InvisPid", my_pid );

	detach();
	var time_left := ModifyWithMagicEfficiency( caster , Cint(GetEffectiveSkill(caster, SKILLID_MAGERY)));
	while( time_left > 0 )
		sleep( 1 );
		time_left := time_left - 1;
		if( CInt( GetObjProperty( cast_on, "#InvisPid" ) ) != my_pid )
			return;	// a newer cast, or a skill hide, owns the hide now
		endif
		if( !cast_on.hidden )
			EraseObjProperty( cast_on, "#InvisPid" );
			return;	// revealed early -- this cast is over, never touch .hidden again
		endif
	endwhile

	if( CInt( GetObjProperty( cast_on, "#InvisPid" ) ) == my_pid )
		EraseObjProperty( cast_on, "#InvisPid" );
		cast_on.hidden := 0;
	endif
	
endprogram
