use uo;

include "poisoning";

program do_poisoning( character )

	// Vial of Venom = apply poison to an item (today's flow, unchanged).
	// Toxin Flask = brew a new poison potion.
	// Neither present -- fall back to the original flow so nothing changes
	// for anyone who hasn't picked up either tool yet. Both present -- ask.
	// 2026-10-05: FindItemInContainer -> the engine call FindObjtypeInContainer. Same
	// recursion (both skip locked sub-containers) and a not-found error is falsy just
	// like the old unset return, so the !x checks below are unchanged. The engine
	// searches the top level before recursing, so where a match exists at both depths
	// you now get the top-level one.
	var vial  := FindObjtypeInContainer( character.backpack, UOBJ_VIAL_OF_VENOM );
	var flask := FindObjtypeInContainer( character.backpack, UOBJ_TOXIN_FLASK );

	if( vial && flask )
		if( YesNo( character, "Brew a new poison potion? (No = apply poison to an item)" ) )
			BrewPoison( character, flask );
		else
			ApplyPoison( character );
		endif
		return;
	elseif( flask )
		BrewPoison( character, flask );
		return;
	endif

	ApplyPoison( character );

endprogram
