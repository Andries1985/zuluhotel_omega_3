/////////////////////////////////////////////////////////////////////////////
//
//  carpentry.src - carpentry tool doubleclick script
//
//  Modifications:
//	19990414 ENS restructured logic a bit
//	19990423 RAC set created objects movable
//      20010329 Jaleem added colored fishing poles (inherit colors from logs)
//  NOTE: Furnature only faces one way, the "open" armoire gfx doesnt open as a
//		Container and wont switch to the closed gfx.
//
// 2026-08-30 -- OSI-style crafting gump, ported onto the shared
// pkg/systems/crafting/include/craftmenu framework (see bowcraft.src for the
// reference pattern). The tool now opens the gump directly (no upfront
// targeting) -- Log is always the primary material (auto-detected from
// backpack + Omega Cache, with a picker like Bowcraft's), and recipes that
// used to need a second targeted material (Ingot/Cloth/Bone -- the old
// ID_INGOTS/ID_CLOTH/ID_BONES tiers) now use that same auto-detect+picker
// behavior for their Material2 slot too (see craftmenu.inc's Pick-button fix
// for slot2/slot3, added specifically for this). Repair Item, Assemble Keg/
// Barrel, and Make Young Oak Staff are gump Options, same pattern as
// Bowcraft/Tailoring's Repair Item -- Barrel parts and the young oak log
// aren't tinkering-exclusive enough to safely rewire onto their own Script.
//
/////////////////////////////////////////////////////////////////////////////

use uo;
use cfgfile;
use os;
use math;

//include "util/key";
include ":keys:key";
include "util/repair";
include ":gumps:yesno";
include "include/client";
include "include/classes";
include "include/objtype";
include "include/itemutil";
include "include/random";
include "include/autoloop";
include "include/attributes";
include "include/difficulty";
//include "include/chests";
include ":karmafame:karmafame";
include ":crafting:craftingfunctions";
include "include/resourcemanager";
include ":crafting:craftmenu";

//const GOLD_COLOR	:= 0x0033;
const CARPENTER_SOUND	:= 0x23e;
const DIVIDER		:= 4;
const APPEAR_AT		:= -10;
const POINTS_MULTIPLIER	:= 10;
const TINKER_LOCKABLE	:= 90;
const FAME_BONUS	:= 10;

// Non-objtype button-id sentinels for the category gump's Options. All real
// recipe objtypes in carpentry.cfg are well under this.
const CP_BTN_REPAIR	:= 900021;
const CP_BTN_KEG	:= 900022;
const CP_BTN_OAKSTAFF	:= 900023;

var carpenter_cfg := ReadConfigFile( "carpentry" );
var carpenter_items := ReadConfigFile( ":carpentry:itemdesc" );


program MakeCarpentryItems( character, tool )

	if( !ReserveItem( tool ) )
		return;
	endif

	RunCarpentryGump( character );

endprogram


// Top-level loop: category/selection gump -> detail gump -> back to top,
// until the player crafts something, picks an Option, or closes out
// entirely. The gump flow itself lives in the shared craftmenu.inc -- this
// is just the carpentry-specific wiring: Repair/Keg/Oak Staff handling, and
// dispatching a completed pick into TryToCreateItem below.
function RunCarpentryGump( character )

	while( 1 )
		var extra_options := array{
			struct{ label := "Repair Item", value := CP_BTN_REPAIR },
			struct{ label := "Assemble Keg/Barrel", value := CP_BTN_KEG },
			struct{ label := "Make Young Oak Staff", value := CP_BTN_OAKSTAFF }
		};
		var choice := CraftMenu_ShowCategoryGump( character, carpenter_cfg, "Carpentry", SKILLID_CARPENTRY, APPEAR_AT, extra_options, DIVIDER );
		if( !choice )
			return;
		endif

		if( choice == CP_BTN_REPAIR )
			SendSysmessage( character, "What would you like to repair?" );
			var use_on := Target( character, TGTOPT_CHECK_LOS );
			if( use_on and Accessible(character, use_on) )
				if( use_on.hp and use_on.quality and carpenter_cfg[use_on.graphic] )
					repair_item( character, use_on, SKILLID_CARPENTRY );
				else
					SendSysMessage( character, "You can't repair that with this." );
				endif
			endif
			return;
		endif

		if( choice == CP_BTN_KEG )
			SendSysmessage( character, "Select a barrel lid, stave, or hoops." );
			var barrel_part := Target( character, TGTOPT_CHECK_LOS );
			if( barrel_part and Accessible(character, barrel_part) and ReserveItem(barrel_part) and IsInContainer(character.backpack, barrel_part) )
				TryToCreateKeg( character, barrel_part );
			else
				SendSysMessage( character, "You can't reach that." );
			endif
			return;
		endif

		if( choice == CP_BTN_OAKSTAFF )
			SendSysmessage( character, "Select the young oak wood." );
			var oak := Target( character, TGTOPT_CHECK_LOS );
			if( !oak )
				return;
			endif
			if( oak.objtype != 0xBA2A )
				SendSysMessage( character, "That's not young oak wood." );
				return;
			endif
			if( Accessible(character, oak) and ReserveItem(oak) )
				MakeYoungOakStaff( character, oak );
			endif
			return;
		endif

		var element := carpenter_cfg[choice];
		if( !element )
			continue;
		endif

		var detail := CraftMenu_ShowDetailGump( character, carpenter_cfg, choice, SKILLID_CARPENTRY, "Carpentry", array{}, DIVIDER );
		if( !detail )
			continue;
		endif

		TryToCreateItem( character, detail.slot1, detail.slot2, choice );
		return;
	endwhile

endfunction


function TryToCreateKeg( character , use_on )

	var needed_parts := { UOBJ_BARREL_LID	  ,
				UOBJ_BARREL_STAVE ,
				UOBJ_BARREL_HOOPS };


	var parts := { use_on };
	var itemname;
	var points;
	var skill;

	foreach objtype in needed_parts
		if( objtype != use_on.objtype )
			var have_it := FindObjtypeInContainer( character.backpack , objtype );
			if( !have_it )
				SendSysMessage( character , "You miss some parts to make the barrel." );
				return;

			else
				if( ReserveItem( have_it ) )
					parts.append( have_it );
				else
					return;
				endif
			endif
		endif
	endforeach

	//Integrity check
	if( len( parts ) != len( needed_parts ) )
		SendSysMessage( character , "You miss some parts to make the barrel." );
		return;
	endif

	var menu := CreateMenu( "What would you like to make?" );
	AddMenuItem( menu , UOBJ_KEG , "Keg" );
	AddMenuItem( menu , UOBJ_BARREL , "Barrel" );

	var choice := SelectMenuItem2( character , menu ).objtype;
	if( !choice )
		return;
	endif

	var element := FindConfigElem( carpenter_cfg , choice );
	if( element )
		itemname := element.Name;
		skill 	 := element.Skill;
	else
		return;
	endif

	sendDiff( character, skill );

	points	:= Cint( skill * POINTS_MULTIPLIER );

	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);
	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);
	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);

	var result_color;
	foreach item in parts
		if( item.color != 0 )
			result_color := item.color;
		endif

		DestroyItem( item );
	endforeach

	if( CheckSkill( character , cint(SKILLID_CARPENTRY) , cint(skill) , cint(points) ) )

		var theitem := CreateItemInBackpack( character , choice );
		if( !theitem )
			SendSysMessage( character , "Your backpack is full." );
			return;
		endif

		theitem.movable := 1;
		if( result_color )
			theitem.color := result_color;
		endif

		SetName( theitem , itemname );
		SendSysmessage( character , "You create the " + itemname + " and place it in your pack." );

	else
		SendSysmessage( character , "You fail to create the" + itemname + " and destroy the material." );
	endif

endfunction


// slot1Request is always Log (the primary material every carpentry recipe
// shares); slot2Request is the recipe's own Material2 co-material (Ingot,
// Cloth, or Bone) when the recipe has one, else 0 -- craftmenu.inc's family
// system + Pick-button now handles picking a specific one of either, so this
// only does the carpentry-specific craft attempt.
function TryToCreateItem( character , primaryRequest , secondaryRequest , item )
	var skillid := SKILLID_CARPENTRY;
	var skillid2;
	var skill;
	var skill2;
	var element;
	var material;
	var material2 := 0;
	var points;
	var points2;
	var itemname;
	var result_qual;
	var give_deed;
	var deedname;

	element := FindConfigElem( carpenter_cfg , item );

	if( element )
		material := element.Material;
		deedname := element.Name;
		if( secondaryRequest )
			material2 := element.Material2;
		endif
	else
		return;
	endif

	// Crystal Items (Log or Ingot tier) need an Elven Anvil/Forge nearby;
	// Soulforge Crafting (Ingot tier) needs a Soulforge -- these used to gate
	// the OLD submenu itself before any individual recipe was even shown;
	// now they're craft-time gates instead, same idea as Tinkering's Crystal
	// Items check.
	if( element.Category == "Log: Crystal Items" or element.Category == "Ingot: Crystal Items" )
		if( !NearAnElvenAnvilOrForge(character) )
			SendSysMessage(character,"You must be closer to an Elven Anvil or Forge!");
			return;
		endif
	endif
	if( element.Category == "Ingot: Soulforge Crafting" )
		if( !NearASoulforge(character) )
			SendSysMessage(character,"You must be closer to a SoulForge!");
			return;
		endif
	endif

	var ressource_diff := CraftMenu_GetFamilyQualityDifficulty( "Log", CInt(primaryRequest.objtype) );
	if( GetEffectiveSkill( character, SKILLID_CARPENTRY ) < ressource_diff )
		SendSysmessage( character , "You aren't skilled enough to make anything with this yet." );
		return;
	endif

	var use_with_diff := 0;
	if( secondaryRequest )
		use_with_diff := CraftMenu_GetFamilyQualityDifficulty( element.Material2Type, CInt(secondaryRequest.objtype) );
		if( GetEffectiveSkill( character, SKILLID_CARPENTRY ) < use_with_diff )
			SendSysmessage( character , "You aren't skilled enough with that material to use it here." );
			return;
		endif
	endif

	//Require half resources during Crafting PH
	if(GetGlobalProperty("PHC") || GetObjProperty(character, "#PPHC"))
		material := CInt(Ceil(material/2));
		if( secondaryRequest )
			material2 := CInt(Ceil(material2/2));
		endif
	endif

	LeaseResource( character, primaryRequest, material );
	if( secondaryRequest and material2 )
		LeaseResource( character, secondaryRequest, material2 );
	endif

	// Loop count was already fixed by CraftMenu_ShowDetailGump
	// (AutoLoop_initFixed for Make Max/Now, or AutoLoop_init with a capped
	// maxx for Make Number) -- do NOT call AutoLoop_init again here, it
	// would overwrite that count (e.g. turning Make Now's fixed 1 back into
	// an "ask every time" prompt).
	while( AutoLoop_more() && GetAvailableResource(character, primaryRequest).total >= material && NOT character.dead)

	// check for comaterial
	if( secondaryRequest )
		if( GetAvailableResource(character, secondaryRequest).total >= material2 )
			// refreshing skill2 stuff
			skillid2 := element.CoSkillid;
			skill2 := element.CoSkill;
		else
			break;
		endif
	elseif( material2 && GetAvailableResource(character, secondaryRequest).total < material2 )
		break;
	endif

	// refreshing stuff
	itemname := element.Name;
	deedname := element.Name;
	skill 	 := element.Skill;
	give_deed := element.MakeDeed;

	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);
	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);
	if( !GetObjProperty( character, CLASSEID_CRAFTER ))
		PlaySoundEffect( character , CARPENTER_SOUND );
		Sleep (2);
	endif

	skill := skill + Cint( ressource_diff / DIVIDER );

	if( skill2 )
		// Flat, not scaled by the co-material's own quality -- see
		// CraftMenu_CanMakeElement's header comment.
		points2 := Cint( (skill2 + Cint(element.Material2 / 3)) * POINTS_MULTIPLIER / 3 );
		if( skill2 < 1 )
			skill2 := 1;
		elseif( skill2 > 150 )
			skill2 := 150;
		endif
	endif

	if( skill < 1 )
		skill := 1;
	elseif( skill > 150 )
		skill := 150;
	endif

	sendDiff( character , skill );
	if( skill2 )
		sendSecDiff( character , skill2 );
	endif

	points	:= Cint( (skill + Cint(element.Material / 3)) * POINTS_MULTIPLIER );
	if( !CheckSkill( character , cint(skillid) , cint(skill) , cint(points) ) )
		var carpentry	:= GetEffectiveSkill( character , skillid );
		var destroy	:= 75 - Cint( carpentry / 2 );

		if( GetObjProperty( character , CLASSEID_CRAFTER ) )
			destroy := Cint( destroy / ClasseBonus( character , CLASSEID_CRAFTER ) );
		endif

		if( destroy > 50 )
			destroy	:= 50;
		endif

		var to_be_destroyed	:= Cint( material * destroy / 100 );
		if( to_be_destroyed < 1 )
			to_be_destroyed	:= 1;
		endif

		ConsumeResource( character , primaryRequest , to_be_destroyed );
		var res_name1 := GetItemDisplayName( CInt(primaryRequest.objtype) );

		if( secondaryRequest )
			var res_name2 := GetItemDisplayName( CInt(secondaryRequest.objtype) );
			var to_be_destroyed2	:= Cint( material2 * destroy / 100 );
			if( to_be_destroyed2 < 1 )
				to_be_destroyed2	:= 1;
			endif
			ConsumeResource( character , secondaryRequest , to_be_destroyed2 );
			SendSysmessage( character , "You destroyed " + to_be_destroyed + " " + res_name1 + " and " + to_be_destroyed2 + " " + res_name2 + "." );
		else
			SendSysmessage( character , "You destroyed " + to_be_destroyed + " " + res_name1 + "." );
		endif

	// if first check goes OK then GO ON
	else

		if( ( skillid2 ) &&  !CheckSkill( character , cint(skillid2) , cint(skill2) , cint(points2) )  )
			var the_skill	:= GetEffectiveSkill( character , skillid2 );
			var destroy	:= 75 - Cint( the_skill / 2 );

			if( GetObjProperty( character , CLASSEID_CRAFTER ) )
				destroy := Cint( destroy / ClasseBonus( character , CLASSEID_CRAFTER ) );
			endif

			if( destroy > 50 )
				destroy	:= 50;
			endif

			var res_name1 := GetItemDisplayName( CInt(primaryRequest.objtype) );
			var res_name2 := GetItemDisplayName( CInt(secondaryRequest.objtype) );

			var to_be_destroyed	:= Cint( material * destroy / 100 );
			if( to_be_destroyed < 1 )
				to_be_destroyed	:= 1;
			endif

			ConsumeResource( character , primaryRequest , to_be_destroyed );

			var to_be_destroyed2	:= Cint( material2 * destroy / 100 );
			if( to_be_destroyed2 < 1 )
				to_be_destroyed2	:= 1;
			endif

			ConsumeResource( character , secondaryRequest , to_be_destroyed2 );
			SendSysmessage( character , "You destroyed " + to_be_destroyed + " " + res_name1 + " and " + to_be_destroyed2 + " " + res_name2 + "." );

		// if second check goes ok as well or there is no second check GO ON
	else
		var excep_ch := 10;
		itemname := element.Name;

		if( GetObjProperty( character , CLASSEID_CRAFTER ) )
			excep_ch := Cint( excep_ch * ClasseBonus( character , CLASSEID_CRAFTER ) );
		else
			skill := skill + 20;
		endif

		if( skill < 90 )
			skill := 90;
		endif

		//Testing exceptional chance for deeds
		var randomchance := Random(20);

		var theitem;
		var item_cfg := ReadConfigFile( ":*:itemdesc" );

		if( element.Exceptional and (GetObjProperty(character, "ForceExceptional") or (randomchance < excep_ch)) )
			if( GetObjProperty(character, "ForceExceptional") or CheckSkill( character , cint(skillid) , cint(skill) , 0 ) )
				//Made something Exceptional
				if( give_deed )
					var product_desc := GetItemDescriptor(CInt(give_deed));
					ApplyMaterialPropertiesDeed(product_desc, primaryRequest, 1, character, SKILLID_CARPENTRY, deedname);
					theitem := CreateItemInBackpack( character , product_desc );
					itemname := GetObjProperty( theitem , "DeedName" );
					SetName( theitem , itemname );
					IncRevision(theitem);
				else
					//Non Deed Item
					var product_desc := GetItemDescriptor(CInt(item));
					ApplyMaterialProperties(product_desc, primaryRequest, 1, character, SKILLID_CARPENTRY);
					theitem := CreateItemInBackpack( character , product_desc );
					IncRevision(theitem);
				endif
				if( skill >= 130 )
					SendSysmessage( character , "This masterpiece will make you famous around the world." );
					AwardFame( character , FAME_BONUS );
				elseif( GetObjProperty( character , CLASSEID_CRAFTER ) and skill >= 110 )
					SendSysmessage( character , "This masterpiece will make you famous around the world." );
					AwardFame( character , FAME_BONUS );
				endif
			endif
		else
			//Failed to make Exceptional, make normal item
			if( give_deed )
				var product_desc := GetItemDescriptor(CInt(give_deed));
				ApplyMaterialPropertiesDeed(product_desc, primaryRequest, 0, character, SKILLID_CARPENTRY, deedname);
				theitem := CreateItemInBackpack( character , product_desc );
				itemname := GetObjProperty( theitem , "DeedName" );
				SetName( theitem , itemname );
				IncRevision(theitem);
			else
				//Non Deed Item
				var product_desc := GetItemDescriptor(CInt(item));
				ApplyMaterialProperties(product_desc, primaryRequest, 0, character, SKILLID_CARPENTRY);
				theitem := CreateItemInBackpack( character , product_desc );
				IncRevision(theitem);
			endif
		endif

		if( !theitem )
			ConsumeResource( character, primaryRequest, material );
			if( secondaryRequest )
				ConsumeResource( character, secondaryRequest, material2 );
			endif
			SendSysmessage( character, "Your backpack is full." );
			break;
		endif

		theitem.hp := theitem.maxhp;

		var result_color;
		if( secondaryRequest and (secondaryRequest.color != 0) and (secondaryRequest.objtype != UOBJ_GOLD_INGOT) )
			result_color := secondaryRequest.color;
		elseif( secondaryRequest and secondaryRequest.objtype == UOBJ_GOLD_INGOT )
			result_color := GOLD_COLOR;
		elseif( primaryRequest.color != 0 )
			result_color := primaryRequest.color;
		endif

		if( result_color )
			theitem.color := result_color;
		endif

		ConsumeResource( character , primaryRequest , material );
		if( secondaryRequest )
			ConsumeResource( character , secondaryRequest , material2 );
		endif


	// endif for first check else
	endif

	// endif for second check else
	endif

		if( !ExtendResourceLease(primaryRequest, character, material) )
			break;
		endif
		if( secondaryRequest and material2 )
			if( !ExtendResourceLease(secondaryRequest, character, material2) )
				break;
			endif
		endif

	endwhile
	ReleaseResourceLease(primaryRequest);
	if( secondaryRequest )
		ReleaseResourceLease(secondaryRequest);
	endif
	AutoLoop_finish();

endfunction


function MakeYoungOakStaff( character , oak )
	var ammount_required := 15;
	var oakRequest := MakeBackpackRequest( character, oak );
	//Require half resources during Crafting PH
	if(GetGlobalProperty("PHC") || GetObjProperty(character, "#PPHC"))
		ammount_required := CInt(Ceil(ammount_required/2));
	endif

	if( GetAvailableResource(character, oakRequest).total < ammount_required )
		SendSysMessage( character , "You don't have enough young oak wood to make a staff." );
		return;
	endif

	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);
	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);
	PlaySoundEffect( character , CARPENTER_SOUND );
	Sleep (2);

	var diff := 100;
	SendSysmessage( character , "Difficulty: "+diff );
	ConsumeResource( character , oakRequest , ammount_required );
	if( CheckSkill( character , cint(SKILLID_CARPENTRY) , cint(diff) , cint(diff * POINTS_MULTIPLIER) ) )
		CreateItemInBackpack( character , 0xBA28 );
		SendSysMessage( character , "You successfully crafted a young oak staff." );
	else
		SendSysMessage( character , "You failed in your attemp to create a young oak staff." );
	endif

endfunction

function IsBone( what )

	case( what.graphic )
		0xf7e:		return 1;

		default:	return 0;
	endcase

endfunction
