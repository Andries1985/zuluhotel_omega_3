//////////
// digtreasure.src
//
// Fires when the tool that was created when you decode a treasuremap 
// is double clicked. Target the map you want to dig from and then a
// ground tile. If you are close enough to the chest coords (chestx, y, z
// in the map) according to your mining skill, a chest is created and
// yummy loot is placed in it according to the map's level. The chest 
// should be locked and trapped. The map and the digging tool are 
// deleted after the chest is 'found'. The chest decays in 30 minutes.
//
// Author: Racalac, 4/24/99
// Hint system added by Zulu, zuluhotel@home.com  01/02/2000
// 
/////////


use uo;
use os;
use cfgfile;


include "include/client";
include "include/utility";
include "include/objtype";
include "include/starteqp";
include "include/classes";
include "include/attributes";
include "include/findcity";

const CHEST_SMALL_BASIC		:= 0xB4A6;
const CHEST_SMALL_ADORNED		:= 0xB4A8;
const CHEST_SMALL_MENACING		:= 0xB4AA;

const CHEST_MEDIUM_BASIC		:= 0xB4AE;
const CHEST_MEDIUM_ADORNED		:= 0xB4B0;
const CHEST_MEDIUM_MENACING	:= 0xB4B2;

const CHEST_LARGE_BASIC		:= 0xB4B4;
const CHEST_LARGE_ADORNED		:= 0xB4B6;
const CHEST_LARGE_MENACING		:= 0xB4B8;

var guardians := {};

program dig_treasure( character )

	if(GetObjProperty(character, "LastShovel") > ReadGameClock())
		SendSysMessage(character, "You need to wait before using that again.");
		return 0;
	endif

	SetObjProperty(character, "LastShovel", ReadGameClock()+5);

	SendSysmessage( character, "Target a treasure map to dig from." );
	var map := Target( character);
	
	if(!map)
		SendSysmessage( character , "Canceled." );
		return;
	endif

	if( map.objtype != UOBJ_MAP2 )
		SendSysmessage( character , "You must select a treasure map." );
		return;
	endif

	var chestx := GetObjProperty( map , "chestx" );
	var chesty := GetObjProperty( map , "chesty" );
	var chestz := GetObjProperty( map , "chestz" );
	var chestr := GetObjProperty( map , "chestr" );

	if( (!chestx) or (!chesty) )  //z might be 0!
		SendSysmessage( character , "That is not a treasure map." );
		return;
	endif

	//Realm check added
	if( character.realm != chestr)
		SendSysMessage( character, "You are in the wrong realm!" );
		return;
	endif

	if(!ReserveItem(map))
		return;
	endif

	SendSysmessage( character , "Target a location to dig." );
	var dig := TargetCoordinates( character );

	if(!dig)
		SendSysmessage( character , "Canceled." );
		return;
	endif
	
	var distt := coordist( character.x , character.y , dig.x , dig.y );
	if( distt > 2 )
		SendSysmessage( character , "That is too far away." );
		return;
	endif

	if(!CheckLosAt( character , dig.x , dig.y , dig.z ) );
		SendSysmessage( character , "You can't see that." );
		return;
	endif
  
	var range := 3;
	var lvl := GetObjProperty( map , "level" );
	var bard_lvl7_roll := 0;
	var bard_level := IsBard( character );
	var chance := CInt(Random(100));
	//Print( "Bard level: " + bard_level + ", Chance: " + chance + ", Level: " + lvl );

	if( lvl == 6 and bard_level > 0 and chance <= bard_level )
		//Print( "I am a bard" );
		lvl := 7;
		bard_lvl7_roll := 1;
		SendSysMessage( character , "Your bardic intuition senses something extraordinary here!" );
	endif

	var distn := coordist( dig.x , dig.y , chestx , chesty );
	var dirns := "None";
	var direw := "None";

	if( distn > range )

		if ( dig.y > chesty )
			dirns := "North";
		endif
		
		if ( dig.y < chesty )
			dirns := "South";
		endif
		
		if ( dig.x < chestx )
			direw := "East";
		endif
		
		if ( dig.x > chestx )
			direw := "West";
		endif

		if (direw == "None")
			SendSysmessage( character , "You dig for awhile and have a feeling to travel to the " + dirns + "." );
		else
			SendSysmessage( character , "You dig for awhile and have a feeling to travel to the " + dirns + ", " + direw + "." );
		endif

	else
		DestroyItem( map );
//		DestroyItem( shovel );
		var current_items := ListItemsAtLocation( chestx , chesty , chestz, chestr );
		foreach thing in current_items
			if( GetObjProperty( thing , "treasurechest" ) )
				DestroyItem( thing );
			endif
		endforeach
		
		Detach();
		SendSysMessage( character , "You unleash the treasure's guardians!" );
		SendSysMessage( character , "The chest will appears when all guardians will be destroyed." );
		
		var cfgfile	:= ReadConfigFile( "guardians" );
		if( cfgfile )
			var elem;
			var total;
			var num;
			var limit;
			var rand;
			var template;
			var i;

			if( bard_lvl7_roll )
				elem := FindConfigElem( cfgfile , 6 );
				if( elem )
					num := GetConfigInt( elem,"num" );
					for( i := 1 ; i <= 3 ; i := i + 1 )
						rand := Random( num ) + 1;
						template := GetConfigString( elem , ("creature" + rand) );
						CreateGuardian( template, chestx, chesty, chestz, chestr );
					endfor
				endif
			else
				elem := FindConfigElem( cfgfile , lvl );
				if( elem )
					total	:= GetConfigString( elem , "total" );
					num	:= GetConfigInt( elem,"num" );
					limit	:= RandomDiceRoll(total)+1;

					if(lvl < 4)
						for( i := 1 ; i <= limit ; i := i + 1 )
							rand := Random( num ) + 1;
							template := GetConfigString( elem , ("creature" + rand) );
							CreateGuardian( template, chestx, chesty, chestz, chestr );
						endfor
					else
					//Special spawning way for lvl 4+

						elem := FindConfigElem( cfgfile , 4 );
						total	:= GetConfigString( elem , "total" );
						num	:= GetConfigInt( elem,"num" );
						limit := RandomDiceRoll(total )+1;

						for( i := 1 ; i <= limit ; i := i + 1 )
							rand := Random( num ) + 1;
							template := GetConfigString( elem , ("creature" + rand) );
							CreateGuardian( template, chestx, chesty, chestz, chestr );
						endfor

						if(lvl > 4)
							elem := FindConfigElem( cfgfile , lvl );
							num	:= GetConfigInt( elem,"num" );
							rand := Random( num ) + 1;
							template := GetConfigString( elem , ("creature" + rand) );
							CreateGuardian( template, chestx, chesty, chestz, chestr );
						endif
					endif
				endif
			endif
		endif
		

		
		while( len(guardians) )
			var new_array := {};
			foreach guard in guardians
				if( guard and !guard.dead )
					new_array.append( guard );
				endif
			endforeach
			guardians := new_array;
			Sleep( 2 );
		endwhile
		
		SendSysmessage( character , "Now that all guardians were defeated, the treasure is revealed!" );
		var chest	 := CreateTreasureChest( lvl , chestx , chesty , chestz, chestr );
		SetObjProperty( chest , "treasurechest" , 1 );
		chest.saveonexit := 0;
		chest.decayat	 := Cint(ReadGameClock()) + 1010;
		chest.locked	 := 0;
	endif

endprogram

function CreateTreasureChest( lvl , x , y , z, r )

	var chest := CreateItemAtLocation( x , y , z , GetTreasureChestObjtype( lvl ) , 1, r );
	var lootgroup;
	var magiclevelup;
	var magicchance;

	case( lvl )
		1: lootgroup := 201;	 break;
		2: lootgroup := 202;	 break;
		3: lootgroup := 203;	 break;
		4: lootgroup := 204;	 break;
		5: lootgroup := 205;	 break;
		6: lootgroup := 206;	 break;
		7: lootgroup := 207;	 break;
		default: lootgroup := 201;		break;
	endcase

	case( lvl )
		1: magicchance := CInt(Random(25) + 75);		break;
		2: magicchance := CInt(Random(25) + 75);		break;
		3: magicchance := CInt(Random(25) + 75);		break;
		4: magicchance := CInt(Random(25) + 75);		break;
		5: magicchance := CInt(Random(20) + 80);		break;
		6: magicchance := CInt(Random(15) + 85);		break;
		7: magicchance := CInt(Random(10) + 90);		break;
		default: magicchance := 50;		break;
	endcase
	
	case( lvl )
		1: magiclevelup := 4;	break;
		2: magiclevelup := 5;	break;
		3: magiclevelup := 6;	break;
		4: magiclevelup := 7;	break;
		5: magiclevelup := 8;	break;
		6: magiclevelup := 9;	break;
		7: magiclevelup := 10;	break;
		default: magiclevelup := 4;		break;
	endcase

	chest.movable := 0;
	MakeLoot( chest , Cint(lootgroup), Cint(magicchance), CInt(magiclevelup));

	return chest;

endfunction


function GetTreasureChestObjtype( lvl )

	var pool;

	if( lvl <= 3 )
		pool := array( CHEST_SMALL_BASIC, CHEST_SMALL_ADORNED, CHEST_SMALL_MENACING );
	elseif( lvl <= 5 )
		pool := array( CHEST_MEDIUM_BASIC, CHEST_MEDIUM_ADORNED, CHEST_MEDIUM_MENACING );
	else
		pool := array( CHEST_LARGE_BASIC, CHEST_LARGE_ADORNED, CHEST_LARGE_MENACING );
	endif

	return pool[ Random( len(pool) ) + 1 ];

endfunction


function CreateGuardian( template, x , y , z, r )

	if(!z)
		z := 1;
	endif

    var nasty := CreateNpcFromTemplate( template, x, y, z, 0, r, MOVEOBJECT_FORCELOCATION );
	if( !nasty )
		CreateGuardian( template, x, y, z, r );
	else
		guardians.append( nasty );
		SetObjProperty( nasty, "untamable", 1 );
		SetObjProperty( nasty, "guardkill", 1 );
		SetObjProperty( nasty, "noloot", 1 );
		SetObjProperty( nasty, "nocut", 1 );
		SetObjProperty( nasty, "tmonster", 1 );

		var anchor	:= struct;
		anchor.+x	:= x;
		anchor.+y	:= y;
		anchor.+range	:= 10;
		anchor.+psub	:= 25;
		SetObjProperty( nasty, "Anchor", anchor);
	endif
	
endfunction