use uo;
use os;
use cfgfile;

include "include/dismount";
include "include/random";

program Hunger( chr )

	EraseObjProperty(chr, "hungrylevel");

	if (chr.cmdlevel>0 || TypeOf(getobjproperty(chr,"ctfloc"))=="Integer") return; endif

	var starttime := GetObjProperty(chr, "#logontime");

	set_critical(0);

	var hunger;

	// 2026-09-21: a drain left over from the previous login is stopped and, if
	// this character is already at 10 or more, a fresh one started now. Before,
	// the drain only ever started at the exact tick hunger reached 10 and it
	// exits on relog by design, so logging in hungry meant no drain at all.
	StopHungerDrain(chr);
	if (Cint(GetObjProperty(chr, "hunger")) >= 10)
		EnsureHungerDrain(chr);
	endif

	while ( chr )

		hunger := Cint(GetObjProperty(chr, "hunger"));

		// 2026-09-14: hunger scale stretched from 0-9(->10) to 0-14(->15).
		if (hunger >= 14)
			hunger := 14;
		elseif (!hunger)
     			hunger :=0;
		endif

		hunger := hunger +1;
		SetObjProperty(chr, "hunger", hunger);

		case (hunger)
		5 :
			SendSysMessage(chr, "You could use a bite to eat...");

		10 :
			SendSysMessage(chr, "You're getting pretty hungry...");
			// Resource drain also starts here (stamina), well before the
			// famine message/auto-eat attempt at 14 -- runs as an
			// independent background script (hungerdamage.src) instead of a
			// blocking inline call, so THIS loop keeps climbing hunger
			// toward 12/14/15 instead of freezing at 10 like the old
			// single-tier design did. hungerdamage.src re-checks current
			// hunger each tick to add mana loss at 12 and health loss at 14.

		12 :
			SendSysMessage(chr, "You're growing faint with hunger...");

		14 :
			SendSysMessage(chr, "You're absolutely famished!");
			// Side effect matters here, not the return value -- health loss
			// is already covered by hungerdamage.src once hunger reaches 14.
			CanEat( chr );
		endcase

		// 2026-09-21: every tick at 10 or more makes sure a drain is running
		// (it was only started at exactly 10, and the old call passed {chr} --
		// a one-item list -- where hungerdamage.src expects the character, so
		// it read hunger off a list, got 0 and exited at once: the drain has
		// never actually run).
		if (hunger >= 10)
			EnsureHungerDrain(chr);
		endif

		sleep( 60 * 60 );
		if (chr)
			if ( starttime != GetObjProperty(chr, "#logontime") )
				return;
			else
				checkmount(chr);
			endif
		else
			return;
		endif

	endwhile    

endprogram

function CheckMount(me)

	var mount := GetEquipmentByLayer( me, 25 );
	if (!mount)
		return;
	else
		poop(me, mount);
	endif

	var freetime := getobjproperty(mount,"freetime");
	if ( (ReadGameClock() < freetime ) or (Random(3)!=1) )
		return;
	endif

	if ( CanFeed(me,mount) )
		return;
	endif
	
	if(Random(10)==1)
		var it := Dismount(me,mount);
		if (it)
			it.script := "barker";
			EraseObjProperty (it, "master");
			it.setmaster( 0 );
			RestartScript(it);
			printtextabove(it,it.name + " has decided it is better off without a master!");
		endif
	endif
	set_critical(0);

endfunction

function poop(me, mount)
if(!me.multi)
	if (Random(50)==1)
		var poopoo := 0;
		case (mount.graphic)
		0x3ea2:
		0x3e9f:
		0x3ea0:
		0x3ea1:
			poopoo := CreateItemAtLocation(me.x,me.y,me.z,0x0f3c,1,me.realm);
			poopoo.decayat := ReadGameClock() + 300;
		endcase
	endif
endif
endfunction

// HungerDamage moved to hungerdamage.src (2026-09-14) -- now an independent
// background script (spawned via Start_Script at hunger level 10 above)
// instead of a blocking inline function, so this file's hourly loop can
// keep climbing hunger toward the new 12/14/15 tiers while it runs.

// 2026-09-21: the running drain's pid lives in #HungerDrainPid on the
// character (set/cleared by hungerdamage.src itself). Starts one only if
// none is alive, so an hourly tick can never stack a second drain.
function EnsureHungerDrain(chr)

	var pid := CInt(GetObjProperty(chr, "#HungerDrainPid"));
	if (pid)
		if (GetProcess(pid))
			return;
		endif
	endif

	Start_Script(":cooking:hungerdamage", chr);

endfunction

// 2026-09-21: kills a drain from an earlier login (it would exit on its own
// within one tick, but a fresh one has to be able to start right away).
function StopHungerDrain(chr)

	var pid := CInt(GetObjProperty(chr, "#HungerDrainPid"));
	if (pid)
		var proc := GetProcess(pid);
		if (proc)
			proc.kill();
		endif
		EraseObjProperty(chr, "#HungerDrainPid");
	endif

endfunction

function CanFeed(me, mount)

	var foodtype := "veggie";
	case (mount.graphic)
		//0x3ea4:	foodtype := "meat";//forest ostard
		0x3ea5:	foodtype := "meat";//frenzied ostard
	endcase
	if (mount.color == 1108)
		foodtype := "meat";//nightmare
	endif

	var cfg := readconfigfile("::food");
	var elem := findconfigelem(cfg,foodtype);
	var foodarray := GetConfigStringArray(elem,"food");
	foreach item in enumerateitemsincontainer(me.backpack)
		if ( cstr(item.objtype) in foodarray )
			PlaySoundEffect(me,cint(0x3b) + Random(3));
			SubtractAmount(item,1);
			PrintTextAbovePrivate(me,"*You feed your mount*",me);
			SetObjProperty(mount,"freetime", cint(ReadGameClock() + 14400));
			return 1;
		endif
	endforeach

	return 0;

endfunction

function CanEat(me)

	var cfg := readconfigfile("::food");
	var elem := findconfigelem(cfg,"cooked");
	var foodarray := GetConfigStringArray(elem,"food");

	var hunger := Cint(GetObjProperty(me, "hunger"));

	foreach item in enumerateitemsincontainer(me.backpack)
		if ( cstr(item.objtype) in foodarray )
			PlaySoundEffect(me,cint(0x3b) + Random(3));
			PrintTextAbovePrivate(me,"*Yummy!*",me);
			var foodvalue := cint(GetObjProperty(item,"foodvalue"));
			if (!foodvalue)
				foodvalue := 1;
			endif
			hunger := hunger - foodvalue;
			SetObjProperty(me,"hunger",hunger);
			SubtractAmount(item,1);
			return 1;
		endif
	endforeach

	return 0;

endfunction
